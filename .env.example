# Couch runtime config. Copy to .env and fill in; .env is never committed.
# systemd loads it via EnvironmentFile=%h/couch/.env, so keep the systemd
# format: KEY=value, unquoted, one per line, comments on their own line.

# Port the couch server listens on for the phone.
COUCH_PORT=8790
# Address the box is reachable at on the LAN; builds the House view links.
COUCH_LAN_HOST=192.168.0.10

# Kodi's JSON-RPC webserver (Settings > Services > Control).
KODI_URL=http://localhost:8090
# Kodi webserver username.
KODI_USER=kodi
# Kodi webserver password. SECRET, no default: the server fails without it.
KODI_PASSWORD=changeme
# Host of Kodi's TCP notification socket (the live player-state feed).
KODI_EVENT_HOST=127.0.0.1
# Port of Kodi's TCP notification socket.
KODI_EVENT_PORT=9090

# Jellyfin server used for the catalogue.
JELLYFIN_URL=http://localhost:8096
# Jellyfin API key (Dashboard > API Keys). Optional: falls back to the
# jellyfin-kodi addon's own token, read at runtime.
JELLYFIN_API_KEY=

# Jellyseerr, for search and requests.
JELLYSEERR_URL=http://localhost:5055
# Jellyseerr's settings.json, which its API key is read from.
JELLYSEERR_SETTINGS=/opt/stacks/jellyseerr/config/settings.json
# Jellyseerr API key. Optional: overrides the settings.json read above.
JELLYSEERR_API_KEY=

# Sonarr, for the upcoming-episodes calendar.
SONARR_URL=http://127.0.0.1:8989
# Sonarr's config.xml, which its API key is read from.
SONARR_CONFIG=/var/lib/sonarr/config.xml
# Sonarr API key. Optional: overrides the config.xml read above.
SONARR_API_KEY=

# Radarr, for film release states.
RADARR_URL=http://127.0.0.1:7878
# Radarr's config.xml, which its API key is read from.
RADARR_CONFIG=/var/lib/radarr/config.xml
# Radarr API key. Optional: overrides the config.xml read above.
RADARR_API_KEY=

# qBittorrent WebUI. Behind the VPN container, so not on localhost.
QBITTORRENT_URL=http://192.168.0.10:8080
# qBittorrent WebUI username.
QBITTORRENT_USER=admin
# qBittorrent WebUI password. SECRET, no default.
QBITTORRENT_PASSWORD=changeme

# Steam Web API key from steamcommunity.com/dev/apikey. SECRET, no default.
STEAM_API_KEY=
# Your 64-bit SteamID, whose owned library is listed.
STEAM_ID=

# YouTube Data API v3 key for in-app search. SECRET, no default.
YOUTUBE_API_KEY=

# couchd's atomically-rewritten status file, shown on the Screen tab. Optional:
# defaults to <repo>/shadow/status.json. couchd not running is normal, so a
# missing file is never an error.
COUCHD_STATUS=
