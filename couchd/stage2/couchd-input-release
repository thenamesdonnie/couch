#!/bin/bash
# couchd stage 2 - ROLLBACK. Gives the DualSense back to ds2000.
#
# Stops and DISABLES inputproc, disarms BOTH halves of the udev fence
# (72 and 74 - see RULES below for why 72 alone is a dead pad), then
# retriggers so the uaccess ACLs come back now rather than at replug.
#
# SR3: rollback must never need Donnie to find the sudo password at 11pm
# with a dead pad in his hand. This script is root-owned and root-only
# writable, and the sudoers drop-in (sudoers-couchd) lets ds2000 run THIS
# ONE SCRIPT with NOPASSWD. That is where the safety comes from: not from
# the argument list, but from ds2000 being unable to change what runs. The
# sudoers line pins it to an empty argument list all the same.
#
# It is idempotent: running it twice, or when nothing is installed, is fine
# and is never an error.
#
#   sudo /usr/local/sbin/couchd-input-release
#
# Cheat-sheet line (verbatim, goes on the audit cheat sheet):
#   pad dead / games see no controller ->  sudo couchd-input-release
#
set -u

# This body runs as root, so nothing here is resolved by bare name off an
# inherited PATH. sudo's secure_path normally already guarantees that; this
# does not depend on it still being configured. Absolute paths below, and a
# fixed PATH for anything a helper might shell out to.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

SYSTEMCTL=/usr/bin/systemctl
UDEVADM=/usr/bin/udevadm
MV=/usr/bin/mv
SED=/usr/bin/sed

# BOTH halves of the fence, and it must stay both. 72 is the half that takes
# the pad (OWNER/GROUP/MODE + TAG-="uaccess"); 74 is the half that was added
# two days later, on 23 Aug 2026, when TAG-= turned out not to remove a node
# from the uaccess builtin's queue at all (tags are STICKY). 74 therefore runs
# AFTER 73-seat-late and strips the ACL the builtin just applied, matching the
# DualSense on its own vid/pid/uniq and the hidraw node with it.
#
# Disarming 72 alone is what this script did until 20 Sep 2026, and it is a
# rollback that LOOKS like it worked and leaves a DEAD PAD: the node is handed
# back by 72's absence, then 74 fires `setfacl -b` and takes the ds2000 ACL
# away again. Step 3's retrigger re-fires 74 every time, so even the verify
# line this script prints could never have passed. The hidraw half is the
# worse one - Steam's DualSense support rides hidraw, not evdev.
#
# Order matters within the list only in that both must be gone before the
# retrigger in step 3; the loop below does them all first.
RULES="/etc/udev/rules.d/72-couchd-own-dualsense.rules
/etc/udev/rules.d/74-couchd-fence-late.rules"
UNIT=inputproc.service

log() { echo "couchd-input-release: $*"; }

# Not `set -e`. The sequencing below is deliberate and each step is meant to
# be survivable: a udevadm that fails must not stop us reaching the
# per-device retrigger, because a half-rolled-back pad is worse than a
# noisy one. Every step therefore reports its own failure and continues,
# and the exit status at the bottom says whether anything went wrong.
failed=0
warn() { failed=1; log "WARNING: $*"; }

# A missing binary IS fatal, and it is worth being loud about rather than
# discovering it one command at a time in the dark.
for bin in "$SYSTEMCTL" "$UDEVADM" "$MV" "$SED"; do
  if [ ! -x "$bin" ]; then
    log "FATAL: $bin is missing or not executable - cannot roll back safely"
    exit 2
  fi
done

# 1. Stop the owner first. If the rule went away while inputproc still held
#    EVIOCGRAB, the pad would be un-hidden but still ungrabbable.
#    Then DISABLE it, so that the two halves of this rollback have the same
#    lifetime. Disarming the rule survives a reboot (the file is renamed on
#    disk); a mere `stop` does not, so without the disable the unit would
#    come back at the next boot, grab a pad that udev no longer hands it,
#    and the box would be in a state neither half of the design describes.
if "$SYSTEMCTL" list-unit-files "$UNIT" >/dev/null 2>&1; then
  if "$SYSTEMCTL" is-active --quiet "$UNIT"; then
    log "stopping $UNIT"
    "$SYSTEMCTL" stop "$UNIT" || warn "could not stop $UNIT"
  fi
  # `disable` on an already-disabled unit is a no-op that exits 0, so this
  # stays idempotent.
  if "$SYSTEMCTL" is-enabled --quiet "$UNIT" 2>/dev/null; then
    log "disabling $UNIT (it must not come back at the next boot)"
    "$SYSTEMCTL" disable "$UNIT" >/dev/null 2>&1 \
      || warn "could not disable $UNIT - CHECK IT BEFORE REBOOTING"
  else
    log "$UNIT already disabled"
  fi
else
  log "no $UNIT installed (nothing to stop)"
fi

# 2. Disarm the rule by renaming it. Declarative, crash-immune: no runtime
#    chmod to leave behind (this is the InputPlumber #582/#586 failure mode
#    we specifically designed out).
disarmed=0
while IFS= read -r rule; do
  [ -n "$rule" ] || continue
  if [ -f "$rule" ]; then
    if "$MV" -f "$rule" "$rule.off"; then
      log "rule disarmed -> $rule.off"
      disarmed=$((disarmed + 1))
    else
      warn "could not rename $rule - THE PAD IS STILL OURS, fix this by hand"
    fi
  else
    log "no rule at $rule (already released)"
  fi
done <<EOF
$RULES
EOF

# Nothing to disarm is a legitimate second run, not a fault. Saying so here
# stops a re-run reading like it did the work twice.
if [ "$disarmed" -eq 0 ]; then
  log "no rules needed disarming (already released)"
fi

# 3. Reload and re-trigger so the ACLs come back NOW, not at next replug.
"$UDEVADM" control --reload-rules || warn "udevadm reload failed"
"$UDEVADM" trigger --subsystem-match=input --subsystem-match=hidraw \
  || warn "udevadm trigger failed"
"$UDEVADM" settle --timeout=10 || true

# 4. Restore uaccess explicitly for anything still lacking it. The trigger
#    above normally does this; this is the belt to its braces, and it is
#    also what makes the script safe to run when udev is being obtuse.
shopt -s nullglob
for dev in /dev/input/event* /dev/hidraw*; do
  # A device can disappear between the glob and the query, so this whole
  # line is allowed to come back empty rather than abort the loop.
  name=$("$UDEVADM" info --query=property --name="$dev" 2>/dev/null \
         | "$SED" -n 's/^ID_MODEL=//p') || name=''
  case "$name" in
    *DualSense*|*Wireless_Controller*)
      "$UDEVADM" trigger --action=change "$dev" 2>/dev/null || true
      ;;
  esac
done

log "done - verify with:  getfacl -c /dev/input/eventN"
log "(expect a user:ds2000:rw- line; if it is absent the pad is still ours)"
if [ "$failed" -ne 0 ]; then
  log "one or more steps reported a WARNING above - re-read them before"
  log "assuming the pad is back. Re-running this script is safe."
  exit 1
fi
exit 0
