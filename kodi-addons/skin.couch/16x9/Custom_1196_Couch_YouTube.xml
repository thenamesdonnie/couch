<?xml version="1.0" encoding="UTF-8"?>
<!-- Couch YouTube (Stagelight phase 2) - the familiar YouTube shape: icon
     sidebar on the left (Home/Subscriptions/Watch Later/History/Trending/
     Search), 3-column 16:9 video grid on the right. The sidebar sets
     yt_path/yt_title window properties; the grid's content follows the
     property, so switching sections is one focus move + select. Window 1196.
     Plain controls (C13). -->
<window type="window" id="1196">
	<defaultcontrol always="true">6100</defaultcontrol>
	<onload>SetProperty(yt_path,plugin://plugin.video.youtube/special/recommendations?category_label=Recommendations)</onload>
	<onload>SetProperty(yt_title,Home)</onload>
	<controls>

		<!-- ground -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="ff0a0c10">couch/white.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture>couch/bg-library.jpg</texture>
			<aspectratio>stretch</aspectratio>
		</control>

		<!-- sidebar ground: a slightly lifted panel, full height -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>360</width>
			<height>1080</height>
			<texture colordiffuse="e60d1016">couch/white.png</texture>
		</control>

		<!-- brand: the tube mark + wordmark, YouTube's own top-left spot -->
		<control type="image">
			<left>52</left>
			<top>52</top>
			<width>44</width>
			<height>44</height>
			<texture>couch/ic-youtube-brand.png</texture>
		</control>
		<control type="label">
			<left>112</left>
			<top>52</top>
			<width>250</width>
			<height>44</height>
			<font>Couch_Emph</font>
			<textcolor>ffeceef1</textcolor>
			<aligny>center</aligny>
			<label>YouTube</label>
		</control>

		<!-- the sidebar: fixed entries, YouTube's order. Selecting one points
		     the grid at that feed. -->
		<control type="list" id="6100">
			<left>24</left>
			<top>140</top>
			<width>312</width>
			<height>560</height>
			<onright>6200</onright>
			<onback>Action(Close)</onback>
			<scrolltime tween="sine" easing="out">160</scrolltime>
			<itemlayout width="312" height="88">
				<control type="image">
					<left>28</left>
					<top>26</top>
					<width>36</width>
					<height>36</height>
					<texture colordiffuse="b4eceef1">$INFO[ListItem.Icon]</texture>
				</control>
				<control type="label">
					<left>88</left>
					<top>0</top>
					<width>210</width>
					<height>88</height>
					<font>Couch_Label</font>
					<textcolor>b4eceef1</textcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout width="312" height="88">
				<control type="image">
					<left>0</left>
					<top>8</top>
					<width>312</width>
					<height>72</height>
					<texture border="24" colordiffuse="3cffffff">couch/libtile.png</texture>
				</control>
				<control type="image">
					<left>28</left>
					<top>26</top>
					<width>36</width>
					<height>36</height>
					<texture>$INFO[ListItem.Icon]</texture>
				</control>
				<control type="label">
					<left>88</left>
					<top>0</top>
					<width>210</width>
					<height>88</height>
					<font>Couch_Label</font>
					<textcolor>ffeceef1</textcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
			<content>
				<item>
					<label>Home</label>
					<icon>couch/ic-house.png</icon>
					<onclick>SetProperty(yt_path,plugin://plugin.video.youtube/special/recommendations?category_label=Recommendations)</onclick>
					<onclick>SetProperty(yt_title,Home)</onclick>
					<onclick>SetFocus(6200)</onclick>
				</item>
				<item>
					<label>Subscriptions</label>
					<icon>couch/ic-users.png</icon>
					<onclick>SetProperty(yt_path,plugin://plugin.video.youtube/special/my_subscriptions?category_label=My+Subscriptions)</onclick>
					<onclick>SetProperty(yt_title,Subscriptions)</onclick>
					<onclick>SetFocus(6200)</onclick>
				</item>
				<item>
					<label>Watch Later</label>
					<icon>couch/ic-clock.png</icon>
					<onclick>SetProperty(yt_path,plugin://plugin.video.youtube/special/playlist/WL/?category_label=Watch+Later)</onclick>
					<onclick>SetProperty(yt_title,Watch Later)</onclick>
					<onclick>SetFocus(6200)</onclick>
				</item>
				<item>
					<label>History</label>
					<icon>couch/ic-history.png</icon>
					<onclick>SetProperty(yt_path,plugin://plugin.video.youtube/special/playlist/HL/?category_label=History)</onclick>
					<onclick>SetProperty(yt_title,History)</onclick>
					<onclick>SetFocus(6200)</onclick>
				</item>
				<item>
					<label>Trending</label>
					<icon>couch/ic-flame.png</icon>
					<onclick>SetProperty(yt_path,plugin://plugin.video.youtube/special/popular_right_now?category_label=Trending)</onclick>
					<onclick>SetProperty(yt_title,Trending)</onclick>
					<onclick>SetFocus(6200)</onclick>
				</item>
				<item>
					<label>Search</label>
					<icon>couch/ic-search.png</icon>
					<onclick>ActivateWindow(videos,plugin://plugin.video.youtube/kodion/search/list/?category_label=Search,return)</onclick>
				</item>
			</content>
		</control>

		<!-- section title over the grid -->
		<control type="label">
			<left>420</left>
			<top>52</top>
			<width>900</width>
			<height>48</height>
			<font>Couch_Header</font>
			<textcolor>ffeceef1</textcolor>
			<label>$INFO[Window.Property(yt_title)]</label>
		</control>

		<!-- the video grid: 3 columns of 16:9 cards, title + channel/duration
		     under each thumb, YouTube's own card shape. -->
		<control type="panel" id="6200">
			<left>420</left>
			<top>128</top>
			<width>1452</width>
			<height>920</height>
			<onleft>6100</onleft>
			<onback>SetFocus(6100)</onback>
			<scrolltime tween="sine" easing="out">210</scrolltime>
			<itemlayout width="484" height="392">
				<control type="image">
					<left>12</left>
					<top>12</top>
					<width>444</width>
					<height>250</height>
					<texture background="true" diffuse="couch/mask-round.png">$INFO[ListItem.Art(thumb)]</texture>
					<aspectratio aligny="center">scale</aspectratio>
				</control>
				<control type="image">
					<left>360</left>
					<top>216</top>
					<width>84</width>
					<height>38</height>
					<texture border="12" colordiffuse="c8000000">couch/libtile.png</texture>
					<visible>!String.IsEmpty(ListItem.Duration) + [String.IsEmpty(ListItem.Duration(hh)) | String.IsEqual(ListItem.Duration(hh),00)]</visible>
				</control>
				<control type="image">
					<left>318</left>
					<top>216</top>
					<width>126</width>
					<height>38</height>
					<texture border="12" colordiffuse="c8000000">couch/libtile.png</texture>
					<visible>!String.IsEmpty(ListItem.Duration) + !String.IsEmpty(ListItem.Duration(hh)) + !String.IsEqual(ListItem.Duration(hh),00)</visible>
				</control>
				<control type="label">
					<left>360</left>
					<top>214</top>
					<width>84</width>
					<height>38</height>
					<font>Couch_Caption</font>
					<textcolor>ffeceef1</textcolor>
					<align>center</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Duration]</label>
					<visible>String.IsEmpty(ListItem.Duration(hh)) | String.IsEqual(ListItem.Duration(hh),00)</visible>
				</control>
				<control type="label">
					<left>318</left>
					<top>214</top>
					<width>126</width>
					<height>38</height>
					<font>Couch_Caption</font>
					<textcolor>ffeceef1</textcolor>
					<align>center</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Duration]</label>
					<visible>!String.IsEmpty(ListItem.Duration(hh)) + !String.IsEqual(ListItem.Duration(hh),00)</visible>
				</control>
				<control type="label">
					<left>16</left>
					<top>272</top>
					<width>436</width>
					<height>34</height>
					<font>Couch_Label</font>
					<textcolor>e6eceef1</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="textbox">
					<left>16</left>
					<top>304</top>
					<width>436</width>
					<height>76</height>
					<font>Couch_Caption</font>
					<textcolor>ff8a93a0</textcolor>
					<label>$INFO[ListItem.Plot]</label>
				</control>
			</itemlayout>
			<focusedlayout width="484" height="392">
				<control type="image">
					<left>-12</left>
					<top>-12</top>
					<width>492</width>
					<height>298</height>
					<texture border="48" infill="false" colordiffuse="a0e8a849">couch/halo-glow.png</texture>
				</control>
				<control type="image">
					<left>4</left>
					<top>4</top>
					<width>460</width>
					<height>266</height>
					<texture border="18" infill="false" colordiffuse="e6ffffff">couch/ring.png</texture>
				</control>
				<control type="image">
					<left>12</left>
					<top>12</top>
					<width>444</width>
					<height>250</height>
					<texture background="true" diffuse="couch/mask-round.png">$INFO[ListItem.Art(thumb)]</texture>
					<aspectratio aligny="center">scale</aspectratio>
				</control>
				<control type="image">
					<left>360</left>
					<top>216</top>
					<width>84</width>
					<height>38</height>
					<texture border="12" colordiffuse="c8000000">couch/libtile.png</texture>
					<visible>!String.IsEmpty(ListItem.Duration) + [String.IsEmpty(ListItem.Duration(hh)) | String.IsEqual(ListItem.Duration(hh),00)]</visible>
				</control>
				<control type="image">
					<left>318</left>
					<top>216</top>
					<width>126</width>
					<height>38</height>
					<texture border="12" colordiffuse="c8000000">couch/libtile.png</texture>
					<visible>!String.IsEmpty(ListItem.Duration) + !String.IsEmpty(ListItem.Duration(hh)) + !String.IsEqual(ListItem.Duration(hh),00)</visible>
				</control>
				<control type="label">
					<left>360</left>
					<top>214</top>
					<width>84</width>
					<height>38</height>
					<font>Couch_Caption</font>
					<textcolor>ffeceef1</textcolor>
					<align>center</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Duration]</label>
					<visible>String.IsEmpty(ListItem.Duration(hh)) | String.IsEqual(ListItem.Duration(hh),00)</visible>
				</control>
				<control type="label">
					<left>318</left>
					<top>214</top>
					<width>126</width>
					<height>38</height>
					<font>Couch_Caption</font>
					<textcolor>ffeceef1</textcolor>
					<align>center</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Duration]</label>
					<visible>!String.IsEmpty(ListItem.Duration(hh)) + !String.IsEqual(ListItem.Duration(hh),00)</visible>
				</control>
				<control type="label">
					<left>16</left>
					<top>272</top>
					<width>436</width>
					<height>34</height>
					<font>Couch_Label</font>
					<textcolor>ffeceef1</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="textbox">
					<left>16</left>
					<top>304</top>
					<width>436</width>
					<height>76</height>
					<font>Couch_Caption</font>
					<textcolor>ffb4bcc8</textcolor>
					<label>$INFO[ListItem.Plot]</label>
				</control>
			</focusedlayout>
			<content target="videos">$INFO[Window.Property(yt_path)]</content>
		</control>

		<!-- corner clock, same spot as home -->
		<control type="label">
			<left>1544</left>
			<top>52</top>
			<width>280</width>
			<height>44</height>
			<font>Couch_Label</font>
			<textcolor>ffeceef1</textcolor>
			<align>right</align>
			<label>$INFO[System.Time]</label>
		</control>

	</controls>
</window>
