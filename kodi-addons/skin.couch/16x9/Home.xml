<?xml version="1.0" encoding="UTF-8"?>
<!-- Couch Home - THE home since 8 Aug 2026 ("can we swap the ui to the
     ps5 one"). PS5-emulating Stagelight layout per Donnie's reference photo:
     tight top row of square tiles, halo H focus, focused game's key art
     full-bleed, clearlogo + Play pill lower-left, Library tile leading the
     row, corner strip (search/settings/power/pad battery). The Copacetic
     home is parked at Home.xml.copacetic (restore = rename back +
     ReloadSkin). Custom_1198 stays as the identical dev window. Plain
     controls (C13). -->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<controls>

		<!-- ground -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="ff0a0c10">couch/white.png</texture>
		</control>

		<!-- the focused item's art owns the screen -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture background="true">$INFO[Container(9000).ListItem.Art(fanart)]</texture>
			<aspectratio>scale</aspectratio>
			<fadetime>400</fadetime>
		</control>
		<!-- PS5-style veil: darker lower-left for the logo block, plus the
		     usual bottom scrim -->
		<include content="Couch_Scrim_Bottom">
			<param name="y" value="380" />
			<param name="height" value="700" />
		</include>
		<include>Couch_GlowField</include>


		<!-- top strip: pad battery, search, settings, power (PS5 corner) -->
		<control type="group">
			<left>1290</left>
			<top>52</top>
			<width>75</width>
			<height>40</height>
			<visible>!String.IsEmpty(Window(home).Property(PadConnected))</visible>
