				<textcolor>ffeceef1</textcolor>
				<label>$INFO[Container(9500).ListItem.Label]</label>
				<visible>Control.HasFocus(9500)</visible>
			</control>
			<control type="label">
				<left>96</left>
				<top>822</top>
				<width>1300</width>
				<height>60</height>
				<font>Couch_Label</font>
				<textcolor>b4eceef1</textcolor>
				<label>$INFO[Container(9500).ListItem.Property(desc)]</label>
				<visible>Control.HasFocus(9500)</visible>
			</control>
			<control type="label">
				<left>96</left>
				<top>892</top>
				<width>600</width>
				<height>34</height>
				<font>Couch_Caption</font>
				<textcolor>ffe8a849</textcolor>
				<label>Unlocked$INFO[Container(9500).ListItem.Property(rarity),   ·   ]</label>
				<visible>Control.HasFocus(9500) + !String.IsEmpty(Container(9500).ListItem.Property(unlocked))</visible>
