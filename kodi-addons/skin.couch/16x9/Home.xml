				<left>0</left>
				<top>0</top>
				<width>43</width>
				<height>40</height>
				<aspectratio aligny="bottom">keep</aspectratio>
				<texture colordiffuse="cceceef1">icons/ps5_pad_simple.png</texture>
			</control>
			<control type="image">
				<visible>!Integer.IsGreater(Window(home).Property(PadBattery),0)</visible>
				<left>49</left>
				<top>0</top>
				<width>20</width>
				<height>40</height>
				<aspectratio aligny="bottom">keep</aspectratio>
				<texture colordiffuse="FFFF5174">icons/couch_battv_0.png</texture>
			</control>
			<control type="image">
				<visible>Integer.IsGreater(Window(home).Property(PadBattery),0) + !Integer.IsGreater(Window(home).Property(PadBattery),7)</visible>
