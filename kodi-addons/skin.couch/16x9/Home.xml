		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="ff000000">couch/white.png</texture>
			<animation effect="fade" start="0" end="100" time="600" tween="sine" easing="in">Visible</animation>
			<visible>!String.IsEmpty(Window(home).Property(CouchLaunching))</visible>
		</control>
