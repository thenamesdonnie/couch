<!-- Couch Library (Stagelight phase 2) - the v5 Netflix-shaped page, all four
     sections: Next up / Continue / New / Everything A-Z. The whole stack
     slides up as focus moves down (conditional slides, the standard Kodi
     scrolling-widgets pattern; transitions only, still frames between - C3).
     Facts for the focused item live in the fixed bottom strip. Window 1197.
     Plain controls (C13). -->
<window type="window" id="1197">
	<defaultcontrol always="true">7900</defaultcontrol>
	<controls>

		<!-- ground -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="ff0a0c10">couch/white.png</texture>
		</control>

		<!-- The rows cover any art-follows-focus backdrop, so the page gets a
		     designed still: quiet amber/cool washes on the ground (Donnie,
		     8 Aug: "replace it with a default nice looking background"). -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture>couch/bg-library.jpg</texture>
			<aspectratio>stretch</aspectratio>
		</control>

		<!-- the sliding stack: header + four sections. Each section is 340
		     tall (46 label + 268 row + 26 air); focus below the first row
		     slides the whole group up one section at a time. -->
		<control type="group">
			<animation effect="slide" end="0,-340" time="210" tween="sine" easing="out" condition="Control.HasFocus(8000) | Control.HasFocus(8100) | Control.HasFocus(8200)">Conditional</animation>
			<animation effect="slide" end="0,-340" time="210" tween="sine" easing="out" condition="Control.HasFocus(8100) | Control.HasFocus(8200)">Conditional</animation>
