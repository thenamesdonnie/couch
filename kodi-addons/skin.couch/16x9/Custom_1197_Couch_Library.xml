		     designed still: quiet amber/cool washes on the ground (Donnie,
		     8 Aug: "replace it with a default nice looking background"). -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture>couch/bg-library.jpg</texture>
			<aspectratio>stretch</aspectratio>
