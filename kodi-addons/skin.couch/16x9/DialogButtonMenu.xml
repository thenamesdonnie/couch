<?xml version="1.0" encoding="UTF-8"?>
<!-- shutdownmenu, Stagelight (8 Aug 2026). The power menu the PS-hold and the
     corner power icon open. Replaces Copacetic's DialogButtonMenu with the
     same bottom-sheet + tile-rail grammar as the switcher: a scrim, a sheet
     that slides up, and a row of rounded tiles with the amber halo on focus.
     Self-contained: explicit power items rather than skinshortcuts, so it
     needs no per-user config and cannot inherit Copacetic styling. -->
<window>
	<defaultcontrol always="true">3001</defaultcontrol>
	<animation effect="fade" start="0" end="100" time="180" tween="sine" easing="out">WindowOpen</animation>
	<animation effect="fade" start="100" end="0" time="160" tween="sine" easing="in">WindowClose</animation>
	<zorder>3</zorder>
	<controls>

		<!-- scrim -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="b3000000">couch/white.png</texture>
		</control>

		<control type="group">
			<animation effect="slide" start="0,140" end="0,0" time="260" tween="cubic" easing="out">WindowOpen</animation>
			<animation effect="slide" start="0,0" end="0,140" time="180" tween="cubic" easing="in">WindowClose</animation>

			<!-- sheet -->
			<control type="image">
				<left>0</left>
				<top>720</top>
				<width>1920</width>
				<height>360</height>
				<texture colordiffuse="f20a0c10">couch/white.png</texture>
			</control>
			<control type="image">
				<left>0</left>
				<top>720</top>
				<width>1920</width>
				<height>3</height>
				<texture colordiffuse="ffe8a849">couch/white.png</texture>
			</control>
			<control type="label">
				<left>96</left>
				<top>748</top>
				<width>1728</width>
				<height>44</height>
				<font>Couch_Label</font>
				<textcolor>ff8a93a0</textcolor>
				<label>Power</label>
			</control>

			<control type="list" id="3001">
				<left>96</left>
				<top>812</top>
				<width>1730</width>
				<height>210</height>
				<orientation>horizontal</orientation>
				<scrolltime tween="sine" easing="out">210</scrolltime>
				<onup>Close</onup>
				<itemlayout width="300" height="210">
					<control type="image">
						<left>20</left>
						<top>10</top>
						<width>260</width>
						<height>150</height>
						<texture border="24" colordiffuse="ff161a22">couch/libtile.png</texture>
					</control>
					<control type="image">
						<left>130</left>
						<top>44</top>
						<width>40</width>
						<height>40</height>
						<texture colordiffuse="d2eceef1">$INFO[ListItem.Icon]</texture>
					</control>
					<control type="label">
						<left>20</left>
						<top>104</top>
						<width>260</width>
						<height>40</height>
						<font>Couch_Caption</font>
						<textcolor>d2eceef1</textcolor>
						<align>center</align>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</itemlayout>
				<focusedlayout width="300" height="210">
					<control type="image">
						<left>4</left>
						<top>-6</top>
						<width>292</width>
						<height>182</height>
						<texture border="48" infill="false" colordiffuse="c8e8a849">couch/halo-glow.png</texture>
					</control>
					<control type="image">
						<left>4</left>
						<top>-6</top>
						<width>292</width>
						<height>182</height>
						<texture border="48" infill="false" colordiffuse="dcffffff">couch/halo-core.png</texture>
					</control>
					<control type="image">
						<left>20</left>
						<top>10</top>
						<width>260</width>
						<height>150</height>
						<texture border="24" colordiffuse="ff1b212c">couch/libtile.png</texture>
					</control>
					<control type="image">
						<left>130</left>
						<top>44</top>
						<width>40</width>
						<height>40</height>
						<texture colordiffuse="ffeceef1">$INFO[ListItem.Icon]</texture>
					</control>
					<control type="label">
						<left>20</left>
						<top>104</top>
						<width>260</width>
						<height>40</height>
						<font>Couch_Caption</font>
						<textcolor>ffeceef1</textcolor>
						<align>center</align>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</focusedlayout>
				<content>
					<item>
						<label>Home</label>
						<icon>couch/ic-home.png</icon>
						<onclick>Dialog.Close(all)</onclick>
						<onclick>ActivateWindow(home)</onclick>
						<visible>!Window.IsVisible(home)</visible>
					</item>
					<item>
						<label>Suspend</label>
						<icon>couch/ic-moon.png</icon>
						<onclick>Suspend</onclick>
					</item>
					<item>
						<label>Restart</label>
						<icon>couch/ic-restart.png</icon>
						<onclick>Reboot</onclick>
					</item>
					<item>
						<label>Power off</label>
						<icon>couch/ic-power.png</icon>
						<onclick>ShutDown</onclick>
					</item>
					<item>
						<label>Exit to desktop</label>
						<icon>couch/ic-exit.png</icon>
						<onclick>Quit</onclick>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>
