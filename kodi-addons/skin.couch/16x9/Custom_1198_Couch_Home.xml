<?xml version="1.0" encoding="UTF-8"?>
<!-- Couch Home (Stagelight phase 3 preview), PS5-emulating layout per
     Donnie's reference photo (8 Aug): tight top row of small square tiles
     (110px, 10px gaps), focused tile enlarged (172px) with a halo ring and
     its name underneath, the focused game's key art filling the screen,
     its clearlogo lower-left with a Play pill. Library tile leads the row.
     Runs as window 1198 until approved as the real Home. Plain controls
     (C13). -->
<window type="window" id="1198">
	<defaultcontrol always="true">9000</defaultcontrol>
	<controls>

		<!-- ground -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="ff0a0c10">couch/white.png</texture>
		</control>

		<!-- the focused item's art owns the screen -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture background="true">$INFO[Container(9000).ListItem.Art(fanart)]</texture>
			<aspectratio>scale</aspectratio>
			<fadetime>400</fadetime>
		</control>
		<!-- PS5-style veil: darker lower-left for the logo block, plus the
		     usual bottom scrim -->
		<include content="Couch_Scrim_Bottom">
			<param name="y" value="380" />
			<param name="height" value="700" />
		</include>
		<include>Couch_GlowField</include>

		<!-- clock -->
		<control type="label">
			<left>1224</left>
			<top>54</top>
			<width>600</width>
			<height>40</height>
			<font>Couch_Label</font>
			<textcolor>ccffffff</textcolor>
			<align>right</align>
			<label>$INFO[System.Time]</label>
		</control>

		<!-- the Library tile: first stop on the row, PS5-icon sized -->
		<control type="button" id="9001">
			<left>96</left>
			<top>124</top>
			<width>110</width>
			<height>110</height>
			<label></label>
			<texturefocus colordiffuse="ff262c37">couch/libtile.png</texturefocus>
			<texturenofocus colordiffuse="cc161a22">couch/libtile.png</texturenofocus>
			<onclick>ActivateWindow(1197)</onclick>
			<onright>9000</onright>
		</control>
		<!-- 2x2 grid glyph -->
		<control type="image">
			<left>130</left>
			<top>158</top>
			<width>18</width>
			<height>18</height>
			<texture colordiffuse="ffeceef1">couch/glyph.png</texture>
		</control>
		<control type="image">
			<left>154</left>
			<top>158</top>
			<width>18</width>
			<height>18</height>
			<texture colordiffuse="ffeceef1">couch/glyph.png</texture>
		</control>
		<control type="image">
			<left>130</left>
			<top>182</top>
			<width>18</width>
			<height>18</height>
			<texture colordiffuse="ffeceef1">couch/glyph.png</texture>
		</control>
		<control type="image">
			<left>154</left>
			<top>182</top>
			<width>18</width>
			<height>18</height>
			<texture colordiffuse="$VAR[Couch_Live_Color]">couch/glyph.png</texture>
		</control>
		<control type="label">
			<left>66</left>
			<top>244</top>
			<width>170</width>
			<height>34</height>
			<font>Couch_Caption</font>
			<textcolor>ffeceef1</textcolor>
			<align>center</align>
			<label>Library</label>
			<visible>Control.HasFocus(9001)</visible>
		</control>

		<!-- the row: PS5 rhythm, 110px tiles with 10px gaps, focused 172px -->
		<control type="list" id="9000">
			<left>211</left>
			<top>76</top>
			<width>1709</width>
			<height>290</height>
			<orientation>horizontal</orientation>
			<scrolltime tween="sine" easing="out">210</scrolltime>
			<onleft>9001</onleft>
			<itemlayout width="120" height="290">
				<control type="image">
					<left>5</left>
					<top>48</top>
					<width>110</width>
					<height>110</height>
					<texture background="true" diffuse="couch/mask-round.png">$INFO[ListItem.Art(thumb)]</texture>
					<aspectratio>scale</aspectratio>
					<colordiffuse>c8ffffff</colordiffuse>
				</control>
			</itemlayout>
			<focusedlayout width="182" height="290">
				<!-- halo ring, offset outside the tile like the PS5 -->
				<control type="image">
					<left>-25</left>
					<top>10</top>
					<width>232</width>
					<height>232</height>
					<texture border="48" infill="false" colordiffuse="96ffffff">couch/halo.png</texture>
				</control>
				<control type="image">
					<left>5</left>
					<top>40</top>
					<width>172</width>
					<height>172</height>
					<texture background="true" diffuse="couch/mask-round.png">$INFO[ListItem.Art(thumb)]</texture>
					<aspectratio>scale</aspectratio>
				</control>
				<control type="image">
					<left>5</left>
					<top>222</top>
					<width>172</width>
					<height>12</height>
					<texture colordiffuse="$VAR[Couch_Live_Color]">couch/lightbar.png</texture>
					<aspectratio>stretch</aspectratio>
				</control>
				<control type="label">
					<left>5</left>
					<top>238</top>
					<width>620</width>
					<height>38</height>
					<font>Couch_Label</font>
					<textcolor>ffeceef1</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
			<content target="videos">plugin://script.copacetic.helper/?info=games&amp;v=2</content>
		</control>

		<!-- lower-left: the focused game's own logo, PS5 style; text fallback
		     when Steam has no separate logo for it -->
		<control type="image">
			<left>96</left>
			<top>520</top>
			<width>560</width>
			<height>240</height>
			<texture background="true">$INFO[Container(9000).ListItem.Art(clearlogo)]</texture>
			<aspectratio align="left" aligny="bottom">keep</aspectratio>
			<fadetime>300</fadetime>
			<visible>!Control.HasFocus(9001) + !String.IsEmpty(Container(9000).ListItem.Art(clearlogo))</visible>
		</control>
		<control type="label">
			<left>96</left>
			<top>688</top>
			<width>1000</width>
			<height>76</height>
			<font>Couch_Title</font>
			<textcolor>ffeceef1</textcolor>
			<label>$INFO[Container(9000).ListItem.Label]</label>
			<visible>!Control.HasFocus(9001) + String.IsEmpty(Container(9000).ListItem.Art(clearlogo))</visible>
		</control>
		<control type="label">
			<left>96</left>
			<top>790</top>
			<width>1000</width>
			<height>40</height>
			<font>Couch_Label</font>
			<textcolor>b4eceef1</textcolor>
			<label>$INFO[Container(9000).ListItem.Genre]</label>
			<visible>!Control.HasFocus(9001)</visible>
		</control>
		<!-- the Play pill -->
		<control type="image">
			<left>96</left>
			<top>856</top>
			<width>232</width>
			<height>64</height>
			<texture colordiffuse="d8161d28">couch/pill.png</texture>
			<visible>!Control.HasFocus(9001)</visible>
		</control>
		<control type="label">
			<left>96</left>
			<top>856</top>
			<width>232</width>
			<height>64</height>
			<font>Couch_Emph</font>
			<textcolor>ffeceef1</textcolor>
			<align>center</align>
			<aligny>center</aligny>
			<label>Play</label>
			<visible>!Control.HasFocus(9001)</visible>
		</control>

		<!-- Library focused: its own lower-left block -->
		<control type="label">
			<left>96</left>
			<top>688</top>
			<width>1000</width>
			<height>76</height>
			<font>Couch_Title</font>
			<textcolor>ffeceef1</textcolor>
			<label>Library</label>
			<visible>Control.HasFocus(9001)</visible>
		</control>
		<control type="label">
			<left>96</left>
			<top>790</top>
			<width>1000</width>
			<height>40</height>
			<font>Couch_Label</font>
			<textcolor>b4eceef1</textcolor>
			<label>Films · TV · YouTube · everything you have</label>
			<visible>Control.HasFocus(9001)</visible>
		</control>

	</controls>
</window>
