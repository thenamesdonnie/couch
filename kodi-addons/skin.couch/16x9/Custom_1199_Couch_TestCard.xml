			<width>96</width>
			<height>96</height>
			<texture colordiffuse="ff8a93a0">couch/white.png</texture>
		</control>
		<control type="image">
			<left>444</left>
			<top>820</top>
			<width>96</width>
			<height>96</height>
			<texture colordiffuse="ffeceef1">couch/white.png</texture>
		</control>
		<control type="image">
			<left>560</left>
			<top>820</top>
			<width>96</width>
			<height>96</height>
			<texture colordiffuse="ffe8a849">couch/white.png</texture>
		</control>
		<control type="image">
			<left>676</left>
			<top>820</top>
			<width>96</width>
			<height>96</height>
			<texture colordiffuse="$VAR[Couch_Live_Color]">couch/white.png</texture>
		</control>
		<control type="label">
			<left>96</left>
			<top>928</top>
			<width>1700</width>
			<height>36</height>
			<font>Couch_Caption</font>
			<textcolor>ff8a93a0</textcolor>
			<label>ground · panel · muted · text · pilot · live = $VAR[Couch_Live_Color] (amber means the pilot light, nothing focused with art)</label>
		</control>

		<!-- focus sink so Back leaves cleanly -->
		<control type="button" id="9000">
			<left>-200</left>
			<top>-200</top>
			<width>1</width>
			<height>1</height>
			<label></label>
			<texturefocus>-</texturefocus>
			<texturenofocus>-</texturenofocus>
			<onclick>PreviousWindow</onclick>
			<onback>PreviousWindow</onback>
		</control>

	</controls>
</window>
