<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- The kill switch for HDR auto-routing, in the same versioned schema the
     rest of this box's settings-bearing addons use (see
     script.couch.switcher/resources/settings.xml for the reasoning).

     Labels have to be numeric string ids: Kodi runs the attribute through
     atoi, so literal text renders as nothing. Hence resources/language/.

     There is a SECOND switch on the server side (touch
     ~/couch/data/tv-autoroute-off). Either being off stops auto-routing;
     turning this one on does not override the server's. That asymmetry is
     deliberate - the off state is the safe one, so anything that can reach it
     wins. -->
<settings version="1">
  <section id="service.couch.autoroute">

    <category id="general" label="32001" help="32002">
      <group id="1" label="32003">

        <setting id="enabled" type="boolean" label="32010" help="32011">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>

      </group>
    </category>

  </section>
</settings>
