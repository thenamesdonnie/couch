<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- PS-button key bindings.

     Kodi 20 (Nexus) still reads the old flat <category>/<setting> format, but
     every settings-bearing addon on this box that was written for Kodi 19+
     (script.copacetic.helper, script.globalsearch, plugin.video.youtube,
     inputstream.adaptive) uses the versioned schema below, and so does Kodi's
     own system/settings/settings.xml. This file follows it: <settings
     version="1"> / section / category / group / setting, with <constraints>
     and an explicit <control>. That is what buys the option lists and the
     sliders their min/step/max.

     Labels have to be numeric string ids - Kodi runs the attribute through
     atoi, so literal text renders as nothing - hence resources/language/.

     The VALUES here are the contract with ~/couch/couchd/gestureconf.py, the
     one reader of the file Kodi writes from this page. Changing an option
     value without changing ACTIONS there silently falls back to the default.
-->
<settings version="1">
  <section id="script.couch.switcher">

    <category id="bindings" label="32001" help="32002">
      <group id="1" label="32003">

        <setting id="gesture.tap" type="string" label="32010" help="32040">
          <level>0</level>
          <default>none</default>
          <constraints>
            <options>
              <option label="32020">none</option>
              <option label="32021">suspend_to_kodi</option>
              <option label="32022">switcher</option>
              <option label="32023">steam_menu</option>
              <option label="32024">power_menu</option>
              <option label="32025">quit_game</option>
              <option label="32026">tv_toggle</option>
              <option label="32027">desktop</option>
            </options>
          </constraints>
          <control type="list" format="string">
            <heading>32010</heading>
          </control>
          <!-- Precedence, enforced in the UI as well as in gestureconf.py: a
               bound double-tap swallows the tap, because every double-tap
               would otherwise fire the tap action on its way through. -->
          <dependencies>
            <dependency type="enable">
              <condition setting="gesture.double_tap" operator="is">none</condition>
            </dependency>
          </dependencies>
        </setting>

        <setting id="gesture.double_tap" type="string" label="32011" help="32041">
          <level>0</level>
          <default>switcher</default>
          <constraints>
            <options>
              <option label="32020">none</option>
              <option label="32021">suspend_to_kodi</option>
              <option label="32022">switcher</option>
              <option label="32023">steam_menu</option>
              <option label="32024">power_menu</option>
              <option label="32025">quit_game</option>
              <option label="32026">tv_toggle</option>
              <option label="32027">desktop</option>
            </options>
          </constraints>
          <control type="list" format="string">
            <heading>32011</heading>
          </control>
        </setting>

        <setting id="gesture.hold" type="string" label="32012" help="32042">
          <level>0</level>
          <default>suspend_to_kodi</default>
          <constraints>
            <options>
              <option label="32020">none</option>
              <option label="32021">suspend_to_kodi</option>
              <option label="32022">switcher</option>
              <option label="32023">steam_menu</option>
              <option label="32024">power_menu</option>
              <option label="32025">quit_game</option>
              <option label="32026">tv_toggle</option>
              <option label="32027">desktop</option>
            </options>
          </constraints>
          <control type="list" format="string">
            <heading>32012</heading>
          </control>
        </setting>

        <setting id="gesture.hold_release" type="string" label="32013" help="32043">
          <level>0</level>
          <default>none</default>
          <constraints>
            <options>
              <option label="32020">none</option>
              <option label="32021">suspend_to_kodi</option>
              <option label="32022">switcher</option>
              <option label="32023">steam_menu</option>
              <option label="32024">power_menu</option>
              <option label="32025">quit_game</option>
              <option label="32026">tv_toggle</option>
              <option label="32027">desktop</option>
            </options>
          </constraints>
          <control type="list" format="string">
            <heading>32013</heading>
          </control>
        </setting>

        <setting id="gesture.long_hold" type="string" label="32014" help="32044">
          <level>0</level>
          <default>none</default>
          <constraints>
            <options>
              <option label="32020">none</option>
              <option label="32021">suspend_to_kodi</option>
              <option label="32022">switcher</option>
              <option label="32023">steam_menu</option>
              <option label="32024">power_menu</option>
              <option label="32025">quit_game</option>
              <option label="32026">tv_toggle</option>
              <option label="32027">desktop</option>
            </options>
          </constraints>
          <control type="list" format="string">
            <heading>32014</heading>
          </control>
          <!-- Same shape as the tap rule: the 0.9s hold fires first and the
               press is spent, so a long hold is only reachable with the hold
               itself bound to nothing. -->
          <dependencies>
            <dependency type="enable">
              <condition setting="gesture.hold" operator="is">none</condition>
            </dependency>
          </dependencies>
        </setting>

      </group>
    </category>

    <category id="advanced" label="32030" help="32031">
      <group id="1" label="32032">

        <setting id="timing.hold_seconds" type="number" label="32033" help="32045">
          <level>0</level>
          <default>0.9</default>
          <constraints>
            <minimum>0.3</minimum>
            <step>0.05</step>
            <maximum>3.0</maximum>
          </constraints>
          <control type="slider" format="number">
            <popup>true</popup>
          </control>
        </setting>

        <setting id="timing.double_tap_seconds" type="number" label="32034" help="32046">
          <level>0</level>
          <default>0.35</default>
          <constraints>
            <minimum>0.15</minimum>
            <step>0.05</step>
            <maximum>1.0</maximum>
          </constraints>
          <control type="slider" format="number">
            <popup>true</popup>
          </control>
        </setting>

        <setting id="timing.long_hold_seconds" type="number" label="32035" help="32047">
          <level>0</level>
          <default>3.0</default>
          <constraints>
            <minimum>1.0</minimum>
            <step>0.5</step>
            <maximum>10.0</maximum>
          </constraints>
          <control type="slider" format="number">
            <popup>true</popup>
          </control>
          <dependencies>
            <dependency type="enable">
              <condition setting="gesture.long_hold" operator="!is">none</condition>
            </dependency>
          </dependencies>
        </setting>

      </group>

      <!-- Not a binding, so gestureconf.py never reads it: default.py reads
           this one itself. It is the rollback switch for the switcher's own
           animated window. Off restores the stock select dialog verbatim,
           which also restores window id 12000 - couchd confirms the gesture
           landed by watching the current window, so the way back has to be a
           setting rather than a redeploy. -->
      <group id="2" label="32037">

        <setting id="ui.animated_dialog" type="boolean" label="32036" help="32048">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>

      </group>
    </category>

  </section>
</settings>
