<?xml version="1.0" encoding="UTF-8"?>
<!-- The on-TV switcher, drawn by default.py's SwitcherDialog.

     Stagelight restyle (8 Aug 2026): the sheet keeps its entrance, but the
     rows became a PS5-style horizontal rail of rounded tiles - the same
     grammar as the Couch home row (halo glow + white core on focus, lightbar
     underneath, Figtree type via the skin's Couch_* font names). Amber is the
     pilot accent, a literal here because $VAR does not cross the addon
     boundary.

     Everything that can be addon-local IS addon-local: the Stagelight
     textures are COPIES in media/ (mask-round, halo-glow, halo-core,
     lightbar), so a skin switch degrades colours, never breaks the dialog.
     Font names resolve from the active skin; an unknown name falls back to
     the default font with a log line.

     Control ids are a contract with default.py: 9000 is the list and the ONLY
     control the python fetches. Avoid ids 50-59 and 2/3/4/12 (WindowXML
     claims them; clicks vanish - the list was id 3 once). One log line is
     expected per open: "Control 9000 ... has been asked to focus, but it
     can't" - WINDOW_INIT races python filling the list; onInit's setFocusId
     lands a beat later. -->
<window type="dialog">
  <defaultcontrol always="true">9000</defaultcontrol>
  <animation effect="fade" start="0" end="100" time="200" tween="sine" easing="out">WindowOpen</animation>
  <animation effect="fade" start="100" end="0" time="200" tween="sine" easing="in">WindowClose</animation>

  <controls>

    <!-- The paused game's freeze-frame, fullscreen behind everything.
         default.py owns the property; empty = hidden. -->
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>scale</aspectratio>
      <fadetime>240</fadetime>
      <texture background="true">$INFO[Window.Property(couch.pausedframe)]</texture>
      <visible>!String.IsEmpty(Window.Property(couch.pausedframe))</visible>
    </control>

    <!-- Scrim: keeps the sheet readable over a bright frame. -->
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture>couch-fill.png</texture>
      <colordiffuse>B3000000</colordiffuse>
    </control>

    <!-- The sheet: bottom-anchored, slides up from the edge. -->
    <control type="group" id="100">
      <animation effect="slide" start="0,140" end="0,0" time="280" tween="cubic" easing="out">WindowOpen</animation>
      <animation effect="slide" start="0,0" end="0,140" time="200" tween="cubic" easing="in">WindowClose</animation>

      <control type="image">
        <left>0</left>
        <top>544</top>
        <width>1920</width>
        <height>536</height>
        <texture>couch-fill.png</texture>
        <colordiffuse>F20A0C10</colordiffuse>
      </control>

      <!-- Amber pilot rule along the top edge. -->
      <control type="image">
        <left>0</left>
        <top>544</top>
        <width>1920</width>
        <height>3</height>
        <texture>couch-fill.png</texture>
        <colordiffuse>FFE8A849</colordiffuse>
      </control>


      <!-- POWER BAR. Text, not symbols: three console actions whose difference
           is precisely which things get turned off, and a 44px glyph cannot
           carry "controller" vs "controller and TV" without ambiguity.
           default.py fills it and dispatches to script.tvpoweroff, so the
           quit-the-game-politely-first logic has exactly one home.
           NOT the default control - the sheet opens on the switch row below,
           so nothing here is ever what the stick lands on first. -->
      <control type="label">
        <left>96</left>
        <top>556</top>
        <width>1728</width>
        <height>36</height>
        <align>left</align>
        <aligny>center</aligny>
        <font>Couch_Label</font>
        <textcolor>FF8A93A0</textcolor>
        <label>Power</label>
      </control>

      <control type="list" id="9010">
        <left>66</left>
        <top>592</top>
        <width>1788</width>
        <!-- 88, not the pill's 76+8: the focus underline hangs below the pill
             and a list clips to its own bounds, so the row has to be tall
             enough to hold it. 88 puts the underline's last row at 680, four
             clear of the "Switch to" label at 684. -->
        <height>88</height>
        <onleft>9010</onleft>
        <onright>9010</onright>
        <onup>9010</onup>
        <ondown>9000</ondown>
        <orientation>horizontal</orientation>
        <scrolltime tween="sine" easing="out">180</scrolltime>

        <itemlayout height="88" width="420">
          <control type="image">
            <left>30</left>
            <top>8</top>
            <width>390</width>
            <height>68</height>
            <texture diffuse="mask-round.png">couch-fill.png</texture>
            <colordiffuse>FF161A22</colordiffuse>
          </control>
          <control type="label">
            <left>30</left>
            <top>8</top>
            <width>390</width>
            <height>68</height>
            <align>center</align>
            <aligny>center</aligny>
            <font>Couch_Caption</font>
            <textcolor>FF8A93A0</textcolor>
            <label>$INFO[ListItem.Label]</label>
          </control>
        </itemlayout>

        <focusedlayout height="88" width="420">
          <!-- Every distinguishing mark is gated on the BAR having focus.
               Kodi keeps drawing focusedlayout for a list's current item even
               when the list is not focused, so without these "Quit game" sat
               lit up like a pre-selection while the stick was down on the
               switch row - on the one bar that turns the television off. Same
               defect the home row had, same fix. -->
          <!-- An amber underline, not the halo the tiles use. A 40px 9-slice
               border on an 88px-tall box leaves 8px of middle, so the ring
               came out squeezed to nothing - the dog-bone problem in
               miniature. The switch row's lightbar is the grammar that
               already reads at TV distance, so the bar borrows it.

               Height is 12 and not 4. lightbar.png is a soft glow whose alpha
               peaks at its vertical CENTRE and fades to nothing at both edges,
               so the box height is not the line's weight: at 4 the bright core
               measured one skin pixel and the "underline" was a hairline. The
               switch row draws the same texture at 16; 12 is as close as fits
               above the "Switch to" label. Measure the lit core, not the
               control, if this is ever retuned. -->
          <control type="image">
            <left>30</left>
            <top>76</top>
            <width>390</width>
            <height>12</height>
            <texture>lightbar.png</texture>
            <colordiffuse>FFE8A849</colordiffuse>
            <visible>Control.HasFocus(9010)</visible>
          </control>
          <control type="image">
            <left>30</left>
            <top>8</top>
            <width>390</width>
            <height>68</height>
            <texture diffuse="mask-round.png">couch-fill.png</texture>
            <colordiffuse>FF1B212C</colordiffuse>
            <visible>Control.HasFocus(9010)</visible>
          </control>
          <!-- ...and the resting panel + grey label in its place, copied from
               itemlayout, so an unfocused bar reads as three equal pills. -->
          <control type="image">
            <left>30</left>
            <top>8</top>
            <width>390</width>
            <height>68</height>
            <texture diffuse="mask-round.png">couch-fill.png</texture>
            <colordiffuse>FF161A22</colordiffuse>
            <visible>!Control.HasFocus(9010)</visible>
          </control>
          <control type="label">
            <left>30</left>
            <top>8</top>
            <width>390</width>
            <height>68</height>
            <align>center</align>
            <aligny>center</aligny>
            <font>Couch_Caption</font>
            <textcolor>FFECEEF1</textcolor>
            <label>$INFO[ListItem.Label]</label>
            <visible>Control.HasFocus(9010)</visible>
          </control>
          <control type="label">
            <left>30</left>
            <top>8</top>
            <width>390</width>
            <height>68</height>
            <align>center</align>
            <aligny>center</aligny>
            <font>Couch_Caption</font>
            <textcolor>FF8A93A0</textcolor>
            <label>$INFO[ListItem.Label]</label>
            <visible>!Control.HasFocus(9010)</visible>
          </control>
        </focusedlayout>
      </control>

      <control type="label">
        <left>96</left>
        <top>684</top>
        <width>1728</width>
        <height>40</height>
        <align>left</align>
        <aligny>center</aligny>
        <font>Couch_Label</font>
        <textcolor>FF8A93A0</textcolor>
        <label>Switch to</label>
      </control>

      <!-- The rail. Same items, same order, same trailing Cancel as the
           select dialog it replaces - default.py builds them, this draws
           them as tiles. Landscape thumbs (window snapshots / game art);
           a tile with no art shows its name centred on a panel. -->
      <control type="list" id="9000">
        <left>66</left>
        <top>726</top>
        <width>1788</width>
        <height>330</height>
        <onleft>9000</onleft>
        <onright>9000</onright>
        <onup>9010</onup>
        <ondown>9000</ondown>
        <orientation>horizontal</orientation>
        <scrolltime tween="sine" easing="out">210</scrolltime>

        <itemlayout height="330" width="272">
          <control type="image">
            <left>30</left>
            <top>52</top>
            <width>232</width>
            <height>130</height>
            <texture diffuse="mask-round.png">couch-fill.png</texture>
            <colordiffuse>FF161A22</colordiffuse>
          </control>
          <control type="image">
            <left>30</left>
            <top>52</top>
            <width>232</width>
            <height>130</height>
            <aspectratio align="center" aligny="center">scale</aspectratio>
            <texture background="true" diffuse="mask-round.png">$INFO[ListItem.Art(thumb)]</texture>
            <colordiffuse>C8FFFFFF</colordiffuse>
            <visible>!String.IsEmpty(ListItem.Art(thumb))</visible>
          </control>
          <control type="label">
            <left>30</left>
            <top>52</top>
            <width>232</width>
            <height>130</height>
            <align>center</align>
            <aligny>center</aligny>
            <font>Couch_Caption</font>
            <textcolor>FF8A93A0</textcolor>
            <label>$INFO[ListItem.Label]</label>
            <visible>String.IsEmpty(ListItem.Art(thumb))</visible>
          </control>
        </itemlayout>

        <focusedlayout height="330" width="272">
          <!-- halo: amber glow + white core, the home row's focus grammar -->
          <control type="image">
            <left>-14</left>
            <top>4</top>
            <width>300</width>
            <height>226</height>
            <texture border="48" infill="false" colordiffuse="C8E8A849">halo-glow.png</texture>
          </control>
          <control type="image">
            <left>-14</left>
            <top>4</top>
            <width>300</width>
            <height>226</height>
            <texture border="48" infill="false" colordiffuse="DCFFFFFF">halo-core.png</texture>
          </control>
          <control type="image">
            <left>16</left>
            <top>34</top>
            <width>240</width>
            <height>166</height>
            <texture diffuse="mask-round.png">couch-fill.png</texture>
            <colordiffuse>FF1B212C</colordiffuse>
          </control>
          <control type="image">
            <left>16</left>
            <top>34</top>
            <width>240</width>
            <height>166</height>
            <aspectratio align="center" aligny="center">scale</aspectratio>
            <texture background="true" diffuse="mask-round.png">$INFO[ListItem.Art(thumb)]</texture>
            <visible>!String.IsEmpty(ListItem.Art(thumb))</visible>
          </control>

          <control type="image">
            <left>16</left>
            <top>210</top>
            <width>240</width>
            <height>16</height>
            <texture>lightbar.png</texture>
            <colordiffuse>FFE8A849</colordiffuse>
          </control>
          <control type="label">
            <left>16</left>
            <top>232</top>
            <width>640</width>
            <height>38</height>
            <align>left</align>
            <font>Couch_Label</font>
            <textcolor>FFECEEF1</textcolor>
            <label>$INFO[ListItem.Label]</label>
          </control>
        </focusedlayout>
      </control>

    </control>
  </controls>
</window>
