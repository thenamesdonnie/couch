#!/usr/bin/env python3
"""A synthetic DualSense on /dev/uhid, for developing stage 2 without the
real pad (design note S7/SR8, audit item 18).

It is hid-tools' PS5ControllerBluetooth - the kernel HID maintainer's own
DS5 emulator, complete with the Bluetooth report descriptor, the CRC-signed
feature reports (0x05 calibration, 0x09 pairing/MAC, 0x20 firmware) and the
BT byte offsets - subclassed here for three reasons and no others:

  1. a FIXED, obviously-fake MAC, so udev rules, logs and Steam configs can
     be scoped to the rig and the real pad's AA:BB:CC:DD:EE:FF is never
     matched by anything we write;
  2. hid-tools caps `self.buttons` at 12, which silently makes button 13 -
     BTN_MODE, the PS button, the entire point of this rig - unsendable;
  3. InputPlumber issue #459's lesson: an UNHANDLED get/set report must
     return SUCCESS, never an error. hid_playstation asks for things this
     emulator has no answer for, and an error reply is what makes a driver
     back off and leave you with a half-bound device.

  fake-pad up                 create it, hold it, print nodes + MAC
  fake-pad press <btn>        tap (~120ms)
  fake-pad hold <btn> [secs]  hold (default 1.2s)
  fake-pad down/release <btn>
  fake-pad axis <ax> <-1..1>  lx ly rx ry
  fake-pad dpad <dir>         up down left right center
  fake-pad sleep <secs>       pause INSIDE the command stream (see below)
  fake-pad status
  fake-pad quit

  Buttons: square cross circle triangle l1 r1 l2 r2 create options l3 r3 ps

WHY `up` IS WRAPPED IN A SAFETY FRAME (SR8). A uhid DS5 on THIS box is not
inert. It wakes the TV and forces HDMI 2 (tv-waker polls js*, so its .off
udev rule is irrelevant), it starts a pad-record recording that pollutes
the gesture corpus, pad-battery starts reading a battery that does not
exist, and pad-connect's usable() test - which tests ANY js* - would think
the real pad is already back and stop trying to reconnect it. So `up`:

  (a) stops tv-waker, pad-record and pad-battery for the duration and puts
      back exactly the ones that were running, in a finally that runs on
      SIGTERM/SIGINT too (this is the ONE place stage-2 code runs systemctl);
      the signal handlers that make that true are installed BEFORE the frame
      is entered - see install_signal_handlers() for why the window between
      "frame entered" and "serving" used to be fatal;
  (b) snapshots ~/couch/recordings/ before and asserts it is unchanged after,
      shouting if it is not;
  (c) REFUSES to start if a real DualSense is connected - a fake pad while
      the real one is live is how you lose an evening;
  (d) claims the pidfile under an exclusive flock BEFORE the frame is
      entered and before any device exists, so two near-simultaneous `up`s
      cannot both end up holding a uhid pad (see claim_pidfile()).

Rollback is: fake-pad quit, or kill it. Everything it touched is restored.
"""
import errno
import fcntl
import os
import re
import select
import signal
import subprocess
import sys
import time

VENV = os.path.expanduser('~/couch/couchd/.venv')
if os.path.isdir(VENV) and sys.prefix != VENV:
    _site = os.path.join(VENV, 'lib', f'python{sys.version_info.major}.'
                                      f'{sys.version_info.minor}',
                         'site-packages')
    if os.path.isdir(_site):
        sys.path.insert(0, _site)

# ---------------------------------------------------------------------------
# The fake MAC. Locally-administered, unmistakably synthetic, and nothing
# like the real pad's AA:BB:CC:DD:EE:FF at any prefix.
FAKE_MAC = 'de:ad:be:ef:fa:ce'
REAL_MAC = os.environ.get('COUCH_PAD_MAC', 'aa:bb:cc:dd:ee:ff')  # your own pad's Bluetooth MAC

FIFO = '/tmp/fake-pad.fifo'
PIDFILE = '/tmp/fake-pad.pid'
STATUSFILE = '/tmp/fake-pad.status'
RECORDINGS = os.path.expanduser('~/couch/recordings')
INHIBIT_UNITS = ('tv-waker.service', 'pad-record.service', 'pad-battery.service')

# The name the REAL pad presents. hid-tools names its emulator "Sony
# Interactive Entertainment Wireless Controller" (the USB product string),
# but hid_playstation takes the input device name from hdev->name, and over
# Bluetooth the real DualSense reports "DualSense Wireless Controller".
# Two independent artefacts on this box confirm it: couchd's PAD_WANTED and
# Kodi's hand-made DualSense_Wireless_Controller_13b_8a.xml buttonmap.
#
# The rig MUST use the real name. 71-dualsense-uaccess.rules matches on
# ATTRS{name}, couchd's PadObserver and inputproc's find_pad() both filter on
# it, and SR8's whole premise is that the fake pad is indistinguishable from
# the real one EXCEPT by MAC. Under the emulator's own name the rig would
# quietly exercise none of those paths.
PAD_NAME = 'DualSense Wireless Controller'

# hid-tools' PS5 button indices (its buttons_map), by the names on the pad.
BUTTONS = {
    'square': 1, 'cross': 2, 'circle': 3, 'triangle': 4,
    'l1': 5, 'r1': 6, 'l2': 7, 'r2': 8,
    'create': 9, 'options': 10, 'l3': 11, 'r3': 12, 'ps': 13,
}
AXES = ('lx', 'ly', 'rx', 'ry')
DPAD = {'up': 0, 'right': 2, 'down': 4, 'left': 6, 'center': 15}


def stamp(msg):
    print(f'{time.strftime("%H:%M:%S")} fake-pad: {msg}', flush=True)


# =========================================================================
# signals and the single-instance claim
# =========================================================================
# One flag for the whole process. serve()'s loop reads it; so do the
# checkpoints in daemon().
STOPPING = {'now': False}


def install_signal_handlers():
    """SIGTERM/SIGINT set STOPPING and NEVER raise. Called at the very top of
    daemon(), before the SafetyFrame is entered.

    This ordering is load-bearing, and getting it wrong left the box with
    tv-waker/pad-record/pad-battery stopped and nothing to restore them:

      * the handlers used to be installed inside serve(), but the frame is
        entered at the top of daemon(). A SIGINT during SafetyFrame.__enter__
        - which spends up to 20s per `systemctl stop`, three of them - raised
        KeyboardInterrupt out of __enter__, so the with-body was never
        entered and __exit__ never ran;
      * a SIGTERM anywhere between __enter__ returning and serve() installing
        its handlers (device create + wait_ready, ~8s) was default-fatal:
        the process died outright with the units still stopped.

    Setting a flag rather than raising is the point. A handler that raises
    can still tear the process out of __enter__ mid-inhibit; a flag cannot.
    The cost is that a signal arriving inside a blocking systemctl call is
    only noticed when that call returns (<=20s), and that is the right trade:
    late-but-restored beats prompt-but-abandoned. For the same reason a
    SECOND signal during teardown is also swallowed - the restore finishes.
    `kill -9` is the operator's remaining escape hatch, and it is the one
    that does leave the units stopped.

    Deliberately silent: no print() in the handler. Python runs handlers
    between bytecodes in the main thread, so printing from one while the main
    thread holds the (non-reentrant) stdout buffer lock can deadlock. The
    checkpoints do the talking instead.
    """
    def onsig(_signum, _frame):
        STOPPING['now'] = True
    signal.signal(signal.SIGTERM, onsig)
    signal.signal(signal.SIGINT, onsig)


def claim_pidfile(path=PIDFILE, attempts=5):
    """Claim being THE rig, atomically. Returns the held fd, or None if
    another live rig already owns it.

    The pidfile used to be written inside serve(), ~8s after startup: two
    `up`s launched within that window both passed daemon_alive(), both
    created a uhid DualSense, and the second clobbered the first's FIFO and
    pidfile. The first pad was then live but unreachable, and killing what
    the pidfile pointed at restored tv-waker while a fake pad was still
    plugged in - the exact state the safety frame exists to prevent.

    So the claim happens FIRST, before the frame and before any device, and
    it is an flock rather than a "does this pid exist?" test: the lock is
    held by the kernel for as long as the process lives, so a rig that died
    hard leaves a stale pidfile that the next `up` can take, while a rig that
    is merely slow to start cannot be raced. The inode re-check closes the
    unlink race (we may have locked a file the previous owner has just
    removed on its way out).
    """
    for _ in range(attempts):
        fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            os.close(fd)
            return None
        try:
            same = os.stat(path).st_ino == os.fstat(fd).st_ino
        except OSError:
            same = False
        if not same:
            os.close(fd)             # locked a file that is already unlinked
            time.sleep(0.05)
            continue
        os.ftruncate(fd, 0)
        os.write(fd, str(os.getpid()).encode())
        os.fsync(fd)
        return fd
    return None


# =========================================================================
# safety frame
# =========================================================================
def real_pad_present(fake_mac=FAKE_MAC, procfile='/proc/bus/input/devices'):
    """A DualSense whose uniq is NOT ours = the real pad. Returns its MAC
    or None. Pure enough to test with a fixture file."""
    try:
        with open(procfile) as f:
            blocks = f.read().split('\n\n')
    except OSError:
        return None
    for b in blocks:
        m = re.search(r'N: Name="([^"]*)"', b)
        if not m or PAD_NAME not in m.group(1):
            continue
        u = re.search(r'U: Uniq=(\S*)', b)
        uniq = (u.group(1) if u else '').lower()
        if uniq != fake_mac.lower():
            return uniq or '(no uniq)'
    return None


def unit_active(unit):
    try:
        r = subprocess.run(['systemctl', '--user', 'is-active', unit],
                           capture_output=True, text=True, timeout=10)
        return r.stdout.strip() == 'active'
    except (OSError, subprocess.SubprocessError):
        return False


def unit_do(verb, unit):
    try:
        subprocess.run(['systemctl', '--user', verb, unit],
                       capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError) as e:
        stamp(f'systemctl {verb} {unit} failed: {e}')


def recordings_snapshot(directory=RECORDINGS):
    try:
        return sorted(os.listdir(directory))
    except OSError:
        return []


def compare_recordings(before, after):
    """Returns the list of files that appeared. SR8: the corpus must not
    gain a single file because of a rig run."""
    return sorted(set(after) - set(before))


class SafetyFrame:
    """Inhibit set in, inhibit set out - on ANY exit, signals included."""

    def __init__(self, units=INHIBIT_UNITS):
        self.units = units
        self.restore = []
        self.recordings_before = []

    def __enter__(self):
        mac = real_pad_present()
        if mac:
            raise SystemExit(
                f'REFUSING: a real DualSense is connected (uniq {mac}). '
                f'Disconnect it before running the rig - a fake pad while '
                f'the real one is live blocks its only reconnect path.')
        self.recordings_before = recordings_snapshot()
        for unit in self.units:
            if unit_active(unit):
                self.restore.append(unit)
                unit_do('stop', unit)
        stamp(f'inhibited: {", ".join(self.restore) or "(none were running)"}')
        stamp(f'recordings before: {len(self.recordings_before)} file(s)')
        return self

    def __exit__(self, *exc):
        for unit in self.restore:
            unit_do('start', unit)
        stamp(f'restored: {", ".join(self.restore) or "(nothing to restore)"}')
        gained = compare_recordings(self.recordings_before,
                                    recordings_snapshot())
        if gained:
            stamp('!' * 60)
            stamp(f'WARNING: the recordings corpus GAINED {len(gained)} '
                  f'file(s) during this run: {gained}')
            stamp('That is corpus pollution (SR8). Delete them before any '
                  'comparator run.')
            stamp('!' * 60)
        else:
            stamp('recordings unchanged - corpus clean')
        return False


# =========================================================================
# the device
# =========================================================================
def make_device():
    """Imported lazily so `fake-pad press ...` needs no hid-tools at all."""
    from hidtools.device.sony_gamepad import PS5ControllerBluetooth

    class FakeDualSense(PS5ControllerBluetooth):
        def __init__(self):
            super().__init__()
            # 1. the fixed fake MAC. self.uniq is both what uhid advertises
            #    (HID_UNIQ, hence udev's ATTRS{uniq}) and what feature report
            #    0x09 encodes, which is where hid_playstation reads it from.
            self.uniq = FAKE_MAC
            # 1b. and the real pad's NAME, so the rig actually exercises the
            #     name-matched paths (71-dualsense-uaccess.rules, couchd's
            #     PAD_WANTED, inputproc's find_pad). See PAD_NAME above.
            self.name = PAD_NAME
            # 2. hid-tools sets range(1, 13) - button 13, BTN_MODE, the PS
            #    button, would raise InvalidHIDCommunication. The report
            #    descriptor declares 14 buttons; only this tuple stops us.
            self.buttons = tuple(range(1, 14))
            self.unhandled = {'get': 0, 'set': 0, 'output': 0}
            # 4. DISARM hid-tools' input_nodes property. Reading it spawns a
            #    background thread that calls UHIDDevice.dispatch() while it
            #    opens every evdev node - and UHIDDevice._poll is a CLASS-level
            #    select.poll(), so that thread and our own dispatch pump are
            #    two concurrent poll() calls on one object ("RuntimeError:
            #    concurrent poll() invocation"). Worse, if opening a node
            #    raises - and it does, because the /dev entry and its ACL land
            #    a moment AFTER the sysfs node appears - the property never
            #    reaches its `done = True; t.join()`, so the thread is
            #    orphaned and polls forever. Pre-seeding the cache makes the
            #    property return [] immediately and never start a thread. We
            #    read the sysfs directly instead (sysfs_event_nodes below),
            #    which needs no thread and opens nothing.
            self._input_nodes = []

        # 3. InputPlumber #459: unhandled reports return SUCCESS.
        def get_report(self, req, rnum, rtype):
            err, data = super().get_report(req, rnum, rtype)
            if err:
                self.unhandled['get'] += 1
                return (0, list(data) or [rnum])
            return (err, data)

        def set_report(self, req, rnum, rtype, data):
            super().set_report(req, rnum, rtype, data)
            self.unhandled['set'] += 1
            return 0

        def output_report(self, data, size, rtype):
            # hid_playstation's rumble/LED writes land here. Swallowed on
            # purpose: S3 means we never decode effects anywhere.
            self.unhandled['output'] += 1

    return FakeDualSense()


def sysfs_event_nodes(dev):
    """[(/dev/input/eventN, name)] straight out of sysfs.

    Deliberately NOT hid-tools' `input_nodes`: that property opens every
    evdev node from a background dispatch thread (see note 4 in the subclass
    above). Everything we need is in the parent input device's uevent file,
    which is a plain read - no thread, no open, no ACL race.
    """
    nodes = []
    try:
        paths = dev.walk_sysfs('input', 'input/input*/event*')
    except Exception:
        return nodes
    for path in sorted(paths, key=lambda p: p.name):
        name = '?'
        try:
            with open(path.parent / 'uevent') as f:
                for line in f:
                    key, _, value = line.strip().partition('=')
                    if key == 'NAME':
                        name = value.strip('"')
        except OSError:
            pass
        nodes.append((os.path.join('/dev/input', path.name), name))
    return nodes


def wait_ready(dev, seconds=8.0):
    """S7's success oracle: hid_playstation bound = three input nodes plus a
    power_supply class. Anything less and the driver did not take it.

    Single-threaded on purpose: this loop is the ONLY thing calling
    dispatch(), so the class-level poll object has exactly one caller.
    """
    deadline = time.time() + seconds
    while time.time() < deadline:
        dev.dispatch(10)
        if dev.started and len(sysfs_event_nodes(dev)) == 3:
            try:
                if dev.power_supply_class is not None:
                    return True
            except Exception:
                pass
        time.sleep(0.05)
    return False


def describe(dev):
    lines = [f'uniq (MAC):   {dev.uniq}',
             f'hid sysfs:    {dev.sys_path}']
    try:
        lines.append(f'hidraw:       {", ".join(dev.hidraw_nodes) or "(none)"}')
    except Exception:
        pass
    nodes = sysfs_event_nodes(dev)
    lines.append(f'input nodes:  {len(nodes)}')
    for devnode, name in nodes:
        lines.append(f'  {devnode}  {name!r}'
                     + ('' if os.path.exists(devnode) else '  [NO DEV NODE]'))
    try:
        ps = dev.power_supply_class
        lines.append(f'power_supply: {"present" if ps else "MISSING"}')
    except Exception:
        lines.append('power_supply: MISSING')
    return '\n'.join(lines)


# =========================================================================
# command handling (FIFO protocol, same shape as vpad)
# =========================================================================
class Rig:
    def __init__(self, dev):
        self.dev = dev
        self.state = {'left': (128, 128), 'right': (128, 128),
                      'hat': 15, 'buttons': {}}
        self.sent = 0

    def send(self):
        self.dev.event(left=self.state['left'], right=self.state['right'],
                       hat_switch=self.state['hat'],
                       buttons=dict(self.state['buttons']))
        self.sent += 1

    def button(self, name, value):
        self.state['buttons'][BUTTONS[name]] = bool(value)
        self.send()

    def axis(self, name, value):
        value = max(-1.0, min(1.0, float(value)))
        raw = int(round((value + 1.0) / 2.0 * 255))
        raw = max(0, min(255, raw))
        left, right = list(self.state['left']), list(self.state['right'])
        {'lx': lambda: left.__setitem__(0, raw),
         'ly': lambda: left.__setitem__(1, raw),
         'rx': lambda: right.__setitem__(0, raw),
         'ry': lambda: right.__setitem__(1, raw)}[name]()
        self.state['left'], self.state['right'] = tuple(left), tuple(right)
        self.send()

    def dpad(self, direction):
        self.state['hat'] = DPAD[direction]
        self.send()

    def handle(self, line):
        """Returns False to quit. Every branch is bounded."""
        parts = line.split()
        if not parts:
            return True
        cmd, args = parts[0], parts[1:]
        try:
            if cmd == 'quit':
                return False
            if cmd == 'status':
                self.write_status()
            elif cmd in ('press', 'hold', 'down', 'release'):
                name = args[0]
                if cmd != 'release':
                    self.button(name, 1)
                if cmd == 'press':
                    self.pace(0.12)
                elif cmd == 'hold':
                    self.pace(float(args[1]) if len(args) > 1 else 1.2)
                if cmd != 'down':
                    self.button(name, 0)
            elif cmd == 'sleep':
                # Timing lives HERE, not in the sender: a driver that sleeps
                # between FIFO writes adds the reader loop's poll latency
                # (up to ~30ms) to every gap, which is the difference between
                # a 48ms double-tap and a 78ms one. A `sleep` line in the same
                # buffered write runs back-to-back with its neighbours, so the
                # gap is pace()'s clock plus sub-ms dispatch. Capped so a typo
                # cannot park the rig (and the inhibit frame) for an hour.
                self.pace(max(0.0, min(30.0, float(args[0]))))
            elif cmd == 'axis' and args[0] in AXES:
                self.axis(args[0], args[1])
            elif cmd == 'dpad' and args[0] in DPAD:
                self.dpad(args[0])
            else:
                stamp(f'bad command: {line}')
        except (IndexError, KeyError, ValueError) as e:
            stamp(f'bad command: {line} ({e})')
        return True

    def pace(self, seconds):
        """Sleep while still servicing uhid: the kernel asks for feature
        reports at awkward moments and a 5s driver timeout is the cost of
        not answering."""
        end = time.time() + seconds
        while time.time() < end:
            self.dev.dispatch(int(min(20, (end - time.time()) * 1000)) or 1)

    def write_status(self):
        try:
            with open(STATUSFILE, 'w') as f:
                f.write(describe(self.dev) + '\n')
                f.write(f'reports sent: {self.sent}\n')
                f.write(f'unhandled (returned success): '
                        f'{self.dev.unhandled}\n')
        except OSError:
            pass


def daemon():
    """Claim, arm, inhibit, create, serve - strictly in that order.

    The claim and the signal handlers both precede the SafetyFrame so that
    EVERY path out of here - signal, exception, quit - unwinds through
    __exit__ and puts the inhibited units back. STOPPING is checked at the
    two checkpoints where a signal that arrived during a long blocking step
    (the systemctl stops, create+wait_ready) can be honoured without leaving
    a device behind.
    """
    lock_fd = claim_pidfile()
    if lock_fd is None:
        raise SystemExit(f'fake-pad is already up (another rig holds '
                         f'{PIDFILE})')
    install_signal_handlers()
    try:
        with SafetyFrame():
            if STOPPING['now']:
                stamp('signalled while inhibiting - no device was created')
                return
            dev = make_device()
            stamp(f'creating uhid DualSense, uniq={FAKE_MAC}')
            try:
                dev.create_kernel_device()
                if not wait_ready(dev):
                    stamp('WARNING: device did not report ready (3 input '
                          'nodes + power_supply). hid_playstation may not '
                          'have bound.')
                stamp('device up:\n' + describe(dev))
                if STOPPING['now']:
                    stamp('signalled while the device was coming up - not '
                          'serving')
                else:
                    serve(Rig(dev))
            finally:
                try:
                    dev.destroy()
                except Exception as e:
                    stamp(f'destroy failed: {e}')
                stamp('uhid device destroyed')
    finally:
        remove_our_files()
        try:
            os.close(lock_fd)        # releases the flock
        except OSError:
            pass


def serve(rig):
    """The command pump. Signals are ALREADY armed by daemon() - this
    function no longer installs handlers of its own, it just reads the one
    process-wide STOPPING flag, so there is no window where the two
    installations disagree about what a SIGTERM means."""
    if os.path.exists(FIFO):
        os.remove(FIFO)
    os.mkfifo(FIFO, 0o600)
    rfd = os.open(FIFO, os.O_RDONLY | os.O_NONBLOCK)
    wfd = os.open(FIFO, os.O_WRONLY | os.O_NONBLOCK)   # keep it from EOF-ing
    rig.write_status()
    stamp(f'listening on {FIFO} (fake-pad quit to stop)')

    buf = b''
    poller = select.poll()
    poller.register(rfd, select.POLLIN)
    try:
        while not STOPPING['now']:
            rig.dev.dispatch(10)
            for _fd, _mask in poller.poll(20):
                try:
                    chunk = os.read(rfd, 4096)
                except BlockingIOError:
                    chunk = b''
                except OSError:
                    chunk = b''
                if not chunk:
                    continue
                buf += chunk
                while b'\n' in buf:
                    line, buf = buf.split(b'\n', 1)
                    if not rig.handle(line.decode('utf-8', 'replace').strip()):
                        STOPPING['now'] = True
                        break
    finally:
        os.close(rfd)
        os.close(wfd)


def remove_our_files():
    """Clean up FIFO/PID/status - but ONLY if they are still ours.

    `fake-pad quit` returns as soon as the line is in the FIFO, so an
    operator (or a script) doing quit-then-up immediately can have the OLD
    daemon's teardown delete the NEW daemon's FIFO and pidfile, leaving a
    rig that is up but unreachable. Checking the pidfile first closes that.
    """
    try:
        owner = int(open(PIDFILE).read())
    except (OSError, ValueError):
        owner = os.getpid()          # no pidfile: nothing else can own these
    if owner != os.getpid():
        stamp(f'another rig (pid {owner}) owns the fifo now - leaving it alone')
        return
    for path in (FIFO, PIDFILE, STATUSFILE):
        try:
            os.remove(path)
        except OSError:
            pass


def daemon_alive():
    try:
        os.kill(int(open(PIDFILE).read()), 0)
        return True
    except (OSError, ValueError):
        return False


def fifo_send(line):
    """Write one command line to the rig's FIFO, NON-BLOCKING.

    Opening a FIFO for writing blocks until a reader opens it - forever, if
    the rig died hard and left its files behind. That parked the operator's
    shell on a dead rig, which is the worst moment to be stuck: the inhibit
    units are down and the only thing that restores them is the process that
    just vanished. O_NONBLOCK turns exactly that case into ENXIO ("no
    reader"), which we report and exit on. Same rule gesture-sweep's
    rig_send() follows.
    """
    try:
        fd = os.open(FIFO, os.O_WRONLY | os.O_NONBLOCK)
    except OSError as e:
        if e.errno == errno.ENXIO:
            sys.exit(f'fake-pad: nothing is reading {FIFO} - the rig died '
                     f'and left its files behind. Check `systemctl --user '
                     f'status {" ".join(INHIBIT_UNITS)}` (they may still be '
                     f'stopped), delete {FIFO} and {PIDFILE}, then '
                     f'fake-pad up.')
        sys.exit(f'fake-pad: cannot open {FIFO}: {e}')
    try:
        os.write(fd, line.rstrip('\n').encode() + b'\n')
    except OSError as e:
        sys.exit(f'fake-pad: write to {FIFO} failed: {e}')
    finally:
        os.close(fd)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ('-h', '--help'):
        sys.exit(__doc__)
    if args[0] == 'up':
        # A courtesy check only - it is a snapshot and two `up`s can both
        # pass it. The binding refusal is claim_pidfile()'s flock, inside
        # daemon(), before anything exists to leak.
        if daemon_alive():
            sys.exit('fake-pad is already up')
        # Deliberately FOREGROUND: this process holds the device, the safety
        # frame and the restore path. Backgrounding it would put the inhibit
        # restore behind a process nobody is watching. Run it in its own
        # terminal or under `setsid ... &` if you want the shell back.
        daemon()
        # Hard exit. Measured on this box: one rig instance in four finished
        # its whole teardown - device destroyed, units restored, corpus
        # checked - and then hung forever in interpreter shutdown, joining a
        # non-daemon thread stuck in poll(). The only Thread() in the whole
        # dependency tree is hid-tools' input_nodes dispatcher
        # (base_device.py:361), which is never joined if the node opens
        # inside it raise. We do not want a third-party thread's lifetime
        # deciding whether the operator gets their shell back, and by this
        # line every last thing we own is already released and verified.
        sys.stdout.flush()
        sys.stderr.flush()
        os._exit(0)
    if args[0] == 'status':
        # Ask the daemon to REFRESH the file first, then read it. Reading it
        # directly returns the snapshot taken at startup, which reports
        # "reports sent: 0" forever and is quietly misleading.
        if daemon_alive():
            fifo_send('status')
            time.sleep(0.3)
        if os.path.exists(STATUSFILE):
            sys.stdout.write(open(STATUSFILE).read())
            return
        sys.exit('fake-pad is not up')
    if not daemon_alive():
        sys.exit('fake-pad is not up (run: fake-pad up)')
    # daemon_alive() is a snapshot; the rig can die in the microsecond after
    # it, so the send itself must not be able to block. See fifo_send().
    fifo_send(' '.join(args))


if __name__ == '__main__':
    main()
