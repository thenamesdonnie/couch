           'sw': (0.0, 1.0), 'se': (1.0, 1.0)}


def parse_fill(value):
    if not value:
        return None
    try:
        return int(value.lstrip('#'), 16) & 0xffffff
    except ValueError:
        raise SystemExit(f'--test-fill wants RRGGBB hex, got {value!r}')


def parse_args(argv=None):
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument('--display', help="X display to put the overlay on - "
                                     "gamescope's nested one, NOT :0")
    p.add_argument('--socket', default=SOCKET_PATH)
    p.add_argument('--player', default='mpv', choices=('mpv', 'none'))
    p.add_argument('--player-args', default='')
    p.add_argument('--test-fill', default=None,
                   help='RRGGBB: fill the picture with a flat opaque colour '
                        'instead of video, so a capture can prove the overlay '
                        'composites. Rig use, with --player none.')
    p.add_argument('--nx', type=float, default=0.66)
    p.add_argument('--ny', type=float, default=0.05)
    p.add_argument('--nw', type=float, default=0.30)
    p.add_argument('--nh', type=float, default=None,
                   help='height as a fraction of the output; omitted, the '
                        'window starts 16:9 and then adopts the video\'s own '
                        'shape once the player has measured it')
    p.add_argument('media', nargs='?', help='url or path for the player')
    return p.parse_args(argv)


def main(argv=None):
    args = parse_args(argv)
    PipDaemon(args).run()
    return 0


if __name__ == '__main__':
    sys.exit(main())
