#!/usr/bin/env python3
"""Generate the console's UI sound set: kodi-addons/resource.uisounds.couch.

Donnie, 24 Aug 2026: "can we add a noise to navigating the menu and selecting
a game pls".

Kodi WAS already making a noise - the stock `resource.uisounds.kodi` clicks
were measurably coming out of the HDMI sink - but the stock set is a mixed bag
(its cursor peaks at -15 dBFS and its select at -27, so the click you most
want to hear is the quietest thing in the pack) and it has nothing at all to
say about launching a game.

Seven hand-made wavs for a couch set had been sitting untracked in the addon
since 11 Aug with no addon.xml, no sounds.xml and no way for Kodi to load
them. They are a good, coherent family, so they were measured off the wave
(fundamental, glide, envelope) and are RE-GENERATED here rather than left as
opaque binaries: the point of this file is that "make select warmer" or "the
tick is too loud" is a number to change, not a re-synthesis from scratch. The
11 Aug originals are kept beside the output in `sources/` as the reference.

The design, and why each sound is the shape it is:

  cursor  a 55ms tick, the quietest thing here. It fires on every single
          d-pad step, so it has to read as texture, not as an event.
  select  a longer 1184Hz note with an octave above it. Confirmation.
  back    the same idea gliding DOWN (800 -> 668Hz): pitch falls when you do.
  in/out  a rising and a falling swoosh, a matched pair for entering and
          leaving a section. Wired OFF by default in sounds.xml - see there.
  error   high, short and hard, the only sound in the set meant to be
          unpleasant.
  launch  the odd one out: 750ms, rising 1512 -> 1934Hz, and it SWELLS (peak
          at ~240ms) instead of decaying from the attack. Everything else is
          a percussive tick; this one is a small event, because it plays when
          a game is being handed the machine.

Levels: the whole set is lifted +10 dB over the 11 Aug originals, which were
uniformly too quiet to hear over a soundbar (the tick peaked at -26 dBFS).
The lift is uniform on purpose - the internal balance was already right, and
the launch swell should stay the biggest thing in the pack.

Two things are added over the originals, both because a synthesised sine
played through eARC into a real soundbar is less forgiving than it looks in a
waveform: a few ms of attack ramp (an instantaneous sine start is a broadband
click - it reads as a pop on a big system) and a quiet harmonic on the
percussive sounds, which is the difference between a beep and a note.

Usage:
    tools/make-uisounds              write the wavs
    tools/make-uisounds --check      regenerate to a temp dir and diff
"""
import argparse
import math
import os
import struct
import sys
import tempfile
import wave

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(REPO, 'kodi-addons', 'resource.uisounds.couch', 'resources')

RATE = 48000

#: The set. Each entry is a sound:
#:
#:   ms       length
#:   f0, f1   fundamental at the start and at the end (equal = no glide)
#:   peak     peak amplitude in dBFS
#:   attack   ms to full amplitude (kills the click of a hard sine start)
#:   swell    ms to the loudest point; None = decay straight from the attack
#:   decay    ms for the tail to fall by 60 dB
#:   parts    (harmonic ratio, relative amplitude) beyond the fundamental
SOUNDS = {
    'cursor': dict(ms=55,  f0=1605, f1=1605, peak=-16, attack=1.5,
                   swell=None, decay=45,  parts=[(2.0, 0.10)]),
    'select': dict(ms=150, f0=1184, f1=1184, peak=-10, attack=2.0,
                   swell=None, decay=130, parts=[(2.0, 0.22)]),
    'back':   dict(ms=170, f0=800,  f1=668, peak=-12, attack=2.0,
                   swell=None, decay=150, parts=[(2.0, 0.12)]),
    'in':     dict(ms=380, f0=773,  f1=1148, peak=-8, attack=12,
                   swell=30,   decay=430, parts=[(2.0, 0.16), (3.0, 0.05)]),
    'out':    dict(ms=400, f0=750,  f1=469, peak=-11, attack=12,
                   swell=30,   decay=450, parts=[(2.0, 0.16), (3.0, 0.05)]),
    'error':  dict(ms=130, f0=2098, f1=2098, peak=-10, attack=1.0,
                   swell=None, decay=95,  parts=[(1.78, 0.30)]),
    'launch': dict(ms=750, f0=1512, f1=1934, peak=-8,  attack=8,
                   swell=240,  decay=900, parts=[(2.0, 0.20), (3.0, 0.07)]),
}


def envelope(i, n, attack, swell, decay):
    """Amplitude at sample i: ramp in, optional swell, exponential tail."""
    t = i / RATE * 1000.0                                   # ms
    if t < attack:
        # raised cosine in, not a straight line: no corner at either end
        return 0.5 - 0.5 * math.cos(math.pi * t / attack)
    if swell is not None and t < swell:
        # hold the ramp climbing to the swell peak, then decay from there
        return 0.5 - 0.5 * math.cos(math.pi * min(1.0, t / swell))
    tail = t - (swell if swell is not None else attack)
    return 10 ** (-3.0 * tail / decay)                       # -60 dB over decay


def render(spec):
    n = int(spec['ms'] / 1000.0 * RATE)
    parts = [(1.0, 1.0)] + list(spec['parts'])
    # Glide by integrating the instantaneous frequency, so the phase stays
    # continuous - stepping the frequency per sample and multiplying by t
    # instead is the classic way to get a warble that is not in the design.
    phases = [0.0] * len(parts)
    raw = []
    for i in range(n):
        frac = i / max(1, n - 1)
        f = spec['f0'] + (spec['f1'] - spec['f0']) * frac
        env = envelope(i, n, spec['attack'], spec['swell'], spec['decay'])
        v = 0.0
        for k, (ratio, amp) in enumerate(parts):
            phases[k] += 2 * math.pi * f * ratio / RATE
            v += amp * math.sin(phases[k])
        raw.append(v * env)
    # Fade the last 8ms to zero: the tail is inaudible by then, but a wav that
    # stops on a non-zero sample clicks on the way out.
    fade = min(int(0.008 * RATE), n)
    for i in range(fade):
        raw[n - fade + i] *= 0.5 + 0.5 * math.cos(math.pi * i / fade)

    high = max(abs(v) for v in raw) or 1.0
    gain = (10 ** (spec['peak'] / 20.0)) / high
    return [v * gain for v in raw]


def write(path, samples):
    frames = bytearray()
    for v in samples:
        s = max(-32768, min(32767, int(round(v * 32767))))
        frames += struct.pack('<hh', s, s)                   # mono, dual-carried
    with wave.open(path, 'wb') as w:
        w.setnchannels(2)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(bytes(frames))


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument('--check', action='store_true',
                    help='regenerate to a temp dir and report differences')
    ap.add_argument('--out', default=OUT)
    args = ap.parse_args()

    dest = tempfile.mkdtemp(prefix='uisounds-') if args.check else args.out
    os.makedirs(dest, exist_ok=True)

    differs = []
    for name, spec in sorted(SOUNDS.items()):
        path = os.path.join(dest, name + '.wav')
        write(path, render(spec))
        live = os.path.join(args.out, name + '.wav')
        if args.check:
            same = (os.path.exists(live) and
                    open(live, 'rb').read() == open(path, 'rb').read())
            print('%-8s %s' % (name, 'ok' if same else 'DIFFERS'))
            if not same:
                differs.append(name)
        else:
            print('%-8s %4dms  peak %+d dBFS  %s' % (
                name, spec['ms'], spec['peak'],
                '%dHz' % spec['f0'] if spec['f0'] == spec['f1']
                else '%d->%dHz' % (spec['f0'], spec['f1'])))
    return 1 if differs else 0


if __name__ == '__main__':
    sys.exit(main())
