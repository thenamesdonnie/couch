                      'wait_after': wait_after, 'idle_timeout': idle_timeout,
                      'note': note})


scenario('single-tap', 'press ps',
         lambda n, r: (expect_no_switcher(n, r)
                       + ([f'{len(noops(r))} unexpected no-op(s)']
                          if noops(r) else [])
                       + ([f'{len(acted(r))} unexpected acted intent(s)']
                          if acted(r) else [])),
         note='tap is unbound: decides nothing, quietly')

for gap in (0, 48, 60, 120):
    scenario(f'double-tap-{gap}ms',
             ('press ps\npress ps' if gap == 0
              else f'press ps\nsleep {gap / 1000:.3f}\npress ps'),
