#!/usr/bin/env python3
"""Synthetic PS-gesture sweep against the LIVE acting couchd (brief item 1).

Everything runs inside tools/fake-pad's inhibit frame: tv-waker, pad-record
and pad-battery are stopped for the duration and restored on any exit, the
TV cannot wake, and the rig refuses to start if the real pad is connected.
The sweep itself only ever produces gesture intents, and under today's
bindings with no game session those are limited to `show kodi` and
`show_switcher` - both Kodi-screen-only. Any acted intent outside that
allowlist fails the sweep loudly.

What it exercises (the 5 Aug brief's still-unexercised list):
  * the full double-tap gap sweep - 0/48/60/120/350 ms release-to-press
    through the real daemon, end-to-end confirmation of the bf34a27
    coalescing fix (0..120 fire the switcher, 350 does not);
  * show_switcher's effect check VERIFIES now (verdict 'confirmed', not
    'unverified' - bug 2 of bf34a27);
  * plain hold and long hold with no session: the no-session gate (bug 3)
    decides a logged no-op, the long-hold tier stays unreachable while
    `hold` is bound;
  * the tap-then-hold boundary: a second press that turns into a hold must
    be a hold, never a double-tap;
  * a stuck hold: release never comes, 'timed-out' via release-never-came,
    clean recovery to idle;
  * a rapid 5-tap burst collapsing to exactly one switcher;
  * pad disconnect mid-gesture: the uhid device is destroyed with the
    button down and couchd must go observer-blind and recover, acting on
    nothing.

Run it with couchd ACTING on gestures (owns.conf), no real pad, no game
session. It sequences scenarios on couchd's own status.json regions, reads
the verdicts from the shadow JSONL, and prints a PASS/FAIL table; exit 0
means every expectation held and the frame restored what it stopped.

The no-session precondition is re-checked before EVERY stimulus, not just at
preflight (still_safe_to_press): a game that starts mid-run, or a
/tmp/game-suspended that appears mid-run, would turn the next scenario's
hold into a real SIGSTOP of a live session and the next tap into a real
resume. On either, the run stops where it is, tears down through the normal
frame restore, and reports a run-level failure - an aborted sweep is never
a pass.
"""
import json
import os
import re
import socket
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
FAKE_PAD = os.path.join(HERE, 'fake-pad')
FIFO = '/tmp/fake-pad.fifo'
PIDFILE = '/tmp/fake-pad.pid'
STATUS = os.path.expanduser('~/couch/shadow/status.json')
TV_WAKE_REQUEST = '/tmp/tv-wake-request'
GAME_SUSPENDED = '/tmp/game-suspended'
LEGACY_INTENTS = '/tmp/legacy-intents.jsonl'
KODI_RPC = ('127.0.0.1', 9090)
KODI_SELECT_DIALOG = 12000
INHIBIT_UNITS = ('tv-waker.service', 'pad-record.service',
                 'pad-battery.service')

# The ONLY (verb, subject) pairs the acting executor may run during this
# sweep. PAIRS, not verbs: `show` dispatches on its subject and only
# `show kodi` is an xlib restack - `show <appid>` spawns game-launch and
# `show steam-menu` presses the virtual guide button, neither of which any
# gesture on an idle box should reach. Anything outside this set fails the
# run outright and aborts the remaining scenarios.
ALLOWED_ACTED = {('show', 'kodi'), ('show_switcher', 'tv')}

# Kodi windows the sweep may close between scenarios. 12000 is the select
# dialog the switcher addon draws. 10106 is Kodi's context menu: Kodi's OWN
# joystick layer also maps the PS button (peripheral.joystick buttonmap +
# gamepad-poweroff.xml's <guide holdtime="1000">), so every hold >=1s in
# this sweep ALSO opens the tv-poweroff menu, exactly as a real-pad hold
# does on this box. That is the console's normal behaviour, not a sweep
# artefact - but the menu is modal and its first entry is "turn everything
# off", so it must never be left standing for the evening couch pass.
DISMISS_WINDOWS = (12000, 10106)

PAD_NAME = 'DualSense Wireless Controller'
FAKE_MAC = 'de:ad:be:ef:fa:ce'


def say(msg):
    print(f'{time.strftime("%H:%M:%S")} sweep: {msg}', flush=True)


def die(msg):
    say(f'FATAL: {msg}')
    sys.exit(2)


# -------------------------------------------------------------------------
# world reads
# -------------------------------------------------------------------------
def read_status(retries=3):
    """status.json, tolerant of landing mid-write."""
    for _ in range(retries):
        try:
            with open(STATUS) as f:
                return json.load(f)
        except (OSError, ValueError):
            time.sleep(0.3)
    return None


def unit_active(unit):
    try:
        r = subprocess.run(['systemctl', '--user', 'is-active', unit],
                           capture_output=True, text=True, timeout=10)
        return r.stdout.strip() == 'active'
    except (OSError, subprocess.SubprocessError):
        return False


def real_pad_present():
    """Same rule as fake-pad's frame: a DualSense whose uniq is not the
    rig's MAC is the real pad."""
    try:
        with open('/proc/bus/input/devices') as f:
            blocks = f.read().split('\n\n')
    except OSError:
        return None
    for b in blocks:
        m = re.search(r'N: Name="([^"]*)"', b)
        if not m or PAD_NAME not in m.group(1):
            continue
        u = re.search(r'U: Uniq=(\S*)', b)
        uniq = (u.group(1) if u else '').lower()
        if uniq != FAKE_MAC:
            return uniq or '(no uniq)'
    return None


def kodi(method, params=None, timeout=3.0):
    """One JSON-RPC call over Kodi's TCP server. Returns the RESULT MATCHED
    BY ID, or None if Kodi is unreachable.

    Port 9090 pushes notifications to every connected client (tv-waker
    depends on exactly that), so the reply to our request can arrive with a
    notification glued before or after it in the same stream. The buffer is
    therefore parsed as a SEQUENCE of JSON documents (raw_decode) and only
    the one carrying our id is the answer; anything else is discarded.
    """
    payload = {'jsonrpc': '2.0', 'id': 714, 'method': method}
    if params is not None:
        payload['params'] = params
    decoder = json.JSONDecoder()
    try:
        with socket.create_connection(KODI_RPC, timeout=timeout) as s:
            s.settimeout(timeout)
            s.sendall(json.dumps(payload).encode())
            buf = ''
            deadline = time.monotonic() + timeout
            while time.monotonic() < deadline:
                try:
                    chunk = s.recv(4096)
                except socket.timeout:
                    return None
                if not chunk:
                    return None
                buf += chunk.decode('utf-8', 'replace')
                while buf:
                    buf = buf.lstrip()
                    try:
                        doc, end = decoder.raw_decode(buf)
                    except ValueError:
                        break               # incomplete document: recv more
                    buf = buf[end:]
                    if isinstance(doc, dict) and doc.get('id') == 714:
                        return doc.get('result')
    except OSError:
        return None
    return None


def kodi_window():
    r = kodi('GUI.GetProperties', {'properties': ['currentwindow']})
    if isinstance(r, dict):
        return (r.get('currentwindow') or {}).get('id')
    return None


# -------------------------------------------------------------------------
# shadow log tailing
# -------------------------------------------------------------------------
class Tail:
    def __init__(self, path):
        self.path = path
        self.offset = os.path.getsize(path) if os.path.exists(path) else 0

    def mark(self):
        if os.path.exists(self.path):
            self.offset = os.path.getsize(self.path)

    def records(self):
        """Everything appended since mark(). NUL-hole and mid-write safe:
        a line that will not parse is skipped, the offset only advances over
        complete lines.

        NULs are stripped from ANYWHERE in the line, not just its ends -
        tools/shadow-diff's load_jsonl() does the same and for the same
        reason. An unclean shutdown leaves a HOLE, not a truncation: the
        05:19 power event left 1154 NUL bytes in snapshots-20260805.jsonl
        where the tail was allocated but never reached the platter. Those
        bytes carry no newline, so they arrive GLUED BETWEEN two real
        records. Stripping only the ends left the NULs in the middle, the
        json.loads failed, and the record was silently dropped - i.e. a
        scenario's own evidence could vanish and read as "nothing happened",
        which in this rig grades as a FAIL against a daemon that behaved.
        """
        out = []
        try:
            with open(self.path, 'rb') as f:
                f.seek(self.offset)
                data = f.read()
        except OSError:
            return out
        end = data.rfind(b'\n')
        if end < 0:
            return out
        self.offset += end + 1
        for line in data[:end].split(b'\n'):
            line = line.replace(b'\x00', b'').strip()
            if not line:
                continue
            try:
                out.append(json.loads(line.decode('utf-8', 'replace')))
            except ValueError:
                continue
        return out


def acted(records, verb=None, reason=None):
    return [r for r in records
            if r.get('kind') == 'intent' and r.get('acted')
            and (verb is None or r.get('verb') == verb)
            and (reason is None or r.get('reason') == reason)]


def effects(records, verb=None):
    return [r for r in records if r.get('kind') == 'effect'
            and (verb is None or r.get('verb') == verb)]


def noops(records):
    return [r for r in records if r.get('kind') == 'decision'
            and r.get('event') == 'gesture-no-op']


def gesture_transitions(records):
    return [(r.get('from'), r.get('to'), r.get('reason')) for r in records
            if r.get('kind') == 'transition' and r.get('region') == 'gesture']


# -------------------------------------------------------------------------
# rig control
# -------------------------------------------------------------------------
def rig_alive():
    try:
        os.kill(int(open(PIDFILE).read()), 0)
        return True
    except (OSError, ValueError):
        return False


def rig_send(script):
    """One buffered write: the rig executes the lines back-to-back, so the
    `sleep` lines inside ARE the gaps (see fake-pad's sleep command).

    O_NONBLOCK on purpose: opening a FIFO for writing with no reader blocks
    forever, and a rig that died hard (leaving the fifo behind) must raise
    ENXIO here rather than park the driver with the inhibit units stopped.
    """
    fd = os.open(FIFO, os.O_WRONLY | os.O_NONBLOCK)
    try:
        os.write(fd, script.rstrip('\n').encode() + b'\n')
    finally:
        os.close(fd)


def script_seconds(script):
    """How long the rig will spend executing it (press=0.12, hold default
    1.2, sleep n) - the driver waits this plus a margin."""
    total = 0.0
    for line in script.strip().split('\n'):
        parts = line.split()
        if not parts:
            continue
        if parts[0] == 'press':
            total += 0.12
        elif parts[0] == 'hold':
            total += float(parts[2]) if len(parts) > 2 else 1.2
        elif parts[0] == 'sleep':
            total += float(parts[1])
    return total


# -------------------------------------------------------------------------
# sequencing on couchd's own view
# -------------------------------------------------------------------------
def wait_for(pred, timeout, what, poll=0.5):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if pred():
            return True
        time.sleep(poll)
    say(f'TIMEOUT waiting for {what} ({timeout}s)')
    return False


def gesture_region():
    s = read_status()
    return (s or {}).get('regions', {}).get('gesture')


def wait_gesture(state, timeout=30):
    return wait_for(lambda: gesture_region() == state, timeout,
                    f'gesture region == {state}')


def dismiss_ui():
    """Close whatever the scenario left on screen - the switcher's select
    dialog (12000) and/or Kodi's own tv-poweroff context menu (10106, which
    Kodi opens on any >=1s PS hold; see DISMISS_WINDOWS) - and PROVE it
    closed. A dialog left open would make the next scenario's effect check
    trivially true, and a modal menu left standing is a booby trap for the
    evening couch pass. Back is only ever sent while one of the two known
    windows is on top, so it cannot navigate Kodi from an arbitrary screen.
    """
    w = kodi_window()
    if w is None:
        say('WARNING: Kodi RPC unreachable; cannot confirm dialog state')
        return False
    for _ in range(6):
        if w not in DISMISS_WINDOWS:
            return True
        kodi('Input.Back')
        time.sleep(0.7)
        w = kodi_window()
        if w is None:
            say('WARNING: Kodi RPC went unreachable mid-dismiss')
            return False
    say(f'WARNING: Kodi window {w} still open after 6 Backs')
    return False


# -------------------------------------------------------------------------
# expectations
# -------------------------------------------------------------------------
def expect_switcher(name, recs):
    """A double-tap that must fire: exactly one acted show_switcher, reason
    double-tap-switcher, verdict confirmed."""
    fails = []
    sw = acted(recs, 'show_switcher')
    if len(sw) != 1:
        fails.append(f'expected exactly 1 acted show_switcher, got {len(sw)}')
    elif sw[0].get('reason') != 'gesture:double-tap-switcher':
        fails.append(f'switcher reason {sw[0].get("reason")!r}')
    eff = effects(recs, 'show_switcher')
    if not eff:
        fails.append('no show_switcher effect verdict landed')
    else:
        bad = [e['verdict'] for e in eff if e.get('verdict') != 'confirmed']
        if bad:
            fails.append(f'show_switcher verdict(s) {bad} (want confirmed)')
    return fails


def expect_no_switcher(name, recs):
    sw = acted(recs, 'show_switcher')
    return ([f'{len(sw)} switcher(s) acted, expected none'] if sw else [])


def expect_hold_noop(name, recs):
    """A no-session hold: at least one gesture-no-op decision naming the
    hold, no acted intents at all."""
    fails = []
    ops = noops(recs)
    if not any(n.get('gesture') == 'hold-fired' and n.get('session') is False
               for n in ops):
        fails.append('no gesture-no-op record for hold-fired with no session')
    if acted(recs):
        fails.append(f'{len(acted(recs))} intents acted; a no-session hold '
                     f'must act on nothing')
    trans = gesture_transitions(recs)
    if not any(t[1] == 'hold-fired' for t in trans):
        fails.append('gesture region never entered hold-fired')
    return fails


SCENARIOS = []


