# -------------------------------------------------------------------------
# the run
# -------------------------------------------------------------------------
MODEL_FILES = ('couchd.py', 'gesture.py', 'gestureconf.py', 'owns.py')


def preflight():
    for unit in ('couchd.service', 'couch.service', 'pad-home.service'):
        if not unit_active(unit):
            die(f'{unit} is not active')
    s = read_status()
    if not s:
        die('cannot read status.json')
    if s.get('mode') != 'acting' or s.get('owns') != ['gestures']:
        die(f"couchd is {s.get('mode')} owns={s.get('owns')}; "
            f"this sweep expects acting ['gestures']")
    if s.get('bindings') != {'tap': 'none', 'double_tap': 'switcher',
                             'hold': 'suspend_to_kodi',
                             'hold_release': 'none', 'long_hold': 'none'}:
        die(f"bindings are not the defaults: {s.get('bindings')} - the "
            f"scenario expectations assume the default vocabulary")
    regions = s.get('regions', {})
    if regions.get('session') != 'none':
        die(f"session region is {regions.get('session')!r}; "
            f"the sweep must not run against a live game")
    if regions.get('foreground') == 'bigpicture':
        die('Big Picture is on top: a no-session hold would emit a real '
            'set_flag suspended=bigpicture (couchd._suspend_intents) - '
            'close it first')
    if regions.get('pad') == 'present':
        die("pad region is already 'present' with no real pad refused - "
            "something else is emulating a pad")
    # A stale suspended flag turns every plain tap into a REAL tap-resume:
    # launch <appid> mode=resume + show <appid>, i.e. game-launch spawning
    # and a /tmp/tv-wake-request touch. Refuse to start until it is gone.
    if os.path.exists(GAME_SUSPENDED):
        die(f'{GAME_SUSPENDED} exists; a tap would act a real resume. '
            f'Let the legacy reconcile clear it (or clear it) first')
    # The daemon must be RUNNING the code we are asserting about: a model
    # file newer than the daemon's start means the fixes on disk are not the
    # fixes in memory, and the sweep would grade the wrong build.
    started = s.get('t', time.time()) - s.get('uptime_s', 0)
    for name in MODEL_FILES:
        path = os.path.join(HERE, '..', 'couchd', name)
        if os.path.exists(path) and os.path.getmtime(path) > started:
            die(f'couchd/{name} is newer than the running daemon; restart '
                f'couchd (a human decision while acting) before sweeping')
    mac = real_pad_present()
    if mac:
        die(f'real DualSense connected (uniq {mac})')
    if rig_alive():
        die('fake-pad is already up; quit it first')
    players = kodi('Player.GetActivePlayers')
    if players:
        die(f'Kodi is playing something ({players}); PS taps during '
            f'playback kick the room back to Home')
    w = kodi_window()
    if w is None:
        say('WARNING: Kodi RPC unreachable - dialog-closed checks degraded')
    elif w in DISMISS_WINDOWS:
        dismiss_ui()
    return s


def still_safe_to_press():
    """Re-check, immediately before EVERY stimulus, the two preflight facts
    that decide whether a PS press is synthetic or real. Returns a reason
    string if the box has changed under us, None if it is still safe.

    preflight() is a check-ONCE, and the box is not frozen for the ~90s a
    sweep takes: Steam can launch a game (a friend's invite, a scheduled
    update finishing, a stray pad-home action), and /tmp/game-suspended can
    appear from the legacy stack at any moment. Either one re-points the
    bindings at real work - `hold` becomes suspend_to_kodi against a LIVE
    game (a real SIGSTOP of somebody's session) and a tap becomes a real
    resume (game-launch spawned, the TV woken). Those are not sweep
    artefacts to grade, they are damage.

    Deliberately cheap - one status.json read and one stat - because it runs
    ten times a run, and deliberately BEFORE the send rather than after: the
    only useful moment to notice is while the button is still up.
    """
    s = read_status()
    if not s:
        return 'status.json became unreadable mid-run'
    region = (s.get('regions') or {}).get('session')
    if region != 'none':
        return (f'session region turned {region!r} mid-run: a game is live '
                f'and a hold would really suspend it')
    if os.path.exists(GAME_SUSPENDED):
        return (f'{GAME_SUSPENDED} appeared mid-run: a tap would act a real '
                f'resume (game-launch + TV wake)')
    return None


def clear_wake_flag(when):
    """The one file that can wake the TV after the frame restores tv-waker,
    which consumes a stale flag on its first 0.4s poll tick. Must run BEFORE
    every stop_rig (frame restore), and once more after, belt and braces."""
    if os.path.exists(TV_WAKE_REQUEST):
        try:
            os.unlink(TV_WAKE_REQUEST)
        except OSError as e:
            say(f'WARNING: could not delete {TV_WAKE_REQUEST}: {e}')
            return
        say(f'WARNING: {TV_WAKE_REQUEST} existed {when} - deleted. '
            f'Find out what wrote it; no sweep path should.')


def start_rig(log_path):
    """Launch the rig. Returns the Popen IMMEDIATELY into the caller's
    hands; readiness failures RAISE rather than die(), because by this
    point the frame may already have the inhibit units stopped and only the
    caller's finally (stop_rig) can put them back. die() here would leak a
    live rig with tv-waker down - the one state the charter forbids."""
    log = open(log_path, 'w')
    return subprocess.Popen(['setsid', FAKE_PAD, 'up'],
                            stdout=log, stderr=subprocess.STDOUT)


def wait_rig_ready(log_path):
    if not wait_for(rig_alive, 20, 'fake-pad daemon'):
        raise RuntimeError(f'fake-pad never came up (see {log_path})')
    # couchd notices the node on its own; the pad region flipping to
    # 'present' is the daemon telling us it is watching THIS pad. 30s: the
    # status file only republishes regions on a pass, and idle passes are
    # seconds apart.
    if not wait_for(lambda: (read_status() or {}).get('regions', {})
                    .get('pad') == 'present', 30, "pad region 'present'"):
        raise RuntimeError(f'couchd never saw the fake pad (see {log_path})')
    say('rig up, couchd watching the fake pad')


def stop_rig(proc, log_path):
    """Quit the rig, and never wait 30s on a rig that cannot hear us.

    fake-pad claims its pidfile at process start now (before the FIFO
    exists), so rig_alive() can be true while there is nothing to write to -
    a rig killed early, or one still inside the ~20s of systemctl stops.
    A failed `quit` therefore goes straight to a SIGTERM on the process
    group, which fake-pad's handlers turn into the same clean unwind through
    its safety frame."""
    quit_sent = False
    if rig_alive():
        try:
            rig_send('quit')
            quit_sent = True
        except OSError as e:
            say(f'could not deliver quit to the rig ({e}); signalling it')
    if proc is not None:
        if not quit_sent:
            try:
                os.killpg(os.getpgid(proc.pid), 15)
            except OSError:
                pass
        try:
            proc.wait(timeout=30)
        except subprocess.TimeoutExpired:
            say('rig did not exit on quit; killing its process group')
            try:
                os.killpg(os.getpgid(proc.pid), 15)
                proc.wait(timeout=10)
            except (OSError, subprocess.TimeoutExpired):
                say('WARNING: rig would not die; inhibit units may still '
                    'be stopped - check systemctl --user status tv-waker')
    try:
        with open(log_path) as f:
            tail = f.read().strip().split('\n')[-8:]
        say('rig log tail:')
        for line in tail:
            print(f'    {line}', flush=True)
    except OSError:
        pass


def main():
    say('preflight')
    status0 = preflight()
    inhibit_before = {u: unit_active(u) for u in INHIBIT_UNITS}
    fails0 = status0.get('action_failures', 0)
    tail = Tail(status0.get('shadow_log',
                            os.path.expanduser('~/couch/shadow/couchd-'
                                               + time.strftime('%Y%m%d')
                                               + '.jsonl')))
    legacy0 = (os.path.getsize(LEGACY_INTENTS)
               if os.path.exists(LEGACY_INTENTS) else 0)
    log_path = f'/tmp/gesture-sweep-rig-{os.getpid()}.log'

    results = []
    forbidden = []
    aborts = []
    proc = None
    try:
        proc = start_rig(log_path)
        wait_rig_ready(log_path)
        time.sleep(2.0)     # let both stacks finish opening the node
        for sc in SCENARIOS:
            say(f"--- {sc['name']}: {sc['note']}")
            if not wait_gesture('idle', sc['idle_timeout']):
                results.append((sc['name'],
                                ['gesture region never returned to idle '
                                 'before the scenario']))
                continue
            time.sleep(3.5)     # outlast every 3s intent cooldown
            unsafe = still_safe_to_press()
            if unsafe:
                say(f'ABORTING: {unsafe}')
                say('no further scenarios will run; tearing down through the '
                    'frame')
                aborts.append(unsafe)
                results.append((sc['name'], [f'not run: {unsafe}']))
                break
            tail.mark()
            rig_send(sc['script'])
            time.sleep(script_seconds(sc['script']) + sc['wait_after'])
            recs = tail.records()
            bad = [r for r in acted(recs)
                   if (r.get('verb'), r.get('subject')) not in ALLOWED_ACTED]
            if bad:
                forbidden += [(sc['name'], r.get('verb'), r.get('subject'),
                               r.get('reason')) for r in bad]
                say('ABORTING: a forbidden intent acted; no further '
                    'scenarios will run')
                results.append((sc['name'], ['forbidden intent acted']))
                break
            results.append((sc['name'], sc['expect'](sc['name'], recs)))
            dismiss_ui()

        # -- disconnect mid-gesture: the teardown IS the stimulus ----------
        if not forbidden and not aborts:
            say('--- disconnect-mid-hold: uhid destroyed, button down')
            wait_gesture('idle', 30)
            time.sleep(3.5)
            unsafe = still_safe_to_press()
            if unsafe:
                # The stimulus here is a button held DOWN across a teardown;
                # against a live game that is a real suspend. Skip it and let
                # the finally restore the frame.
                say(f'ABORTING: {unsafe}')
                aborts.append(unsafe)
                results.append(('disconnect-mid-hold', [f'not run: {unsafe}']))
            else:
                tail.mark()
                rig_send('down ps')
                time.sleep(1.1)   # past 0.9: hold fired, button still down
                clear_wake_flag('before frame restore')
                stop_rig(proc, log_path)
                proc = None
                clear_wake_flag('just after frame restore')
                ok_gone = wait_for(lambda: (read_status() or {})
                                   .get('regions', {}).get('pad')
                                   in ('absent', 'unknown'), 20,
                                   "pad region to leave 'present'")
                time.sleep(2.0)
                recs = tail.records()
                dfails = []
                if not ok_gone:
                    dfails.append('couchd never noticed the pad vanish')
                if acted(recs, 'show_switcher'):
                    dfails.append('switcher acted off a disconnected mid-hold '
                                  'press')
                dfails += [f'forbidden intent acted: {r.get("verb")} '
                           f'{r.get("subject")}' for r in acted(recs)
                           if (r.get('verb'), r.get('subject'))
                           not in ALLOWED_ACTED]
                if not unit_active('couchd.service'):
                    dfails.append('couchd DIED during the disconnect')
                results.append(('disconnect-mid-hold', dfails))
                dismiss_ui()  # the 1.1s hold opened Kodi's poweroff menu too
    except RuntimeError as e:
        results.append(('rig-start', [str(e)]))
    finally:
        if proc is not None:
            clear_wake_flag('before frame restore')
            stop_rig(proc, log_path)
        clear_wake_flag('at teardown')

    # -- postflight -------------------------------------------------------
    say('postflight')
    time.sleep(2.0)
    endfails = []
    s = read_status()
    if not s:
        endfails.append('status.json unreadable after the run')
    else:
        delta = s.get('action_failures', 0) - fails0
        if s.get('pid') != status0.get('pid'):
            endfails.append(f"couchd RESTARTED during the sweep "
                            f"(pid {status0.get('pid')} -> {s.get('pid')})")
            delta = s.get('action_failures', 0)
        if delta:
            endfails.append(f'action_failures rose by {delta}')
        if s.get('mode') != 'acting' or s.get('owns') != ['gestures']:
            endfails.append(f"ownership changed: {s.get('mode')} "
                            f"{s.get('owns')}")
    for unit, was in inhibit_before.items():
        if unit_active(unit) != was:
            endfails.append(f'{unit} not restored to its pre-run state')
    w = kodi_window()
    if w in DISMISS_WINDOWS:
        endfails.append(f'Kodi window {w} left open for the evening pass - '
                        f'close it (Input.Back)')
    if forbidden:
        endfails.append(f'FORBIDDEN INTENTS ACTED: {forbidden}')
    if aborts:
        endfails.append(f'RUN ABORTED - the box changed under the sweep: '
                        f'{"; ".join(aborts)}. The scenarios after the abort '
                        f'did NOT run, so this is an incomplete sweep, not a '
                        f'pass')
    legacy_delta = ((os.path.getsize(LEGACY_INTENTS)
                     if os.path.exists(LEGACY_INTENTS) else 0) - legacy0)
    say(f'legacy would-do stream grew {legacy_delta} bytes '
        f'(differ material, informational)')

    # -- report -----------------------------------------------------------
    print()
    width = max((len(n) for n, _ in results), default=8)
    failed = 0
    for name, fails in results:
        mark = 'PASS' if not fails else 'FAIL'
        failed += bool(fails)
        print(f'  {name:<{width}}  {mark}')
        for f in fails:
            print(f'  {"":<{width}}    - {f}')
    for f in endfails:
        print(f'  RUN: {f}')
    print()
    if failed or endfails:
        say(f'{failed} scenario(s) failed, {len(endfails)} run-level '
            f'failure(s)')
        return 1
    say('all scenarios passed, frame restored, 0 action failures')
    return 0


if __name__ == '__main__':
    sys.exit(main())
