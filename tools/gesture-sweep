scenario('double-tap-350ms', 'press ps\nsleep 0.350\npress ps',
         expect_no_switcher, wait_after=4,
         note='at the window: two singles, no switcher')

scenario('hold-1.5s', 'hold ps 1.5', expect_hold_noop,
