#!/usr/bin/env python3
"""Prove the picture-in-picture overlay actually composites, with no TV.

    tools/pip-gamescope-rig

Runs gamescope on its HEADLESS backend (no window, no DRM output, nothing on
any screen), puts pipd's overlay on gamescope's nested X server, and then asks
gamescope to screenshot its own full composition. If the fill colour appears
in the capture at the rectangle we asked for, the overlay plane works. Then it
moves the picture and captures again.

This exists because the honest alternative was "try it on the television with
a game running and see". The headless backend means the whole mechanism can be
proved on a box with the TV in standby, and the only things left for a live
session are the ones that genuinely need a display: frame pacing, and what the
plane costs.

WHAT IT DOES NOT PROVE. Headless has no display, so nothing here says anything
about refresh rate, VRR, tearing, or the cost of the plane. It also runs
llvmpipe-free (real Vulkan on the 9070 XT) but composites to a buffer rather
than a screen, so "it composited" is the claim, not "it composited fast".

Safe by construction: it never touches DISPLAY :0. If it cannot get its own
nested server it fails rather than falling back to anything.
"""
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.abspath(__file__))
GAMESCOPE = os.path.expanduser('~/src/gamescope/build/src/gamescope')
OUT_W, OUT_H = 1280, 720
FILL = 0x00FF00                 # a green nothing else in the frame can be
SCREENSHOT_ATOM = 'GAMESCOPECTRL_REQUEST_SCREENSHOT'
FULL_COMPOSITION = 3            # gamescope-control.xml screenshot_type


def wait_for(predicate, timeout, what):
    deadline = time.time() + timeout
    while time.time() < deadline:
        got = predicate()
        if got:
            return got
        time.sleep(0.1)
    raise SystemExit(f'timed out waiting for {what}')


def request_screenshot(display, path):
    """Set the atom gamescope watches on the root of its nested server, then
    wait for the file. gamescope deletes the property when it is done, but the
    file appearing is the signal that matters."""
    from Xlib import display as xdisplay, Xatom
    if os.path.exists(path):
        os.unlink(path)
    dpy = xdisplay.Display(display)
    root = dpy.screen().root
    root.change_property(dpy.get_atom(SCREENSHOT_ATOM), Xatom.CARDINAL, 32,
                         [FULL_COMPOSITION])
    dpy.sync()
    dpy.close()
    wait_for(lambda: os.path.exists(path) and os.path.getsize(path) > 0,
             15, f'gamescope to write {path}')
    time.sleep(0.3)             # let the write finish
    return path


def find_fill(png_path, rgb):
    """Where is the fill colour in this capture? Returns a bounding box in
    pixels, or None. Uses ImageMagick because it is already a dependency of
    the phone screen tab."""
    txt = subprocess.run(
        ['convert', png_path, '-depth', '8', 'txt:-'],
        capture_output=True, text=True, check=True).stdout
    want = f'#{rgb:06X}'
    xs, ys = [], []
    for line in txt.splitlines():
        m = re.match(r'(\d+),(\d+):', line)
        if not m or want not in line.upper():
            continue
        xs.append(int(m.group(1)))
        ys.append(int(m.group(2)))
    if not xs:
        return None
    return min(xs), min(ys), max(xs) - min(xs) + 1, max(ys) - min(ys) + 1


def send(sock_path, msg):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(sock_path)
    s.sendall((json.dumps(msg) + '\n').encode())
    reply = json.loads(s.recv(65536).decode())
    s.close()
    return reply


def main():
    if not os.path.exists(GAMESCOPE):
        raise SystemExit(f'no gamescope build at {GAMESCOPE} - see '
                         'docs/gamescope-spike-20260806.md')
    for tool in ('convert',):
        if not shutil.which(tool):
            raise SystemExit(f'{tool} is needed to read the capture')

    tmp = tempfile.mkdtemp(prefix='pip-rig-')
    display_file = os.path.join(tmp, 'display')
    sock_path = os.path.join(tmp, 'pip.sock')
    shot = '/tmp/gamescope.png'      # gamescope's own default
    gs = pip = None
    try:
        # The child's only job is to report the nested DISPLAY and stay alive.
        # gamescope exits when its primary child does.
        # gamescope execs `gamescopereaper` by name. In an installed tree it
        # is on PATH; in our source build it sits beside the binary, so put
        # that directory on PATH or the primary child dies instantly.
        env = dict(os.environ,
                   PATH=os.path.dirname(GAMESCOPE) + os.pathsep + os.environ['PATH'])
        gs = subprocess.Popen(
            [GAMESCOPE, '--backend', 'headless',
             '-W', str(OUT_W), '-H', str(OUT_H), '--',
             # A real client with a real window, standing in for the game.
             # gamescope's composite path needs valid base-plane contents;
             # with no window mapped there is nothing to screenshot and the
             # capture never lands. xeyes is the smallest honest stand-in.
             'sh', '-c', f'printf %s "$DISPLAY" > {display_file}; exec xeyes'],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env)

        def nested():
            if gs.poll() is not None:
                raise SystemExit(f'gamescope died:\n{gs.stdout.read()}')
            if os.path.exists(display_file):
                got = open(display_file).read().strip()
                return got or None
            return None

        display = wait_for(nested, 30, "gamescope's nested display")
        if display == os.environ.get('DISPLAY'):
            raise SystemExit('nested display equals the outer one - refusing '
                             'to run, this would touch the real screen')
        print(f'gamescope headless up, nested display {display}')

        pip = subprocess.Popen(
            [sys.executable, os.path.join(HERE, 'pipd'),
             '--display', display, '--player', 'none',
             '--socket', sock_path, '--test-fill', f'{FILL:06x}',
             '--nx', '0.6', '--ny', '0.1', '--nw', '0.25'],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        wait_for(lambda: os.path.exists(sock_path), 20, "pipd's socket")
        status = send(sock_path, {'cmd': 'status'})
        print(f'pipd up: {status["pixels"]}')
        # Longer than pipd's 2s placement-settle window, deliberately: the
        # first capture is meant to prove the picture ends up where it was
        # asked for WITHOUT anyone moving it, so it has to be taken after
        # startup has finished rather than during it.
        time.sleep(3.0)

        failures = []

        request_screenshot(display, shot)
        found = find_fill(shot, FILL)
        want = status['pixels']
        print(f'\ncapture 1: overlay found at {found}')
        if not found:
            failures.append(
                'the overlay did NOT composite - no fill pixels in a full '
                'composition capture. This is the whole mechanism failing.')
        else:
            for k, got, exp in (('x', found[0], want['x']), ('y', found[1], want['y']),
                                ('w', found[2], want['w']), ('h', found[3], want['h'])):
                if abs(got - exp) > 2:
                    failures.append(f'{k}: composited {got}, asked for {exp}')

        # 'se', NOT 'sw'. The south-WEST corner has x=0, so a capture there
        # agrees with a broken x for the wrong reason - which is exactly what
        # the first version of this rig did. The south-EAST corner moves BOTH
        # axes away from the origin and is the only honest check.
        moved = send(sock_path, {'cmd': 'corner', 'where': 'se'})
        time.sleep(0.7)
        request_screenshot(display, shot)
        found2 = find_fill(shot, FILL)
        want2 = moved['pixels']
        print(f'capture 2 (moved to se): overlay found at {found2}')
        if not found2:
            failures.append('the overlay vanished after a move')
        elif abs(found2[0] - want2['x']) > 2 or abs(found2[1] - want2['y']) > 2:
            failures.append(f'move: composited at {found2[:2]}, '
                            f"asked for {want2['x']},{want2['y']}")
        elif found2[:2] == found[:2]:
            failures.append('the picture did not actually move')

        print()
        if failures:
            for f in failures:
                print(f'FAIL: {f}')
            return 1
        print('PASS: the overlay composites above the game plane, at the '
              'rectangle asked for, and moving it moves the picture.')
        return 0
    finally:
        for proc in (pip, gs):
            if proc and proc.poll() is None:
                proc.terminate()
                try:
                    proc.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    proc.kill()
        shutil.rmtree(tmp, ignore_errors=True)


if __name__ == '__main__':
    sys.exit(main())
