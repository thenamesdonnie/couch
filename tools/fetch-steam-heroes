#!/usr/bin/env python3
"""Mirror Steam's double-resolution hero art (3840x1240) for installed games.

Steam's client only caches heroes at 1920x620, which looks soft as the
full-bleed background on the 4K Stagelight home. The store CDN serves a
library_hero_2x.jpg for most titles; this pulls each installed game's one
into ~/.local/share/game-tiles/heroes/<appid>.jpg. A 404 leaves a .miss
marker so the CDN is not re-asked on every run (retried after 30 days -
Steam does backfill art). Safe to run repeatedly; only fetches what is
missing. games.py prefers these files for fanart when present.

Run directly or let games.py spawn it in the background.
"""
import glob
import os
import re
import time
import urllib.request

STEAMAPPS = os.path.expanduser('~/.steam/steam/steamapps')
OUT = os.path.expanduser('~/.local/share/game-tiles/heroes')
CDN = 'https://shared.steamstatic.com/store_item_assets/steam/apps/%s/library_hero_2x.jpg'
MISS_RETRY_S = 30 * 24 * 3600


def appids():
    out = []
    for path in glob.glob(os.path.join(STEAMAPPS, 'appmanifest_*.acf')):
        m = re.search(r'appmanifest_(\d+)\.acf$', path)
        if m:
            out.append(m.group(1))
    return out


def main():
    os.makedirs(OUT, exist_ok=True)
    got = skipped = missed = 0
    for appid in appids():
        dst = os.path.join(OUT, '%s.jpg' % appid)
        miss = dst + '.miss'
        if os.path.isfile(dst):
            skipped += 1
            continue
        if os.path.isfile(miss) and time.time() - os.path.getmtime(miss) < MISS_RETRY_S:
            skipped += 1
            continue
        try:
            with urllib.request.urlopen(CDN % appid, timeout=10) as r:
                data = r.read()
            if len(data) < 10000:
                raise ValueError('suspiciously small')
            tmp = dst + '.part'
            with open(tmp, 'wb') as f:
                f.write(data)
            os.replace(tmp, dst)
            got += 1
        except Exception:
            open(miss, 'w').close()
            missed += 1
    print('heroes: %d fetched, %d already had, %d not on CDN' % (got, skipped, missed))


if __name__ == '__main__':
    main()
