#!/usr/bin/env python3
"""Switch Bloodborne's frame-rate target under shadPS4: 60, 90 or 120.

  bb-fps status      what is armed now
  bb-fps 60          the eboot's baked 60 fps patch, emulator vblank 60
  bb-fps 120         emulator vblank 120 (untested; expect dips)
  bb-fps 90          emulator vblank 90, NO patch (see below)

Why no XML patch at 90 (3 Sep 2026, measured): this eboot is Lance
McDonald's 60 fps MOD build, whose frame time is DYNAMIC (0x1cbdb42 reads the
real delta from a struct instead of storing a constant). Kyo's "60/90 FPS++"
blocks were written for the STOCK eboot: they overwrite Lance's code with
constants and NOPs (only 22 of their 178 shared lines match this eboot), and
"90 FPS++" crashed at boot in the headless rig (jump into garbage right after
black.gfx). With the dynamic delta, raising the emulated vblank is the whole
change: vblank 90 gave a 90.0 fps median standing still at Cainhurst, no
crash. So this tool only ever touches config.json's vblank_frequency and
makes sure every "++" block stays OFF. Applies at the next launch.
Backups: Bloodborne.xml.pre-fps-<stamp>, config.json.pre-fps-<stamp>.

The display side is separate: the TV must be on a 120 Hz mode for 90 to
present cleanly, and without working VRR (driver reports vrr_capable 0 as of
3 Sep 2026) 90 on 120 paces unevenly. That is what the live test is for.
"""
import json
import os
import re
import shutil
import sys
import time

XML = os.path.expanduser('~/.local/share/shadPS4/patches/shadPS4/Bloodborne.xml')
CFG = os.path.expanduser('~/.local/share/shadPS4/config.json')
CAP_PATCHES = ['30 FPS++', '60 FPS++', '90 FPS++', 'Uncap FPS++', '60FPS (no deltatime)']
TARGETS = {'60': None, '90': None, '120': None}


def enabled_set(xml):
    out = {}
    for m in re.finditer(r'<Metadata[^>]*Name="([^"]*)"[^>]*isEnabled="([^"]*)"', xml):
        out[m.group(1)] = m.group(2) == 'true'
    return out


def set_enabled(xml, name, on):
    pat = re.compile(r'(<Metadata[^>]*Name="%s"[^>]*isEnabled=")([^"]*)(")' % re.escape(name))
    new, n = pat.subn(lambda m: m.group(1) + ('true' if on else 'false') + m.group(3), xml)
    if n != 1:
        sys.exit('patch %r: expected exactly one Metadata entry, found %d' % (name, n))
    return new


def status():
    en = enabled_set(open(XML).read())
    cfg = json.load(open(CFG))
    caps = [p for p in CAP_PATCHES if en.get(p)]
    vb = cfg['GPU']['vblank_frequency']
    target = str(vb) if not caps else 'BROKEN: ++ patch on (%s), vblank %s' % (', '.join(caps), vb)
    print('fps target: %s   (++ patches on: %s; vblank_frequency %s)' % (target, ', '.join(caps) or 'none', vb))
    return target, vb


def apply(target):
    stamp = time.strftime('%Y%m%d-%H%M%S')
    xml = open(XML).read()
    for p in CAP_PATCHES:
        xml = set_enabled(xml, p, p == TARGETS[target])
    cfg = json.load(open(CFG))
    cfg['GPU']['vblank_frequency'] = int(target)
    shutil.copy2(XML, XML + '.pre-fps-' + stamp)
    shutil.copy2(CFG, CFG + '.pre-fps-' + stamp)
    open(XML, 'w').write(xml)
    json.dump(cfg, open(CFG, 'w'), indent=4)
    print('armed %s fps for the next launch' % target)
    status()


def main():
    a = sys.argv[1:] or ['status']
    if a[0] == 'status':
        status()
    elif a[0] in TARGETS:
        apply(a[0])
    else:
        print(__doc__)
        return 2


if __name__ == '__main__':
    sys.exit(main())
