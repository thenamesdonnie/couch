# the CLI
# =========================================================================
def fifo_send(line):
    """One command line to the daemon, NON-BLOCKING. Opening a FIFO for
    writing blocks until a reader shows up - forever if the daemon died hard -
    and the one thing this tool must never do is park its caller. O_NONBLOCK
    turns that into ENXIO, which the callers below treat as 'no daemon'."""
    try:
        fd = os.open(FIFO, os.O_WRONLY | os.O_NONBLOCK)
    except OSError as e:
        if e.errno in (errno.ENXIO, errno.ENOENT):
            return False
        say(f'cannot open {FIFO}: {e}')
        return False
    try:
        os.write(fd, line.rstrip('\n').encode() + b'\n')
        return True
    except OSError as e:
        say(f'write to {FIFO} failed: {e}')
        return False
    finally:
        os.close(fd)


def wait_gone(pid, seconds):
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        try:
            os.kill(pid, 0)
        except OSError:
            return True
        time.sleep(0.02)
    return False


def spawn(image, timeout):
    """Start the daemon and wait for it to say the window is up.

    Detached (start_new_session) because it must outlive the shell that ran
    `curtain show`, and its stdio goes to LOG because a background process
    writing to the caller's terminal during a suspend is nobody's friend.
    """
    rfd, wfd = os.pipe()
    argv = [sys.executable, os.path.abspath(__file__), '__serve__', image,
            f'{timeout:.3f}', str(wfd)]
    try:
        log = open(LOG, 'a')
    except OSError:
        log = subprocess.DEVNULL
    try:
        with open(os.devnull, 'rb') as null:
            proc = subprocess.Popen(argv, stdin=null, stdout=log, stderr=log,
                                    pass_fds=(wfd,), start_new_session=True)
    except (OSError, subprocess.SubprocessError) as e:
        os.close(rfd)
        os.close(wfd)
        say(f'cannot start the curtain daemon: {e}')
        return 1
    finally:
        if hasattr(log, 'close'):
            log.close()
    os.close(wfd)                              # so EOF means 'the child died'
    try:
        message = read_line(rfd, READY_WAIT)
    finally:
        os.close(rfd)
    if message == 'READY':
        return 0
    if message.startswith('ERR'):
        say(message[4:].strip() or 'the curtain daemon refused')
        return 1
    # No word either way: something is wrong enough that we do not want an
    # unconfirmed window over the console. Kill it now rather than leave it to
    # the watchdog - this is the one case where the caller is still waiting.
    if proc.poll() is not None:
        say(f'the curtain daemon exited ({proc.returncode}) without mapping'
            + (f': {message}' if message else f' - see {LOG}'))
        return 1
    say(f'curtain did not come up within {READY_WAIT:.0f}s'
        + (f' ({message})' if message else ''))
    try:
        proc.terminate()
    except OSError:
        pass
    return 1


def read_line(fd, seconds):
    end = time.monotonic() + seconds
    buf = b''
    while time.monotonic() < end:
        left = end - time.monotonic()
        r, _, _ = select.select([fd], [], [], max(0.01, min(0.5, left)))
        if not r:
            continue
        try:
            chunk = os.read(fd, 512)
        except OSError:
            return ''
        if not chunk:                          # EOF: the child is gone
            return buf.decode('utf-8', 'replace').strip()
        buf += chunk
        if b'\n' in buf:
            return buf.split(b'\n', 1)[0].decode('utf-8', 'replace').strip()
    return buf.decode('utf-8', 'replace').strip()


def cmd_show(image, timeout):
    if not os.path.exists(image):
        say(f'no such image: {image}')
        return 1
    if daemon_alive():
        before = read_status().get('shows', 0)
        if fifo_send(f'show {shlex.quote(image)} {timeout:.3f}'):
            end = time.monotonic() + 2.0
            while time.monotonic() < end:
                st = read_status()
                if st.get('shows', 0) > before and st.get('image') == image:
                    return 0
                if not daemon_alive():
                    break
                time.sleep(0.02)
            say('the running curtain did not take the new image; replacing it')
        # It died between the liveness check and the write, or it is wedged.
        cmd_clear()
    clear_stale()
    return spawn(image, timeout)


def cmd_fade(duration):
    pid = daemon_pid()
    if not daemon_alive():
        clear_stale()
        say('no curtain is up (nothing to fade)')
        return 0                               # the wanted end state already holds
    if not fifo_send(f'fade {duration:.3f}'):
        return cmd_clear()
    # Bounded wait so callers can sequence on it, but never a hard dependency:
    # if the daemon is slow the watchdog still has it, so we return 0 either
    # way rather than fail a suspend over a dissolve.
    if not wait_gone(pid, duration + 1.5):
        say('curtain still up after the fade window; its watchdog has it')
    return 0


def cmd_clear():
    pid = daemon_pid()
    if not daemon_alive():
        clear_stale()
        return 0
    if fifo_send('clear'):
        if wait_gone(pid, 1.5):
            return 0
    try:
        os.kill(pid, signal.SIGTERM)           # the FIFO is wedged; be blunt
    except OSError:
        pass
    if not wait_gone(pid, 1.5):
        say(f'curtain pid {pid} did not exit; its watchdog will take it')
    clear_stale()
    return 0


def cmd_status():
    st = read_status()
    alive = daemon_alive()
    if not alive:
        clear_stale()
        print('no curtain is up')
        return 1
    st['remaining'] = round(max(0.0, st.get('remaining', 0)
                                - (time.time() - st.get('ts', time.time()))), 2)
    print(json.dumps(st, indent=2, sort_keys=True))
    return 0


def main(argv):
    try:
        opts = parse_args(argv)
    except Usage as e:
        if not e.args or e.args[0] is None:
            print(__doc__, file=sys.stderr)
            return 2
        say(str(e))
        return 2
    # pause-snap's defaults, for the same reason: this may be run from a shell
    # script, a Kodi addon or systemd, none of which reliably carry DISPLAY.
    os.environ.setdefault('DISPLAY', ':0')
    os.environ.setdefault('XAUTHORITY', os.path.expanduser('~/.Xauthority'))
    cmd = opts['cmd']
    if cmd == '__serve__':
        return serve(opts['image'], opts['timeout'], opts['ready_fd'])
    if cmd == 'show':
        return cmd_show(opts['image'], opts['timeout'])
    if cmd == 'fade':
        return cmd_fade(opts['duration'])
    if cmd == 'clear':
        return cmd_clear()
    return cmd_status()


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except CurtainError as e:
        say(str(e))
        sys.exit(1)
