# the daemon
# =========================================================================
STOPPING = {'now': False}


def install_signal_handlers():
    """SIGTERM/SIGINT set a flag and never raise - fake-pad's rule, for the
    same reason: a handler that raises can tear the process out of the middle
    of teardown. The loop and the fade both check the flag."""
    def onsig(_signum, _frame):
        STOPPING['now'] = True
    signal.signal(signal.SIGTERM, onsig)
    signal.signal(signal.SIGINT, onsig)


def arm_watchdog(seconds):
    """The hard half of the contract. The loop's own deadline check is the
    polite half; this is the one that holds when a blocking X call never
    returns, and it holds because the handler does not try to be tidy - it
    calls os._exit(), the process dies, and the X server destroys the windows
    of a client that has gone away. No X call is made from the handler, so
    there is nothing left to hang on."""
    def onalarm(_signum, _frame):
        os._exit(3)
    signal.signal(signal.SIGALRM, onalarm)
    signal.setitimer(signal.ITIMER_REAL, max(0.1, seconds + WATCHDOG_GRACE))


def write_status(overlay, deadline, warm=False):
    payload = {
        'pid': os.getpid(),
        'image': overlay.image,
        'shows': overlay.shows,
        'uploads': overlay.uploads,
        'mapped': overlay.mapped,
        'warm': bool(warm),
        'display': overlay.display_name,
        'screen': [overlay.w, overlay.h],
        'remaining': round(max(0.0, deadline - time.monotonic()), 2),
        'ts': time.time(),
    }
    tmp = STATUSFILE + f'.{os.getpid()}'
    try:
        with open(tmp, 'w') as f:
            json.dump(payload, f)
        os.replace(tmp, STATUSFILE)            # readers never see half a file
    except OSError:
        try:
            os.remove(tmp)
        except OSError:
            pass


def remove_our_files():
    """Only if they are still ours - fake-pad's rule. `curtain fade` returns
    as soon as its line is in the FIFO, so a fade immediately followed by a
    fresh `show` can otherwise have the OLD daemon's teardown delete the NEW
    daemon's fifo and pidfile."""
    owner = daemon_pid()
    if owner is not None and owner != os.getpid():
        return
    for path in (FIFO, PIDFILE, STATUSFILE):
        try:
            os.remove(path)
        except OSError:
            pass


def report(ready_fd, message):
    """One line back to the `show` that spawned us, then the pipe is done."""
    if ready_fd is None:
        return
    try:
        os.write(ready_fd, message.encode() + b'\n')
    except OSError:
        pass


def parse_spin(spec):
    """'strip.png,x,y,d,n,fps' -> dict, or None on any trouble. The spinner
    is cosmetic-on-cosmetic: a bad spec degrades to the static card."""
    try:
        path, x, y, d, n, fps = spec.split(',')
        x, y, d, n, fps = int(x), int(y), int(d), int(n), float(fps)
        if not (os.path.isfile(path) and 8 <= d <= 512
                and 2 <= n <= 96 and 1.0 <= fps <= 30.0):
            return None
        return {'path': path, 'x': x, 'y': y, 'd': d, 'n': n, 'fps': fps}
    except (ValueError, OSError):
        return None


def serve(image, timeout, ready_fd=None, spin=None):
    """Claim, map, report, then serve the FIFO until the deadline.

    Order matters: the claim happens before any X resource exists, so two
    near-simultaneous `show`s cannot both end up holding an overlay window;
    and the readiness report happens only after the window is genuinely on
    screen, so a caller that got exit 0 knows the shuffle underneath is now
    hidden.
    """
    install_signal_handlers()
    lock_fd = claim_pidfile()
    if lock_fd is None:
        report(ready_fd, 'ERR another curtain already holds ' + PIDFILE)
        return 1
    overlay = Overlay()
    deadline = time.monotonic() + timeout
    try:
        try:
            overlay.open()
            overlay.set_image(image)
            overlay.show()
        except CurtainError as e:
            report(ready_fd, f'ERR {e}')
            say(str(e))
            return 1
        except Exception as e:
            report(ready_fd, f'ERR {type(e).__name__}: {e}')
            say(f'{type(e).__name__}: {e}')
            return 1
        if spin:
            sp = parse_spin(spin)
            if sp:
                try:
                    overlay.load_spinner(sp)
                except Exception as e:
                    say(f'spinner unavailable ({e}); static card')
            else:
                say('spinner spec unusable; static card')
        arm_watchdog(timeout)
        write_status(overlay, deadline)
        report(ready_fd, 'READY')
        if ready_fd is not None:
            try:
                os.close(ready_fd)
            except OSError:
                pass
            ready_fd = None
        return loop(overlay, deadline, timeout)
    finally:
        overlay.teardown()
        remove_our_files()
        try:
            os.close(lock_fd)                  # releases the flock
        except OSError:
            pass


def loop(overlay, deadline, timeout):
    """The command pump. Every wait is bounded by the deadline, so the daemon
    cannot outlive its timeout even if nobody ever writes to the FIFO."""
    try:
        if os.path.exists(FIFO):
            os.remove(FIFO)
        os.mkfifo(FIFO, 0o600)
        rfd = os.open(FIFO, os.O_RDONLY | os.O_NONBLOCK)
        wfd = os.open(FIFO, os.O_WRONLY | os.O_NONBLOCK)   # keeps it off EOF
    except OSError as e:
        say(f'fifo unavailable ({e}); the curtain will only watchdog out')
        rfd = wfd = None
    poller = select.poll()
    if rfd is not None:
        poller.register(rfd, select.POLLIN)
    buf = b''
    faded = False
    # The warm-hold state (docstring: THE WARM HOLD). While warm['on'], the
    # window is unmapped, the pixmap stays uploaded, and the daemon retires
    # the moment warm['flag'] disappears - or when the (re-armed, WARM_IDLE_MAX)
    # deadline runs out, whichever is first.
    warm = {'on': False, 'flag': None, 'next_check': 0.0, 'gone_at': None}
    next_spin = time.monotonic()
    try:
        while not STOPPING['now']:
            now = time.monotonic()
            left = deadline - now
            if left <= 0:
                if warm['on']:
                    say('warm hold: idle bound reached with the pause still '
                        'on; retiring (nothing was on screen)')
                else:
                    say(f'watchdog: {timeout:.1f}s up, tearing the curtain '
                        f'down (nobody faded or cleared it)')
                break
            if warm['on'] and now >= warm['next_check']:
                warm['next_check'] = now + WARM_FLAG_POLL_S
                if not (warm['flag'] and os.path.exists(warm['flag'])):
                    # ...but NOT instantly. The flag's removal is the FIRST
                    # act of a resume, not its last: game-launch clears it
                    # before the SIGCONTs (the reconcile-flip ordering rule)
                    # and only reaches its curtain_show a beat later - so an
                    # immediate retirement here killed the warm pixmap
                    # milliseconds before the one show it exists for, and the
                    # resume paid the full ~1.15s cold rebuild anyway
                    # (measured live, 23 Aug: 1155ms). The grace covers the
                    # rest of a resume and no more; the daemon still cannot
                    # outlive the pause by anything a player would notice.
                    if warm['gone_at'] is None:
                        warm['gone_at'] = now
                        say(f'warm hold: {warm["flag"]} is gone (a resume is '
                            f'starting); holding {WARM_FLAG_GRACE_S:.0f}s more')
                    elif now - warm['gone_at'] >= WARM_FLAG_GRACE_S:
                        say('warm hold: the pause is over and nobody came '
                            'for the frame; retiring')
                        break
            wait_ms = min(POLL_MS, int(left * 1000) + 1)
            if overlay.spin:
                if now >= next_spin:
                    overlay.spin_tick()
                    if overlay.spin:
                        # Advance the SCHEDULE, not "now + period". Restarting
                        # the clock from `now` adds the whole of this tick's
                        # lateness to every subsequent one, so the cadence
                        # drifts long and uneven - which reads as judder, and
                        # was doing so on top of the old 12fps. Only if we are
                        # more than a frame behind (a stall, not jitter) do we
                        # give up on the missed slots and resynchronise, so a
                        # hiccup cannot make the spinner sprint to catch up.
                        period = overlay.spin['period']
                        next_spin += period
                        if next_spin < now:
                            next_spin = now + period
                    else:
                        next_spin = now + 3600
                wait_ms = max(1, min(wait_ms,
                                     int((next_spin - now) * 1000) + 1))
            for _fd, _mask in poller.poll(wait_ms):
                try:
                    chunk = os.read(rfd, 4096)
                except OSError:
                    chunk = b''
                if not chunk:
                    continue
                buf += chunk
                while b'\n' in buf:
                    line, buf = buf.split(b'\n', 1)
                    action, deadline, timeout = handle(
                        overlay, line.decode('utf-8', 'replace').strip(),
                        deadline, timeout, warm)
                    if action == 'fade':
                        faded = True
                    if action in ('fade', 'stop'):
                        STOPPING['now'] = True
                        break
    finally:
        for fd in (rfd, wfd):
            if fd is not None:
                try:
                    os.close(fd)
                except OSError:
                    pass
    if faded:
        say('faded out')
    return 0


def handle(overlay, line, deadline, timeout, warm):
    """Returns (action, deadline, timeout). action is '' (carry on), 'stop',
    'fade', or 'hold' (fade done, staying warm). `warm` is the loop's
    warm-state dict; show leaves it, `fade ... hold` enters it."""
    try:
        parts = shlex.split(line)
    except ValueError:
        parts = line.split()
    if not parts:
        return '', deadline, timeout
    cmd, args = parts[0], parts[1:]
    try:
        if cmd == 'show':
            # Same window, new watchdog. The re-raise matters as much as the
            # image: something may have stacked over us since. The same
            # UNCHANGED picture is the warm path - the pixmap is already on
            # the server, so this is a map+raise, no decode and no upload.
            if not overlay.image_matches(args[0]):
                overlay.set_image(args[0])
            overlay.show()
            fresh = None
            if len(args) > 1:
                fresh = float(args[1])
            elif warm['on']:
                # A mapped curtain must never inherit the warm hold's long
                # bound: a show with no explicit timeout gets the default.
                fresh = DEFAULT_TIMEOUT
            if fresh is not None:
                timeout = fresh
                deadline = time.monotonic() + fresh
                arm_watchdog(fresh)
            warm['on'] = False
            write_status(overlay, deadline)
            return '', deadline, timeout
        if cmd == 'fade':
            duration = float(args[0]) if args else DEFAULT_FADE
            # Never fade past the watchdog: the deadline is the promise, the
            # dissolve is the decoration.
            duration = max(0.0, min(duration,
                                    deadline - time.monotonic() - 0.05))
            overlay.fade(duration, stop=lambda: STOPPING['now'])
            if len(args) > 1 and args[1] == 'hold' and not STOPPING['now']:
                # Enter the warm hold: unmapped, pixmap kept, three bounds
                # (flag gone / idle cap / SIGALRM at the cap) per the header.
                bound = float(args[2]) if len(args) > 2 else WARM_IDLE_MAX
                bound = max(1.0, bound)
                warm.update(on=True,
                            flag=args[3] if len(args) > 3 else HOLD_FLAG,
                            next_check=0.0)
                overlay.spin = None        # the spinner dies with the map
                deadline = time.monotonic() + bound
                timeout = bound
                arm_watchdog(bound)
                write_status(overlay, deadline, warm=True)
                say(f'faded to warm hold ({overlay.image}); retiring when '
                    f'{warm["flag"]} goes, or in {bound:.0f}s')
                return 'hold', deadline, timeout
            return 'fade', deadline, timeout
        if cmd == 'clear':
            return 'stop', deadline, timeout
        if cmd == 'status':
            write_status(overlay, deadline, warm=warm['on'])
            return '', deadline, timeout
        if cmd == 'quit':
            return 'stop', deadline, timeout
        say(f'bad command: {line}')
    except CurtainError as e:
        # A replacement image that will not load leaves the CURRENT frame up
        # rather than tearing the curtain down mid-transition.
        say(f'{cmd}: {e}')
    except (IndexError, ValueError) as e:
        say(f'bad command: {line} ({e})')
    return '', deadline, timeout


