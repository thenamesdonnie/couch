def cmd_extract(args) -> None:
    out = BUILD / "orig"
    out.mkdir(parents=True, exist_ok=True)
    manifest = []

    for key, pattern in MAP_TARGETS:
        binder, _, _ = load_map_binder(key)
        for e in binder.entries:
            name = entry_basename(e)
            if not pattern.match(name) or name.endswith("_l.tpf.dcx"):
                continue
            tpf = TPF.from_bytes(dcx_decompress(e.data))
            for t in tpf.textures:
                manifest.append(_record(t, out, source="map", binder=key, entry=e.name,
                                        entry_bytes=len(e.data)))

    binder = load_sfx_binder()
    for e in binder.entries:
        stem = entry_basename(e).removesuffix(".tpf")
        if stem not in SFX_TARGETS:
            continue
        tpf = TPF.from_bytes(e.data)
        for t in tpf.textures:
            manifest.append(_record(t, out, source="sfx", binder="commoneffects", entry=e.name,
                                    entry_bytes=len(e.data), grid=SFX_TARGETS[stem]))

    manifest.sort(key=lambda r: (r["source"], r["name"]))
    (BUILD / "manifest.json").write_text(json.dumps(manifest, indent=2))
    print(f"extracted {len(manifest)} textures to {out}")
    print(f"manifest: {BUILD / 'manifest.json'}")
    _print_table(manifest)


def _record(tex, out: Path, source: str, binder: str, entry: str, entry_bytes: int,
            grid=None) -> dict:
    f = dds_fields(tex.data)
    img = decode(tex.data)
    if img is None:
        raise SystemExit(f"{tex.stem}: cannot decode {f['kind']}")
    img.save(out / f"{tex.stem}.png")
    (out / f"{tex.stem}.dds").write_bytes(tex.data)      # kept: the header we clone

    role = role_of(tex.stem)
    cap = CAP_OVERRIDES.get(tex.stem, DEFAULT_CAP)
    scale = 4
    while scale > 1 and max(f["width"], f["height"]) * scale > cap:
        scale //= 2

    dxgi_out = f["dxgi"]
    tpf_format_out = tex.format
    if f["dxgi"] == DXGI_BC1_UNORM_SRGB:                 # the BC1 -> BC7 upgrade
        dxgi_out, tpf_format_out = DXGI_BC7_UNORM_SRGB, TPF_FORMAT_BC7
    elif f["dxgi"] == DXGI_BC1_UNORM:
        dxgi_out, tpf_format_out = DXGI_BC7_UNORM, TPF_FORMAT_BC7

    return {
        "name": tex.stem, "source": source, "binder": binder, "entry": entry,
        "role": role, "grid": list(grid) if grid else None,
        "width": f["width"], "height": f["height"], "fourcc": f["fourcc"],
        "dxgi": f["dxgi"], "tpf_format": tex.format, "mips": f["mips"],
        "dds_bytes": f["bytes"], "entry_bytes": entry_bytes,
        "scale": scale, "out_width": f["width"] * scale, "out_height": f["height"] * scale,
        "out_dxgi": dxgi_out, "out_tpf_format": tpf_format_out,
        "srgb": f["dxgi"] in (DXGI_BC1_UNORM_SRGB, DXGI_BC7_UNORM_SRGB),
        "skipped": scale == 1,
    }


def _manifest() -> list[dict]:
    p = BUILD / "manifest.json"
    if not p.exists():
        raise SystemExit("no manifest; run `ds3-texup extract` first")
    return json.loads(p.read_text())


def _selected(args) -> list[dict]:
    rows = [r for r in _manifest() if not r["skipped"]]
    if args.only:
        rows = [r for r in rows if args.only in r["name"]]
    if not rows:
        raise SystemExit("nothing selected")
    return rows


def cmd_upscale(args) -> None:
    src, dst = BUILD / "orig", BUILD / "up"
    dst.mkdir(parents=True, exist_ok=True)
    work = BUILD / "work"
    work.mkdir(exist_ok=True)
    notes = {}
    for r in _selected(args):
        out_png = dst / f"{r['name']}.png"
        if out_png.exists() and not args.force:
            print(f"  {r['name']}: have it")
            continue
        img = Image.open(src / f"{r['name']}.png").convert("RGBA")
        t0 = time.time()
        if r["role"] in ("albedo", "sprite"):
            up = ai_upscale(img, tuple(r["grid"]) if r["grid"] else None, work)
            if r["scale"] != 4:                          # 4x then halve: reads more detail
                up = up.resize((r["out_width"], r["out_height"]), Image.LANCZOS)
            note = "AI x4" if r["scale"] == 4 else f"AI x4 then LANCZOS down to x{r['scale']}"
            note += " on RGB" + (", LANCZOS alpha" if r["role"] == "sprite" else "")
            if r["grid"]:
                note += f", per frame {r['grid'][0]}x{r['grid'][1]}"
        else:
            up, clamped = lanczos_upscale(img, r["scale"], r["role"])
            note = f"LANCZOS x{r['scale']}"
            if r["role"] == "normal":
                note += f", {clamped} texels renormalised onto the unit disc"
        up.save(out_png)
        notes[r["name"]] = note
        print(f"  {r['name']}: {r['width']}x{r['height']} -> {up.width}x{up.height}  "
              f"{note}  [{time.time() - t0:.1f}s]")
    if notes:
        p = BUILD / "upscale_notes.json"
        old = json.loads(p.read_text()) if p.exists() else {}
        old.update(notes)
        p.write_text(json.dumps(old, indent=2))
    print(f"upscaled into {dst}")


def _encode_level(img: Image.Image, role: str, quality: int, tmp: Path) -> bytes:
    """One mip level through bc7enc. BC4 for masks (red channel), BC7 otherwise."""
    png = tmp / "level.png"
    dds = tmp / "level.dds"
    for p in (png, dds):
        p.unlink(missing_ok=True)
    if role == "mask":
        a = np.asarray(img.convert("RGBA"))
        Image.fromarray(np.stack([a[..., 0]] * 3, axis=2), "RGB").save(png)
        cmd = [str(BC7ENC), "-4", "-f", "-g", "-q", "-o", str(png)]
    else:
        img.convert("RGBA").save(png)
        cmd = [str(BC7ENC), "-U", f"-u{quality}", "-g", "-q", "-o", str(png)]
    _run(cmd)
    if not dds.exists():
        raise SystemExit(f"bc7enc wrote no DDS for a {img.size} level")
    d = dds.read_bytes()
    _, _, _, off = dds_describe(d)
    return d[off:]


def cmd_encode(args) -> None:
    src, orig, dst = BUILD / "up", BUILD / "orig", BUILD / "dds"
    dst.mkdir(parents=True, exist_ok=True)
    results = {}
    old = json.loads((BUILD / "psnr.json").read_text()) if (BUILD / "psnr.json").exists() else {}
    for r in _selected(args):
        out = dst / f"{r['name']}.dds"
        if out.exists() and not args.force:
            print(f"  {r['name']}: have it")
            continue
        up = Image.open(src / f"{r['name']}.png").convert("RGBA")
        original = (orig / f"{r['name']}.dds").read_bytes()
        t0 = time.time()
        with tempfile.TemporaryDirectory(prefix="texup-") as td:
            tmp = Path(td)
            levels = [_encode_level(im, r["role"], args.quality, tmp)
                      for im in mip_chain(up, srgb=r["srgb"])]
        d = rebuild_dds(original, up.width, up.height, levels,
                        dxgi_override=r["out_dxgi"] if r["out_dxgi"] != r["dxgi"] else None)

        # Read-back proof: decode the finished bytes and score them against the
        # PNG they were made from. A silent bad encode looks exactly like a good
        # one until the game shows a black tile.
        back = decode(d)
        if back is None or back.size != (up.width, up.height):
            raise SystemExit(f"{r['name']}: finished DDS does not decode back")
        a, b = np.asarray(up).astype(float), np.asarray(back).astype(float)
        chans = [0] if r["role"] == "mask" else [0, 1, 2, 3]
        mse = ((a[..., chans] - b[..., chans]) ** 2).mean()
        psnr = float("inf") if mse == 0 else 10 * np.log10(255.0 * 255.0 / mse)
        out.write_bytes(d)
        results[r["name"]] = round(psnr, 2)
        print(f"  {r['name']}: {up.width}x{up.height} {len(levels)} mips  "
              f"{len(d):,}B  PSNR {psnr:.2f} dB  [{time.time() - t0:.1f}s]")
    old.update(results)
    (BUILD / "psnr.json").write_text(json.dumps(old, indent=2))
    if old:
        vals = list(old.values())
        print(f"round-trip PSNR: min {min(vals):.2f}  median {sorted(vals)[len(vals) // 2]:.2f}  "
              f"max {max(vals):.2f} dB over {len(vals)} textures")


def cmd_pack(args) -> None:
    """Patch the shipped binders IN PLACE and prove, byte by byte, what moved.

    The first build of this tool re-SERIALISED the binders with soulstruct and
    the game rendered Archdragon Peak with the wrong textures on the arch,
    pillars and floor, white geometry chunks, and the fog as solid white slabs,
    while soulstruct happily reloaded the same files. The cause was found with
    the reader in this file: BND4's hash table stores `path_hashes_offset` as an
    ABSOLUTE file offset, and a re-serialised BHD came out 2 bytes shorter (the
    UTF-16 name block packs slightly differently), so the table moved to 23030
    while its own header still pointed at 23032. Every path the engine looked up
    read the hash array 2 bytes skewed, and the last pair ran off the end of the
    file. soulstruct never noticed because it finds entries by walking the record
    array and only ever copies the hash table as opaque bytes.

    So: nothing is re-serialised. New payloads are appended to the end, only the
    replaced entries' own size and offset fields are rewritten, and every other
    byte of both files stays where it was.

    Two outputs, deliberately separate, so a capture can blame one of them:
        mod-map/map/m32/...   the cloud sea and sky
        mod-sfx/sfx/...       the fog sprites

    MERGING OTHER PACKS (`--base-dir`, `--inject`, `--out-name`).

    ModEngine2's mod loader is FIRST MATCH WINS on whole files, so three mods that
    each ship a full `map/m32/m32_0000.tpfbhd` do not layer: the first one in the
    list shadows the other two completely. Ours was first, so the Texture
    Improvement 4K stone and Visual Overhaul's reflectance maps were both dead in
    that map. The fix is one binder that carries all three sets of entries.

        --base-dir DIR   start from this pack's binders instead of the archive
                         originals. The base supplies the CONTAINER as well as
                         the bytes: header, name block, hash table and every
                         record we do not replace stay exactly where the base put
                         them, so the base's hash table remains valid.
        --inject DIR     take every entry in DIR's binders whose payload differs
                         from the game original, and patch it into the base.
                         Repeatable; later ones win over earlier ones. ONLY THE
                         ENTRY DATA is taken, never the container.
        --out-name NAME  the build subdirectory (default mod-map / mod-sfx).
        --skip-sfx       map binders only.

    Precedence is base, then each --inject in order, then our own upscales, and
    every override is printed with where it came from.
    """
    dds_dir = BUILD / "dds"
    rows = [r for r in _manifest() if not r["skipped"]]
    have = {r["name"]: r for r in rows if (dds_dir / f"{r['name']}.dds").exists()}
    if args.only:
        have = {k: v for k, v in have.items() if args.only in k}
    if not have:
        raise SystemExit("no encoded DDS files; run `ds3-texup encode` first")

    base_root = Path(args.base_dir).expanduser() if args.base_dir else None
    inject_roots = [Path(p).expanduser() for p in (args.inject or [])]
    map_out = BUILD / (args.out_name or "mod-map")
    shutil.rmtree(BUILD / "mod", ignore_errors=True)          # the broken rewrite
    if not args.only:
        # a full build owns its output directory, so stale binders from an
        # earlier merge cannot survive into it. A --only build touches one
        # binder and must NOT delete the siblings it is not rebuilding.
        shutil.rmtree(map_out, ignore_errors=True)
    written = []

    for key in MAP_BINDERS:
        picked = {r["entry"]: r for r in have.values()
                  if r["source"] == "map" and r["binder"] == key}
        if not picked and not inject_roots and not base_root:
            continue

        orig_bhd = dvd().get(MAP_BINDERS[key] + ".tpfbhd")
        orig_bdt = dvd().get(MAP_BINDERS[key] + ".tpfbdt")
        orig = entries_by_name(orig_bhd)

        if base_root is not None:
            found = find_pack_binder(base_root, key)
            if found is None:
                raise SystemExit(f"{base_root}: no {key}.tpfbhd/.tpfbdt")
            base_bhd_path, base_bdt_path = found
            base_bhd = base_bhd_path.read_bytes()
            base_changed = len(injected_payloads(base_root, key, orig_bhd, orig_bdt))
        else:
            base_bhd_path = base_bdt_path = None
            base_bhd = orig_bhd
            base_changed = 0
        base = entries_by_name(base_bhd)

        # base -> each --inject in order -> our own upscales
        payloads: dict[str, bytes] = {}
        provenance: dict[str, str] = {}
        counts = []
        for root in inject_roots:
            got = injected_payloads(root, key, orig_bhd, orig_bdt)
            counts.append((root.name, len(got)))
            for name, data in got.items():
                payloads[name] = data
                provenance[name] = root.name
        for name, r in picked.items():
            cur = payloads.get(name)
            if cur is None:
                e = base[name]
                cur = (read_payload(base_bdt_path, e) if base_bdt_path is not None
                       else orig_bdt[e["off"]:e["off"] + e["csize"]])
            tpf = TPF.from_bytes(dcx_decompress(cur))
            _swap(tpf, r, dds_dir)
            if name in provenance:
                print(f"    note: {name} was also changed by {provenance[name]}; ours wins")
            payloads[name] = dcx_compress_dflt(tpf.to_bytes())
            provenance[name] = "ours"
        if not payloads and base_root is None:
            continue

        dest_bhd = map_out / f"map/m32/{key}.tpfbhd"
        dest_bdt = map_out / f"map/m32/{key}.tpfbdt"
        dest_bhd.parent.mkdir(parents=True, exist_ok=True)
        if base_bdt_path is not None:
            shutil.copyfile(base_bdt_path, dest_bdt)          # streamed, not slurped
        else:
            dest_bdt.write_bytes(orig_bdt)
        base_bdt_len = dest_bdt.stat().st_size
        base_bdt_sha = sha_file(dest_bdt)

        out_bhd = bytearray(base_bhd)
        sink = FileAppender(dest_bdt)
        try:
            changes = patch_entries_in_place(out_bhd, sink, payloads)
        finally:
            sink.close()
        dest_bhd.write_bytes(bytes(out_bhd))

        written.append(dict(kind="bxf4", key=key, bhd=dest_bhd, bdt=dest_bdt,
                            orig_bhd=base_bhd, base_bdt_len=base_bdt_len,
                            base_bdt_sha=base_bdt_sha, changes=changes,
                            names=set(payloads), payloads=payloads,
                            provenance=provenance))
        added = sum(len(v) for v in payloads.values())
        src = f"{base_root.name} ({base_changed} entries changed vs the archive)" \
            if base_root else "the archive original"
        tally = ", ".join(f"{n} {c}" for n, c in counts) or "none"
        print(f"  {key}: base {src}, {len(base)} entries; injected {tally}; "
              f"ours {sum(1 for v in provenance.values() if v == 'ours')}")
        print(f"    {len(payloads)} entries patched in place, "
              f"bhd {len(base_bhd):,} -> {len(out_bhd):,} bytes (equal: "
              f"{len(base_bhd) == len(out_bhd)}), "
              f"bdt {base_bdt_len:,} -> {dest_bdt.stat().st_size:,} "
              f"({added:,} appended + {sum(c['pad'] for c in changes)} alignment bytes; "
              f"{sum(c['old_size'] for c in changes):,} of the base is now dead space)")

    picked = [r for r in have.values() if r["source"] == "sfx"]
    if picked and not args.skip_sfx:
        raw = dvd().get(SFX_BINDER)
        plain = dcx_decompress(raw)
        binder = Binder.from_bytes(plain)
        payloads = {}
        for e in binder.entries:
            r = {x["entry"]: x for x in picked}.get(e.name)
            if r is None:
                continue
            tpf = TPF.from_bytes(e.data)
            _swap(tpf, r, dds_dir)
            payloads[e.name] = tpf.to_bytes()
        new_plain, changes = patch_bnd4(plain, payloads)
        dest = BUILD / "mod-sfx/sfx/frpg_sfxbnd_commoneffects_resource.ffxbnd.dcx"
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_bytes(dcx_compress_dflt(new_plain))
        written.append(dict(kind="bnd4", key="commoneffects", bhd=dest, bdt=None,
                            orig_bhd=plain, orig_bdt=None, changes=changes,
                            names=set(payloads), payloads=payloads,
                            provenance={n: "ours" for n in payloads}, plain=new_plain))
        print(f"  commoneffects: {len(payloads)} entries patched in place, "
              f"{len(plain):,} -> {len(new_plain):,} bytes uncompressed, "
              f"{dest.stat().st_size:,} DFLT-compressed")

    _verify(written, have)
    print("\ncopy commands (nothing has been deployed):")
    cmd_deploy_cmds(args)


def _swap(tpf: TPF, r: dict, dds_dir: Path) -> None:
    tex = next(t for t in tpf.textures if t.stem == r["name"])
    d = (dds_dir / f"{r['name']}.dds").read_bytes()
    f = dds_fields(d)
    tex.data = d
    tex.format = r["out_tpf_format"]
    tex.mipmap_count = f["mips"]


def _verify(written: list, have: dict[str, dict]) -> None:
    """Prove it with our own reader, not with the library that wrote it.

    The old proof (soulstruct reloads the file) is exactly the proof that passed
    while the game was rendering garbage, so it is worth nothing on its own. What
    is checked here: the BHD is the same length, the header, name block and hash
    table are untouched, the hash table's absolute offset still lands on its own
    data, every record we did not replace is byte-identical, and the ranges that
    DID change are listed and confirmed to be inside a replaced entry's record.

    "the original" here means THE BASE: the archive binder for a plain build, the
    `--base-dir` pack's binder for a merge. Everything the base did stays put and
    the merge only adds. The BDT is compared by streamed sha256 over its first
    `base_bdt_len` bytes rather than by loading it, because a Texture Improvement
    base BDT is 1.46 GB and holding two copies of that to run `==` is how a
    verification step becomes the reason a build cannot run.
    """
    for w in written:
        print(f"\n=== {w['bhd'].name} ===")
        if w["kind"] == "bxf4":
            new_bhd = w["bhd"].read_bytes()
            new_bdt = w["bdt"]                 # a Path: read by seek, never slurped
            old_bhd = w["orig_bhd"]
        else:
            new_bhd = w["plain"]
            new_bdt = None
            old_bhd = w["orig_bhd"]

        if len(new_bhd) != len(old_bhd) and w["kind"] == "bxf4":
            raise SystemExit("BHD length changed; the hash table would move")
        before = {e["name"]: e for e in bnd4_entries(old_bhd)}
        after = {e["name"]: e for e in bnd4_entries(new_bhd)}
        ho, hn = hash_table_info(old_bhd), hash_table_info(new_bhd)

        # 1. header, name block and hash table must not have moved or changed
        ent_end = _ENTRIES_START + len(before) * ENTRY_RECORD_SIZE
        tail_ok = old_bhd[ent_end:ho["offset"]] == new_bhd[ent_end:hn["offset"]]
        table_end = ho["path_hashes_offset"] + ho["hash_count"] * 8
        print(f"  header 0x00..0x40 identical: {old_bhd[:0x40] == new_bhd[:0x40]}")
        print(f"  name block identical and in place: {tail_ok}")
        print(f"  hash table at {hn['offset']:#x} (was {ho['offset']:#x}), "
              f"bytes identical: {old_bhd[ho['offset']:table_end] == new_bhd[hn['offset']:table_end]}")
        print(f"  path_hashes_offset {hn['path_hashes_offset']} vs groups end {hn['groups_end']}: "
              f"{'STALE, THIS IS THE BUG' if hn['stale'] else 'consistent'}; "
              f"overruns the file: {hn['overruns']}")
        if hn["stale"] or hn["overruns"]:
            raise SystemExit("hash table is not valid in the output")

        # the check that would have caught the first build: resolve every record
        cb = check_hash_table(old_bhd, list(before.values()))
        ca = check_hash_table(new_bhd, list(after.values()))
        print(f"  path hashes that resolve to the right entry: "
              f"before {cb['ok']}/{cb['ok'] + cb['bad']}, after {ca['ok']}/{ca['ok'] + ca['bad']}")
        if ca["bad"]:
            raise SystemExit(f"{ca['bad']} path hashes resolve to the wrong entry")

        # 16-byte data alignment, the second thing the re-serialised build broke
        # (228/245 offsets were misaligned there, against 245/245 in the vanilla file)
        al_b = sum(1 for e in before.values() if e["off"] % BDT_ALIGN == 0)
        al_a = sum(1 for e in after.values() if e["off"] % BDT_ALIGN == 0)
        print(f"  entry data 16-byte aligned: before {al_b}/{len(before)}, "
              f"after {al_a}/{len(after)}")
        if al_a != len(after):
            raise SystemExit("an entry is not 16-byte aligned")

        # 2. records: only the replaced ones may differ, and only in 3 fields
        untouched = [n for n in before if n not in w["names"]]
        same = sum(before[n]["raw"] == after[n]["raw"] for n in untouched)
        print(f"  untouched entry records byte-identical: {same}/{len(untouched)}")
        if same != len(untouched):
            raise SystemExit("an untouched record changed")
        # the entry table, read with our own reader, for everything we touched
        # plus three untouched neighbours. There are no sha or aes fields in a
        # BXF4 record: per-entry keys and hashed ranges are a BHD5 feature and
        # these binders are not BHD5. The record is exactly the seven fields below.
        touched_idx = sorted(after[n]["i"] for n in w["names"])
        neighbours = []
        for i in touched_idx:
            for j in (i - 1, i + 1):
                if 0 <= j < len(after) and j not in touched_idx and j not in neighbours:
                    neighbours.append(j)
        by_index = {e["i"]: e for e in after.values()}
        old_by_index = {e["i"]: e for e in before.values()}
        # A merge replaces 100+ entries per binder, so the full before/after table
        # is a wall. Show one sample from each provenance plus three untouched
        # neighbours; the byte proofs below cover all of them.
        prov = w.get("provenance", {})
        sample_idx, seen = [], set()
        for n in sorted(w["names"], key=lambda n: after[n]["i"]):
            src = prov.get(n, "?")
            if src not in seen or len(sample_idx) < 3:
                seen.add(src)
                sample_idx.append(after[n]["i"])
        show = sorted(set(sample_idx) | set(neighbours[:3]))
        print(f"\n  entry table, our own reader, {len(sample_idx)} of {len(touched_idx)} "
              f"touched + {min(3, len(neighbours))} untouched neighbours:")
        print(f"    {'idx':>4} {'id':>7} {'name':38s} {'flags':>5} {'csize':>12} "
              f"{'usize':>12} {'offset':>12}  state")
        for i in show:
            b, a = old_by_index[i], by_index[i]
            tag = f"REPLACED from {prov.get(a['name'], '?')}" if a["name"] in w["names"] else (
                "identical" if b["raw"] == a["raw"] else "CHANGED (must not happen)")
            for lbl, e in (("before", b), ("after ", a)):
                print(f"    {e['i']:>4} {e['id']:>7} "
                      f"{e['name'].rsplit(chr(92), 1)[-1][:38]:38s} {e['flags']:#05x} "
                      f"{e['csize']:>12,} {e['usize']:>12,} {e['off']:>12,}  {lbl} {tag}")

        # 3. the byte diff of the BHD, as ranges
        ranges = diff_ranges(old_bhd, new_bhd)
        appended = 0
        if w["kind"] == "bnd4" and ranges and ranges[-1][0] == len(old_bhd):
            # a single-file BND4 grows in the same buffer the records live in, so
            # the final range IS the appended payload, not a corrupted record
            appended = ranges[-1][1] - ranges[-1][0]
            ranges = ranges[:-1]
        recs = {(e["rec"], e["rec"] + ENTRY_RECORD_SIZE) for e in after.values()
                if e["name"] in w["names"]}
        outside = [r for r in ranges if not any(lo <= r[0] and r[1] <= hi for lo, hi in recs)]
        print(f"  byte-diff over the original {len(old_bhd):,} bytes: {len(ranges)} ranges, "
              f"all inside a replaced entry's record: {not outside}"
              + (f"; {appended:,} bytes appended after them" if appended else ""))
        if outside:
            raise SystemExit(f"BHD changed outside a replaced record: {outside[:5]}")
        shown = sorted(ranges)[:4]
        print("    first ranges: " + ", ".join(f"{lo}..{hi}" for lo, hi in shown))

        # 4. the BDT: untouched prefix must be byte-identical, growth is append-only
        if new_bdt is not None:
            base_len, base_sha = w["base_bdt_len"], w["base_bdt_sha"]
            got = sha_file(new_bdt, base_len)
            print(f"  BDT first {base_len:,} bytes identical to the base "
                  f"(sha256 {base_sha[:16]}): {got == base_sha}")
            if got != base_sha:
                raise SystemExit("the BDT prefix changed")
            print(f"  BDT grew by {new_bdt.stat().st_size - base_len:,} bytes, all appended")

        # 5. every replaced payload reads back byte-for-byte out of the finished
        #    file at the offset its own record now points at, and our own textures
        #    decode at their new size. The byte-equality half is what proves a
        #    MERGE: an injected entry has no manifest row to decode against, and
        #    "the bytes we handed in are the bytes at that offset" is the whole
        #    claim being made about it.
        reader = None if new_bdt is None else open(new_bdt, "rb")
        n = mismatched = 0
        try:
            for name in sorted(w["names"]):
                e = after[name]
                if reader is not None:
                    reader.seek(e["off"])
                    raw = reader.read(e["csize"])
                else:
                    raw = new_bhd[e["off"]:e["off"] + e["csize"]]
                if raw != w["payloads"][name]:
                    mismatched += 1
                    continue
                if w["provenance"].get(name) != "ours":
                    continue
                tpf = TPF.from_bytes(dcx_decompress(raw) if raw[:4] == b"DCX\0" else raw)
                for t in tpf.textures:
                    r = have.get(t.stem)
                    if r is None:
                        continue
                    img = decode(t.data)
                    if img is None or img.size != (r["out_width"], r["out_height"]):
                        raise SystemExit(
                            f"{t.stem} does not decode at {r['out_width']}x{r['out_height']}")
                    n += 1
        finally:
            if reader is not None:
                reader.close()
        print(f"  replaced payloads that read back byte-identical: "
              f"{len(w['names']) - mismatched}/{len(w['names'])}")
        if mismatched:
            raise SystemExit(f"{mismatched} replaced payloads do not match what was written")
        print(f"  {n} of our own textures read straight out of the patched bytes and decode")


def cmd_preview(args) -> None:
    """Original vs upscaled at 1:1, so the difference is looked at, not asserted.

    1:1 means one output pixel per screen pixel on BOTH sides, with the original
    scaled up by nearest neighbour to the same crop extent. Anything else is a
    picture of a resampler, not of the upscale.
    """
    rows = {r["name"]: r for r in _manifest()}
    wanted = args.names or ["m32_00_kumo_20_a", "s11630", "m32_00_stormsky_03_a"]
    for name in wanted:
        r = rows.get(name)
        if r is None or r["skipped"]:
            print(f"  {name}: not in the manifest, skipped")
            continue
        up_path = BUILD / "up" / f"{name}.png"
        if not up_path.exists():
            print(f"  {name}: not upscaled yet")
            continue
        orig = Image.open(BUILD / "orig" / f"{name}.png").convert("RGBA")
        up = Image.open(up_path).convert("RGBA")
        s = up.width // orig.width
        crop = min(512, up.width, up.height)
        # Centre the crop on the busiest 256px of the ORIGINAL, so the panel is
        # never a flat patch of sky that proves nothing.
        a = np.asarray(orig.convert("L")).astype(float)
        step = max(1, orig.width // 32)
        best, bx, by = -1.0, 0, 0
        cs = crop // s
        for y in range(0, max(1, orig.height - cs), step):
            for x in range(0, max(1, orig.width - cs), step):
                v = a[y:y + cs, x:x + cs].std()
                if v > best:
                    best, bx, by = v, x, y
        o = orig.crop((bx, by, bx + cs, by + cs)).resize((crop, crop), Image.NEAREST)
        u = up.crop((bx * s, by * s, bx * s + crop, by * s + crop))
        _preview_sheet(name, r, o, u, BUILD / f"preview_{name}.png")


def _preview_sheet(name: str, r: dict, left: Image.Image, right: Image.Image, path: Path) -> None:
    from PIL import ImageDraw

    pad, label = 12, 26
    bg = (58, 58, 64)
    w = pad * 3 + left.width + right.width
    h = pad * 2 + label * 2 + left.height
    sheet = Image.new("RGB", (w, h), bg)
    for i, im in enumerate((left, right)):
        tile = Image.new("RGBA", im.size, (*bg, 255))
        tile.alpha_composite(im)
        sheet.paste(tile.convert("RGB"), (pad + i * (left.width + pad), pad + label))
    d = ImageDraw.Draw(sheet)
    d.text((pad, pad // 2), f"{name}  ({r['role']}, {r['fourcc']}/dxgi {r['dxgi']} "
                            f"-> dxgi {r['out_dxgi']})", fill=(235, 235, 240))
    d.text((pad, pad + label + left.height + 4),
           f"original {r['width']}x{r['height']}, shown nearest-neighbour at 1:1",
           fill=(215, 215, 222))
    d.text((pad * 2 + left.width, pad + label + left.height + 4),
           f"upscaled {r['out_width']}x{r['out_height']}, 1:1", fill=(215, 215, 222))
    sheet.save(path)
    print(f"  {path}  ({sheet.width}x{sheet.height})")


def cmd_seamcheck(args) -> None:
    """Prove per-frame upscaling does not bleed across a flipbook frame boundary.

    Runs the same sheet twice, whole and per frame, and reports the absolute
    difference as a function of distance from a frame edge. If the whole-sheet
    pass were dragging neighbouring frames together, the difference would spike
    at distance 0 and decay. Measured on s11630, 3 Sep 2026: 1.31 at the edge
    against 1.14 at 256 px in, and the ALPHA channel bit-identical at every seam
    column, i.e. no bleed on this sheet at all.
    """
    name = args.name or "s11630"
    r = next((x for x in _manifest() if x["name"] == name), None)
    if r is None:
        raise SystemExit(f"{name} is not in the manifest")
    img = Image.open(BUILD / "orig" / f"{name}.png").convert("RGBA")
    work = BUILD / "work"
    work.mkdir(parents=True, exist_ok=True)
    whole = np.asarray(ai_upscale(img, None, work)).astype(int)
    grid = tuple(r["grid"]) if r["grid"] else None
    if grid is None:
        print(f"{name} has no integer frame grid; only the whole-sheet pass exists")
        return
    per = np.asarray(ai_upscale(img, grid, work)).astype(int)
    cols, rows_n = grid
    cw = img.width // cols * 4
    d = np.abs(whole - per)
    print(f"{name}: whole-sheet vs per-frame ({cols}x{rows_n} frames, {cw} px each after 4x)")
    for off in (0, 1, 2, 4, 8, 16, 32, 64, cw // 4, cw // 2):
        idx = [(c * cw + off) % whole.shape[1] for c in range(cols)]
        rgba = d[:, idx].max(axis=2)
        alpha = d[:, idx, 3]
        print(f"  {off:4d} px from a frame edge: rgba mean {rgba.mean():5.2f} max {rgba.max():3d}"
              f" | alpha mean {alpha.mean():5.2f} max {alpha.max():3d}")
    print(f"  whole-image mean |difference| {d.max(axis=2).mean():.2f}/255")


def cmd_report(args) -> None:
    _print_table(_manifest())


def _print_table(manifest: list[dict]) -> None:
    psnr = json.loads((BUILD / "psnr.json").read_text()) if (BUILD / "psnr.json").exists() else {}
    notes = (json.loads((BUILD / "upscale_notes.json").read_text())
             if (BUILD / "upscale_notes.json").exists() else {})
    print(f"\n{'texture':24s} {'role':7s} {'from':>11s} {'fmt':>16s}  "
          f"{'to':>11s} {'fmt':>16s} {'PSNR':>7s}  method")
    print("-" * 122)
    for r in sorted(manifest, key=lambda x: (x["source"], x["name"])):
        fro = f"{r['width']}x{r['height']}"
        to = "(skipped)" if r["skipped"] else f"{r['out_width']}x{r['out_height']}"
        f_in = f"{r['fourcc']}/dxgi{r['dxgi']}" if r["dxgi"] else r["fourcc"]
        f_out = "-" if r["skipped"] else (f"{r['fourcc']}/dxgi{r['out_dxgi']}"
                                          if r["dxgi"] else r["fourcc"])
        p = psnr.get(r["name"])
        print(f"{r['name']:24s} {r['role']:7s} {fro:>11s} {f_in:>16s}  {to:>11s} {f_out:>16s} "
              f"{(f'{p:.2f}' if p else '-'):>7s}  {notes.get(r['name'], '')}")
    n_skip = sum(1 for r in manifest if r["skipped"])
    print(f"\n{len(manifest)} textures, {n_skip} already at the cap and skipped")


def cmd_check(args) -> None:
    """Structurally check ANY BND4/BXF4 with our own reader. `check <bhd> [bdt]`.

    Deliberately usable on files this tool did not make, so a known-good binder
    can be used as a control. Run it on the shipped m32_0000 and on the Nexus
    Texture Improvement pack's rebuilt copy: both pass, which is what makes a
    pass on our own output mean something.
    """
    if not args.names:
        raise SystemExit("usage: ds3-texup check <file.tpfbhd|file.ffxbnd.dcx> [file.tpfbdt]")
    path = Path(args.names[0])
    d = path.read_bytes()
    if d[:4] == b"DCX\0":
        d = dcx_decompress(d)
    entries = bnd4_entries(d)
    info = hash_table_info(d)
    chk = check_hash_table(d, entries)
    aligned = sum(1 for e in entries if e["off"] % BDT_ALIGN == 0)
    print(f"{path.name}: {d[:4].decode()} {len(d):,} bytes, {len(entries)} entries, "
          f"record size {ENTRY_RECORD_SIZE:#x}")
    if info is None:
        print("  no hash table (hash_table_offset is 0)")
    else:
        print(f"  hash table @{info['offset']:#x}: {info['group_count']} groups, "
              f"{info['hash_count']} path hashes")
        print(f"  path_hashes_offset {info['path_hashes_offset']} vs groups end "
              f"{info['groups_end']}: {'STALE' if info['stale'] else 'consistent'}, "
              f"overruns file: {info['overruns']}")
        print(f"  path hashes resolving to the right entry: {chk['ok']}/"
              f"{chk['ok'] + chk['bad']}")
    print(f"  entry data 16-byte aligned: {aligned}/{len(entries)}")
    bad = (info is not None and (info["stale"] or info["overruns"] or chk["bad"])) \
        or aligned != len(entries)
    if len(args.names) > 1:
        # size only, never the bytes: a merged BDT is 1.5 GB and the question here
        # is whether any record points past the end of it
        bdt_len = Path(args.names[1]).stat().st_size
        over = [e["name"] for e in entries if e["off"] + e["csize"] > bdt_len]
        print(f"  entries whose data runs past the end of {Path(args.names[1]).name} "
              f"({bdt_len:,} bytes): {len(over)}")
        bad = bad or bool(over)
    print("  VERDICT:", "BROKEN" if bad else "structurally sound")
    return 1 if bad else 0


def cmd_deploy_cmds(args) -> None:
    """Print the copies for each test output separately. Deploys nothing.

    They are separate on purpose: after a build that broke the map, "which half
    breaks it" is a question a capture can answer only if the halves ship alone.
    """
    wanted = [(getattr(args, "out_name", None) or "mod-map",
               "MAP: the cloud sea, sky and storm strips, plus anything merged in"),
              ("mod-sfx", "SFX ONLY: the ten fog and haze sprites")]
    for name, what in wanted:
        root = BUILD / name
        if not root.exists():
            continue
        print(f"\n  # {what}")
        dirs = sorted({str(DEPLOY / f.parent.relative_to(root))
                       for f in root.rglob("*") if f.is_file()})
        print(f"  mkdir -p {' '.join(dirs)}")
        for f in sorted(root.rglob("*")):
            if f.is_file():
                print(f"  cp {f} {DEPLOY / f.relative_to(root)}")


def cmd_all(args) -> None:
    cmd_extract(args)
    cmd_upscale(args)
    cmd_encode(args)
    cmd_preview(args)
    cmd_pack(args)


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("command", choices=["extract", "upscale", "encode", "pack", "preview",
                                        "seamcheck", "report", "check", "deploy-cmds", "all"])
    ap.add_argument("names", nargs="*",
                    help="preview: which textures to show; check: the binder file(s)")
    ap.add_argument("--only", help="restrict upscale/encode/pack to names containing this")
    ap.add_argument("--force", action="store_true", help="redo work that already has output")
    ap.add_argument("--quality", type=int, default=6, help="bc7e level 0..6 (default 6)")
    ap.add_argument("--name", help="seamcheck: which flipbook (default s11630)")
    ap.add_argument("--base-dir", help="pack: start from this mod's binders instead of "
                                       "the archive originals (its container is kept)")
    ap.add_argument("--inject", action="append", metavar="DIR",
                    help="pack: patch in every entry this mod changed vs the game "
                         "original (entry DATA only, never the container). Repeatable, "
                         "later ones win")
    ap.add_argument("--out-name", help="pack: build subdirectory for the map binders "
                                       "(default mod-map)")
    ap.add_argument("--skip-sfx", action="store_true",
                    help="pack: map binders only, leave the sfx sprite binder alone")
    args = ap.parse_args()

    for tool, what in ((REALESRGAN, "realesrgan-ncnn-vulkan"), (BC7ENC, "bc7enc")):
        if args.command in ("upscale", "encode", "seamcheck", "all") and not tool.exists():
            raise SystemExit(f"{what} not found at {tool}; see the Pipeline section of "
                             "docs/research/ds3-graphics-modernisation-20260903.md")
    BUILD.mkdir(parents=True, exist_ok=True)
    {"extract": cmd_extract, "upscale": cmd_upscale, "encode": cmd_encode, "pack": cmd_pack,
     "preview": cmd_preview, "seamcheck": cmd_seamcheck, "report": cmd_report,
     "check": cmd_check, "deploy-cmds": cmd_deploy_cmds, "all": cmd_all}[args.command](args)


if __name__ == "__main__":
    main()
