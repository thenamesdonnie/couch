def role_of(stem: str) -> str:
    """albedo | normal | mask | sprite, from the name the artists gave it."""
    if stem.startswith("s"):
        return "sprite"
    if stem.endswith("_n"):
        return "normal"
    if stem.endswith("_m"):
        return "mask"
    return "albedo"


