    return entry.name.replace("\\", "/").rsplit("/", 1)[-1]


# BND4 / BXF4 on-disk layout, read off real DS3 files with tools/souls-extract and
# cross-checked against soulstruct's PARSER (never its writer, which cannot write
# these at all). Header, 0x40 bytes:
#   0x00 magic "BND4" or "BHF4"      0x0C uint32 entry_count
#   0x10 int64 header_size (0x40)    0x18 char[8] signature
#   0x20 int64 entry_header_size     0x28 int64 data_offset
#   0x30 u8 unicode, 0x31 u8 flags, 0x32 u8 hash_table_type, 5 pad
#   0x38 int64 hash_table_offset     0x40 entry records
# Entry record, 0x24 bytes for DS3's flags 0x74 (measured: 1+3+4+8+8+4+4+4 = 36):
#   +0x00 u8 flags (0x40 here)       +0x01 pad3      +0x04 int32 = -1
#   +0x08 int64 compressed_size      +0x10 int64 uncompressed_size
#   +0x18 uint32 data_offset         +0x1C int32 entry_id
#   +0x20 uint32 name_offset (UTF-16LE if header byte 0x30 is 1, else Shift-JIS)
# Entry data is 16-BYTE ALIGNED (345/345 offsets in the shipped m32_0000 and
# 349/349 in the commoneffects ffxbnd divide by 16; the gaps between consecutive
# entries run 0..15, i.e. alignment padding and nothing else).
ENTRY_RECORD_SIZE = 0x24
BDT_ALIGN = 16
_OFF_ENTRY_COUNT, _OFF_ENTRY_HEADER_SIZE = 0x0C, 0x20
_OFF_UNICODE, _OFF_HASH_TABLE, _ENTRIES_START = 0x30, 0x38, 0x40
_REC_CSIZE, _REC_USIZE, _REC_DATA_OFFSET, _REC_ID, _REC_NAME = 0x08, 0x10, 0x18, 0x1C, 0x20


def bnd4_entries(d: bytes) -> list[dict]:
    """Parse the entry table of a BND4 or BHF4 with our own reader, no soulstruct.

    HEADER BYTE 0x30 IS THE NAME ENCODING and it is not decoration. FromSoft's
    own binders set it to 1 (UTF-16LE, NUL-NUL terminated), and so does the
    Texture Improvement pack, but DS3 Visual Overhaul's writer sets it to 0 and
    stores single-byte (Shift-JIS) names. Reading a `unicode = 0` binder as
    UTF-16 does not fail, it succeeds with the bytes shifted by one: VO's
    `m32_00_c3010_Angle01_r.tpf.dcx` came back as `㍭弲〰...`, which
    reads as mojibake but is really "m3" "2_" ... one byte out of phase. That
    also made its path-hash table look 0/245 broken, when in fact it resolves
    245/245 once the names are decoded the way its own header says they are.
    """
    if d[:4] not in (b"BND4", b"BHF4"):
        raise SystemExit(f"not a BND4/BHF4: {d[:4]!r}")
    count = struct.unpack_from("<I", d, _OFF_ENTRY_COUNT)[0]
    rec_size = struct.unpack_from("<q", d, _OFF_ENTRY_HEADER_SIZE)[0]
    if rec_size != ENTRY_RECORD_SIZE:
        raise SystemExit(f"entry header size {rec_size:#x} is not the 0x24 layout this tool knows")
    wide = d[_OFF_UNICODE] == 1
    step, term, enc = (2, b"\0\0", "utf-16-le") if wide else (1, b"\0", "shift_jis")
    out = []
    for i in range(count):
        o = _ENTRIES_START + i * rec_size
        name_off = struct.unpack_from("<I", d, o + _REC_NAME)[0]
        e = name_off
        while d[e:e + step] != term:
            e += step
        out.append(dict(
            i=i, rec=o, flags=d[o], csize=struct.unpack_from("<q", d, o + _REC_CSIZE)[0],
            usize=struct.unpack_from("<q", d, o + _REC_USIZE)[0],
            off=struct.unpack_from("<I", d, o + _REC_DATA_OFFSET)[0],
            id=struct.unpack_from("<i", d, o + _REC_ID)[0], name_off=name_off,
            name=d[name_off:e].decode(enc), raw=bytes(d[o:o + rec_size]),
        ))
    return out


def hash_table_info(d: bytes) -> dict | None:
    """The BND4 path-hash table. `path_hashes_offset` is an ABSOLUTE file offset.

    THIS FIELD IS WHY THE FIRST BUILD BROKE THE GAME. Layout, read off a real
    m32_0000.tpfbhd (soulstruct's `HashTableHeader` models a leading 8-byte pad
    that is not there, but it never uses the table to find anything so it never
    notices):
        +0x00 int64  path_hashes_offset   ABSOLUTE, from the start of the FILE
        +0x08 uint32 group_count
        +0x0C int32  unknown = 0x00080810
        +0x10 group_count * (int32 length, int32 first_index)
        then  (uint32 path_hash, int32 ENTRY INDEX) pairs
    The pairs point at entry INDICES, so the table is how the engine turns a
    path into an entry, and it is only valid while both the entry order and the
    table's own file position are untouched.
    """
    off = struct.unpack_from("<q", d, _OFF_HASH_TABLE)[0]
    if off == 0:
        return None
    ph_off = struct.unpack_from("<q", d, off)[0]
    group_count = struct.unpack_from("<I", d, off + 8)[0]
    groups_end = off + 0x10 + group_count * 8
    total = sum(struct.unpack_from("<i", d, off + 0x10 + n * 8)[0] for n in range(group_count))
    return dict(offset=off, path_hashes_offset=ph_off, group_count=group_count,
                groups_end=groups_end, hash_count=total,
                stale=ph_off != groups_end, overruns=ph_off + total * 8 > len(d))


def fs_path_hash(name: str) -> int:
    """FromSoft's binder path hash: lowercase, backslashes to slashes, leading /.

        h = h * 37 + c, over UTF-16 code units, wrapping at 32 bits

    Taken from SoulsFormats' `SFUtil.FromPathHash` and confirmed against 42,548
    records in 100 vanilla DS3 tpfbhd files. NOT soulstruct's version, which is
    `h += i * 37 + ord(c)` with `i` the enumerate index and no lowercasing; that
    is a different function and reproduces nothing, so soulstruct rebuilding a
    hash table would produce a table that resolves every path to the wrong entry.
    """
    t = name.lower().replace("\\", "/")
    if not t.startswith("/"):
        t = "/" + t
    h = 0
    for c in t:
        h = (h * 37 + ord(c)) & 0xFFFFFFFF
    return h


def check_hash_table(d: bytes, entries: list[dict]) -> dict:
    """Resolve every path-hash record and confirm it lands on the right entry.

    This is the check that would have caught the first build in a second. The
    record is (uint32 hash, int32 ENTRY INDEX) and the index is the position in
    the entry-header array, so a table that is stale, shifted, or built from a
    reordered entry list still passes every structural check and still hands the
    engine the wrong texture. Only resolving it catches that.
    """
    info = hash_table_info(d)
    if info is None:
        return dict(present=False)
    ok = bad = 0
    for n in range(info["hash_count"]):
        o = info["path_hashes_offset"] + n * 8
        if o + 8 > len(d):
            bad += 1
            continue
        hv, idx = struct.unpack_from("<Ii", d, o)
        if 0 <= idx < len(entries) and fs_path_hash(entries[idx]["name"]) == hv:
            ok += 1
        else:
            bad += 1
    return dict(present=True, ok=ok, bad=bad, **info)


def patch_entries_in_place(records: bytearray, data: bytearray,
                           new: dict[str, bytes]) -> list[dict]:
    """Append each replacement to `data` and rewrite ONLY its own record fields.

    `records` holds the entry table (the BHD of a split binder), `data` holds the
    payloads (the BDT). For a single-file BND4 they are the SAME bytearray and
    must be passed as the same object, because appending to the file also extends
    the buffer the records live in.

    Nothing moves. The header, the name block, the hash table and every record we
    are not replacing keep their exact bytes and their exact file positions, so
    the hash table's absolute `path_hashes_offset` stays correct by construction.
    The cost is dead space: a replaced entry leaves its old payload behind. That
    is the price of not moving anything, and it is worth paying.
    """
    entries = {e["name"]: e for e in bnd4_entries(bytes(records))}
    changes = []
    for name, payload in new.items():
        e = entries.get(name)
        if e is None:
            raise SystemExit(f"no entry named {name!r}")
        pad = (-len(data)) % BDT_ALIGN
        data += b"\0" * pad
        offset = len(data)
        if offset > 0xFFFFFFFF:
            raise SystemExit(f"{name}: data offset {offset} does not fit the record's uint32")
        data += payload
        before = bytes(records[e["rec"]:e["rec"] + ENTRY_RECORD_SIZE])
        struct.pack_into("<q", records, e["rec"] + _REC_CSIZE, len(payload))
        struct.pack_into("<q", records, e["rec"] + _REC_USIZE, len(payload))
        struct.pack_into("<I", records, e["rec"] + _REC_DATA_OFFSET, offset)
        changes.append(dict(name=name, rec=e["rec"], before=before,
                            after=bytes(records[e["rec"]:e["rec"] + ENTRY_RECORD_SIZE]),
                            old_off=e["off"], new_off=offset, pad=pad,
                            old_size=e["csize"], new_size=len(payload)))
    return changes


def patch_bxf4(bhd: bytes, bdt: bytes, new: dict[str, bytes]) -> tuple[bytes, bytes, list[dict]]:
    """Split binder: records live in the BHD, payloads in the BDT. Two buffers."""
    out_bhd, out_bdt = bytearray(bhd), bytearray(bdt)
    changes = patch_entries_in_place(out_bhd, out_bdt, new)
    return bytes(out_bhd), bytes(out_bdt), changes


class FileAppender:
    """An append-only `data` sink for `patch_entries_in_place`, backed by a file.

    WHY THIS EXISTS: memory. Merging on top of the Texture Improvement pack means
    the base BDTs are 393 MB, 1.46 GB, 1.08 GB and 1.44 GB. The in-memory path
    would hold the source bytes plus a bytearray copy, i.e. about 3 GB resident
    for m32_0001 alone, on a box with other things running. The patcher only ever
    asks `len(data)` and does `data += bytes`, so a file handle satisfies it
    exactly and the base BDT is copied to the destination with `shutil.copyfile`
    (streamed) and then appended to in place. Nothing changes about the algorithm:
    payloads still go on the end, 16-byte aligned, and no existing byte moves.
    """

    def __init__(self, path: Path):
        self.path = path
        self.f = open(path, "r+b")
        self.f.seek(0, os.SEEK_END)
        self.n = self.f.tell()

    def __len__(self) -> int:
        return self.n

    def __iadd__(self, b: bytes) -> "FileAppender":
        self.f.write(b)
        self.n += len(b)
        return self

    def close(self) -> None:
        self.f.flush()
        os.fsync(self.f.fileno())
        self.f.close()


def sha_file(path: Path, length: int | None = None) -> str:
    """sha256 of a file, or of its first `length` bytes. Streamed, 1 MB at a time."""
    h = hashlib.sha256()
    left = length if length is not None else path.stat().st_size
    with open(path, "rb") as f:
        while left > 0:
            chunk = f.read(min(1 << 20, left))
            if not chunk:
                raise SystemExit(f"{path}: wanted {length} bytes, file is shorter")
            h.update(chunk)
            left -= len(chunk)
    return h.hexdigest()


def read_payload(bdt: Path, e: dict) -> bytes:
    """One entry's payload, read by seek. The BDT is never loaded whole."""
    with open(bdt, "rb") as f:
        f.seek(e["off"])
        d = f.read(e["csize"])
    if len(d) != e["csize"]:
        raise SystemExit(f"{bdt.name}: entry {e['name']} runs past the end of the file")
    return d


def find_pack_binder(root: Path, key: str) -> tuple[Path, Path] | None:
    """Locate `<key>.tpfbhd` + `.tpfbdt` in a mod directory, laid out either way.

    Accepts the pack root (`.../staging/ti`, which holds `map/m32/...`) or the
    binder directory itself, because the Nexus packs and our own build tree
    disagree about which one you point at.
    """
    for cand in (root / "map/m32" / key, root / key):
        bhd, bdt = cand.with_suffix(".tpfbhd"), cand.with_suffix(".tpfbdt")
        if bhd.exists() and bdt.exists():
            return bhd, bdt
    return None


def entries_by_name(bhd: bytes) -> dict[str, dict]:
    return {e["name"]: e for e in bnd4_entries(bhd)}


def injected_payloads(inject_root: Path, key: str, orig_bhd: bytes,
                      orig_bdt: bytes) -> dict[str, bytes]:
    """Every entry in `inject_root`'s binder whose payload differs from the game's.

    WHY DIFF AGAINST THE GAME ORIGINAL rather than trusting a mod's own file
    list: these packs ship FULL binders, all 245/700/626/600 entries, of which
    only a handful are actually edited (Visual Overhaul: 27/82/72/90 `_r`
    reflectance maps). Copying the whole binder would overwrite the base pack's
    work with vanilla bytes. The only honest definition of "what this mod
    changed" is a payload-by-payload comparison with the archive.

    Only the ENTRY DATA is taken. Visual Overhaul's container is never copied:
    its BHD is written by a different tool (single-byte names, 18,080 bytes
    against the shipped 24,992) and the merge keeps the base pack's container
    byte for byte so the base's hash table stays valid by construction.
    """
    found = find_pack_binder(inject_root, key)
    if found is None:
        return {}
    inj_bhd_path, inj_bdt_path = found
    inj_bhd = inj_bhd_path.read_bytes()
    inj = entries_by_name(inj_bhd)
    orig = entries_by_name(orig_bhd)
    missing = set(orig) - set(inj)
    if missing:
        raise SystemExit(f"{inj_bhd_path}: {len(missing)} entries the game has are absent, "
                         f"e.g. {sorted(missing)[:3]}")
    out = {}
    with open(inj_bdt_path, "rb") as fi:
        for name, oe in orig.items():
            ie = inj[name]
            a = orig_bdt[oe["off"]:oe["off"] + oe["csize"]]
            fi.seek(ie["off"])
            b = fi.read(ie["csize"])
            if len(b) != ie["csize"]:
                raise SystemExit(f"{inj_bdt_path.name}: {name} runs past the end of the file")
            if a != b:
                out[name] = b
    return out


def patch_bnd4(data: bytes, new: dict[str, bytes]) -> tuple[bytes, list[dict]]:
    """Single-file binder: records and payloads share one buffer, so pass one."""
    buf = bytearray(data)
    changes = patch_entries_in_place(buf, buf, new)
    return bytes(buf), changes


def diff_ranges(a: bytes, b: bytes) -> list[tuple[int, int]]:
    """Contiguous byte ranges where two buffers differ, over their common length."""
    n = min(len(a), len(b))
    out, start = [], None
    for i in range(n):
        if a[i] != b[i]:
            if start is None:
                start = i
        elif start is not None:
            out.append((start, i))
            start = None
    if start is not None:
        out.append((start, n))
    if len(a) != len(b):
        out.append((n, max(len(a), len(b))))
    return out


# ----------------------------------------------------------------- DDS surgery

def dds_fields(d: bytes) -> dict:
    w, h, kind, off = dds_describe(d)
    return {
        "width": w, "height": h, "kind": kind, "data_offset": off,
        "fourcc": d[84:88].decode("ascii", "replace"),
        "dxgi": struct.unpack_from("<I", d, 128)[0] if d[84:88] == b"DX10" else None,
        "mips": struct.unpack_from("<I", d, 28)[0],
        "linear_size": struct.unpack_from("<I", d, 20)[0],
        "bytes": len(d),
    }


def block_bytes(kind_dxgi_fourcc: tuple, w: int, h: int) -> int:
    """Encoded size of one mip level, honouring the 4x4 block minimum."""
    dxgi, fourcc = kind_dxgi_fourcc
    bw, bh = max(1, (w + 3) // 4), max(1, (h + 3) // 4)
    if fourcc == "ATI1" or dxgi == 80:
        return bw * bh * 8
    if dxgi in (DXGI_BC1_UNORM, DXGI_BC1_UNORM_SRGB):
        return bw * bh * 8
    return bw * bh * 16          # BC7


def rebuild_dds(original: bytes, w: int, h: int, levels: list[bytes],
                dxgi_override: int | None = None) -> bytes:
    """The original header with new dimensions. Nothing else is touched.

    Cloning beats constructing: the DS3 headers carry flags 0xa1007 and caps
    0x401008 (TEXTURE|COMPLEX|MIPMAP), and a header we invented would be one
    forgotten bit away from a texture the game silently refuses.
    """
    _, _, _, off = dds_describe(original)
    head = bytearray(original[:off])
    struct.pack_into("<I", head, 12, h)
    struct.pack_into("<I", head, 16, w)
    struct.pack_into("<I", head, 20, len(levels[0]))     # DDSD_LINEARSIZE value
    struct.pack_into("<I", head, 28, len(levels))
    if dxgi_override is not None and original[84:88] == b"DX10":
        struct.pack_into("<I", head, 128, dxgi_override)
    return bytes(head) + b"".join(levels)


# ------------------------------------------------------------- colour helpers

def srgb_to_linear(a: np.ndarray) -> np.ndarray:
    a = a / 255.0
    return np.where(a <= 0.04045, a / 12.92, ((a + 0.055) / 1.055) ** 2.4)


def linear_to_srgb(a: np.ndarray) -> np.ndarray:
    out = np.where(a <= 0.0031308, a * 12.92, 1.055 * np.clip(a, 0, None) ** (1 / 2.4) - 0.055)
    return np.clip(out * 255.0, 0, 255)


def resize_planes(a: np.ndarray, size: tuple[int, int]) -> np.ndarray:
    """LANCZOS on a float HxWxC array, one plane at a time (PIL 'F' mode)."""
    out = [np.asarray(Image.fromarray(a[..., c].astype(np.float32), "F").resize(size, Image.LANCZOS))
           for c in range(a.shape[2])]
    return np.stack(out, axis=2)


def mip_chain(img: Image.Image, srgb: bool) -> list[Image.Image]:
    """Full chain down to 1x1. sRGB colour is halved in LINEAR light.

    Halving sRGB bytes directly brightens every mip, which on a cloud sea shows
    up as a horizon that gets paler with distance. Alpha is linear either way.
    """
    a = np.asarray(img.convert("RGBA")).astype(np.float64)
    rgb = srgb_to_linear(a[..., :3]) if srgb else a[..., :3] / 255.0
    work = np.concatenate([rgb, a[..., 3:] / 255.0], axis=2)
    levels, w, h = [img.convert("RGBA")], img.width, img.height
    while w > 1 or h > 1:
        w, h = max(1, w // 2), max(1, h // 2)
        work = np.clip(resize_planes(work, (w, h)), 0.0, 1.0)
        rgb_out = linear_to_srgb(work[..., :3]) if srgb else work[..., :3] * 255.0
        px = np.concatenate([rgb_out, work[..., 3:] * 255.0], axis=2)
        levels.append(Image.fromarray(np.clip(px + 0.5, 0, 255).astype(np.uint8), "RGBA"))
    return levels


def dilate_rgb(img: Image.Image) -> Image.Image:
    """Push the nearest opaque colour into every transparent texel.

    Without this, the network upscales whatever junk the artists left behind
    alpha=0 and then the resampled alpha uncovers a slice of it at the sprite
    edge. Standard alpha-bleed, done with an exact distance transform.
    """
    from scipy import ndimage

    a = np.asarray(img.convert("RGBA")).copy()
    empty = a[..., 3] == 0
    if not empty.any() or empty.all():
        return img
    _, idx = ndimage.distance_transform_edt(empty, return_indices=True)
    a[..., :3] = a[idx[0], idx[1], :3]
    return Image.fromarray(a, "RGBA")


# --------------------------------------------------------------- the upscalers

def _run(cmd: list[str]) -> None:
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        raise SystemExit(f"{cmd[0]} failed ({r.returncode}):\n{r.stderr[-2000:]}")


def esrgan_batch(pngs: dict[str, Image.Image], workdir: Path) -> dict[str, Image.Image]:
    """Upscale a batch of images 4x through realesrgan-ncnn-vulkan on the GPU.

    Batch mode (directory in, directory out) rather than one call per image: the
    binary reloads the model and re-enumerates Vulkan devices on every start,
    which is most of the cost for small tiles. 64 flipbook frames take 5.7 s in
    one batch versus 16.0 s for the same pixels as one 1024x1024 sheet.
    """
    src, dst = workdir / "in", workdir / "out"
    shutil.rmtree(src, ignore_errors=True)
    shutil.rmtree(dst, ignore_errors=True)
    src.mkdir(parents=True)
    dst.mkdir(parents=True)
    for name, im in pngs.items():
        im.save(src / f"{name}.png")
    _run([str(REALESRGAN), "-i", str(src), "-o", str(dst), "-n", REALESRGAN_MODEL,
          "-m", str(REALESRGAN_MODELS), "-s", "4", "-f", "png"])
    out = {}
    for name in pngs:
        p = dst / f"{name}.png"
        if not p.exists():
            raise SystemExit(f"realesrgan produced no output for {name}")
        out[name] = Image.open(p).convert("RGBA")
        out[name].load()
    return out


def ai_upscale(img: Image.Image, grid, workdir: Path, alpha_ai: bool = False) -> Image.Image:
    """4x an RGBA image: the network on RGB, LANCZOS on ALPHA.

    THE ALPHA RULE, and it was measured, not assumed. realesrgan-ncnn-vulkan
    bicubics the alpha of an RGBA input rather than running the network on it, so
    the obvious fix was to feed alpha through as its own greyscale image. Looked
    at, on one 128 px frame of s11630 blown up 4x:

      LANCZOS          the soft feathered edge survives, no invented structure
      realesrgan-x4plus  the edge hardens and the feather becomes RADIAL
                         FILAMENTS, a hairy fringe all round the puff
      realesr-animevideov3-x4  the feather is smoothed away into a flat blob

    A smoke billboard IS its soft edge, so the filaments are not detail, they are
    damage, and they would be drawn 7 to 30 m tall. Alpha therefore gets LANCZOS.
    The channel split still earns its place: it is what lets alpha take a
    different path from RGB at all, LANCZOS beats the built-in bicubic, and RGB
    gets dilated into the transparent region first so the network never drags
    junk from behind alpha=0 into a visible edge. `alpha_ai=True` puts the
    network back on alpha if a future sheet ever wants it.

    Flipbook sheets are sliced into frames first, for BOTH paths: LANCZOS at 4x
    reaches about four source texels either side, so resizing a whole sheet would
    smear one frame's alpha into its neighbour's border just as surely as a
    convolution would.
    """
    img = img.convert("RGBA")
    a = np.asarray(img)
    has_alpha = a[..., 3].min() < 255
    rgb_src = dilate_rgb(img) if has_alpha else img

    def alpha_for(box, size):
        crop = Image.fromarray(a[box[1]:box[3], box[0]:box[2], 3])
        return np.asarray(crop.resize(size, Image.LANCZOS))

    if grid:
        cols, rows = grid
        cw, ch = img.width // cols, img.height // rows
        if cw * cols != img.width or ch * rows != img.height:
            raise SystemExit(f"grid {grid} does not divide {img.size}")
        tiles = {}
        for r in range(rows):
            for c in range(cols):
                box = (c * cw, r * ch, c * cw + cw, r * ch + ch)
                tiles[f"c{r:02d}_{c:02d}"] = rgb_src.crop(box).convert("RGB")
                if has_alpha and alpha_ai:
                    tiles[f"a{r:02d}_{c:02d}"] = Image.fromarray(
                        a[box[1]:box[3], box[0]:box[2], 3]).convert("RGB")
        up = esrgan_batch(tiles, workdir)
        out = Image.new("RGBA", (img.width * 4, img.height * 4))
        for r in range(rows):
            for c in range(cols):
                box = (c * cw, r * ch, c * cw + cw, r * ch + ch)
                t = np.asarray(up[f"c{r:02d}_{c:02d}"]).copy()
                if not has_alpha:
                    t[..., 3] = 255
                elif alpha_ai:
                    t[..., 3] = np.asarray(up[f"a{r:02d}_{c:02d}"])[..., 0]
                else:
                    t[..., 3] = alpha_for(box, (cw * 4, ch * 4))
                out.paste(Image.fromarray(t, "RGBA"), (c * cw * 4, r * ch * 4))
        return out

    batch = {"c": rgb_src.convert("RGB")}
    if has_alpha and alpha_ai:
        batch["a"] = Image.fromarray(a[..., 3]).convert("RGB")
    up = esrgan_batch(batch, workdir)
    t = np.asarray(up["c"]).copy()
    if not has_alpha:
        t[..., 3] = 255
    elif alpha_ai:
        t[..., 3] = np.asarray(up["a"])[..., 0]
    else:
        t[..., 3] = alpha_for((0, 0, img.width, img.height), (img.width * 4, img.height * 4))
    return Image.fromarray(t, "RGBA")


def lanczos_upscale(img: Image.Image, scale: int, role: str) -> tuple[Image.Image, int]:
    """LANCZOS for data channels. Returns (image, texels clamped back onto the disc).

    Normals: DS3 keeps X in R and Y in G with B a near-constant third channel.
    A resampled (x, y) only has to satisfy x^2 + y^2 <= 1 for the shader's
    reconstructed Z to be real, and LANCZOS overshoot can break that, so any
    texel that lands outside the unit disc is scaled back onto it.
    """
    size = (img.width * scale, img.height * scale)
    a = np.asarray(img.convert("RGBA")).astype(np.float64)
    up = np.clip(resize_planes(a, size), 0, 255)
    clamped = 0
    if role == "normal":
        x, y = up[..., 0] / 127.5 - 1.0, up[..., 1] / 127.5 - 1.0
        length = np.sqrt(x * x + y * y)
        bad = length > 1.0
        clamped = int(bad.sum())
        if clamped:
            s = np.where(bad, 1.0 / np.maximum(length, 1e-9), 1.0)
            up[..., 0] = np.clip((x * s + 1.0) * 127.5, 0, 255)
            up[..., 1] = np.clip((y * s + 1.0) * 127.5, 0, 255)
    return Image.fromarray(np.clip(up + 0.5, 0, 255).astype(np.uint8), "RGBA"), clamped


