+// --- Linux port ---------------------------------------------------------
+// Everything below line 4286 in the original kraken.cpp is a Windows-only CLI
+// that LoadLibrary's the real Oodle DLL to A/B against this decoder. We only
+// want the decoder, so it is cut. This is the sole export we need.
+extern "C" const char *ooz_last_unimplemented(void) { return g_ooz_unimpl; }
+
+extern "C" int ooz_decompress(const byte *src, size_t src_len, byte *dst, size_t dst_len) {
+  g_ooz_unimpl = nullptr;
+  return Kraken_Decompress(src, src_len, dst, dst_len);
+}
+
+// Lenient variant. ooz's own Kraken_Decompress fails the whole decode if any
+// source bytes remain after the output is complete:
+//     if (src_len != 0) goto FAIL;
+// FromSoft's DCX stores a compressedSize padded out to alignment, so there are
+// almost always a few trailing bytes and that check rejects a decode that in
+// fact succeeded. Everything under ~256KB is a single block that happens to
+// land exactly, which is why only larger files appeared to fail.
+extern "C" int ooz_decompress_lenient(const byte *src, size_t src_len, byte *dst, size_t dst_len) {
+  g_ooz_unimpl = nullptr;
+  KrakenDecoder *dec = Kraken_Create();
+  int offset = 0;
+  while (dst_len != 0) {
+    if (!Kraken_DecodeStep(dec, dst, offset, dst_len, src, src_len)) { Kraken_Destroy(dec); return -1; }
+    if (dec->src_used == 0) { Kraken_Destroy(dec); return -1; }
+    src += dec->src_used;
+    src_len -= dec->src_used;
+    dst_len -= dec->dst_used;
+    offset += dec->dst_used;
   }
-
-  if (nverify)
-    fprintf(stderr, "%d files verified OK!\n", nverify);
-  return 0;
+  Kraken_Destroy(dec);
+  return offset;      // trailing source bytes are fine
 }
