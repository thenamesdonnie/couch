#!/usr/bin/env python3
"""Record the DualSense's evdev stream for the couchd replay suite.

Runs forever (systemd user unit pad-record.service). Whenever a DualSense
appears it opens the same nodes pad-home-watcher reads (the button/stick
device; Motion and Touchpad are excluded, they never carry the events the
state machine cares about) and streams every event, gzip-compressed as it
goes, to a file in ~/couch/recordings/. When the pad goes away the file is
closed and summarised in /tmp/pad-record.log. Purely passive: the nodes are
opened read-only and never grabbed, so Kodi/Steam/the watcher see the pad
exactly as before.

Alongside raw events it records the console state machine's context: the
contents of /tmp/game-session and /tmp/game-suspended are checked every
~100ms and any change is written as a marker line stamped with the flag
file's own mtime (not the poll time), because the gesture decisions the
replay must validate branch on flag state at button-release time.

Recordings older than RETAIN_DAYS are deleted when a new one starts.

File format (one JSON value per line, in a .jsonl.gz):
  {"header": ..., "started": ..., "nodes": {...}}   first line
  [t, dev, type, code, value]                       an input_event; t is the
                                                    kernel's event timestamp
                                                    (float seconds), dev
                                                    indexes header nodes
  {"t": <mtime|poll>, "marker": "game-session", "value": ...}  a flag changed
EV_MSC (scancode chatter) is dropped; EV_KEY/EV_ABS/EV_SYN are kept so a
replay can preserve report boundaries. The gzip stream is sync-flushed every
~2s of quiet, so a hard kill loses at most the tail after the last flush.
"""
import glob
import gzip
import json
import os
import re
import select
import struct
import time

EVENT_FORMAT = 'llHHi'  # struct input_event on x86_64
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)
EV_SYN, EV_KEY, EV_ABS = 0x00, 0x01, 0x03
KEEP = (EV_SYN, EV_KEY, EV_ABS)

WANTED = 'DualSense Wireless Controller'
UNWANTED = re.compile(r'Motion|Touchpad', re.I)
FLAGS = ('/tmp/game-session', '/tmp/game-suspended')
OUT_DIR = os.path.expanduser('~/couch/recordings')
LOG = '/tmp/pad-record.log'
SCAN_SECONDS = 2.0
FLUSH_SECONDS = 2.0
RETAIN_DAYS = 14


def say(msg):
    with open(LOG, 'a') as f:
        f.write(f"{time.strftime('%H:%M:%S')} {msg}\n")


def find_pads():
    nodes = {}
    try:
        blocks = open('/proc/bus/input/devices').read().split('\n\n')
    except OSError:
        return nodes
    for b in blocks:
        m = re.search(r'N: Name="([^"]*)"', b)
        if not m or WANTED not in m.group(1) or UNWANTED.search(m.group(1)):
            continue
        h = re.search(r'H: Handlers=.*?(event\d+)', b)
        if h:
            nodes['/dev/input/' + h.group(1)] = m.group(1)
    return nodes


def read_flags():
    """{name: (content-or-None, mtime-or-None)} for the two /tmp flags."""
    state = {}
    for path in FLAGS:
        try:
            content = open(path).read().strip()
            mtime = os.stat(path).st_mtime
        except OSError:
            content, mtime = None, None
        state[os.path.basename(path)] = (content, mtime)
    return state


def prune_old():
    cutoff = time.time() - RETAIN_DAYS * 86400
    for path in glob.glob(os.path.join(OUT_DIR, 'pad-*.jsonl*')):
        try:
            if os.stat(path).st_mtime < cutoff:
                os.remove(path)
                say(f'pruned {os.path.basename(path)} (older than {RETAIN_DAYS}d)')
        except OSError:
            pass


def record(nodes):
    """One recording: from these nodes appearing until every one is gone."""
    prune_old()
    stamp = time.strftime('%Y%m%d-%H%M%S')
    path = os.path.join(OUT_DIR, f'pad-{stamp}.jsonl.gz')
    fds = {}   # fd -> dev index
    names = []
    for node, name in sorted(nodes.items()):
        try:
            fd = os.open(node, os.O_RDONLY | os.O_NONBLOCK)
        except OSError as e:
            say(f'cannot open {node}: {e} (dualsense udev rule missing?)')
            continue
        fds[fd] = len(names)
        names.append({'node': node, 'name': name})
    if not fds:
        return

    flags = read_flags()
    events = 0
    started = time.time()
    dirty = False
    last_flush = started
    with gzip.open(path, 'wt') as out:
        out.write(json.dumps({'header': 1, 'started': stamp,
                              'nodes': names,
                              'flags': {k: v[0] for k, v in flags.items()}})
                  + '\n')
        say(f'recording {path} from {", ".join(n["node"] for n in names)}')
        while fds:
            ready, _, _ = select.select(list(fds), [], [], 0.1)
            for fd in ready:
                try:
                    data = os.read(fd, EVENT_SIZE * 64)
                except OSError:
                    data = b''
                if not data:  # pad gone
                    dev = fds.pop(fd)
                    os.close(fd)
                    say(f'{names[dev]["node"]} gone')
                    continue
                for off in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
                    sec, usec, etype, code, value = struct.unpack_from(
                        EVENT_FORMAT, data, off)
                    if etype not in KEEP:
                        continue
                    out.write(json.dumps([round(sec + usec / 1e6, 6),
                                          fds[fd], etype, code, value]) + '\n')
                    events += 1
                    dirty = True
            now_flags = read_flags()
            for key, (val, mtime) in now_flags.items():
                if val != flags[key][0]:
                    # Stamp with the flag file's own mtime so the marker
                    # lines up with the button event that caused it, not
                    # with our poll; deletion has no mtime, use now.
                    out.write(json.dumps(
                        {'t': round(mtime if mtime else time.time(), 3),
                         'marker': key, 'value': val}) + '\n')
                    say(f'marker {key} -> {val!r}')
                    dirty = True
            flags = now_flags
            if dirty and time.time() - last_flush >= FLUSH_SECONDS:
                out.flush()  # Z_SYNC_FLUSH: readable up to here on hard kill
                last_flush = time.time()
                dirty = False

    say(f'closed {path}: {events} events over {time.time() - started:.0f}s')


def main():
    os.makedirs(OUT_DIR, exist_ok=True)
    say('pad-record up, waiting for a pad')
    while True:
        nodes = find_pads()
        if nodes:
            record(nodes)
        time.sleep(SCAN_SECONDS)


if __name__ == '__main__':
    main()
