#!/usr/bin/env python3
"""Extract PS4 trophy data for shadPS4 games into the shape the Games row
already reads for Steam achievements, so the skin renders both identically.

Per game (keyed by its serial, e.g. CUSA00900):

    icons:  ~/.local/share/game-tiles/trophy-icons/<serial>/TROP000.png
    detail: ~/.local/share/game-tiles/achievements/<serial>.json
    counts: ~/.local/share/game-tiles/achievements.json  {serial: "got/total"}

The detail rows carry the same keys the Steam side writes (name, desc, icon,
unlocked, unlocktime, rarity) plus "grade" (bronze/silver/gold/platinum).
rarity is always "" - that is global PSN data and this runs offline.

RETAIL DUMPS ARE ENCRYPTED. The trophy config inside sce_sys/trophy/trophy00.trp
is not TROP.XML but TROP.ESFM: AES-128-CBC ciphertext keyed off Sony's release
trophy key, which is not shipped with shadPS4 or with this tool. Without that
key the names/descriptions cannot be read at all - the icons and the trophy
COUNT still can. Give the tool the key (any one of these) and it decrypts:

    $PS4_TROPHY_KEY                                      (32 hex chars)
    ~/.config/couch/ps4-trophy-key                       (32 hex chars)
    ~/.local/share/shadPS4/config.toml   [Keys] TrophyKey
    ~/.local/share/shadPS4/keys.json     TrophyKeySet.ReleaseTrophyKey

or drop an already-decrypted TROP.XML at either

    ~/.local/share/game-tiles/trophy-xml/<serial>.xml
    <game>/sce_sys/trophy/TROP.XML

With a key set, shadPS4 extracts its own copy to game_data/<serial>/TrophyFiles
on launch; that copy is preferred here because it is also where unlock times
are recorded.

    ps4-trophies [--placeholder] [serial ...]

No arguments scans ~/games/ps4 for dumps whose folder is named like a serial.
--placeholder writes icon-only rows when the config cannot be read, so the
window shows the right count and art with "Trophy 01" style names.
"""
import glob
import json
import os
import re
import struct
import sys
import xml.etree.ElementTree as ET

HOME = os.path.expanduser('~')
PS4_DIR = os.path.join(HOME, 'games/ps4')
SHADPS4 = os.path.join(HOME, '.local/share/shadPS4')
TILES = os.path.join(HOME, '.local/share/game-tiles')
ICON_DIR = os.path.join(TILES, 'trophy-icons')
DETAIL_DIR = os.path.join(TILES, 'achievements')
CACHE = os.path.join(TILES, 'achievements.json')
XML_DIR = os.path.join(TILES, 'trophy-xml')
KEY_FILE = os.path.join(HOME, '.config/couch/ps4-trophy-key')

SERIAL_RE = re.compile(r'^[A-Z]{4}\d{5}$')
GRADE = {'B': 'bronze', 'S': 'silver', 'G': 'gold', 'P': 'platinum'}

TRP_MAGIC = 0xDCA24D00
TRP_ENTRY_START = 0x60  # header is 0x60 even though only 0x40 of it is used
TRP_ENTRY_SIZE = 0x40
TRP_FLAG_ENCRYPTED = 3


# ---------------------------------------------------------------- TRP archive

class Entry(object):
    def __init__(self, name, pos, size, flag):
        self.name, self.pos, self.size, self.flag = name, pos, size, flag


def read_trp(path):
    """Parse a Sony TRP archive. Returns (blob, [Entry]) with entries whose
    offset/size fall outside the file dropped rather than raising - dumps in
    the wild carry padding entries and truncated tails."""
    blob = open(path, 'rb').read()
    if len(blob) < TRP_ENTRY_START:
        raise ValueError('too short to be a TRP')
    magic, _ver, _fsize, count, esize, _dev = struct.unpack_from('>IIQIII', blob, 0)
    if magic != TRP_MAGIC:
        raise ValueError('bad magic %#010x' % magic)
    if esize < 48 or esize > 4096:
        esize = TRP_ENTRY_SIZE
    if count <= 0 or count > 100000:
        raise ValueError('implausible entry count %d' % count)
    out = []
    for i in range(count):
        off = TRP_ENTRY_START + i * esize
        if off + 48 > len(blob):
            break
        name = blob[off:off + 32].split(b'\0')[0].decode('ascii', 'replace').strip()
        pos, size = struct.unpack_from('>QQ', blob, off + 32)
        flag = struct.unpack_from('>I', blob, off + 48)[0] if off + 52 <= len(blob) else 0
        if not name or size == 0 or pos < TRP_ENTRY_START or pos + size > len(blob):
            continue
        out.append(Entry(name, pos, size, flag))
    return blob, out


def extract_icons(serial, blob, entries):
    """Write every PNG in the archive out under trophy-icons/<serial>/.
    Idempotent: rewrites only when missing or a different size. Returns
    {'TROP000.PNG': '/abs/path.png'}."""
    dest = os.path.join(ICON_DIR, serial)
    os.makedirs(dest, exist_ok=True)
    icons = {}
    for e in entries:
        if not e.name.upper().endswith('.PNG'):
            continue
        data = blob[e.pos:e.pos + e.size]
        if not data.startswith(b'\x89PNG'):
            continue
        path = os.path.join(dest, e.name[:-4] + '.png')
        try:
            stale = os.path.getsize(path) != len(data)
        except OSError:
            stale = True
        if stale:
            tmp = path + '.part'
            open(tmp, 'wb').write(data)
            os.replace(tmp, path)
        icons[e.name.upper()] = path
    return icons


# ------------------------------------------------------------ AES (stdlib only)
# Needed only to decrypt TROP.ESFM. shadPS4 derives the file key by AES-ECB
# encrypting the game's 16-byte NP communication ID under Sony's trophy key,
# then decrypts the body CBC. Verified against the FIPS-197 vector.

SBOX = bytes.fromhex(
    '637c777bf26b6fc53001672bfed7ab76ca82c97dfa5947f0add4a2af9ca472c0'
    'b7fd9326363ff7cc34a5e5f171d8311504c723c31896059a071280e2eb27b275'
    '09832c1a1b6e5aa0523bd6b329e32f8453d100ed20fcb15b6acbbe394a4c58cf'
    'd0efaafb434d338545f9027f503c9fa851a3408f929d38f5bcb6da2110fff3d2'
    'cd0c13ec5f974417c4a77e3d645d197360814fdc222a908846eeb814de5e0bdb'
    'e0323a0a4906245cc2d3ac629195e479e7c8376d8dd54ea96c56f4ea657aae08'
    'ba78252e1ca6b4c6e8dd741f4bbd8b8a703eb5664803f60e613557b986c11d9e'
    'e1f8981169d98e949b1e87e9ce5528df8ca1890dbfe6426841992d0fb054bb16')
INV_SBOX = bytearray(256)
for _i, _v in enumerate(SBOX):
    INV_SBOX[_v] = _i


def _xtime(a):
    return ((a << 1) ^ 0x1b) & 0xff if a & 0x80 else a << 1


def _mul(a, b):
    r = 0
    while b:
        if b & 1:
            r ^= a
        a = _xtime(a)
        b >>= 1
    return r


class AES128(object):
    def __init__(self, key):
        if len(key) != 16:
            raise ValueError('AES-128 needs a 16-byte key')
        rk, rcon = list(key), 1
        for i in range(16, 176, 4):
            t = rk[i - 4:i]
            if i % 16 == 0:
                t = [SBOX[t[1]] ^ rcon, SBOX[t[2]], SBOX[t[3]], SBOX[t[0]]]
                rcon = _xtime(rcon)
            rk += [rk[i - 16 + j] ^ t[j] for j in range(4)]
        self.rk = rk

    def _ark(self, s, r):
        for i in range(16):
            s[i] ^= self.rk[r * 16 + i]

    def encrypt_block(self, block):
        s = list(block)
        self._ark(s, 0)
        for r in range(1, 11):
            s = [SBOX[b] for b in s]
            s = [s[(i + 4 * (i % 4)) % 16] for i in range(16)]
            if r != 10:
                for c in range(0, 16, 4):
                    a = s[c:c + 4]
                    for j in range(4):
                        s[c + j] = (_mul(a[j], 2) ^ _mul(a[(j + 1) % 4], 3)
                                    ^ a[(j + 2) % 4] ^ a[(j + 3) % 4])
            self._ark(s, r)
        return bytes(s)

    def decrypt_block(self, block):
        s = list(block)
        self._ark(s, 10)
        for r in range(9, -1, -1):
            s = [s[(i - 4 * (i % 4)) % 16] for i in range(16)]
            s = [INV_SBOX[b] for b in s]
            self._ark(s, r)
            if r:
                for c in range(0, 16, 4):
                    a = s[c:c + 4]
                    for j in range(4):
                        s[c + j] = (_mul(a[j], 14) ^ _mul(a[(j + 1) % 4], 11)
                                    ^ _mul(a[(j + 2) % 4], 13) ^ _mul(a[(j + 3) % 4], 9))
        return bytes(s)


def cbc_decrypt(key, iv, data):
    aes, prev, out = AES128(key), iv, bytearray()
    for i in range(0, len(data) - len(data) % 16, 16):
        blk = data[i:i + 16]
        out += bytes(x ^ y for x, y in zip(aes.decrypt_block(blk), prev))
        prev = blk
    return bytes(out)


# ------------------------------------------------------------- trophy config

def trophy_key():
    """Sony's release trophy key, from wherever the user put it. Never shipped
    with this tool."""
    raw = os.environ.get('PS4_TROPHY_KEY', '')
    if not raw:
        try:
            raw = open(KEY_FILE).read()
        except OSError:
            pass
    if not raw:
        try:
            m = re.search(r'^\s*TrophyKey\s*=\s*"([0-9a-fA-F]*)"',
                          open(os.path.join(SHADPS4, 'config.toml')).read(), re.M)
            raw = m.group(1) if m else ''
        except OSError:
            pass
    if not raw:
        try:
            keys = json.load(open(os.path.join(SHADPS4, 'keys.json')))
            raw = keys.get('TrophyKeySet', {}).get('ReleaseTrophyKey', '')
        except Exception:
            pass
    raw = re.sub(r'[^0-9a-fA-F]', '', raw or '')
    try:
        return bytes.fromhex(raw) if len(raw) == 32 else None
    except ValueError:
        return None


def np_comm_id(gamedir):
    """The NPWRxxxxx_00 id the file key is derived from; it is the only ASCII
    in npbind.dat."""
    for name in ('npbind.dat', 'nptitle.dat'):
        try:
            blob = open(os.path.join(gamedir, 'sce_sys', name), 'rb').read()
        except OSError:
            continue
        m = re.search(rb'NPWR[0-9]{5}_[0-9]{2}', blob)
        if m:
            return m.group(0)
    return None


def decrypt_esfm(data, key, npid):
    """Try the shadPS4 scheme. Returns plaintext XML bytes or None - the caller
    treats an unreadable config as 'no config', never as an error to crash on."""
    file_key = AES128(key).encrypt_block(npid.ljust(16, b'\0')[:16])
    for iv, body in ((b'\0' * 16, data), (data[:16], data[16:])):
        plain = cbc_decrypt(file_key, iv, body)
        if b'<trophyconf' in plain:
            return plain
    return None


def _xml_text(blob):
    """Pull the trophyconf document out of a buffer that may carry a binary
    header or trailing padding."""
    start = blob.find(b'<?xml')
    if start < 0:
        start = blob.find(b'<trophyconf')
    end = blob.rfind(b'</trophyconf>')
    if start < 0 or end < 0:
        return None
    return blob[start:end + len(b'</trophyconf>')].decode('utf-8', 'replace')


def find_trophy_xml(serial, gamedir, blob, entries):
    """Locate the trophy config, best source first. shadPS4's own extracted
    copy wins because it is the one that also carries unlock times.
    Returns (xml_text, where) or (None, reason)."""
    for path in sorted(glob.glob(os.path.join(
            SHADPS4, 'game_data', serial, 'TrophyFiles', '*', 'Xml', '*.[Xx][Mm][Ll]'))):
        if os.path.basename(path).upper().startswith('TROP.'):
            try:
                text = _xml_text(open(path, 'rb').read())
            except OSError:
                continue
            if text:
                return text, path

    for path in (os.path.join(XML_DIR, serial + '.xml'),
                 os.path.join(gamedir, 'sce_sys', 'trophy', 'TROP.XML')):
        try:
            text = _xml_text(open(path, 'rb').read())
        except OSError:
            continue
        if text:
            return text, path

    esfm = None
    for e in entries:
        if not re.match(r'TROP\.(E?SFM|XML)$', e.name, re.I):
            continue
        data = blob[e.pos:e.pos + e.size]
        text = _xml_text(data)
        if text:
            return text, 'trophy00.trp:%s' % e.name
        esfm = data
    if esfm is None:
        return None, 'no TROP config entry in trophy00.trp'

    key, npid = trophy_key(), np_comm_id(gamedir)
    if not key:
        return None, 'TROP.ESFM is encrypted and no trophy key is configured'
    if not npid:
        return None, 'TROP.ESFM is encrypted and npbind.dat has no NP comm id'
    text = _xml_text(decrypt_esfm(esfm, key, npid) or b'')
    if text:
        return text, 'trophy00.trp:TROP.ESFM (decrypted)'
    return None, 'TROP.ESFM decryption failed (wrong key?)'


def parse_trophy_xml(text):
    """<trophyconf><trophy id ttype hidden><name/><detail/></trophy>...
    Returns [{'id', 'grade', 'hidden', 'name', 'desc'}] in file order."""
    root = ET.fromstring(text)
    out = []
    for el in root.iter('trophy'):
        try:
            tid = int(el.get('id', ''))
        except ValueError:
            continue
        out.append({
            'id': tid,
            'grade': GRADE.get((el.get('ttype') or '').upper(), ''),
            'hidden': (el.get('hidden') or '').lower() in ('yes', 'true', '1'),
            'name': (el.findtext('name') or '').strip() or 'Trophy %02d' % (tid + 1),
            'desc': (el.findtext('detail') or '').strip(),
        })
    return out


# ---------------------------------------------------------------- unlock state

def _epoch(value):
    """shadPS4 has written unlock times as an epoch and as a formatted date
    depending on version; anything unparseable counts as time-unknown (0)."""
    value = (value or '').strip()
    if not value:
        return 0
    if re.fullmatch(r'\d{9,12}', value):
        return int(value)
    import time
    for fmt in ('%Y-%m-%dT%H:%M:%SZ', '%Y-%m-%d %H:%M:%S', '%a %b %d %H:%M:%S %Y',
                '%d/%m/%Y %H:%M:%S', '%m/%d/%Y %H:%M:%S'):
        try:
            return int(time.mktime(time.strptime(value, fmt)))
        except ValueError:
            continue
    return 0


def unlock_state(serial):
    """Earned trophies for a serial: {trophy id: unlock epoch (0 if unknown)}.

    shadPS4 records unlocks by rewriting its OWN extracted copy of the trophy
    XML, marking each earned entry with an unlockstate/timestamp attribute.
    The attribute names are still read defensively: if the format changes this
    is the one function to fix.

    PATH TRAP (fixed 29 Aug 2026). This build writes
    `home/<user>/trophy/NPWR#####_00.xml` - named by the **NP communication
    id**, NOT the serial - and `game_data/<serial>/` does not exist at all.
    The filter below only accepted paths containing the serial, so every real
    unlock file was skipped. Worse, the skip happened BEFORE the `.xml` test,
    so the files never reached `unknown` either and the diagnostic said
    "no shadPS4 unlock data" with no paths to chase. Symptom: Donnie earned 11
    trophies in Bloodborne and the Kodi shelf sat at 0/40 with fresh,
    correct-looking, entirely empty JSON - nothing stale, so no amount of
    restarting Kodi would ever have helped.

    `np_comm_id()` returns BYTES; it must be decoded before the `in path`
    test or this raises TypeError into a caller that does not catch it.
    """
    roots = [os.path.join(SHADPS4, 'game_data', serial),
             os.path.join(SHADPS4, 'trophy')]
    roots += glob.glob(os.path.join(SHADPS4, 'home', '*', 'trophy'))
    npid = np_comm_id(game_dir(serial))
    if isinstance(npid, bytes):
        npid = npid.decode('ascii', 'ignore')
    seen, unknown = {}, []
    for root in roots:
        for dirpath, _dirs, files in os.walk(root):
            for fn in files:
                path = os.path.join(dirpath, fn)
                if (serial not in path
                        and os.path.basename(root) != serial
                        and not (npid and npid in path)):
                    continue
                if not fn.lower().endswith('.xml'):
                    unknown.append(path)
                    continue
                try:
                    root_el = ET.parse(path).getroot()
                except Exception:
                    unknown.append(path)
                    continue
                for el in root_el.iter('trophy'):
                    try:
                        tid = int(el.get('id', ''))
                    except ValueError:
                        continue
                    state = (el.get('unlockstate') or el.get('unlocked')
                             or el.get('earned') or '').lower()
                    stamp = (el.get('timestamp') or el.get('unlocktime')
                             or el.get('time') or '')
                    if state in ('true', 'yes', '1') or stamp:
                        seen[tid] = max(seen.get(tid, 0), _epoch(stamp))
    if not seen:
        sys.stderr.write('%s: no shadPS4 unlock data%s, everything reports locked\n'
                         % (serial, (' in ' + ', '.join(sorted(unknown)[:3])) if unknown
                            else ''))
    return seen


# --------------------------------------------------------------------- output

def build_rows(trophies, unlocked, icons):
    """Same row shape and sort order as tools/fetch-steam-achievements: unlocked
    first (newest first), then locked by name. Hidden-and-still-locked trophies
    do not give their description away."""
    rows = []
    for t in trophies:
        is_unlocked = t['id'] in unlocked
        rows.append({
            'name': t['name'],
            'desc': 'Hidden trophy' if (t['hidden'] and not is_unlocked) else t['desc'],
            'icon': icons.get('TROP%03d.PNG' % t['id'], ''),
            'unlocked': is_unlocked,
            'unlocktime': unlocked.get(t['id'], 0),
            'rarity': '',
            'grade': t['grade'],
        })
    rows.sort(key=lambda r: (not r['unlocked'], -r['unlocktime'], r['name'].lower()))
    return rows


def write_detail(serial, rows):
    os.makedirs(DETAIL_DIR, exist_ok=True)
    tmp = os.path.join(DETAIL_DIR, '%s.json.part' % serial)
    with open(tmp, 'w') as fh:
        json.dump(rows, fh)
    os.replace(tmp, os.path.join(DETAIL_DIR, '%s.json' % serial))


def update_cache(counts):
    """Shared with the Steam fetcher, so read-modify-write instead of replace."""
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    try:
        out = json.load(open(CACHE))
    except Exception:
        out = {}
    out.update(counts)
    tmp = CACHE + '.part'
    with open(tmp, 'w') as fh:
        json.dump(out, fh)
    os.replace(tmp, CACHE)


# ------------------------------------------------------------------- driving

def discover():
    """Dump folders named like a serial. Folders of .pkg files ('bloodborne')
    and patch folders are not games and are skipped."""
    serials = set()
    for pat in ('*/sce_sys/trophy/trophy00.trp', '*/eboot.bin'):
        for path in glob.glob(os.path.join(PS4_DIR, pat)):
            base = os.path.basename(path[:path.index('/', len(PS4_DIR) + 1)])
            if SERIAL_RE.match(base):
                serials.add(base)
    return sorted(serials)


def game_dir(serial):
    for path in (os.path.join(PS4_DIR, serial), os.path.join(PS4_DIR, serial + '-patch')):
        if os.path.isfile(os.path.join(path, 'sce_sys', 'trophy', 'trophy00.trp')):
            return path
    return os.path.join(PS4_DIR, serial)


def run(serial, placeholder=False):
    """Returns (summary line, count string or None)."""
    gdir = game_dir(serial)
    trp = os.path.join(gdir, 'sce_sys', 'trophy', 'trophy00.trp')
    if not os.path.isfile(trp):
        return '%s: no trophy00.trp under %s' % (serial, gdir), None
    try:
        blob, entries = read_trp(trp)
    except (ValueError, OSError) as exc:
        return '%s: unreadable trophy00.trp (%s)' % (serial, exc), None

    icons = extract_icons(serial, blob, entries)
    unlocked = unlock_state(serial)
    text, where = find_trophy_xml(serial, gdir, blob, entries)

    trophies = []
    if text:
        try:
            trophies = parse_trophy_xml(text)
        except ET.ParseError as exc:
            sys.stderr.write('%s: %s is not valid trophy XML (%s)\n' % (serial, where, exc))
    if not trophies:
        sys.stderr.write('%s: %s\n' % (serial, where or 'no trophy config'))
        ids = sorted(int(n[4:7]) for n in icons if re.fullmatch(r'TROP\d{3}\.PNG', n))
        if not placeholder or not ids:
            return ('%s: trophy names unavailable, %d icons extracted, nothing written'
                    % (serial, len(ids)), None)
        trophies = [{'id': i, 'grade': '', 'hidden': False,
                     'name': 'Trophy %02d' % (i + 1),
                     'desc': 'Trophy details are encrypted in this dump'} for i in ids]
        where = 'placeholder'

    rows = build_rows(trophies, unlocked, icons)
    got = sum(1 for r in rows if r['unlocked'])
    write_detail(serial, rows)
    return ('%s: %d trophies, %d unlocked' % (serial, len(rows), got),
            '%d/%d' % (got, len(rows)))


def main():
    args = [a for a in sys.argv[1:] if not a.startswith('-')]
    flags = [a for a in sys.argv[1:] if a.startswith('-')]
    if '-h' in flags or '--help' in flags:
        print(__doc__.strip())
        return
    placeholder = '--placeholder' in flags
    serials = args or discover()
    if not serials:
        sys.exit('no PS4 dumps found under %s' % PS4_DIR)
    counts, failed = {}, 0
    for serial in serials:
        line, count = run(serial, placeholder)
        print(line)
        if count is None:
            failed += 1
        else:
            counts[serial] = count
    if counts:
        update_cache(counts)
    sys.exit(1 if failed else 0)


if __name__ == '__main__':
    main()
