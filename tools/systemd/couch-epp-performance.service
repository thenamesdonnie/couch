[Unit]
Description=Pin CPU energy_performance_preference to performance (resets each boot)
# The 22 Aug 2026 play test: EPP performance (from balance_performance) was
# part of the platform set that produced the best Bloodborne session on
# record (avg 60.0, 1% low 55.7). The sysfs setting does not survive a
# reboot, and the ReBAR BIOS trip resets it too, so pin it at boot the same
# way couch-4k120.service pins the display path.
After=multi-user.target
[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do echo performance > "$f" 2>/dev/null || true; done'
[Install]
WantedBy=multi-user.target
