def cmd_list(rig, args):
    for f in FAULTS:
        needs = []
        if f['needs_game']:
            needs.append('LIVE GAME')
        if f.get('live_mode'):
            needs.append('--live uses the real game')
        if f['forbids_game']:
            needs.append('no game running')
        if f['pause_legacy']:
            needs.append('pauses %s' % LEGACY_UNIT)
        rig.out('')
        rig.out('%s   (~%.0fs)' % (f['name'], f['watch_s']))
        rig.out('  audit    : %s' % f['audit'])
        rig.out('  proves   : %s' % f['proves'])
        rig.out('  couchd   : %s' % ', '.join(
            '%s%s' % (m.get('reason') or m.get('name') or m['kind'],
                      ' within %.0fs' % m['deadline_s'])
            for m in f['expect']))
        rig.out('  legacy   : %s' % f['legacy_repair'])
        rig.out('  needs    : %s' % ('; '.join(needs) or 'nothing special'))
        rig.out('  on the TV: %s' % f['tv'])
    rig.out('')
    rig.out('Run one with:  tools/fault-rig inject <name> --i-am-present')
    return 0


def cmd_status(rig, args):
    t = rig.now()
    rig.out('fault-rig status at %s' % now_iso(t))
    data = rig.journal.load()
    if data:
        rig.out('  STAGED: %s (%s) since %s, %d undo step(s)'
                % (data.get('fault'), data.get('id'),
                   now_iso(data.get('t', t)), len(data.get('undo') or [])))
        wd = data.get('watchdog') or {}
        if wd.get('due_t'):
            rig.out('  auto-restore in %.0fs (%s)'
                    % (max(0.0, wd['due_t'] - t), wd.get('kind')))
        rig.out('  ABORT NOW:  tools/fault-rig restore --i-am-present')
    else:
        rig.out('  nothing staged')
    rig.out('  couchd     : %s' % ('active' if rig.unit_active(COUCHD_UNIT)
                                   else 'NOT ACTIVE'))
    st = rig.couchd_status()
    if st:
        rig.out('  couchd sees: %s (status %.0fs old)'
                % (' '.join('%s=%s' % kv for kv in
                            sorted((st.get('regions') or {}).items())),
                   t - float(st.get('t') or 0)))
        if st.get('resource_leaks'):
            rig.out('  leaks      : %s' % '; '.join(st['resource_leaks']))
    rig.out('  %-10s : %s' % (LEGACY_UNIT,
                              'active' if rig.unit_active(LEGACY_UNIT)
                              else 'STOPPED (paused by the rig? run restore)'))
    rig.out('  game pids  : %d' % len(rig.game_pids()))
    for name in ('game-session', 'game-suspended'):
        rig.out('  %-12s: %s' % (name, rig.flag(name)))
    decoys = rig.decoys()
    rig.out('  decoys     : %s' % (' '.join(str(p) for p in decoys) or 'none'))
    rig.out('  evidence   : %s' % rig.injections_path(t))
    rig.out('  correlate  : tools/shadow-diff --since %s' % hhmmss(t - 3600))
    return 0


def cmd_inject(rig, args):
    fault = BY_NAME.get(args.fault)
    if fault is None:
        rig.out('no such injection: %s' % args.fault)
        rig.out('known: %s' % ', '.join(sorted(BY_NAME)))
        return 2
    if args.live and not fault.get('live_mode'):
        raise Refused('%s has no --live mode.' % fault['name'])

    world = preflight(rig, fault, live=args.live)
    watch_s = args.watch if args.watch is not None else fault['watch_s']
    timeout = args.timeout if args.timeout is not None else watch_s + 60
    timeout = int(max(MIN_TIMEOUT_S, min(MAX_TIMEOUT_S, timeout)))

    t0 = rig.now()
    ident = '%s-%s' % (time.strftime('%Y%m%d-%H%M%S', time.localtime(t0)),
                       fault['name'])
    rig.out('injecting %s (%s)' % (fault['name'], ident))

    # The journal and the watchdog come FIRST: from this line on, everything is
    # undoable and something other than this process will undo it.
    rig.journal.start(id=ident, fault=fault['name'], t=t0,
                      mode='live' if args.live else 'default',
                      timeout_s=timeout, undo=[])
    try:
        watchdog = rig.arm_watchdog(timeout)
    except Exception:
        # No watchdog, no injection. Nothing has been touched yet, so the
        # journal is the only thing to clean up.
        rig.journal.clear()
        raise
    rig.journal.data['watchdog'] = watchdog
    rig.journal.save()

    if fault['pause_legacy']:
        rig.stop_legacy()

    facts = stage(rig, fault, live=args.live)

    marker = rig.marker({
        'event': 'inject', 'id': ident, 't': t0, 'fault': fault['name'],
        'mode': 'live' if args.live else 'default',
        'audit': fault['audit'], 'proves': fault['proves'],
        'legacy_paused': bool(fault['pause_legacy']),
        'legacy_unit': LEGACY_UNIT if fault['pause_legacy'] else None,
        'timeout_s': timeout, 'watch_s': watch_s, 'facts': facts,
        'expect': fault['expect'], 'expected_detection': fault['c17'],
        'world_before': {'game_pids': world['game_pids'],
                         'regions': (world['status'] or {}).get('regions'),
                         'session': rig.flag('game-session'),
                         'suspended': rig.flag('game-suspended')},
        'shadow_log': rig.shadow_log_path(t0),
        'diff_hint': 'tools/shadow-diff --since %s' % hhmmss(t0 - 60),
    })
    rig.out('  marker  -> %s' % rig.injections_path(t0))
    rig.out('  expect  : %s' % fault['c17'])

    rows = []
    if not args.no_watch:
        rig.out('  watching couchd for up to %.0fs...' % watch_s)
        rows = watch(rig, t0, fault, facts, watch_s)
        for label, ok, lat, detail, req in rows:
            rig.out('  %-4s %-46s %s  (%s)'
                    % ('OK' if ok else ('MISS' if req else 'info'), label,
                       ('%.2fs' % lat) if lat is not None else '   -  ', detail))
        rig.marker({'event': 'detect', 'id': ident, 'fault': fault['name'],
                    'rows': [{'expect': l, 'ok': ok, 'latency_s': lat,
                              'detail': d, 'required': req}
                             for l, ok, lat, d, req in rows],
                    'ok': passed(rows)})
        rig.out('  VERDICT: %s' % ('couchd would have repaired it'
                                   if passed(rows) else
                                   'couchd did NOT decide in time - triage T4'))

    if args.hold:
        rig.out('  HOLDING. Auto-restore in %ds, or now with:  '
                'tools/fault-rig restore --i-am-present' % timeout)
        return 0
    restore(rig, by='inject')
    return 0 if (args.no_watch or passed(rows)) else 1


def restore(rig, by='operator'):
    """Undo everything, in reverse, idempotently. Safe to run at any time,
    with or without a journal, however many times you like."""
    data = rig.journal.load()
    undone, failed = [], []

    # Sweep decoys first and unconditionally: a lost journal must never leave a
    # stopped process wearing a game's name on this box.
    for pid in rig.decoys():
        for sig in (signal.SIGCONT, signal.SIGKILL):
            try:
                rig.kill(pid, sig)
            except OSError as e:
                if e.errno != errno.ESRCH:
                    failed.append('kill %d: %s' % (pid, e))
        undone.append('killed decoy %d' % pid)

    for step in reversed((data or {}).get('undo') or []):
        op = step.get('op')
        try:
            if op == 'flag':
                path = rig.flag_path(step['name'])
                current = _read(path)
                if current == step.get('we_wrote'):
                    if step.get('restore_to') is None:
                        os.remove(path)
                        undone.append('removed %s' % path)
                    else:
                        with open(path, 'w') as fh:
                            fh.write(step['restore_to'])
                        undone.append('restored %s' % path)
                else:
                    undone.append('left %s alone (someone else changed it)'
                                  % path)
            elif op == 'joystick':
                if step.get('restore_to') is not None:
                    rig.jrpc('Settings.SetSettingValue',
                              {'setting': 'input.enablejoystick',
                               'value': bool(step['restore_to'])})
                    undone.append('joystick back to %s' % step['restore_to'])
            elif op == 'thaw':
                for pid in step.get('pids') or []:
                    try:
                        rig.kill(int(pid), signal.SIGCONT)
                    except OSError as e:
                        if e.errno != errno.ESRCH:
                            raise
                undone.append('SIGCONT %d pid(s)' % len(step.get('pids') or []))
            elif op == 'systemctl':
                rig.run(['systemctl', '--user', step['action'], step['unit']])
                undone.append('%s %s' % (step['action'], step['unit']))
            elif op == 'decoy':
                pid = int(step['pid'])
                for sig in (signal.SIGCONT, signal.SIGKILL):
                    try:
                        rig.kill(pid, sig)
                    except OSError as e:
                        if e.errno != errno.ESRCH:
                            raise
                undone.append('killed decoy %d' % pid)
            elif op == 'vpad-quit':
                rig.vpad('quit')
                undone.append('vpad down')
            else:                                      # pragma: no cover
                failed.append('unknown undo step %r' % op)
        except Exception as e:
            failed.append('%s: %s: %s' % (op, type(e).__name__, e))

    rig.cancel_watchdog((data or {}).get('watchdog'))

    # Belt and braces: whatever the journal said, the old repair loop must be
    # running when this returns.
    if not rig.unit_active(LEGACY_UNIT):
        rig.run(['systemctl', '--user', 'start', LEGACY_UNIT])
        undone.append('started %s (was down)' % LEGACY_UNIT)

    rig.journal.clear()
    for line in undone:
        rig.out('  undo: %s' % line)
    for line in failed:
        rig.out('  UNDO FAILED: %s' % line)
    rig.marker({'event': 'restore', 'by': by,
                'id': (data or {}).get('id'), 'fault': (data or {}).get('fault'),
                'undone': undone, 'failed': failed,
                'legacy_active': rig.unit_active(LEGACY_UNIT)})
    rig.out('restored%s' % ('' if not failed else ' WITH %d PROBLEM(S) - read '
                            'the lines above' % len(failed)))
    return 1 if failed else 0


def cmd_restore(rig, args):
    return restore(rig, by='watchdog' if args.auto else 'operator')


# =========================================================================
# hidden helper subcommands (the rig re-execs itself)
# =========================================================================
def cmd_watchdog(rig, args):                           # pragma: no cover
    time.sleep(args.seconds)
    return restore(rig, by='watchdog')


def cmd_decoy_window(rig, args):                       # pragma: no cover
    """A plain grey window that WM_CLASSes itself as a Steam game, so the
    frozen-game-visible repair has something to be provoked by. It never takes
    focus and never touches another window."""
    from Xlib import X, display
    d = display.Display(os.environ.get('DISPLAY', ':0'))
    screen = d.screen()
    win = screen.root.create_window(
        60, 60, 900, 520, 0, screen.root_depth,
        X.InputOutput, X.CopyFromParent,
        background_pixel=screen.white_pixel,
        override_redirect=True, event_mask=X.ExposureMask)
    win.set_wm_class('steam_app_%s' % DECOY_APPID, 'steam_app_%s' % DECOY_APPID)
    win.set_wm_name('FAULT-RIG DECOY %s (%s)' % (DECOY_APPID, args.token))
    win.map()
    win.configure(stack_mode=X.Above)
    d.sync()
    gc = win.create_gc(foreground=screen.black_pixel,
                       background=screen.white_pixel)
    deadline = time.time() + args.seconds
    while time.time() < deadline:
        while d.pending_events():
            d.next_event()
        win.draw_text(gc, 30, 60, b'FAULT-RIG DECOY - not a game, not a crash')
        win.draw_text(gc, 30, 100, b'tools/fault-rig restore --i-am-present')
        d.sync()
        time.sleep(1.0)
    win.destroy()
    d.sync()
    return 0


# =========================================================================
# cli
# =========================================================================
def build_parser():
    ap = argparse.ArgumentParser(
        prog='fault-rig', description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest='cmd')

    sub.add_parser('list', help='the injections and what each one proves')
    sub.add_parser('status', help='what is staged, what is paused, what is left')

    p = sub.add_parser('inject', help='stage one fault')
    p.add_argument('fault', help='name from `fault-rig list`')
    p.add_argument('--i-am-present', action='store_true')
    p.add_argument('--live', action='store_true',
                   help='use the REAL game session (lost-thaw only)')
    p.add_argument('--hold', action='store_true',
                   help='leave the fault staged after watching (auto-restore '
                        'still fires at the timeout)')
    p.add_argument('--no-watch', action='store_true',
                   help='stage and return without reading couchd back')
    p.add_argument('--watch', type=float, help='seconds to watch couchd')
    p.add_argument('--timeout', type=float,
                   help='auto-restore deadline in seconds (%d-%d)'
                        % (MIN_TIMEOUT_S, MAX_TIMEOUT_S))

    p = sub.add_parser('restore', help='undo everything; idempotent')
    p.add_argument('--i-am-present', action='store_true')
    p.add_argument('--auto', action='store_true',
                   help='marks the marker as watchdog-driven')

    p = sub.add_parser('_watchdog')
    p.add_argument('--seconds', type=float, required=True)
    p = sub.add_parser('_decoy-window')
    p.add_argument('--token', default=DECOY_TOKEN)
    p.add_argument('--seconds', type=float, default=900.0)
    return ap


HANDLERS = {'list': cmd_list, 'status': cmd_status, 'inject': cmd_inject,
            'restore': cmd_restore, '_watchdog': cmd_watchdog,
            '_decoy-window': cmd_decoy_window}
NEEDS_PRESENT = ('inject', 'restore')


def main(argv=None, rig=None):
    ap = build_parser()
    args = ap.parse_args(argv)
    if not args.cmd:
        ap.print_help()
        return 2
    if args.cmd in NEEDS_PRESENT and not getattr(args, 'i_am_present', False):
        print('fault-rig refuses to run without --i-am-present.\n'
              'This rig deliberately breaks the living-room console for a few '
              'seconds. It is a daytime job with the owner in the room, not '
              'something to fire off remotely. Add --i-am-present when you are '
              'actually there.', file=sys.stderr)
        return 3
    rig = rig or Rig()
    try:
        return HANDLERS[args.cmd](rig, args)
    except Refused as e:
        print('refused: %s' % e, file=sys.stderr)
        return 4


if __name__ == '__main__':
    sys.exit(main())
