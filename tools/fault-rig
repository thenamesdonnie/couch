# =========================================================================
# small helpers
# =========================================================================
def now_iso(t):
    return time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(t))


def hhmmss(t):
    return time.strftime('%H:%M:%S', time.localtime(t))


def _read(path):
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return None


class Refused(Exception):
    """A pre-check said no. Never a traceback, always a sentence."""


# =========================================================================
# the journal: every mutation, with its undo, on disk before it happens
# =========================================================================
class Journal:
    """Crash-safe undo list. Written after every step so a rig that dies
    half-way still leaves `restore` everything it needs."""

    def __init__(self, path):
        self.path = path
        self.data = None

    def exists(self):
        return os.path.exists(self.path)

    def load(self):
        raw = _read(self.path)
        if not raw:
            return None
        try:
            self.data = json.loads(raw)
        except ValueError:
            self.data = None
        return self.data

    def start(self, **fields):
        self.data = dict(fields)
        self.data.setdefault('undo', [])
        self.save()
        return self.data

    def add(self, undo):
        """Record an undo step BEFORE performing the action it undoes."""
        self.data['undo'].append(undo)
        self.save()

    def save(self):
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        tmp = self.path + '.tmp'
        with open(tmp, 'w') as fh:
            json.dump(self.data, fh, indent=1)
        os.replace(tmp, self.path)

    def clear(self):
        self.data = None
        try:
            os.remove(self.path)
        except OSError:
            pass


# =========================================================================
# the rig: everything that touches the world goes through one object
# =========================================================================
class Rig:
    def __init__(self, tmp=None, shadow_dir=None, bin_dir=None, run=None,
                 now=None, sleep=None, kill=None, alive=None, cmdlines=None,
                 jrpc=None, spawn=None, out=None, self_path=None):
        self.tmp = tmp or TMP_DIR
        self.shadow_dir = shadow_dir or SHADOW_DIR
        self.bin = bin_dir or BIN_DIR
        self._run = run or self._real_run
        self.now = now or time.time
        self.sleep = sleep or time.sleep
        self._kill = kill or os.kill
        self._alive = alive or (lambda pid: os.path.exists('/proc/%d' % pid))
        self._cmdlines = cmdlines or self._real_cmdlines
        self._jrpc = jrpc or self._real_jrpc
        self._spawn = spawn or self._real_spawn
        self.out = out or (lambda line: print(line))
        self.self_path = self_path or os.path.abspath(__file__)
        self.journal = Journal(os.path.join(self.shadow_dir, STATE_NAME))

    # -- real implementations (each one swappable in tests) ---------------
    @staticmethod
    def _real_run(cmd, timeout=15):
        return subprocess.run(cmd, capture_output=True, text=True,
                              timeout=timeout, check=False)

    @staticmethod
    def _real_cmdlines():
        out = {}
        for d in os.listdir('/proc'):
            if not d.isdigit():
                continue
            try:
                with open('/proc/%s/cmdline' % d, 'rb') as fh:
                    out[int(d)] = fh.read().replace(b'\0', b' ').decode(
                        'utf-8', 'replace').strip()
            except OSError:
                continue
        return out

    @staticmethod
    def _real_jrpc(method, params):
        import base64
        import urllib.request
        body = json.dumps({'jsonrpc': '2.0', 'id': 1, 'method': method,
                           'params': params}).encode()
        req = urllib.request.Request(kodi_url(), data=body,
                                     headers={'content-type': 'application/json'})
        token = base64.b64encode(kodi_auth().encode()).decode()
        req.add_header('Authorization', 'Basic ' + token)
        with urllib.request.urlopen(req, timeout=5) as r:
            return json.loads(r.read()).get('result')

    @staticmethod
    def _real_spawn(cmd):
        p = subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                             start_new_session=True)
        return p.pid

    # -- public wrappers over the swappable callables ---------------------
    def run(self, cmd, timeout=15):
        return self._run(cmd, timeout=timeout)

    def kill(self, pid, sig):
        return self._kill(int(pid), sig)

    def alive(self, pid):
        return self._alive(int(pid))

    def jrpc(self, method, params):
        return self._jrpc(method, params)

    # -- world reads ------------------------------------------------------
    def flag_path(self, name):
        return os.path.join(self.tmp, name)

    def flag(self, name):
        return _read(self.flag_path(name))

    def game_pids(self):
        """The live game session, by the same tree identity couchd uses."""
        r = self._run([os.path.join(self.bin, 'game-pids')])
        return [int(x) for x in (r.stdout or '').split() if x.isdigit()]

    def guard_pid(self):
        raw = self.flag('steam-input-guard.pid')
        try:
            return int(raw)
        except (TypeError, ValueError):
            return None

    def guard_alive(self):
        pid = self.guard_pid()
        return bool(pid and self._alive(pid))

    def unit_active(self, unit):
        r = self._run(['systemctl', '--user', 'is-active', unit])
        return (r.stdout or '').strip() == 'active'

    def couchd_status(self):
        raw = _read(os.path.join(self.shadow_dir, 'status.json'))
        if not raw:
            return None
        try:
            return json.loads(raw)
        except ValueError:
            return None

    def joystick(self):
        r = self._jrpc('Settings.GetSettingValue',
                       {'setting': 'input.enablejoystick'})
        return (r or {}).get('value')

    def decoys(self):
        """Every decoy this rig has ever left behind, journal or no journal."""
        return sorted(pid for pid, cmd in self._cmdlines().items()
                      if DECOY_TOKEN in cmd and pid != os.getpid())

    def shadow_log_path(self, t=None):
        day = time.strftime('%Y%m%d', time.localtime(t or self.now()))
        return os.path.join(self.shadow_dir, 'couchd-%s.jsonl' % day)

    def injections_path(self, t=None):
        day = time.strftime('%Y%m%d', time.localtime(t or self.now()))
        return os.path.join(self.shadow_dir, 'injections-%s.jsonl' % day)

    def shadow_records(self, since_t):
        """couchd's decisions since a timestamp. Pure file reading."""
        recs = []
        path = self.shadow_log_path(since_t)
        try:
            with open(path, errors='replace') as fh:
                for line in fh:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        r = json.loads(line)
                    except ValueError:
                        continue
                    if isinstance(r, dict) and float(r.get('t') or 0) >= since_t:
                        recs.append(r)
        except OSError:
            pass
        return recs

    # -- world writes (every one is journalled first) ---------------------
    def write_flag(self, name, content):
        path = self.flag_path(name)
        previous = _read(path)
        self.journal.add({'op': 'flag', 'name': name, 'restore_to': previous,
                          'we_wrote': content})
        with open(path, 'w') as fh:
            fh.write(content)
        self.out('  staged %s = %r' % (path, content))

    def set_joystick(self, value, previous):
        self.journal.add({'op': 'joystick', 'restore_to': previous,
                          'we_wrote': value})
        self._jrpc('Settings.SetSettingValue',
                   {'setting': 'input.enablejoystick', 'value': value})
        self.out('  set Kodi input.enablejoystick = %s (was %s)'
                 % (value, previous))

    def stop_legacy(self):
        self.journal.add({'op': 'systemctl', 'action': 'start',
                          'unit': LEGACY_UNIT})
        self._run(['systemctl', '--user', 'stop', LEGACY_UNIT])
        self.out('  paused the old repair loop (%s stopped)' % LEGACY_UNIT)

    def spawn_decoy(self, kind):
        """A process couchd's pid identity is supposed to see (reaper) or is
        supposed to ignore (bystander). Both carry DECOY_TOKEN so `restore`
        can sweep them up even if the journal is gone."""
        if kind == 'reaper':
            argv0 = '%s AppId=%s -- %s' % (REAPER, DECOY_APPID, DECOY_TOKEN)
        elif kind == 'bystander':
            argv0 = '%s/%s.x86_64' % (BYSTANDER_PATH, DECOY_TOKEN)
        else:
            raise Refused('unknown decoy kind %r' % kind)
        pid = self._spawn(['/bin/bash', '-c',
                           'exec -a "%s" /bin/sleep 900' % argv0])
        self.journal.add({'op': 'decoy', 'pid': pid, 'kind': kind})
        self.out('  decoy %s process pid %d (%s)' % (kind, pid, argv0[:60]))
        return pid

    def spawn_decoy_window(self):
        pid = self._spawn([sys.executable, self.self_path, '_decoy-window',
                           '--token', DECOY_TOKEN, '--seconds', '900'])
        self.journal.add({'op': 'decoy', 'pid': pid, 'kind': 'window'})
        self.out('  decoy window pid %d (class steam_app_%s)'
                 % (pid, DECOY_APPID))
        return pid

    def freeze(self, pids):
        self.journal.add({'op': 'thaw', 'pids': list(pids)})
        for pid in pids:
            try:
                self._kill(pid, signal.SIGSTOP)
            except OSError:
                pass
        self.out('  SIGSTOP %d process(es): %s'
                 % (len(pids), ' '.join(str(p) for p in pids)))

    def vpad(self, *args):
        self._run([os.path.join(self.bin, 'vpad'), *args])

    # -- the auto-restore watchdog ----------------------------------------
    def arm_watchdog(self, seconds):
        """Schedule `restore` independently of this process. Preferred: a
        transient systemd --user timer, which survives an ssh drop, a killed
        rig and a logged-out operator. Fallback: a detached child. If NEITHER
        can be armed, the caller must refuse to inject at all."""
        # A timer left pending by a crashed run would make systemd-run refuse
        # the name; clearing it first is safe because preflight has already
        # established that nothing is staged.
        self._run(['systemctl', '--user', 'stop', WATCHDOG_UNIT + '.timer',
                   WATCHDOG_UNIT + '.service'])
        r = self._run(['systemd-run', '--user', '--collect',
                       '--unit', WATCHDOG_UNIT,
                       '--on-active=%ds' % int(seconds),
                       '--description=fault-rig auto-restore',
                       self.self_path, 'restore', '--i-am-present', '--auto'])
        if r.returncode == 0:
            self.out('  auto-restore armed: systemd timer %s in %ds'
                     % (WATCHDOG_UNIT, seconds))
            return {'kind': 'systemd', 'unit': WATCHDOG_UNIT,
                    'due_t': self.now() + seconds}
        try:
            pid = self._spawn([sys.executable, self.self_path, '_watchdog',
                               '--seconds', str(int(seconds))])
        except Exception as e:
            raise Refused('cannot arm the auto-restore watchdog (%s: %s); '
                          'refusing to inject' % (type(e).__name__, e))
        self.out('  auto-restore armed: background watchdog pid %d in %ds '
                 '(systemd-run unavailable)' % (pid, seconds))
        return {'kind': 'process', 'pid': pid, 'due_t': self.now() + seconds}

    def cancel_watchdog(self, info):
        if not info:
            return
        if info.get('kind') == 'systemd':
            self._run(['systemctl', '--user', 'stop',
                       info.get('unit', WATCHDOG_UNIT) + '.timer'])
            self._run(['systemctl', '--user', 'stop',
                       info.get('unit', WATCHDOG_UNIT) + '.service'])
        elif info.get('kind') == 'process' and info.get('pid'):
            try:
                self._kill(int(info['pid']), signal.SIGTERM)
            except OSError:
                pass

    # -- markers ----------------------------------------------------------
    def marker(self, rec):
        rec = dict(rec)
        rec.setdefault('kind', 'injection')
        rec.setdefault('t', self.now())
        rec.setdefault('iso', now_iso(rec['t']))
        path = self.injections_path(rec['t'])
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, 'a') as fh:
            fh.write(json.dumps(rec, sort_keys=True) + '\n')
        return rec


# =========================================================================
# pre-checks
# =========================================================================
def preflight(rig, fault, live=False):
    """Everything that must be true before we are allowed to break anything.
    Raises Refused with a sentence the operator can act on."""
    if rig.journal.exists():
        raise Refused('an injection is already staged. Run '
                      '`tools/fault-rig restore --i-am-present` first.')

    if not rig.unit_active(COUCHD_UNIT):
        raise Refused('couchd is not active, so an injection would prove '
                      'nothing. Start it with `systemctl --user start couchd`.')
    st = rig.couchd_status()
    if not st:
        raise Refused('couchd wrote no status.json; it is running but not '
                      'observing. Check /tmp/couchd.log.')
    age = rig.now() - float(st.get('t') or 0)
    if age > STATUS_MAX_AGE_S:
        raise Refused('couchd status.json is %.0fs old (limit %.0fs) - it is '
                      'not observing. Restart it before injecting.'
                      % (age, STATUS_MAX_AGE_S))

    pids = rig.game_pids()
    needs = fault['needs_game'] or (live and fault.get('live_mode'))
    if needs and not pids:
        raise Refused('this injection needs a live game session and there is '
                      'none. Start a game first (phone Games tab, or a Kodi '
                      'tile), then run it again.')
    if fault['forbids_game'] and pids and not live:
        raise Refused('a real game session is running (%d processes). This '
                      'injection stages fake session state and must never '
                      'clobber a real one. Quit the game first '
                      '(`game-launch quit`), or use --live if the injection '
                      'supports it.' % len(pids))

    if rig.guard_alive():
        raise Refused('steam-input-guard is running right now, so a transition '
                      'is still landing. Wait about ten seconds and try again.')

    if fault['pause_legacy'] and not rig.unit_active(LEGACY_UNIT):
        raise Refused('%s is not active, so the rig cannot pause it and put it '
                      'back afterwards. Start it first: `systemctl --user '
                      'start %s`.' % (LEGACY_UNIT, LEGACY_UNIT))

    # Faults that stage a flag must not overwrite one that is genuinely there.
    # (--live works ON the real session, so its flags are supposed to exist.)
    for name in ('game-session', 'game-suspended'):
        if fault['forbids_game'] and not live and rig.flag(name) is not None:
            raise Refused('%s already exists (%r). Clear the console back to a '
                          'clean state before injecting.'
                          % (rig.flag_path(name), rig.flag(name)))
    if rig.decoys():
        raise Refused('decoy processes from an earlier run are still alive '
                      '(%s). Run `tools/fault-rig restore --i-am-present`.'
                      % ' '.join(str(p) for p in rig.decoys()))
    return {'game_pids': pids, 'status': st}


# =========================================================================
# the injections themselves
# =========================================================================
def stage(rig, fault, live=False):
    """Perform one fault. Returns a dict of facts for the marker (pids etc)."""
    name = fault['name']
    facts = {}

    if name == 'joystick-drift':
        session = rig.flag('game-session')
        suspended = rig.flag('game-suspended')
        want = not (session is not None and suspended is None)
        current = rig.joystick()
        if current is not want:
            raise Refused("Kodi's joystick setting is already %s, which is the "
                          'wrong value on its own - there is nothing to inject. '
                          'Let the console settle first.' % current)
        rig.set_joystick(not want, current)
        facts['want'] = 'kodi' if want else 'game'
        facts['set_to'] = not want

    elif name == 'orphaned-session':
        dead = dead_pid(rig)
        rig.write_flag('game-session', '%d steam %s' % (dead, DECOY_APPID))
        facts['launcher_pid'] = dead

    elif name == 'stale-suspended-flag':
        rig.write_flag('game-suspended', DECOY_APPID)

    elif name == 'lost-thaw':
        if live:
            pids = rig.game_pids()
            if rig.flag('game-suspended') is not None:
                raise Refused('the game is already paused, so a lost thaw '
                              'cannot be staged. Resume it first (PS tap or the '
                              'phone), then run this again.')
            rig.freeze(pids)
            facts['pids'] = pids
            facts['mode'] = 'live'
        else:
            pid = rig.spawn_decoy('reaper')
            rig.sleep(1.5)                 # let the tree scan see it running
            rig.freeze([pid])
            facts['pids'] = [pid]
            facts['mode'] = 'decoy'

    elif name == 'frozen-game-visible':
        # A faithful reproduction needs all three: a frozen process, the paused
        # flag that explains it, and the game's window on top. With the process
        # frozen AND the flag present, the stale-flag and lost-thaw repairs are
        # both correctly silent, so the only repair left is the one under test.
        pid = rig.spawn_decoy('reaper')
        rig.sleep(1.5)
        rig.freeze([pid])
        rig.write_flag('game-suspended', DECOY_APPID)
        win = rig.spawn_decoy_window()
        facts['pids'] = [pid]
        facts['window_pid'] = win

    elif name == 'bystander-process':
        pid = rig.spawn_decoy('bystander')
        facts['pid'] = pid
        rig.sleep(1.5)

    elif name == 'menu-capture':
        if fault.get('after_handoff'):
            rig.out('  waiting for your PS hold (the paused-game flag)...')
            if not wait_for_flag(rig, 'game-suspended', 60.0):
                raise Refused('no PS hold seen in 60s, so there was no guard '
                              'window to inject into. Nothing was changed.')
            rig.out('  handoff seen; opening the Steam menu now')
        if not os.path.exists(rig.flag_path('vpad.fifo')):
            rig.journal.add({'op': 'vpad-quit'})
            rig.vpad('up')
            rig.sleep(1.0)
        rig.vpad('press', 'guide')
        facts['via'] = 'vpad press guide'

    else:                                             # pragma: no cover
        raise Refused('no staging code for %r' % name)

    return facts


def dead_pid(rig):
    """A pid that is certainly not a process. Searching downward from the
    kernel's max keeps us far away from anything real."""
    for candidate in range(4194300, 4194000, -1):
        if not rig.alive(candidate):
            return candidate
    raise Refused('could not find a free pid number for the fake launcher')


def wait_for_flag(rig, name, seconds):
    deadline = rig.now() + seconds
    while rig.now() < deadline:
        if rig.flag(name) is not None:
            return True
        rig.sleep(0.5)
    return False


# =========================================================================
# detection: did couchd say the right thing, in time?
# =========================================================================
def match(rec, m, facts):
    kind = m['kind']
    if kind == 'intent':
        return (rec.get('kind') == 'intent'
                and rec.get('reason') == m['reason']
                and (not m.get('verb') or rec.get('verb') == m['verb']))
    if kind == 'invariant':
        return (rec.get('kind') == 'invariant'
                and rec.get('name') == m['name']
                and any(m['leak'] in str(l) for l in (rec.get('leaks') or ())))
    if kind == 'agreement-excludes':
        if rec.get('kind') != 'agreement':
            return False
        pid = facts.get('pid')
        return (pid not in (rec.get('couchd_would_freeze') or [])
                and pid not in (rec.get('game_pids_tree') or []))
    return False                                       # pragma: no cover


def violation(rec, m, facts):
    """The inverse of a negative matcher: proof couchd got it WRONG."""
    if m['kind'] != 'agreement-excludes' or rec.get('kind') != 'agreement':
        return False
    pid = facts.get('pid')
    return (pid in (rec.get('couchd_would_freeze') or [])
            or pid in (rec.get('game_pids_tree') or []))


def evaluate(records, t0, fault, facts):
    """[(label, ok, latency_or_None, detail, required)] - one row per
    expectation. Only the required rows decide pass or fail; the rest are
    context (couchd's leak invariant fires on its own schedule)."""
    rows = []
    for m in fault['expect']:
        label = m.get('reason') or m.get('name') or m['kind']
        if m.get('verb'):
            label = '%s -> %s' % (label, m['verb'])
        req = bool(m.get('required'))
        bad = [r for r in records if violation(r, m, facts)]
        if bad:
            rows.append((label, False, round(float(bad[0]['t']) - t0, 2),
                         'couchd claimed the decoy pid: %s'
                         % json.dumps(bad[0])[:160], req))
            continue
        hit = next((r for r in records if match(r, m, facts)), None)
        if hit is None:
            rows.append((label, False, None,
                         'not seen within %.0fs' % m['deadline_s'], req))
            continue
        lat = round(float(hit['t']) - t0, 2)
        ok = lat <= m['deadline_s']
        rows.append((label, ok, lat,
                     'within deadline %.0fs' % m['deadline_s'] if ok else
                     'LATE: deadline was %.0fs' % m['deadline_s'], req))
    return rows


def passed(rows):
    """True when every REQUIRED expectation was met."""
    req = [r for r in rows if r[4]]
    return bool(req) and all(r[1] for r in req)


def watch(rig, t0, fault, facts, seconds):
    """Poll couchd's shadow log until every expectation is met or the watch
    window closes. Read-only: it opens one file and parses JSON."""
    deadline = rig.now() + seconds
    rows = []
    while True:
        rows = evaluate(rig.shadow_records(t0), t0, fault, facts)
        if rows and all(r[1] for r in rows):
            break
        if rig.now() >= deadline:
            break
        rig.sleep(1.0)
    return rows


