#!/usr/bin/env python3
"""Compose a fullscreen game LOADING card for the curtain to show at launch.

game-launch raises tools/curtain over the Kodi -> Big Picture -> game window
shuffle so the room never sees the flip. The curtain shows one static frame;
this builds that frame: the game's hero art, darkened, with the game's logo
(or name) and a "LOADING" line with the Stagelight amber rule under it.

    loading-card <appid|mode> [screen_w screen_h]

Resolves art itself from the appid so game-launch only passes what it has.
Prints the PNG path on stdout (under /tmp, one per screen size, overwritten).
Every failure is a line on stderr + non-zero exit the caller throws away -
the curtain is cosmetic and a launch must never wait on or break for a
picture (tools/curtain's contract).
"""
import glob
import os
import re
import sys

HOME = os.path.expanduser('~')
LIBCACHE = os.path.join(HOME, '.steam/debian-installation/appcache/librarycache')
HERO_DIR = os.path.join(HOME, '.local/share/game-tiles/heroes')
LOGO_DIR = os.path.join(HOME, '.local/share/game-tiles/logos')
STEAMAPPS = os.path.join(HOME, '.steam/steam/steamapps')
PS4_DIR = os.path.join(HOME, 'games/ps4')
FONT_DIR = os.path.join(HOME, 'couch/kodi-addons/skin.couch/fonts/Figtree')
OUT_TMPL = '/tmp/couch-loading-%dx%d.png'


def steam_name(appid):
    for path in glob.glob(os.path.join(STEAMAPPS, 'appmanifest_%s.acf' % appid)):
        try:
            txt = open(path, encoding='utf-8', errors='replace').read()
        except OSError:
            continue
        m = re.search(r'"name"\s+"([^"]*)"', txt)
        if m:
            return m.group(1)
    return ''


def sfo_title(gdir):
    """TITLE from sce_sys/param.sfo - just enough of the binary format."""
    path = os.path.join(gdir, 'sce_sys', 'param.sfo')
    try:
        import struct
        data = open(path, 'rb').read()
        if data[:4] != b'\x00PSF':
            return ''
        key_off, dat_off, n = struct.unpack_from('<III', data, 8)
        for i in range(n):
            ko, fmt, dlen, dmax, do = struct.unpack_from('<HHIII', data,
                                                         20 + i * 16)
            key = data[key_off + ko:data.index(b'\x00', key_off + ko)]
            if key == b'TITLE':
                return data[dat_off + do:dat_off + do + dlen].split(
                    b'\x00')[0].decode('utf-8', 'replace')
    except Exception:
        pass
    return ''


def resolve(appid):
    """(hero_art_path or '', logo_path or '', title) for a Steam appid,
    a shadPS4 eboot path, or a bare mode string."""
    # Steam appid: numeric
    if str(appid).isdigit():
        base = os.path.join(LIBCACHE, str(appid))
        hero = os.path.join(HERO_DIR, '%s.jpg' % appid)
        if not os.path.isfile(hero):
            hits = glob.glob(os.path.join(base, '**', 'library_hero.jpg'),
                             recursive=True)
            hero = hits[0] if hits else ''
        logo = os.path.join(base, 'logo.png')
        return (hero, logo if os.path.isfile(logo) else '', steam_name(appid))
    # shadPS4 eboot path -> its folder's art; a hand-placed wordmark at
    # logos/<serial>.png (SteamGridDB) beats drawing the title as plain text,
    # and param.sfo's TITLE beats the serial when text is all we have.
    if os.path.sep in str(appid):
        gdir = os.path.dirname(appid)
        serial = os.path.basename(gdir)
        logo = os.path.join(LOGO_DIR, '%s.png' % serial)
        if not os.path.isfile(logo):
            logo = ''
        title = sfo_title(gdir) or serial
        # a mirrored text-free hero beats the dump art (pic1 bakes the
        # wordmark in, which doubles up under the logo overlay)
        hero = os.path.join(HERO_DIR, '%s.jpg' % serial)
        if os.path.isfile(hero):
            return (hero, logo, title)
        for cand in (os.path.join('sce_sys', 'pic1.png'), 'cover.png',
                     os.path.join('sce_sys', 'icon0.png')):
            p = os.path.join(gdir, cand)
            if os.path.isfile(p):
                # dump art carries its own title - the logo would double it
                return (p, '', title) if cand.endswith('pic1.png') else (p, logo, title)
        return ('', logo, title)
    return ('', '', str(appid).title())


def main():
    if len(sys.argv) < 2:
        sys.exit('usage: loading-card <appid|mode> [w h]')
    appid = sys.argv[1]
    sw = int(sys.argv[2]) if len(sys.argv) > 2 else 3840
    sh = int(sys.argv[3]) if len(sys.argv) > 3 else 2160

    from PIL import Image, ImageDraw, ImageFilter, ImageFont
    hero, logo, title = resolve(appid)

    canvas = Image.new('RGB', (sw, sh), (8, 9, 12))
    if hero and os.path.isfile(hero):
        try:
            with Image.open(hero) as im:
                im.load()
                art = im.convert('RGB')
            # cover-fit (fill the screen, crop overflow), then darken
            scale = max(sw / art.width, sh / art.height)
            art = art.resize((max(1, int(art.width * scale)),
                              max(1, int(art.height * scale))), Image.LANCZOS)
            ax = (art.width - sw) // 2
            ay = (art.height - sh) // 2
            art = art.crop((ax, ay, ax + sw, ay + sh))
            dark = Image.new('RGB', (sw, sh), (0, 0, 0))
            canvas = Image.blend(art, dark, 0.62)
        except Exception as e:
            sys.stderr.write('art failed: %s\n' % e)

    d = ImageDraw.Draw(canvas)

    def font(px, weight='SemiBold'):
        try:
            return ImageFont.truetype(
                os.path.join(FONT_DIR, 'Figtree-%s.ttf' % weight), px)
        except Exception:
            return ImageFont.load_default()

    cx, base = sw // 2, int(sh * 0.62)

    # the game's own logo, centred above the LOADING line, else its name
    placed = False
    if logo and os.path.isfile(logo):
        try:
            with Image.open(logo) as im:
                im.load()
                lg = im.convert('RGBA')
            lw = int(sw * 0.34)
            lh = int(lg.height * lw / lg.width)
            maxh = int(sh * 0.22)
            if lh > maxh:
                lh = maxh
                lw = int(lg.width * lh / lg.height)
            lg = lg.resize((lw, lh), Image.LANCZOS)
            canvas.paste(lg, (cx - lw // 2, base - lh - int(sh * 0.05)), lg)
            placed = True
        except Exception as e:
            sys.stderr.write('logo failed: %s\n' % e)
    if not placed and title:
        f = font(int(sh * 0.052), 'SemiBold')
        w = d.textlength(title, font=f)
        d.text((cx - w / 2, base - int(sh * 0.11)), title, font=f,
               fill=(236, 238, 241))

    # Spinner (Donnie, 8 Aug 2026: "instead of LOADING text, I want a
    # spinner"): an amber arc on a faint ring, pre-rendered as N frames
    # composited over the card's own pixels at the spinner rect, so the
    # curtain can animate it with plain opaque blits.
    from PIL import Image as _I
    n_frames, fps = 24, 12
    dia = max(56, int(sh * 0.072))
    sx, sy = cx - dia // 2, base + int(sh * 0.02)
    ss = 4  # supersample for smooth arcs
    big = dia * ss
    stroke = max(3 * ss, big // 14)
    pad = stroke
    frames = []
    for i in range(n_frames):
        fr = _I.new('RGBA', (big, big), (0, 0, 0, 0))
        fd = ImageDraw.Draw(fr)
        box = [pad, pad, big - pad, big - pad]
        fd.arc(box, 0, 360, fill=(236, 238, 241, 36), width=stroke)
        a0 = (360.0 / n_frames) * i
        fd.arc(box, a0, a0 + 100, fill=(255, 255, 255, 235), width=stroke)
        frames.append(fr.resize((dia, dia), Image.LANCZOS))
    strip = _I.new('RGB', (dia * n_frames, dia))
    base_crop = canvas.crop((sx, sy, sx + dia, sy + dia))
    for i, fr in enumerate(frames):
        cell = base_crop.copy()
        cell.paste(fr, (0, 0), fr)
        strip.paste(cell, (i * dia, 0))
    # frame 0 baked into the card so the very first blitted image already
    # shows the spinner (the curtain starts animating a beat later)
    canvas.paste(frames[0], (sx, sy), frames[0])

    out = OUT_TMPL % (sw, sh)
    strip_out = out[:-len('.png')] + '.spin.png'
    tmp = out + '.part'
    canvas.save(tmp, 'PNG')
    os.replace(tmp, out)
    tmp = strip_out + '.part'
    strip.save(tmp, 'PNG')
    os.replace(tmp, strip_out)
    print(out)
    print('spinner %s %d %d %d %d %d' % (strip_out, sx, sy, dia, n_frames, fps))


if __name__ == '__main__':
    try:
        main()
    except Exception as e:
        sys.stderr.write('loading-card: %s\n' % e)
        sys.exit(1)
