#!/usr/bin/env python3
"""Render the Couch UI sound set from a spec, with levels that are ASSERTED.

There is no sample library on this box, so the cues are synthesised. That is a
feature, not a compromise: every cue in the set is generated from the same few
primitives, so they are a FAMILY by construction - same timbre, same decay
shape, related pitches - rather than four unrelated noises that happen to be in
the same folder.

    tools/uisound-render            # render to the addon's resources/
    tools/uisound-render --dry-run  # print what would be written

Design notes and the measured calibration live in docs/specs/ui-sound.md.
Every cue is peak-normalised to an explicit target in dBFS and the result is
re-measured after writing, because "I set the amplitude" is not the same claim
as "the file is that loud".
"""
import argparse
import math
import os
import struct
import sys
import wave

SR = 48000          # matches audiooutput.samplerate on this box; no resampling
CHANNELS = 2
OUT_DEFAULT = os.path.expanduser(
    '~/couch/kodi-addons/resource.uisounds.couch/resources')


# ---------------------------------------------------------------- primitives

def _env(n, attack, decay, curve=4.0):
    """Attack/decay envelope in SAMPLES. Exponential decay, because a linear
    fade-out on a very short cue reads as a click at the end."""
    out = []
    for i in range(n):
        a = min(1.0, i / attack) if attack > 0 else 1.0
        d = math.exp(-curve * max(0.0, i - attack) / max(1, decay))
        out.append(a * d)
    return out


def tone(freq, dur, attack=0.002, decay=None, curve=4.0, harmonics=()):
    """A pitched cue: fundamental plus optional quiet harmonics."""
    n = int(SR * dur)
    decay = decay if decay is not None else n
    e = _env(n, int(SR * attack), int(decay if decay > 1 else SR * decay), curve)
    buf = []
    for i in range(n):
        t = i / SR
        v = math.sin(2 * math.pi * freq * t)
        for mult, amp in harmonics:
            v += amp * math.sin(2 * math.pi * freq * mult * t)
        buf.append(v * e[i])
    return buf


def noise(dur, attack=0.001, curve=8.0, seed=1):
    """A soft transient with no pitch - for cues that should read as a 'thud'
    or 'brush' rather than a note."""
    n = int(SR * dur)
    e = _env(n, int(SR * attack), n, curve)
    # deterministic LCG: the same build must produce the same bytes every time
    x = seed
    buf = []
    for i in range(n):
        x = (1103515245 * x + 12345) & 0x7FFFFFFF
        buf.append(((x / 0x3FFFFFFF) - 1.0) * e[i])
    return buf


def lowpass(buf, cutoff):
    """One-pole low-pass. Takes the glassy edge off a synthetic cue so it sits
    in a room instead of sitting on top of it."""
    a = math.exp(-2 * math.pi * cutoff / SR)
    out, prev = [], 0.0
    for v in buf:
        prev = (1 - a) * v + a * prev
        out.append(prev)
    return out


def mix(*layers):
    n = max(len(l) for l in layers)
    out = [0.0] * n
    for l in layers:
        for i, v in enumerate(l):
            out[i] += v
    return out


def peak_normalise(buf, target_dbfs):
    peak = max(abs(v) for v in buf) or 1.0
    gain = (10 ** (target_dbfs / 20.0)) / peak
    return [v * gain for v in buf]


def write_wav(path, buf, dry=False):
    data = b''.join(struct.pack('<hh', *(int(max(-1, min(1, v)) * 32767),) * 2)
                    for v in buf)
    if dry:
        return len(buf) / SR
    with wave.open(path, 'w') as w:
        w.setnchannels(CHANNELS)
        w.setsampwidth(2)
        w.setframerate(SR)
        w.writeframes(data)
    return len(buf) / SR


def measure(path):
    """Read the file back and report what is ACTUALLY in it."""
    with wave.open(path) as w:
        n = w.getnframes()
        raw = w.readframes(n)
        s = struct.unpack('<%dh' % (n * w.getnchannels()), raw)
        mono = s[0::2]
        peak = max(abs(v) for v in mono) / 32768
        rms = math.sqrt(sum(v * v for v in mono) / len(mono)) / 32768
        return (n / w.getframerate(),
                20 * math.log10(peak) if peak else -99,
                20 * math.log10(rms) if rms else -99)


# ------------------------------------------------------------------ the cues
#
# Every number here is argued in docs/specs/ui-sound.md. The short version:
#
#  * PEAK, not RMS, is the target, because Kodi sums overlapping sounds with no
#    limiter (ActiveAE mixes additively). The cursor tick can stack ~4 deep on a
#    held direction, so -26 dBFS peak sums to about -14 dBFS - still clear of
#    clipping. Peaking a UI cue near 0 dBFS, as two of Kodi's stock sounds do,
#    is how you get pumping on a soundbar.
#  * THE LADDER is roughly 6 dB per step of consequence, measured off Valve's
#    shipped Big Picture set. The whole family spans 8 dB (-26 to -18), inside
#    the ~10 dB spread Brewster/Patterson recommend so nothing stands out when
#    the volume goes up and nothing vanishes when it goes down.
#  * EVERYTHING RECURRING STAYS BELOW 5 kHz (Brewster). Above that it is thrown
#    away first by high-frequency hearing loss and by a modest soundbar.
#  * SHORT, because Kodi has NO rate limit - no 50 ms lockout like Valve's. The
#    cursor tick is the shortest thing in the set for exactly that reason.
#  * Harmonics, not pure sines: "simple tones such as sinewaves are not
#    effective" (Brewster). Each cue is a fundamental plus quiet partials,
#    low-passed so it sits in a room instead of on top of it.
#
# name          dur   freq  harmonics                 attack  curve  lp    peak
CUES = {
    # the reference. Fires on every direction press, so it is the shortest,
    # quietest thing here and it decays fast so repeats barely overlap.
    'cursor':  dict(dur=0.055, freq=1600, harm=((2, .30), (3, .12)),
                    atk=0.0015, curve=7.0, lp=5200, peak=-26.0),
    # confirm: warmer and lower than the tick, +6 dB.
    'select':  dict(dur=0.150, freq=1180, harm=((2, .40), (3, .18), (4, .07)),
                    atk=0.003, curve=4.2, lp=4200, peak=-20.0),
    # back: same family, falling contour, +4 dB.
    'back':    dict(dur=0.170, freq=880, harm=((2, .32), (3, .12)),
                    atk=0.004, curve=4.0, lp=3600, peak=-22.0, glide=-0.28),
    # error: fast attack, deliberately unresolved (a flat 7th against the
    # fundamental), so it reads as "no" without being loud.
    'error':   dict(dur=0.130, freq=2100, harm=((1.78, .55), (2, .22)),
                    atk=0.001, curve=6.0, lp=5000, peak=-20.0),
    # window open / close: the rare cues, so they get the top of the ladder and
    # the most air. Rising vs falling glide carries the direction.
    'in':      dict(dur=0.380, freq=760, harm=((2, .34), (3, .16), (5, .05)),
                    atk=0.010, curve=3.0, lp=4800, peak=-18.0, glide=+0.55),
    'out':     dict(dur=0.400, freq=760, harm=((2, .30), (3, .12)),
                    atk=0.010, curve=3.2, lp=4000, peak=-21.0, glide=-0.42),
    # launch: the biggest thing in the set and the rarest. Slow attack, so it
    # swells rather than clicks - it is covering the curtain, not a keypress.
    'launch':  dict(dur=0.750, freq=1500, harm=((1.5, .40), (2, .30), (3, .12)),
                    atk=0.240, curve=1.8, lp=4600, peak=-18.0, glide=+0.30),
}


def render_cue(spec):
    n = int(SR * spec['dur'])
    e = _env(n, int(SR * spec['atk']), n, spec['curve'])
    glide = spec.get('glide', 0.0)
    buf = []
    phase = 0.0
    for i in range(n):
        t = i / SR
        # a gentle pitch glide gives the family its direction without needing
        # a second note; ratio is per-cue and can be negative (falling)
        f = spec['freq'] * (1.0 + glide * (t / spec['dur']))
        phase += 2 * math.pi * f / SR
        v = math.sin(phase)
        for mult, amp in spec['harm']:
            v += amp * math.sin(phase * mult)
        buf.append(v * e[i])
    buf = lowpass(buf, spec['lp'])
    return peak_normalise(buf, spec['peak'])


if __name__ == '__main__':
    ap = argparse.ArgumentParser()
    ap.add_argument('--dry-run', action='store_true')
    ap.add_argument('--out', default=OUT_DEFAULT)
    a = ap.parse_args()
    if not a.dry_run:
        os.makedirs(a.out, exist_ok=True)
    print('%-9s %7s %9s %9s   %s' % ('cue', 'len', 'peak', 'rms', 'target'))
    bad = []
    for name, spec in CUES.items():
        path = os.path.join(a.out, name + '.wav')
        write_wav(path, render_cue(spec), a.dry_run)
        if a.dry_run:
            print('%-9s %6.0fms %9s %9s   %.1f dBFS (dry run)'
                  % (name, spec['dur'] * 1000, '-', '-', spec['peak']))
            continue
        dur, pk, rms = measure(path)
        print('%-9s %6.0fms %6.1f dB %6.1f dB   want %.1f'
              % (name, dur * 1000, pk, rms, spec['peak']))
        # ASSERT the file is what we asked for, rather than trusting the maths
        if abs(pk - spec['peak']) > 0.6:
            bad.append('%s: peak %.1f, wanted %.1f' % (name, pk, spec['peak']))
    if bad:
        print('\nLEVEL ASSERTION FAILED:')
        for b in bad:
            print('  ' + b)
        sys.exit(1)
    print('\nall cues within 0.6 dB of target; 48kHz 16-bit stereo')
