_FONTS = {}


def load_font(size, weight='SemiBold'):
    """One of the skin's own Figtree weights at `size` px - the same files
    Font.xml points the Couch_* fonts at, so the deck's type IS the TV's."""
    key = (weight, size)
    if key in _FONTS:
        return _FONTS[key]
    from PIL import ImageFont
    font = None
    for name in ('Figtree-%s.ttf' % weight, 'Figtree-SemiBold.ttf',
                 'Figtree-Medium.ttf', 'Figtree-Regular.ttf'):
        p = os.path.join(FONT_DIR, name)
        if os.path.exists(p):
            try:
                font = ImageFont.truetype(p, size)
                break
            except OSError:
                pass
    if font is None:
        font = ImageFont.load_default()
    _FONTS[key] = font
    return font


def short_label(title):
    """'shadPS4 v0.17.0 | CUSA00900 - Bloodborne <01.09> · paused' is a
    window title, not a card label. Same cleanup as the Kodi dialog's
    pretty_title (default.py): strip the emulator preamble and the version
    tag, pass anything human-named through untouched. The ' · paused'
    marker is stripped here and re-added by card_label, so callers that
    want the bare name get it."""
    t = title.replace(' · paused', '')
    m = re.match(r'^shadPS4\b[^|]*\|\s*[A-Z]+\d+\s*-\s*(.*)$', t)
    if m:
        t = re.sub(r'\s*<[^>]*>', '', m.group(1))
    t = t.strip(' |')
    return (t[:33] + '…') if len(t) > 34 else (t or title[:28])


_SCRIM_CACHE = {}


def deck_scrim(out_w, out_h):
    """The deck's backdrop: deck-scrim.png (a light veil up top so the room
    can still see the game, easing to near-black where the deck sits)
    stretched to the output, exactly as the XML stretches it to 1920x1080.
    Falls back to a procedural smoothstep of the measured curve if the
    addon's media dir ever moves. Cached; callers get a fresh copy."""
    from PIL import Image
    key = (out_w, out_h)
    cached = _SCRIM_CACHE.get(key)
    if cached is None:
        alpha = None
        try:
            tex = Image.open(os.path.join(MEDIA_DIR, 'deck-scrim.png'))
            alpha = tex.convert('RGBA').split()[-1].resize(
                (out_w, out_h), Image.BILINEAR)
        except Exception:
            y0, y1 = (v * out_h / DESIGN_H for v in SCRIM_EASE)
            col = Image.new('L', (1, out_h))
            col.putdata([
                int(SCRIM_TOP_A + (255 - SCRIM_TOP_A)
                    * (0.0 if y <= y0 else 1.0 if y >= y1 else
                       (lambda t: t * t * (3 - 2 * t))((y - y0) / (y1 - y0))))
                for y in range(out_h)])
            alpha = col.resize((out_w, out_h), Image.NEAREST)
        base = Image.new('RGBA', (out_w, out_h), (0, 0, 0, 255))
        base.putalpha(alpha)
        _SCRIM_CACHE[key] = base
    return _SCRIM_CACHE[key].copy()


def fetch_thumb(row, timeout=2.0):
    """The row's art as a PIL image, or None. Paused rows carry the
    freeze-frame; live windows get the compositor's winthumb - the same two
    sources the phone switcher shows."""
    from PIL import Image
    import io
    url = row.get('thumb') or ('/api/art/winthumb?id=%s' % row['id']
                               if str(row.get('id', '')).startswith('0x')
                               else None)
    if not url:
        return None
    if url.startswith('/'):
        url = API + url
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return Image.open(io.BytesIO(r.read())).convert('RGB')
    except Exception:
        return None


class ThumbCache:
    """fetch_thumb, remembered - the resident's art never refetches per
    show or per redraw. Keyed by the row's thumb URL: a paused row's
    freeze-frame gets a fresh filename per suspend (pause-snap's epoch-ms
    stamp), so a new snap misses the cache by construction and get() is
    always safe at show time; live winthumbs share one URL, so the lazy
    refresh calls refetch() to keep them current, falling back to the
    cached copy when a fetch fails (stale art beats a blank card)."""

    def __init__(self, fetch=None):
        self._fetch = fetch or fetch_thumb
        self._by_key = {}

    @staticmethod
    def key(row):
        return row.get('thumb') or str(row.get('id', ''))

    def get(self, row):
        k = self.key(row)
        if k not in self._by_key:
            self._by_key[k] = self._fetch(row)
        return self._by_key[k]

    def refetch(self, row):
        k = self.key(row)
        fresh = self._fetch(row)
        if fresh is not None:
            self._by_key[k] = fresh
        return self._by_key.get(k)


def _crop_cover(img, w, h):
    """Centre-crop `img` to cover w x h, like the XML's aspectratio=scale
    with center alignment."""
    want = w / h
    have = img.width / img.height
    if have > want:
        cw = int(img.height * want)
        img = img.crop(((img.width - cw) // 2, 0,
                        (img.width + cw) // 2, img.height))
    else:
        ch = int(img.width / want)
        img = img.crop((0, (img.height - ch) // 2,
                        img.width, (img.height + ch) // 2))
    return img.resize((w, h))


def _ellipsize(draw, text, font, max_w):
    if draw.textlength(text, font=font) <= max_w:
        return text
    while text and draw.textlength(text + '…', font=font) > max_w:
        text = text[:-1].rstrip()
    return text + '…'


_ICONS = {}


def _icon(name, size, color):
    """A media glyph from the addon's own icon-*.png, tinted the way the
    XML colordiffuses it (the file's alpha is the shape; the fill is
    ours). None if the file is missing - the caller falls back to the
    pill's text label, exactly as the XML does."""
    key = (name, size, color)
    if key not in _ICONS:
        from PIL import Image
        try:
            src = Image.open(os.path.join(MEDIA_DIR, name)).convert(
                'RGBA').resize((size, size))
            tinted = Image.new('RGBA', (size, size), color + (255,))
            tinted.putalpha(src.split()[-1])
        except Exception:
            tinted = None
        _ICONS[key] = tinted
    return _ICONS[key]


def compose_strip(rows, focus, out_w, out_h, thumbs, power_focus=None,
                  spotify=None, media_focus=None):
    """The whole deck as one fullscreen RGBA image, a PIL re-creation of
    script-couch-switcher.xml: the eased scrim, the POWER capsules, the
    spotify cluster (drawn only while `spotify` says a phone session is
    live - an inactive answer leaves the sheet pixel-identical to the deck
    before the bar existed), the SWITCH TO rail. Exactly one of the three
    is lit: power_focus/media_focus None+None means the rail card `focus`
    is (the XML gates every focus mark on ITS list having focus). Redrawn
    per focus move - tens of ms of PIL at 4K, nothing animates, the move
    IS the transition."""
    from PIL import Image, ImageDraw
    s = out_h / DESIGN_H

    def px(v):
        return round(v * s)

    n = len(rows)
    _w, _h, tile_w, tile_h, _gap, xs = layout(n, out_w, out_h)
    # The Kodi list scrolls; here, if the rail outgrows the screen, slide it
    # left just enough to keep the focused card inside the right margin.
    # (rail_i keeps marking the current card while the power bar is lit,
    # so the slide holds steady across a zone hop, like Kodi's scroll.)
    edge = out_w - px(120)
    over = xs[focus][0] + tile_w - edge if n else 0
    if over > 0:
        xs = [(x - over, y) for x, y in xs]

    img = deck_scrim(out_w, out_h)
    glass = Image.new('RGBA', (out_w, out_h), (0, 0, 0, 0))
    d = ImageDraw.Draw(glass)
    cap_font = load_font(px(FONT_CAPTION[1]), FONT_CAPTION[0])
    lab_font = load_font(px(FONT_LABEL[1]), FONT_LABEL[0])
    emph_font = load_font(px(FONT_EMPH[1]), FONT_EMPH[0])

    # Eyebrows (Couch_Caption, muted).
    d.text((px(EYEBROW_POWER_XY[0]), px(EYEBROW_POWER_XY[1])), 'POWER',
           font=cap_font, fill=MUTED + (255,), anchor='lm')
    d.text((px(EYEBROW_SWITCH_XY[0]), px(EYEBROW_SWITCH_XY[1])), 'SWITCH TO',
           font=cap_font, fill=MUTED + (255,), anchor='lm')

    # The power capsules: translucent white pills, the focused one filling
    # white with ink text - the deck's one focus grammar.
    ch = px(CAPSULE_H)
    for j, (label, _key) in enumerate(POWER_ACTIONS):
        cx = px(CAPSULE_X0 + j * CAPSULE_PITCH)
        cy = px(CAPSULE_Y)
        lit = power_focus == j
        d.rounded_rectangle(
            (cx, cy, cx + px(CAPSULE_W), cy + ch), radius=ch // 2,
            fill=(255, 255, 255, CAPSULE_FOCUS_A if lit else GLASS_A))
        d.text((cx + px(CAPSULE_W) / 2, cy + ch / 2), label, font=lab_font,
               fill=(INK if lit else REST_TEXT) + (255,), anchor='mm')

    # The spotify cluster: amber dot + now-playing eyebrow, three icon
    # pills. Gated whole on an active session, like the XML's
    # !String.IsEmpty(Window.Property(couch.spotify)).
    if spotify_active(spotify):
        d.ellipse((px(DOT_XY[0]) - px(DOT_R), px(DOT_XY[1]) - px(DOT_R),
                   px(DOT_XY[0]) + px(DOT_R), px(DOT_XY[1]) + px(DOT_R)),
                  fill=AMBER + (255,))
        d.text((px(MEDIA_EYEBROW_X), px(EYEBROW_POWER_XY[1])),
               _ellipsize(d, now_playing_label(spotify), cap_font,
                          px(MEDIA_EYEBROW_W)),
               font=cap_font, fill=MUTED + (255,), anchor='lm')
        for j, (label, icon_name) in enumerate(media_items(spotify)):
            mx = px(MEDIA_X0 + j * MEDIA_PITCH)
            lit = media_focus == j
            d.rounded_rectangle(
                (mx, px(CAPSULE_Y), mx + px(MEDIA_CAPSULE_W),
                 px(CAPSULE_Y) + ch), radius=ch // 2,
                fill=(255, 255, 255, CAPSULE_FOCUS_A if lit else GLASS_A))
            glyph = _icon(icon_name, px(MEDIA_ICON),
                          INK if lit else REST_TEXT)
            centre = (mx + px(MEDIA_CAPSULE_W) / 2, px(CAPSULE_Y) + ch / 2)
            if glyph is not None:
                glass.paste(glyph, (round(centre[0] - px(MEDIA_ICON) / 2),
                                    round(centre[1] - px(MEDIA_ICON) / 2)),
                            glyph)
            else:
                d.text(centre, label, font=lab_font,
                       fill=(INK if lit else REST_TEXT) + (255,),
                       anchor='mm')

    # The rail's glass panels (and the no-art cards' centred names).
    rail_lit = power_focus is None and media_focus is None
    for i, row in enumerate(rows):
        x, y = xs[i]
        focused = rail_lit and i == focus
        d.rounded_rectangle(
            (x, y, x + tile_w, y + tile_h), radius=px(CARD_RADIUS),
            fill=(255, 255, 255, GLASS_FOCUS_A if focused else GLASS_A))
        if thumbs.get(i) is None:
            d.text((x + tile_w / 2, y + tile_h / 2),
                   _ellipsize(d, card_label(row), lab_font, tile_w - px(16)),
                   font=lab_font,
                   fill=(BRIGHT_TEXT if focused else REST_TEXT) + (255,),
                   anchor='mm')
    img.alpha_composite(glass)

    # The art, rounded by the mask, dimmed to 85% at rest and full-bright
    # under focus (the XML's D8FFFFFF diffuse against none).
    mask_full = Image.new('L', (tile_w, tile_h), 0)
    ImageDraw.Draw(mask_full).rounded_rectangle(
        (0, 0, tile_w - 1, tile_h - 1), radius=px(CARD_RADIUS), fill=255)
    mask_rest = mask_full.point(lambda p: p * ART_REST_A // 255)
    for i in range(n):
        th = thumbs.get(i)
        if th is None:
            continue
        x, y = xs[i]
        focused = rail_lit and i == focus
        img.paste(_crop_cover(th, tile_w, tile_h), (x, y),
                  mask_full if focused else mask_rest)

    # The lit card's white ring and its title beneath (Couch_Emph).
    if rail_lit and n:
        top = Image.new('RGBA', (out_w, out_h), (0, 0, 0, 0))
        d2 = ImageDraw.Draw(top)
        x, y = xs[focus]
        m = px(RING_OUT)
        d2.rounded_rectangle(
            (x - m, y - m, x + tile_w + m, y + tile_h + m),
            radius=px(RING_RADIUS), outline=(255, 255, 255, 255),
            width=max(2, px(RING_STROKE)))
        d2.text((x, y + tile_h + px(TITLE_DY)),
                _ellipsize(d2, card_label(rows[focus]), emph_font,
                           px(TITLE_W)),
                font=emph_font, fill=BRIGHT_TEXT + (255,), anchor='lm')
        img.alpha_composite(top)
    return img


