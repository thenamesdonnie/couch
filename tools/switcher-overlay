def say(msg):
    print('switcher-overlay: %s' % msg, file=sys.stderr, flush=True)


KODI_RPC = 'http://localhost:8090/jsonrpc'
KODI_AUTH = 'kodi:$KODI_PASSWORD'       # game-launch's jrpc, same box, same rule


def kodi_joystick(enabled):
    """Kodi sits BEHIND the rail with its joystick input live (the suspend
    routed the pad to it) - without this, every dpad press navigates the
    invisible home row and Cross launches whatever it landed on. Same
    setting game-launch's pad_to_game/pad_to_kodi flip. Failures are log
    lines: a rail that refuses to open because Kodi was down would strand
    the player worse than a background-navigation glitch."""
    import base64
    body = json.dumps({'jsonrpc': '2.0', 'id': 1,
                       'method': 'Settings.SetSettingValue',
                       'params': {'setting': 'input.enablejoystick',
                                  'value': bool(enabled)}}).encode()
    req = urllib.request.Request(KODI_RPC, data=body, headers={
        'content-type': 'application/json',
        'authorization': 'Basic ' + base64.b64encode(
            KODI_AUTH.encode()).decode()})
    try:
        with urllib.request.urlopen(req, timeout=3) as r:
            r.read()
        say('kodi joystick -> %s' % enabled)
    except (urllib.error.URLError, OSError) as e:
        say('kodi joystick toggle failed (%s)' % e)


def power_dispatch(action):
    """Fire a power-bar pick EXACTLY as the Kodi dialog does (default.py):
    Addons.ExecuteAddon on script.tvpoweroff with params [action], over
    JSON-RPC. The switcher holds no power logic of its own - tvpoweroff
    owns what 'quit'/'pad_off'/'all_off' mean, in one home."""
    import base64
    body = json.dumps({'jsonrpc': '2.0', 'id': 1,
                       'method': 'Addons.ExecuteAddon',
                       'params': {'addonid': POWER_ADDON,
                                  'params': [action]}}).encode()
    req = urllib.request.Request(KODI_RPC, data=body, headers={
        'content-type': 'application/json',
        'authorization': 'Basic ' + base64.b64encode(
            KODI_AUTH.encode()).decode()})
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            r.read()
        say('power action %s -> %s' % (action, POWER_ADDON))
    except (urllib.error.URLError, OSError) as e:
        say('power action %s failed (%s)' % (action, e))


def fetch_rows():
    seam = os.environ.get('SWITCHER_OVERLAY_ROWS')
    if seam:
        with open(seam) as f:
            return pick_rows(json.load(f))
    try:
        with urllib.request.urlopen(API + '/api/windows', timeout=3) as r:
            return pick_rows(json.load(r))
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise RuntimeError('no window list from the couch server: %s' % e)


def fetch_spotify():
    """What the spotifyd receiver is doing, or {} - NEVER an exception
    (default.py's _spotify_status rule): a slow or absent endpoint
    degrades to the deck as it was before the bar existed."""
    seam = os.environ.get('SWITCHER_OVERLAY_SPOTIFY')
    if seam:
        try:
            with open(seam) as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}
    try:
        with urllib.request.urlopen(API + '/api/spotify', timeout=2) as r:
            return json.load(r)
    except Exception as e:  # decoration must never cost the deck
        say('spotify status failed (%s)' % e)
        return {}


def spotify_command(cmd):
    """Fire a transport command exactly as the Kodi dialog does
    (default.py): POST /api/spotify/<cmd> with an empty JSON body; returns
    the server's fresh status so the pills redraw from the answer."""
    req = urllib.request.Request(API + '/api/spotify/' + cmd, data=b'{}',
                                 headers={'content-type': 'application/json'})
    with urllib.request.urlopen(req, timeout=5) as r:
        return json.load(r)


def activate(row_id):
    req = urllib.request.Request(
        API + '/api/windows/activate',
        data=json.dumps({'id': row_id}).encode(),
        headers={'content-type': 'application/json'})
    # Activating a paused row resumes the game, which takes a moment.
    with urllib.request.urlopen(req, timeout=20) as r:
        r.read()


def fresh_frame_at(dirpath, now_ms, within_ms=6000):
    """True when a freeze-frame captured within `within_ms` of now exists.
    Filename convention is pause-snap's (<name>__<epoch_ms>.jpg)."""
    try:
        names = os.listdir(dirpath)
    except OSError:
        return False
    for n in names:
        if not n.endswith('.jpg') or n.endswith(('.tile.jpg', '.full.jpg')):
            continue
        stem = n[:-len('.jpg')]
        tail = stem.rsplit('__', 1)[-1]
        if tail.isdigit() and abs(now_ms - int(tail)) <= within_ms:
            return True
    return False


def rail_already_up():
    """The singleton check: a live pid in the flag means the rail is on
    screen and this invocation should quietly stand down."""
    try:
        pid = int(open(OVERLAY_FLAG).read().strip())
    except (OSError, ValueError):
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        try:
            os.remove(OVERLAY_FLAG)     # stale corpse; clear it
        except OSError:
            pass
        return False


def open_pads():
    with open('/proc/bus/input/devices') as f:
        nodes = pad_nodes(parse_devices(f.read()))
    fds = []
    for node in nodes:
        try:
            fds.append(os.open(node, os.O_RDONLY | os.O_NONBLOCK))
        except OSError as e:
            say('cannot open %s (%s)' % (node, e))
    return fds


def wait_for_fresh_frame():
    """Give the gesture's own pause-snap FRAME_WAIT_S to land. Bounded;
    no frame is only a cosmetic loss (the paused tile shows stale art)."""
    deadline = time.monotonic() + FRAME_WAIT_S
    while time.monotonic() < deadline:
        if fresh_frame_at(PAUSED_DIR, int(time.time() * 1000)):
            return True
        time.sleep(0.1)
    return False


def deck_loop(overlay, rows, thumbs, spotify, fds, stop, listen_sock=None,
              sock_handler=None, refresh_once=None):
    """Drive the mapped deck until an outcome. Returns
    (outcome, detail, rows): outcome in 'picked' (detail = the row),
    'power' (detail = the action key), 'cancel', 'superseded' (the
    suspended flag cleared underneath us), 'stopped' (a signal, or the
    resident's socket said so). Media picks stay inside - skipping is a
    repeat-press activity (default.py's rule).

    The resident threads its listening socket in (`listen_sock` +
    `sock_handler(conn, msg)` -> outcome-or-None), so a second show is
    answered while mapped; `refresh_once` runs after the first paint and
    trues up what the pre-baked sheet guessed (the freshly-paused row's
    marker and freeze-frame), keeping focus on the same row id."""
    st = PadState()
    zone, power_i, media_i = 'rail', 0, 0    # the deck opens on the rail,
    focus = initial_focus(rows)              # never on anything that turns
                                             # the room off
    def redraw():
        overlay.draw(compose_strip(
            rows, focus, overlay.out_w, overlay.out_h, thumbs,
            power_i if zone == 'power' else None, spotify,
            media_i if zone == 'media' else None))

    if refresh_once is not None:
        fresh = refresh_once()
        if fresh is not None:
            new_rows, new_thumbs, new_spotify = fresh
            focus = merge_focus(rows, new_rows, focus)
            rows, thumbs, spotify = new_rows, new_thumbs, new_spotify
            if zone == 'media' and not spotify_active(spotify):
                zone = 'rail'
            redraw()

    while not stop['sig']:
        # Superseded from outside: the PS button's own resume clears the
        # flag; a rail with no frozen game under it is a lie.
        if not os.path.exists(SUSPENDED_FLAG):
            say('suspended flag gone - closing (superseded)')
            return 'superseded', None, rows
        extra = [listen_sock] if listen_sock is not None else []
        ready, _, _ = select.select(fds + extra, [], [], 0.25)
        action = None
        for fd in ready:
            if listen_sock is not None and fd is listen_sock:
                out = sock_handler()
                if out is not None:
                    return out, None, rows
                continue
            try:
                buf = os.read(fd, EVENT_SIZE * 64)
            except OSError:
                continue
            for ev in decode_events(buf):
                action = pad_action(ev, st) or action
        if not action:
            continue
        if action in ('left', 'right', 'up', 'down'):
            moved = deck_move(zone, focus, power_i, media_i, action,
                              len(rows),
                              3 if spotify_active(spotify) else 0)
            if moved != (zone, focus, power_i, media_i):
                zone, focus, power_i, media_i = moved
                redraw()
        elif action == 'select' and zone == 'media':
            # A media pick does NOT close the deck: fire the verb, redraw
            # pill + now-playing line from the fresh answer.
            cmd, next_playing = media_click(spotify, media_i)
            say('spotify: %s' % cmd)
            try:
                fresh = spotify_command(cmd)
            except (urllib.error.URLError, OSError, ValueError) as e:
                say('spotify %s failed (%s)' % (cmd, e))
                continue
            if not fresh.get('active'):
                # The phone walked away mid-press. Park focus somewhere
                # real BEFORE hiding the bar (default.py does the same).
                spotify = {}
                zone = 'rail'
            else:
                # The pill reflects INTENT, never the server's lagging
                # read; a skip carries the old state through.
                fresh['playing'] = next_playing
                spotify = fresh
            redraw()
        elif action == 'select' and zone == 'power':
            say('power: %s' % POWER_ACTIONS[power_i][1])
            return 'power', POWER_ACTIONS[power_i][1], rows
        elif action == 'select':
            say('picked: %s' % rows[focus]['title'])
            return 'picked', rows[focus], rows
        elif action == 'back':
            say('cancelled')
            return 'cancel', None, rows
    return 'stopped', None, rows


class StepRunner:
    """Executes the pure plans (show_steps / finish_steps) against the
    real world. One home for the side-effect ordering both modes share;
    `unmap` is the only verb the two spell differently (the one-shot
    destroys its windows, the resident keeps them for the next show).
    run() returns False the moment a step refuses - only open_pads can -
    so an aborted show never half-maps."""

    def __init__(self, overlay, unmap, write_flag, draw):
        self.overlay = overlay
        self._unmap = unmap
        self._write_flag = write_flag
        self._draw = draw
        self.fds = []
        self.frame_wait_ms = 0

    def run(self, steps):
        for step in steps:
            name, args = step[0], step[1:]
            if name == 'open_pads':
                self.fds = ([] if os.environ.get('SWITCHER_OVERLAY_NO_PAD')
                            else open_pads())
                if not self.fds \
                        and not os.environ.get('SWITCHER_OVERLAY_NO_PAD'):
                    say('no pad to read - nothing could ever be picked')
                    return False
            elif name == 'frame_wait':
                t0 = time.monotonic()
                wait_for_fresh_frame()
                self.frame_wait_ms = int((time.monotonic() - t0) * 1000)
            elif name == 'map':
                self.overlay.map_now()
            elif name == 'draw':
                self._draw()
            elif name == 'write_flag':
                self._write_flag()
            elif name == 'joystick':
                if self.fds:
                    kodi_joystick(args[0])
            elif name == 'unmap':
                try:
                    self._unmap()
                except Exception as e:
                    # A dead nested display must not strand the steps that
                    # matter more: the activate, the joystick, the flag.
                    say('unmap failed (%s)' % e)
            elif name == 'activate':
                try:
                    activate(args[0])
                except (urllib.error.URLError, OSError) as e:
                    say('activate %s failed (%s)' % (args[0], e))
            elif name == 'power':
                power_dispatch(args[0])
            elif name == 'remove_flag':
                try:
                    os.remove(OVERLAY_FLAG)
                except OSError:
                    pass
            elif name == 'close_pads':
                for fd in self.fds:
                    try:
                        os.close(fd)
                    except OSError:
                        pass
                self.fds = []
        return True


def write_overlay_flag():
    try:
        with open(OVERLAY_FLAG, 'w') as f:
            f.write(str(os.getpid()))
    except OSError as e:
        say('cannot announce the rail (%s)' % e)


# =========================================================================
# the resident daemon (and its client half)
# =========================================================================
def resident_show(display, resume_on_cancel=True, timeout=3.0):
    """Ask a live resident rail to map. True when a resident accepted the
    show (or already has it up); False means run the one-shot path. The
    resident acks before it performs (show_reply), so this returns in
    milliseconds either way."""
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(RESIDENT_SOCK)
        s.sendall((json.dumps({'cmd': 'show', 'display': display,
                               'resume_on_cancel': resume_on_cancel})
                   + '\n').encode())
        reply = json.loads(s.recv(4096).decode() or '{}')
        s.close()
        if not reply.get('ok'):
            say('resident refused the show: %s' % reply.get('error'))
        return bool(reply.get('ok'))
    except (OSError, ValueError):
        return False


class ResidentRail:
    """The rail that lives with the game session: window built and baked,
    plane unmapped, waiting on the control socket. See the module
    docstring's RESIDENT MODE section for the why."""

    def __init__(self, display):
        self.display = display
        self.overlay = None
        self.sock = None
        self.mapped = False
        self.stop = {'sig': False}
        self.rows, self.thumbs, self.spotify = [], {}, {}
        self.baked = None
        self.tc = ThumbCache()
        self.last_refresh = 0.0     # scheduling clock (0 = refresh due now)
        self.baked_at = 0.0         # when the sheet was really composed
        self.resume_on_cancel = True
        self.pending_show = None

    # -- cache ------------------------------------------------------------
    def refresh(self):
        """Re-fetch rows/spotify, refetch thumbs through the cache,
        recompose the sheet and pre-bake its BGRA bytes. The hidden-side
        work that makes show map-plus-draw."""
        try:
            rows = fetch_rows()
        except RuntimeError as e:
            say('refresh: %s' % e)
            self.last_refresh = time.monotonic()
            return False
        spotify = fetch_spotify()
        thumbs = {i: self.tc.refetch(r) for i, r in enumerate(rows)}
        sheet = compose_strip(rows, initial_focus(rows), self.overlay.out_w,
                              self.overlay.out_h, thumbs, spotify=spotify)
        self.rows, self.thumbs, self.spotify = rows, thumbs, spotify
        self.baked = bake_bgra(sheet)
        self.last_refresh = self.baked_at = time.monotonic()
        return True

    def _refresh_for_show(self):
        """The just-suspended world, fetched fast right after the instant
        first paint: the game row grew its ' · paused' marker and its
        freeze-frame thumb (a NEW url, so the cache misses into a fetch by
        construction). Returns (rows, thumbs, spotify) or None."""
        try:
            rows = fetch_rows()
        except RuntimeError:
            return None
        spotify = fetch_spotify()
        thumbs = {i: self.tc.get(r) for i, r in enumerate(rows)}
        self.rows, self.thumbs, self.spotify = rows, thumbs, spotify
        self.last_refresh = time.monotonic()
        return rows, thumbs, spotify

    # -- the show itself --------------------------------------------------
    def do_show(self, t0):
        runner = StepRunner(self.overlay, self.overlay.unmap_now,
                            write_overlay_flag,
                            lambda: self.overlay.draw_baked(self.baked))
        steps = show_steps(False, rail_already_up(),
                           os.path.exists(SUSPENDED_FLAG))
        if not runner.run(steps):
            return
        self.mapped = True
        # The latency this whole mode exists to buy, measured every time.
        say('show: signal-to-mapped %dms (frame-wait %dms, sheet baked '
            '%.0fs ago)' % (int((time.monotonic() - t0) * 1000),
                            runner.frame_wait_ms,
                            time.monotonic() - self.baked_at))
        try:
            outcome, detail, rows = deck_loop(
                self.overlay, self.rows, self.thumbs, self.spotify,
                runner.fds, self.stop, listen_sock=self.sock,
                sock_handler=self.handle_conn,
                refresh_once=self._refresh_for_show)
        except Exception:
            # Whatever broke mid-deck, the screen and pad must come back;
            # the run loop decides whether the session itself died.
            outcome, detail, rows = 'stopped', None, self.rows
            raise
        finally:
            steps, _ = finish_steps(outcome, detail,
                                    paused_row=first_paused(rows),
                                    resume_on_cancel=self.resume_on_cancel)
            runner.run(steps)
            self.mapped = False
            # The world just changed under the cache (a resume, a raise):
            # re-bake on the next idle beat rather than in the player's
            # face.
            self.last_refresh = 0.0

    # -- the control surface ----------------------------------------------
    def handle_conn(self, timeout=2.0):
        """One connection, one line, one reply. Runs from the idle loop
        AND from inside deck_loop (a poke while mapped), so it must decide
        from self.mapped. Returns an outcome to hand deck_loop, or None."""
        try:
            conn, _ = self.sock.accept()
        except OSError:
            return None
        outcome = None
        with conn:
            conn.settimeout(timeout)
            try:
                line = conn.recv(4096).decode('utf-8', 'replace')
                msg = parse_command(line)
            except (OSError, ValueError) as e:
                self._reply(conn, {'ok': False, 'error': str(e)})
                return None
            cmd = msg['cmd']
            if cmd == 'show':
                reply, should_map = show_reply(msg, self.display,
                                               self.mapped,
                                               rail_already_up())
                self._reply(conn, reply)
                if should_map:
                    self.resume_on_cancel = bool(
                        msg.get('resume_on_cancel', True))
                    self.pending_show = time.monotonic()
            elif cmd == 'hide':
                self._reply(conn, {'ok': True})
                if self.mapped:
                    outcome = 'stopped'
            elif cmd == 'quit':
                self._reply(conn, {'ok': True, 'stopping': True})
                self.stop['sig'] = True
                if self.mapped:
                    outcome = 'stopped'
            elif cmd == 'status':
                self._reply(conn, {
                    'ok': True, 'display': self.display,
                    'mapped': self.mapped, 'rows': len(self.rows),
                    'baked_age_s': round(
                        time.monotonic() - self.baked_at, 1)})
            else:
                self._reply(conn, {'ok': False,
                                   'error': 'unknown cmd %r' % cmd})
        return outcome

    @staticmethod
    def _reply(conn, obj):
        try:
            conn.sendall((json.dumps(obj) + '\n').encode())
        except OSError:
            pass

    # -- lifetime ---------------------------------------------------------
    def session_gone(self):
        """The wrapped session this rail belongs to has ended: the display
        bridge no longer names our display (game-launch cleared it in
        teardown, or a new launch swept it), or the nested X server itself
        is gone - which the sync probe notices as a dropped connection."""
        try:
            bridge = open(BRIDGE_FLAG).read().strip()
        except OSError:
            return 'display bridge cleared'
        if bridge != self.display:
            return 'display bridge now names %s' % bridge
        try:
            self.overlay.dpy.sync()
        except Exception as e:
            return 'nested display died (%s)' % type(e).__name__
        return None

    def run(self):
        try:
            self.overlay = RailOverlay(self.display)
        except Exception as e:
            say('no display %s (%s) - resident cannot start' % (
                self.display, e))
            return 2
        self.overlay.create(self.overlay.out_w, self.overlay.out_h,
                            mapped=False)
        t0 = time.monotonic()
        self.refresh()
        try:
            if os.path.exists(RESIDENT_SOCK):
                os.unlink(RESIDENT_SOCK)
            self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            self.sock.bind(RESIDENT_SOCK)
            os.chmod(RESIDENT_SOCK, 0o600)   # pipd's rule: costs nothing
            self.sock.listen(8)
        except OSError as e:
            say('cannot bind %s (%s)' % (RESIDENT_SOCK, e))
            self.overlay.close()
            return 2
        for s in (signal.SIGTERM, signal.SIGINT):
            signal.signal(s, lambda *_: self.stop.update(sig=True))
        say('resident rail on %s: hidden and ready, %d rows prebaked in '
            '%dms' % (self.display, len(self.rows),
                      int((time.monotonic() - t0) * 1000)))
        self.pending_show = None
        try:
            while not self.stop['sig']:
                ready, _, _ = select.select([self.sock], [], [], 1.0)
                if ready:
                    self.handle_conn()
                if self.pending_show is not None:
                    t_show, self.pending_show = self.pending_show, None
                    try:
                        self.do_show(t_show)
                    except Exception as e:
                        # do_show's finally already unwound the screen; a
                        # dead display is the next session_gone's verdict,
                        # anything else is a logged miss, not a death.
                        say('show broke (%s: %s)' % (type(e).__name__, e))
                    continue
                gone = self.session_gone()
                if gone:
                    say('%s - resident retiring' % gone)
                    break
                if time.monotonic() - self.last_refresh >= REFRESH_S:
                    self.refresh()
            return 0
        finally:
            # The flag is the pad-ownership announcement: whether we think
            # we are mapped or a half-run show left it behind, a flag that
            # names THIS pid must not outlive it.
            flag_ours = False
            try:
                flag_ours = open(OVERLAY_FLAG).read().strip() \
                    == str(os.getpid())
            except OSError:
                pass
            if self.mapped or flag_ours:
                # Killed while on screen: leave the room usable, exactly
                # like the one-shot's killed-from-outside path.
                runner = StepRunner(self.overlay, self.overlay.unmap_now,
                                    write_overlay_flag, lambda: None)
                runner.fds = open_pads()
                runner.run(finish_steps('stopped')[0])
                self.mapped = False
            try:
                self.sock.close()
                os.unlink(RESIDENT_SOCK)
            except OSError:
                pass
            self.overlay.close()
            say('resident rail down')


def resident_main(display):
    # Newest wins, like the display-bridge rule: an earlier resident (a
    # crashed session's leftover whose X death it has not noticed yet) is
    # retired, never deferred to. cmdline-verified before the TERM.
    try:
        old = int(open(RESIDENT_PIDFILE).read().strip())
        with open('/proc/%d/cmdline' % old, 'rb') as f:
            is_rail = b'switcher-overlay' in f.read()
        if is_rail and old != os.getpid():
            say('retiring previous resident %d' % old)
            os.kill(old, signal.SIGTERM)
            deadline = time.monotonic() + 2.0
            while time.monotonic() < deadline and os.path.exists(
                    '/proc/%d' % old):
                time.sleep(0.1)
    except (OSError, ValueError):
        pass
    try:
        with open(RESIDENT_PIDFILE, 'w') as f:
            f.write(str(os.getpid()))
    except OSError as e:
        say('cannot write %s (%s)' % (RESIDENT_PIDFILE, e))
    try:
        return ResidentRail(display).run()
    finally:
        try:
            if open(RESIDENT_PIDFILE).read().strip() == str(os.getpid()):
                os.unlink(RESIDENT_PIDFILE)
        except OSError:
            pass


def main(argv):
    display = None
    resume_on_cancel = True
    resident = False
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == '--display' and args:
            display = args.pop(0)
        elif a == '--no-resume-on-cancel':
            resume_on_cancel = False
        elif a == '--resident':
            resident = True
        else:
            print(__doc__, file=sys.stderr)
            return 2
    if not display:
        say('--display is required (gamescope\'s nested display)')
        return 2

    if resident:
        return resident_main(display)

    # A live resident owns this display's rail: hand the show over and
    # stand down. It acks in milliseconds; anything else (no socket, a
    # refusal, a stale daemon) falls through to the one-shot below.
    if resident_show(display, resume_on_cancel):
        say('a resident rail took the show - standing down')
        return 0

    if rail_already_up():
        say('a rail is already up - standing down')
        return 0

    # Let the suspend's own pause-snap land BEFORE anything maps: a rail in
    # the composite would be burned into the freeze-frame, and the paused
    # tile wants the fresh frame anyway. Bounded; no frame is only a
    # cosmetic loss.
    if os.path.exists(SUSPENDED_FLAG):
        wait_for_fresh_frame()

    try:
        rows = fetch_rows()
    except RuntimeError as e:
        say(str(e))
        return 2
    if not rows:
        say('no rows to show')
        return 2
    focus = initial_focus(rows)
    say('rows: %s (focus %d)' % ([r['title'] for r in rows], focus))

    thumbs = {i: fetch_thumb(r) for i, r in enumerate(rows)}
    spotify = fetch_spotify()       # {} hides the cluster, non-fatally

    overlay = RailOverlay(display)
    strip = compose_strip(rows, focus, overlay.out_w, overlay.out_h, thumbs,
                          spotify=spotify)
    overlay.create(*strip.size)
    overlay.draw(strip)
    if strip.size != (overlay.out_w, overlay.out_h):
        # pipd's measured lesson: gamescope's first commit of the plane
        # does not carry a position set before content exists - draw, then
        # place, then damage again so the move rides a fresh commit. The
        # deck's strip IS the output, so place is a no-op and the second
        # full-sheet draw was pure burn; both stay only for a strip that
        # is ever smaller than the plane again.
        overlay.place_centre(*strip.size)
        overlay.draw(strip)
    say('rail up on %s (%dx%d)' % (display, *strip.size))
    write_overlay_flag()

    stop = {'sig': False}
    for s in (signal.SIGTERM, signal.SIGINT):
        signal.signal(s, lambda *_: stop.update(sig=True))

    fds = [] if os.environ.get('SWITCHER_OVERLAY_NO_PAD') else open_pads()
    oneshot = bool(os.environ.get('SWITCHER_OVERLAY_ONESHOT'))
    if not fds and not oneshot:
        say('no pad to read - nothing could ever be picked')
        try:
            os.remove(OVERLAY_FLAG)
        except OSError:
            pass
        overlay.close()
        return 2

    if fds:                          # the deck opens on the rail, never on
        kodi_joystick(False)         # anything that turns the room off

    runner = StepRunner(overlay, overlay.close, write_overlay_flag,
                        lambda: None)
    runner.fds = fds
    try:
        outcome, detail, rows = deck_loop(overlay, rows, thumbs, spotify,
                                          fds, stop)
        steps, code = finish_steps(outcome, detail,
                                   paused_row=first_paused(rows),
                                   resume_on_cancel=resume_on_cancel)
        runner.run(steps)
        return 0 if (oneshot and outcome == 'stopped') else code
    finally:
        try:
            os.remove(OVERLAY_FLAG)
        except OSError:
            pass
        try:
            overlay.close()      # tolerant of the unmap step's own close
        except Exception:
            pass
        for fd in runner.fds:
            try:
                os.close(fd)
            except OSError:
                pass


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
