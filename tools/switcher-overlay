def bake_bgra(pil_img):
    """RGBA PIL -> (w, h, the BGRA ZPixmap bytes PutImage wants). Split
    from the push so the resident can pay the ~33MB-at-4K swizzle while
    hidden and a show only has to move bytes."""
    w, h = pil_img.size
    raw = pil_img.convert('RGBA').tobytes()
    bgra = bytearray(len(raw))
    bgra[0::4] = raw[2::4]
    bgra[1::4] = raw[1::4]
    bgra[2::4] = raw[0::4]
    bgra[3::4] = raw[3::4]
    return w, h, bytes(bgra)


class RailOverlay:
    def __init__(self, display_name):
        from Xlib import X, Xatom, display as xdisplay
        self.X, self.Xatom = X, Xatom
        self.dpy = xdisplay.Display(display_name)
        self.screen = self.dpy.screen()
        self.root = self.screen.root
        geom = self.root.get_geometry()
        self.out_w, self.out_h = geom.width, geom.height
        self.parent = self.child = self.gc = None

    def _argb_visual(self):
        for depth in self.screen.allowed_depths:
            if depth.depth == 32 and depth.visuals:
                return depth.visuals[0].visual_id
        return None

    def create(self, strip_w, strip_h, mapped=True):
        """Build the plane. mapped=False (the resident) leaves the PARENT
        unmapped: gamescope never sees an external overlay at all, so the
        hidden rail is free. The child maps now either way - it lives
        inside the parent and composites only when the parent does."""
        X = self.X
        visual = self._argb_visual()
        if visual is None:
            raise RuntimeError('no 32-bit visual: the scrim cannot be '
                               'translucent, refusing a black screen')
        cmap = self.root.create_colormap(visual, X.AllocNone)
        # The premultiplied translucent scrim IS the parent's background.
        self.parent = self.root.create_window(
            0, 0, self.out_w, self.out_h, 0, 32, X.InputOutput, visual,
            background_pixel=SCRIM_ARGB, border_pixel=0, colormap=cmap,
            override_redirect=1, event_mask=X.StructureNotifyMask)
        self.child = self.parent.create_window(
            0, 0, strip_w, strip_h, 0, 32, X.InputOutput, visual,
            background_pixel=0, border_pixel=0,
            colormap=self.root.create_colormap(visual, X.AllocNone))
        self.gc = self.child.create_gc()
        atom = self.dpy.get_atom('GAMESCOPE_EXTERNAL_OVERLAY')
        self.parent.change_property(atom, self.Xatom.CARDINAL, 32, [1])
        self.parent.set_wm_name('couch-switcher')
        self.parent.set_wm_class('couch-switcher', 'couch-switcher')
        self.child.map()
        if mapped:
            self.parent.map()
        else:
            # Belt for the unmap_now finding above: even a stray commit on
            # a hidden plane must never reach the screen.
            self._set_opacity(0)
        self.dpy.sync()

    def _set_opacity(self, value):
        atom = self.dpy.get_atom('_NET_WM_WINDOW_OPACITY')
        self.parent.change_property(atom, self.Xatom.CARDINAL, 32, [value])

    def map_now(self):
        self._set_opacity(0xffffffff)
        self.parent.map()
        self.dpy.sync()

    def unmap_now(self):
        # Opacity 0 is what actually hides it - MEASURED on the headless
        # rig, then confirmed in the source: steamcompmgr's unmap_win never
        # clears the plane's committed buffer (a literal "TODO clear done
        # commits here?") and the external-overlay pick ignores map state,
        # so a once-shown plane keeps compositing its last frame. The paint
        # is gated on `externalOverlay->opacity`, so zero removes it. The
        # unmap stays too: it keeps the X-side state honest and is what
        # SHOULD hide it the day the TODO gets done. (A never-mapped plane
        # is invisible only because it has no commit yet - which is why the
        # resident's hidden start costs nothing either way.)
        self._set_opacity(0)
        self.parent.unmap()
        self.dpy.sync()

    def place_centre(self, strip_w, strip_h):
        x = (self.out_w - strip_w) // 2
        y = (self.out_h - strip_h) // 2
        self.child.configure(x=x, y=y, width=strip_w, height=strip_h)
        self.dpy.sync()

    def draw(self, pil_img):
        self.draw_baked(bake_bgra(pil_img))

    def draw_baked(self, baked):
        """(w, h, BGRA bytes) -> the child, chunked under the X request
        cap. A classic X request's length field is CARD16 in 4-byte units,
        so one PutImage caps at ~256KB and python-xlib does not negotiate
        BIG-REQUESTS: a 1MB chunk dies in struct.pack ('H' overflow),
        measured on the first live draw. Stay comfortably under."""
        w, h, bgra = baked
        rows_per_chunk = max(1, 240_000 // (w * 4))
        y = 0
        while y < h:
            rows = min(rows_per_chunk, h - y)
            chunk = bgra[y * w * 4:(y + rows) * w * 4]
            self.child.put_image(self.gc, 0, y, w, rows,
                                 self.X.ZPixmap, 32, 0, chunk)
            y += rows
        self.dpy.sync()

    def close(self):
        for win in (self.child, self.parent):
            if win is not None:
                try:
                    win.destroy()
                except Exception:
                    pass
        try:
            self.dpy.sync()
            self.dpy.close()
        except Exception:
            pass


