# struct input_event on 64-bit linux: tv_sec, tv_usec, type, code, value
EVENT_FMT = 'llHHi'
EVENT_SIZE = struct.calcsize(EVENT_FMT)
EV_KEY, EV_ABS = 0x01, 0x03
ABS_HAT0X, ABS_HAT0Y = 0x10, 0x11
ABS_X, ABS_Y = 0x00, 0x01
BTN_SOUTH, BTN_EAST = 0x130, 0x131      # Cross / Circle
STICK_ON = 18000                # DualSense ABS_X is 0..255? no - hid-playstation
STICK_OFF = 12000               # reports 0..255; see note in pad_action
# hid-playstation's DualSense ABS_X range is 0..255 centred 128; the
# thresholds above are for pads that report 16-bit ranges. Both are handled:
# values <= 255 use the small scale.
STICK8_ON, STICK8_OFF = 200, 160


