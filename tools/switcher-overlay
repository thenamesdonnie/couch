def parse_devices(text):
    """/proc/bus/input/devices -> [(name, '/dev/input/eventN'), ...].

    Only the main pad node: motion sensors and touchpad carry the same
    DualSense name prefix but their N: lines name them, so an exact-name
    match keeps the buttons node and drops the rest."""
    out = []
    name = None
    for line in text.splitlines():
        if line.startswith('N: Name='):
            name = line.split('=', 1)[1].strip().strip('"')
        elif line.startswith('H: Handlers=') and name:
            for tok in line.split('=', 1)[1].split():
                if tok.startswith('event'):
                    out.append((name, '/dev/input/' + tok))
            name = None
    return out


def pad_nodes(devs):
    """The nodes worth opening for switcher navigation: any device whose
    name says game controller, minus the DualSense's sensor/touchpad
    side-nodes. Every match is opened - a second pad navigating the rail is
    a feature, not a conflict."""
    out = []
    for name, node in devs:
        low = name.lower()
        if ('controller' in low or 'gamepad' in low or 'x-box' in low) \
                and 'motion' not in low and 'touchpad' not in low:
            out.append(node)
    return out


def decode_events(buf):
    """Raw bytes -> [(type, code, value)], dropping any trailing partial."""
    n = len(buf) // EVENT_SIZE
    out = []
    for i in range(n):
        _s, _u, etype, code, value = struct.unpack_from(EVENT_FMT, buf,
                                                        i * EVENT_SIZE)
        out.append((etype, code, value))
    return out


class PadState:
    """Edge detection for the stick, so a held deflection is ONE move.
    The dpad hat already edge-detects itself (0 between presses). The two
    axes engage independently: a diagonal that latched X must not eat Y."""
    def __init__(self):
        self.stick_engaged = False       # ABS_X
        self.stick_y_engaged = False     # ABS_Y


def pad_action(ev, st):
    """(type, code, value) ->
    'left'|'right'|'up'|'down'|'select'|'back'|None."""
    etype, code, value = ev
    if etype == EV_KEY and value == 1:
        if code == BTN_SOUTH:
            return 'select'
        if code == BTN_EAST:
            return 'back'
        return None
    if etype != EV_ABS:
        return None
    if code == ABS_HAT0X:
        if value < 0:
            return 'left'
        if value > 0:
            return 'right'
        return None
    if code == ABS_HAT0Y:
        if value < 0:
            return 'up'
        if value > 0:
            return 'down'
        return None
    if code in (ABS_X, ABS_Y):
        small = -1 <= value <= 260        # an 8-bit pad (hid-playstation)
        centre = 128 if small else 0
        on = STICK8_ON - 128 if small else STICK_ON
        off = STICK8_OFF - 128 if small else STICK_OFF
        mag = value - centre
        vert = code == ABS_Y
        if (st.stick_y_engaged if vert else st.stick_engaged):
            if abs(mag) < off:
                if vert:
                    st.stick_y_engaged = False
                else:
                    st.stick_engaged = False
            return None
        action = None
        if mag <= -on:
            action = 'up' if vert else 'left'
        elif mag >= on:
            action = 'down' if vert else 'right'
        if action:
            if vert:
                st.stick_y_engaged = True
            else:
                st.stick_engaged = True
        return action
    return None


def move_focus(i, action, n):
    """Wrap-around, matching the home row's feel."""
    if n <= 0:
        return 0
    if action == 'left':
        return (i - 1) % n
    if action == 'right':
        return (i + 1) % n
    return i


# The power bar above the rail, verbatim from the Kodi dialog (default.py's
# POWER_ACTIONS): labels beside the script.tvpoweroff actions they fire.
# Text, not symbols (Donnie's call, 8 Aug): the three differ only in WHICH
# things get turned off, and a glyph cannot carry that.
POWER_ADDON = 'script.tvpoweroff'
POWER_ACTIONS = [('Quit game', 'quit'),
                 ('Controller off', 'pad_off'),
                 ('Controller + TV off', 'all_off')]


def move_power(i, action, n=len(POWER_ACTIONS)):
    """Movement inside the power bar WITHOUT a spotify bar to hand off to:
    it clamps instead of wrapping, because in the XML its ends hand focus
    to the spotify list, which is hidden while no session is live, so
    'focus then simply stays put at the strip's ends' (the XML's words)."""
    if n <= 0:
        return 0
    if action == 'left':
        return max(0, i - 1)
    if action == 'right':
        return min(n - 1, i + 1)
    return i


def spotify_active(spotify):
    """The one gate everything spotify hangs on, default.py's rule: a dict
    with active truthy. {} (a failed or absent endpoint) and
    {'active': False} both leave the deck exactly as it was before the bar
    existed."""
    return bool(spotify and spotify.get('active'))


def media_items(spotify):
    """The three pills, default.py's _fill_media verbatim: play/pause
    FIRST (walking right off the power bar lands on the button that
    matters), then previous/next. Labels drive the toggle logic; icons are
    the faces (Donnie's call, 15 Aug: pause/previous/next ARE the three
    glyphs every remote on earth taught)."""
    playing = bool(spotify.get('playing'))
    return [('Pause' if playing else 'Play',
             'icon-pause.png' if playing else 'icon-play.png'),
            ('Previous', 'icon-prev.png'),
            ('Next', 'icon-next.png')]


def now_playing_label(spotify):
    """The media cluster's eyebrow: 'Track - Artist', or the service name
    when spotifyd has a session but nothing loaded yet (default.py's
    _set_media_label)."""
    now = ' - '.join(x for x in (spotify.get('track'),
                                 spotify.get('artist')) if x)
    return now if now else 'Spotify'


def media_click(spotify, idx):
    """A pill press -> (command, what the play/pause pill shows after).

    default.py's rule, learned live: an explicit verb chosen by the pill's
    CURRENT state, never a PlayPause toggle - spotifyd's reported state
    lags the command it just took, so the pill is redrawn from INTENT, not
    from the server's stale read. A skip leaves play/pause as it was."""
    playing = bool(spotify.get('playing'))
    if idx == 0:
        return ('pause' if playing else 'play'), not playing
    return ('previous' if idx == 1 else 'next'), playing


def deck_move(zone, rail_i, power_i, media_i, action, n_rows, n_media=0,
              n_power=len(POWER_ACTIONS)):
    """One move on the deck -> (zone, rail_i, power_i, media_i).

    Mirrors the XML's wiring plus default.py's _join_strip repair: the
    power bar and the spotify bar are ONE strip, so walking right off the
    power bar's end lands on the first pill, left off the first capsule
    wraps the screen edge onto the last pill, and back again - entering a
    bar sideways never teleports to wherever it last was. Up from the rail
    lands on the power bar (the rail's onup is 9010, never 9020); up/down
    edges are walls; vertical hops keep each list's remembered index,
    exactly as Kodi lists remember their selected item. n_media=0 (no live
    session) reduces the strip to the clamping power bar alone."""
    if action == 'up':
        if zone == 'rail':
            return 'power', rail_i, power_i, media_i
        return zone, rail_i, power_i, media_i
    if action == 'down':
        if zone in ('power', 'media'):
            return 'rail', rail_i, power_i, media_i
        return zone, rail_i, power_i, media_i
    if zone == 'rail':
        return zone, move_focus(rail_i, action, n_rows), power_i, media_i
    if zone == 'power':
        if not n_media:
            return zone, rail_i, move_power(power_i, action, n_power), media_i
        if action == 'left':
            if power_i > 0:
                return zone, rail_i, power_i - 1, media_i
            return 'media', rail_i, power_i, n_media - 1   # screen-edge wrap
        if action == 'right':
            if power_i < n_power - 1:
                return zone, rail_i, power_i + 1, media_i
            return 'media', rail_i, power_i, 0
        return zone, rail_i, power_i, media_i
    if zone == 'media':
        if action == 'left':
            if media_i > 0:
                return zone, rail_i, power_i, media_i - 1
            return 'power', rail_i, n_power - 1, media_i
        if action == 'right':
            if media_i < n_media - 1:
                return zone, rail_i, power_i, media_i + 1
            return 'power', rail_i, 0, media_i             # screen-edge wrap
    return zone, rail_i, power_i, media_i


def card_label(row):
    """What the Kodi dialog prints on/under a card: the cleaned title, with
    the ' · paused' marker kept (it matters)."""
    label = short_label(row.get('title') or str(row.get('id', '')))
    if row.get('paused'):
        label += ' · paused'
    return label


def pick_rows(payload):
    """The API answer -> the rows worth a tile. The desktop row stays (the
    phone offers it), Kodi stays, the paused game stays. Unmapped strays
    with no title are noise."""
    rows = payload.get('windows') if isinstance(payload, dict) else payload
    out = []
    for r in rows or []:
        if not r.get('id') or not r.get('title'):
            continue
        out.append(r)
    return out


def initial_focus(rows):
    """Focus the first row that is NOT the paused game: the player opened
    the rail to go somewhere else; 'continue' is one press away and B
    cancels anyway."""
    for i, r in enumerate(rows):
        if not r.get('paused'):
            return i
    return 0


def first_paused(rows):
    """The paused row a cancel would resume, or None."""
    for r in rows or []:
        if r.get('paused'):
            return r
    return None


def merge_focus(old_rows, new_rows, focus):
    """Keep the eye where it was across a refresh: the focused ROW (by id)
    keeps focus even if the list reordered; a vanished row falls back to
    initial_focus. Without this the post-map refresh would visibly yank
    the ring off whatever the player was already aiming at."""
    if 0 <= focus < len(old_rows or []):
        want = old_rows[focus].get('id')
        for i, r in enumerate(new_rows):
            if r.get('id') == want:
                return i
    return initial_focus(new_rows)


# =========================================================================
# the map/unmap lifecycle, pure: plans in data, side effects elsewhere.
# (tools/test_switcher_overlay.py drives these; StepRunner executes them.)
# =========================================================================
def parse_command(line):
    """One control line -> a dict, or ValueError (pipd's rule: the socket
    must never be able to crash the daemon with a malformed line)."""
    try:
        msg = json.loads(line)
    except (json.JSONDecodeError, TypeError) as e:
        raise ValueError('not JSON: %s' % e)
    if not isinstance(msg, dict):
        raise ValueError('expected a JSON object')
    if not isinstance(msg.get('cmd'), str) or not msg['cmd']:
        raise ValueError('missing "cmd"')
    return msg


def show_reply(msg, display, mapped, flag_busy):
    """A 'show' command -> (reply dict, should_map). The reply goes out
    BEFORE the show runs (two-stage ack), so the poker - couchd mid-pass -
    is never parked behind the frame-wait. Idempotent by design: a show
    while mapped is a happy no-op (the second double-tap rule), and a
    foreign rail owning the flag stands this one down (the singleton)."""
    if msg.get('display') not in (None, display):
        return {'ok': False, 'error': 'display mismatch: rail is on %s'
                                      % display}, False
    if mapped:
        return {'ok': True, 'mapped': True, 'note': 'already up'}, False
    if flag_busy:
        return {'ok': False, 'error': 'another rail owns the screen'}, False
    return {'ok': True, 'accepted': True}, True


def show_steps(mapped, flag_busy, suspended):
    """One accepted 'show' -> the ordered side effects, or [] to stand
    down. The order is the one-shot's, proven live: pads first (nothing
    could ever be picked without one - abort, do not map), the frame-wait
    ONLY when suspended and only now that we are really mapping (mapping
    earlier would burn the rail into pause-snap's freeze-frame), then
    map+draw, then the flag - which means MAPPED AND OWNING THE PAD, so it
    must not exist a moment before the sheet does - then Kodi's joystick
    off so the invisible home row stops listening."""
    if mapped or flag_busy:
        return []
    out = [('open_pads',)]
    if suspended:
        out.append(('frame_wait',))
    out += [('map',), ('draw',), ('write_flag',), ('joystick', False)]
    return out


def finish_steps(outcome, detail=None, paused_row=None,
                 resume_on_cancel=True):
    """A deck outcome -> (ordered side effects, one-shot exit code).

    Semantics copied verb for verb from the one-shot flow that ran live
    15 Aug: the rail leaves the screen BEFORE the world changes (unmap
    first), the flag stays up THROUGH an activate (guard-vs-resume: while
    a resume is in flight no reconcile may hand the pad back to Kodi, so
    remove_flag comes last), and Kodi's joystick returns exactly when the
    screen lands somewhere Kodi-steerable - never after a paused pick or a
    resume-on-cancel, whose routing belongs to game-launch's resume, and
    never after a supersede, where the PS button's own resume already
    routed the pad."""
    steps = [('unmap',)]
    code = 1
    if outcome == 'picked':
        steps.append(('activate', detail['id']))
        if not detail.get('paused'):
            steps.append(('joystick', True))
        code = 0
    elif outcome == 'power':
        steps += [('power', detail), ('joystick', True)]
        code = 0
    elif outcome == 'cancel':
        if resume_on_cancel and paused_row is not None:
            steps.append(('activate', paused_row['id']))
        else:
            steps.append(('joystick', True))
    elif outcome == 'superseded':
        code = 3
    elif outcome == 'stopped':
        steps.append(('joystick', True))
    steps += [('remove_flag',), ('close_pads',)]
    return steps, code


def layout(n, out_w, out_h):
    """-> (strip_w, strip_h, tile_w, tile_h, gap, [(x, y), ...]).

    The strip IS the whole output now: the deck design is a fullscreen
    sheet (gradient scrim easing into the bottom), so the child window
    covers the plane and place_centre lands it at 0,0 untouched. Tiles are
    the XML's 300x169 cards on a 324 pitch, left-anchored at the rail's
    x=120 (+12 card inset), scaled out of 1080i space."""
    s = out_h / DESIGN_H
    tile_w, tile_h = round(CARD_W * s), round(CARD_H * s)
    gap = round((CARD_PITCH - CARD_W) * s)
    pitch = tile_w + gap
    x0, y = round(RAIL_X0 * s), round(RAIL_Y * s)
    xs = [(x0 + i * pitch, y) for i in range(n)]
    return out_w, out_h, tile_w, tile_h, gap, xs


