    return '', ''


# ---- observer health (R5, independent of diffing) ----------------------------
def world_series(obs, snaps):
    """(t, world-dict) samples from world obs + snapshots - the heartbeat channel."""
    out = [(float(r['t']), r) for r in obs if r.get('source') == 'world' and 't' in r]
    for s in snaps:
        w = dict(s)
        w.update(s.get('flags') or {})
        out.append((float(s['t']), w))
    return sorted(out, key=lambda x: x[0])


def daemon_runs(crecs, fallback):
    """([(start, end)], [model_version]) - the windows couchd was observing in,
    and which MODEL each one was running.

    With no daemon records at all we cannot know, so the whole data span is one run.
    When they exist, a run whose start record is missing (the log rotated at midnight
    mid-run) is anchored to couchd's own first record - NOT to the legacy stream,
    which is cumulative across days and once stretched run 1 back three hours.
    """
    marks = sorted((float(r['t']), r.get('event'), r.get('model_version'))
                   for r in crecs if r.get('kind') == 'daemon'
                   and isinstance(r.get('t'), (int, float)))
    if not marks:
        return [tuple(fallback)], [None]
    cts = [float(r['t']) for r in crecs if isinstance(r.get('t'), (int, float))]
    first, last = (min(cts), max(cts)) if cts else fallback
    runs, models, start, model = [], [], None, None
    for t, ev, mv in marks:
        if ev == 'start':
            if start is None:
                start, model = t, mv
        elif ev == 'stop':
            runs.append((start if start is not None else first, t))
            models.append(model)
            start, model = None, None
    if start is not None:
        runs.append((start, last))
        models.append(model)
    if not runs:
        return [tuple(fallback)], [None]
    return runs, models


def in_runs(t, runs, slack=0.0):
    return any(a - slack <= t <= b + slack for a, b in runs)


def observer_health(obs, blinds, snaps, runs, notes):
    """Heartbeat gaps, daemon-declared blindness, activity cross-checks, verdict."""
    t0, t1 = runs[0][0], runs[-1][1]
    span = sum(max(0.0, b - a) for a, b in runs)
    per = {}
    for r in obs:
        if isinstance(r.get('t'), (int, float)):
            per.setdefault(str(r.get('source') or 'unknown'), []).append(float(r['t']))
    health, reasons = [], []
    for src in sorted(set(REQUIRED_SOURCES) | set(OPTIONAL_SOURCES) | set(per)):
        ts = sorted(per.get(src, []))
        health.append({'source': src, 'present': bool(ts), 'samples': len(ts),
                       'required': src in REQUIRED_SOURCES,
                       'last_gap': (t1 - ts[-1]) if ts else span})
        if not ts and src in REQUIRED_SOURCES:
            notes.append('no %s observations all evening (obs are change-driven, so '
                         'quiet is not stale - but check the source was wired)' % src)

    series = world_series(obs, snaps)
    hb = 0.0
    for a, b in runs:                       # heartbeat judged INSIDE each daemon run
        beats = [t for t, _ in series if a <= t <= b]
        gaps = [beats[0] - a] + [y - x for x, y in zip(beats, beats[1:])] + \
               [b - beats[-1]] if beats else [b - a]
        hb = max([hb] + gaps)
        if max(gaps) > HEARTBEAT_LIMIT_S:
            reasons.append('world/snapshot heartbeat gap of %.0fs inside the run '
                           '%s..%s (limit %.0fs)' % (max(gaps), fmt_t(a), fmt_t(b),
                                                     HEARTBEAT_LIMIT_S))

    for b in blinds:
        age = float(b.get('age_s') or b.get('duration') or 0.0)
        txt = 'observer_blind on %s: %s %s (age %.0fs)' % (
            b.get('source'), b.get('why', ''), b.get('detail', ''), age)
        (reasons if age > OBSERVER_BLIND_LIMIT_S else notes).append(txt)

    for src, pred in ACTIVITY_CHECKS.items():       # world said active, source silent
        for a, b in runs:
            start, last = None, None
            for t, w in [x for x in series if a <= x[0] <= b] + [(b + 1.0, {})]:
                if pred(w):
                    start, last = (t if start is None else start), t
                    continue
                if start is not None:
                    if last - start > OBSERVER_BLIND_LIMIT_S and \
                            not [x for x in per.get(src, []) if start <= x <= last]:
                        reasons.append('%s observer silent for %.0fs while the world '
                                       'said it was active' % (src, last - start))
                    start = None
    return {'window': [t0, t1], 'span_s': span, 'sources': health, 'heartbeat_gap': hb,
            'runs': runs, 'blind': blinds, 'valid': not reasons, 'reasons': reasons}


# ---- report ------------------------------------------------------------------
def fmt_t(t):
    try:
        return datetime.fromtimestamp(t).strftime('%H:%M:%S.%f')[:-3]
    except (ValueError, OSError, OverflowError):
        return str(t)


def arg_str(it):
    a, bits = it['args'], []
    ps = pid_set(it)
    if ps is not None:
        bits.append('pids=%d[%s]' % (len(ps), ','.join(sorted(ps)[:4])))
    for k in ('resolver', 'mode', 'flag', 'appid', 'window', 'scope', 'app'):
        if k in a:
            bits.append('%s=%s' % (k, a[k]))
    if it.get('reason'):
        bits.append('why=%s' % it['reason'])
    return ' '.join(bits)[:64]


def snapshot_near(snaps, t):
    """The world couchd saw at or before a divergence (real snapshot schema)."""
    prev = [s for s in snaps if float(s.get('t', 0)) <= t]
    if not prev:
        return ''
    s = max(prev, key=lambda x: float(x.get('t', 0)))
    f, reg = s.get('flags') or {}, s.get('regions') or {}
    bits = ['session=%s' % f.get('session'), 'suspended=%s' % f.get('suspended'),
            'focused=%s' % s.get('focused'), 'joystick=%s' % s.get('joystick'),
            'ui_mode=%s' % s.get('ui_mode'), 'pids=%d' % len(s.get('pids') or {}),
            '/'.join('%s:%s' % (k, v) for k, v in sorted(reg.items()))]
    return 'world @%s (%s): %s' % (fmt_t(float(s.get('t', t))), s.get('why', '?'),
                                   ' '.join(bits))


def mkrow(section, li, ci, offset, flags, notes, couchd_i, legacy_i,
          direction=SHADOWING):
    """One report row, with the T column pre-filled from the whitelist if it hits.

    triage() is asked about the UNREVERSED section, so every pre-declared entry
    keeps firing after the flip; the row then carries the reversed name.
    """
    lab, note = triage(section, li, ci, flags, couchd_i, legacy_i)
    ref = li or ci
    return {'section': section_for(section, direction), 'direction': direction,
            'label': lab, 't': ref['t'], 'verb': ref['verb'],
            'subject': ref['subject'], 'flags': sorted(set(flags)), 'offset': offset,
            'args': ' || '.join(arg_str(x) for x in (li, ci) if x),
            'note': '; '.join([n for n in notes if n] + ([note] if note else [])),
            'origin': ref['origin']}


def build(legacy_path, shadow_path, snapshots_path=None, since=None, context=True,
          window=None):
    """Everything the report needs, as plain data (also the --json payload)."""
    notes = []
    if since:
        notes.append('--since %s: everything before it ignored' % fmt_t(since))
    lrecs, l_ok = load_jsonl(legacy_path, notes, 'legacy')
    crecs, c_ok = load_jsonl(shadow_path, notes, 'couchd')
    snaps = [r for r in crecs if r.get('kind') == 'snapshot' and 't' in r]
    if snapshots_path and os.path.exists(snapshots_path):
        snaps += [r for r in load_jsonl(snapshots_path, [], 'snapshots')[0]
                  if r.get('kind') in (None, 'snapshot') and 't' in r]

    legacy_all = [i for i in (as_intent(r, 'legacy') for r in lrecs) if i]
    couchd_all = [i for i in (as_intent(r, 'couchd') for r in crecs) if i]
    obs = [r for r in crecs if r.get('kind') == 'obs']
    trans = [r for r in crecs if r.get('kind') == 'transition']
    blinds = [r for r in crecs if r.get('kind') == 'observer_blind']
    agree = [r for r in crecs if r.get('kind') == 'agreement']
    bad_inv = [r for r in crecs if r.get('kind') == 'invariant' and not r.get('ok')]
    # The run windows come from couchd's OWN records only. Including the legacy
    # stream here once stretched run 1 back three hours, because /tmp/legacy-
    # intents.jsonl is cumulative across days while the shadow log rotates nightly.
    ats = [float(r['t']) for r in lrecs + crecs + snaps
           if isinstance(r.get('t'), (int, float))]
    span = (min(ats), max(ats)) if ats else (0.0, 0.0)
    runs, run_models = daemon_runs(crecs, span)
    starts = [float(r['t']) for r in crecs if r.get('kind') == 'daemon'
              and r.get('event') == 'start' and isinstance(r.get('t'), (int, float))]
    if since:
        keep = [(i, (max(a, since), b)) for i, (a, b) in enumerate(runs) if b > since]
        if keep:
            run_models = [run_models[i] for i, _ in keep]
            runs = [r for _, r in keep]
        else:
            runs, run_models = [(since, span[1])], [None]
    # --window CLIPS the analysis to a stated stretch of the evening. Without
    # it every number below silently covers whatever the files happen to hold,
    # which is how "0 gating divergences" once came out of a 4-minute idle
    # window with no decisions in it and read like an evening's verdict.
    clipped = 0
    if window:
        w0, w1 = window
        kept = [(i, (max(a, w0), min(b, w1))) for i, (a, b) in enumerate(runs)
                if b >= w0 and a <= w1]
        clipped = len(runs) - len(kept)
        run_models = [run_models[i] for i, _ in kept] or [None]
        runs = [r for _, r in kept] or [(w0, w1)]
        notes.append('--window %s..%s: analysis clipped to it (%d run(s) fell '
                     'outside)' % (fmt_t(w0), fmt_t(w1), clipped))

        def _in(seq):
            return [r for r in seq
                    if isinstance(r.get('t'), (int, float)) and w0 <= r['t'] <= w1]
        # Health, transitions and snapshots are clipped too, or the report
        # measures observer gaps against records outside the window it claims
        # to be about.
        obs, trans, blinds = _in(obs), _in(trans), _in(blinds)
        agree, snaps = _in(agree), _in(snaps)
        bad_inv = _in(bad_inv)
    # STALENESS IS A MODEL QUESTION, NOT A CLOCK ONE. Two runs of the same
    # model are one model's evidence however many restarts sit between them;
    # a run of an older model is not comparable and never gates. Corpora
    # written before couchd stamped `model_version` fall back to the old
    # "newest start wins" rule, and say so.
    # ...and both rules judge only the runs still in scope: a --window that
    # pins Tuesday evening must not be declared stale by a restart on Friday.
    inside = [t for t in starts if any(a - 0.001 <= t <= b for a, b in runs)]
    model_t = max(inside) if inside else (max(starts) if starts and not window
                                          else runs[0][0])
    known = [m for m in run_models if m]
    if known:
        newest_model = next((m for _, m in sorted(
            zip([r[0] for r in runs], run_models), key=lambda x: -x[0]) if m), None)
        current = [r for r, m in zip(runs, run_models) if m == newest_model]
        model_key, model_rule = newest_model, 'model_version'
        older = [m for m in run_models if m and m != newest_model]
        if older:
            notes.append('%d run(s) ran an OLDER model (%s) than the newest '
                         '(%s) - marked stale, excluded from gating'
                         % (len(older), ', '.join(sorted(set(older))), newest_model))
        if len(current) > 1:
            notes.append('%d run(s) share model %s and are compared TOGETHER; '
                         'a restart is not a new model' % (len(current), newest_model))
    elif window:
        # No fingerprints in this corpus, but the operator has PINNED the
        # stretch under review. Taking that as "these runs are one model's
        # evidence" is the whole point of the flag - and it is an assertion by
        # a human, not a fact from the data, so the verdict line says so.
        current = list(runs)
        model_key, model_rule = None, '--window (corpus predates model_version)'
        notes.append('this corpus carries no model_version; --window is taken '
                     'as your assertion that these %d run(s) ran ONE model. '
                     'Corpora written from 5 Aug 2026 carry the fingerprint and '
                     'do not need the assertion' % len(runs))
    else:
        current = [r for r in runs if r[0] >= model_t - 0.001]
        model_key, model_rule = None, 'newest-start (corpus predates model_version)'
        if len(runs) > 1:
            notes.append('this corpus carries no model_version, so staleness '
                         'falls back to "newest daemon start wins" (%s) - which '
                         'marks a whole evening stale after any later restart. '
                         'Use --window to pin the evening you mean'
                         % fmt_t(model_t))
    # WHO WAS ACTING, per responsibility, per stretch of the evening. Computed
    # before anything is diffed, because it decides which stream is the shadow.
    windows = ownership_windows(crecs, span)
    for i in legacy_all + couchd_all:
        i['direction'] = direction_of(i, windows)
    ctx = [i for i in legacy_all + couchd_all if i['verb'] in CONTEXT_VERBS]
    # A bare `yield` marker names a gesture whose bound action couchd now runs.
    # It predicts no verb, so there is nothing to join it to: counted, shown as
    # context, and never a divergence in either direction.
    yields = [i for i in legacy_all + couchd_all if i['verb'] in YIELD_MARKER_VERBS]
    skip = CONTEXT_VERBS | YIELD_MARKER_VERBS
    legacy_i = [i for i in legacy_all if i['verb'] not in skip]
    couchd_i = [i for i in couchd_all if i['verb'] not in skip
                and in_runs(i['t'], runs, RUN_EDGE_SLACK_S)]
    outside = [i for i in legacy_i if not in_runs(i['t'], runs, RUN_EDGE_SLACK_S)]
    if outside:
        legacy_i = [i for i in legacy_i if i not in outside]
        notes.append('%d legacy intent(s) outside couchd\'s run windows excluded '
                     '(couchd was not running; %s)' % (len(outside), ', '.join(
                         sorted({'%s(%s)' % (i['verb'], i['subject'])
                                 for i in outside}))[:120]))
    if ctx:
        notes.append('%d trigger-channel record(s) (%s) held as context, not diffed'
                     % (len(ctx), ','.join(sorted(CONTEXT_VERBS))))
    if yields:
        notes.append('%d bare `yield` marker(s) held as context: the watcher '
                     'names the gesture it no longer performs, not the verbs '
                     'couchd ran in its place, so there is nothing to join '
                     '(%s)' % (len(yields), ', '.join(sorted(
                         {'%s/%s' % (i['subject'], i['args'].get('action'))
                          for i in yields}))[:120]))
    if bad_inv:
        notes.append('%d failing invariant record(s): %s' % (len(bad_inv), '; '.join(
            sorted({'%s %s' % (r.get('name'), r.get('leaks') or '')
                    for r in bad_inv}))[:200]))
    for r in crecs:
        if r.get('kind') == 'daemon' and r.get('event') == 'stop':
            notes.append('daemon stop @%s: %s passes, %s intents'
                         % (fmt_t(float(r.get('t', 0))), r.get('passes'),
                            r.get('intents')))

    pairs, l_only, c_only = match(legacy_i, couchd_i)
    for p in pairs:
        # One side claiming the reversed direction is enough: a yielded legacy
        # would-do and a couchd record with `acted` on it are the same fact
        # said by each stack about itself, and either alone is conclusive.
        p['direction'] = ACTING if ACTING in (p['legacy']['direction'],
                                              p['couchd']['direction']) \
            else SHADOWING
    l_only, assoc = associate_repeats(pairs, l_only, 'legacy')
    c_only, c_assoc = associate_repeats(pairs, c_only, 'couchd')
    assoc += c_assoc
    launches = sorted(i['t'] for i in ctx if i['verb'] in ('launch', 'invoked'))
    l_only, l_seq = launch_sequence_split(l_only, launches, 'legacy')
    c_only, c_seq = launch_sequence_split(c_only, launches, 'couchd')
    for p in pairs:
        compare_pair(p)
    asserts = assertions(couchd_i, legacy_i, release_edges(obs, trans), pairs)
    for a in asserts:                       # an ordering violation gates even in-window
        if a['ok'] is False and a['intent'] is not None:
            for p in pairs:
                if p['couchd'] is a['intent'] or p['legacy'] is a['intent']:
                    p['flags'].append('ORDER')
                    p['notes'].append('%s: %s' % (a['name'], a['detail']))

    # An ordering violation gates wherever it lands, matched or not (R5).
    viol = {id(a['intent']): a for a in asserts if a['ok'] is False and a['intent']}
    # C17 health, not divergence: an intent couchd decided and then DECLINED
    # (precondition gone, still inside a deadline, in backoff, refused,
    # model-only) left the world untouched, so there is no effect for the other
    # stream to disagree with - it belongs in ACTING HEALTH, per verb, not in a
    # divergence column that would read as "couchd did something legacy did
    # not". An ordering violation still outranks that and keeps its row.
    declined = [it for it in c_only
                if it['acted'] is False and id(it) not in viol]
    dropped = {id(it) for it in declined}       # by identity: two records can
    c_only = [it for it in c_only if id(it) not in dropped]   # be equal by value
    rows = [mkrow('COUCHD-ONLY', None, it, None,
                  ['ORDER'] if id(it) in viol else [],
                  ['%s: %s' % (viol[id(it)]['name'], viol[id(it)]['detail'])]
                  if id(it) in viol else [], couchd_i, legacy_i, it['direction'])
            for it in c_only]
    rows += [mkrow('LEGACY-ONLY', it, None, None, [], [], couchd_i, legacy_i,
                   it['direction'])
             for it in l_only]
    rows += [mkrow('BOTH-BUT-DIFFERENT', p['legacy'], p['couchd'], p['offset'],
                   p['flags'], p['notes'], couchd_i, legacy_i, p['direction'])
             for p in pairs if p['flags']]
    rows.sort(key=lambda r: (SECTIONS.index(r['section']), r['t']))
    lverbs = {i['verb'] for i in legacy_i}
    cverbs = {i['verb'] for i in couchd_i}
    for r in rows:
        r['context'] = snapshot_near(snaps, r['t']) if (snaps and context) else ''
        r['run'] = next((n for n, (a, b) in enumerate(runs, 1)
                         if a - RUN_EDGE_SLACK_S <= r['t'] <= b + RUN_EDGE_SLACK_S), 0)
        r['stale'] = not in_runs(r['t'], current, RUN_EDGE_SLACK_S)
        absent = (r['section'] in ('LEGACY-ONLY', 'SHADOW-ONLY')
                  and r['verb'] not in cverbs) or \
                 (r['section'] in ('COUCHD-ONLY', 'ACTED-ONLY')
                  and r['verb'] not in lverbs)
        if absent:                      # vocabulary gap, not a decision divergence
            r['note'] = '; '.join(x for x in (r['note'], 'verb never appears in the '
                                  'other stream at all (structural)') if x)
    cooled = [{'t': it['t'], 'verb': it['verb'], 'subject': it['subject'], 'side': side,
               'args': arg_str(it),
               'offset': it['t'] - p['couchd' if p['direction'] == ACTING
                                    else 'legacy']['t'],
               'note': '%s repeat of the pair at %s (%s), window %.0fs' %
                       ('legacy' if side == 'legacy' else 'couchd fan-out',
                        fmt_t(p['couchd' if p['direction'] == ACTING
                                else 'legacy']['t']),
                        it['reason'] if side == 'couchd' else p['couchd']['reason'],
                        cooldown_s(p['couchd']['reason']))}
              for it, p, side in assoc]
    launch_rows = [{'t': it['t'], 'verb': it['verb'], 'subject': it['subject'],
                    'side': side, 'args': arg_str(it), 'offset': it['t'] - lt,
                    'note': 'launch-sequence artifact: %+.1fs from the launch at %s '
                            '(non-gating)' % (it['t'] - lt, fmt_t(lt))}
                   for it, lt, side in sorted(l_seq + c_seq, key=lambda x: x[0]['t'])]

    verbs = sorted({i['verb'] for i in legacy_i + couchd_i})
    counts = {v: {s: sum(1 for r in rows if r['section'] == s and r['verb'] == v)
                  for s in SECTIONS} for v in verbs}
    offsets = {}
    for v in verbs:
        o = [abs(p['offset']) for p in pairs if p['legacy']['verb'] == v]
        if o:
            offsets[v] = {'n': len(o), 'min': min(o), 'p50': pct(o, 50),
                          'p95': pct(o, 95), 'max': max(o)}
    run_rows = [{'n': n, 'start': a, 'end': b, 'stale': (a, b) not in current,
                 'model': run_models[n - 1] if n <= len(run_models) else None,
                 'intents': sum(1 for i in couchd_i if a <= i['t'] <= b),
                 'rows': sum(1 for r in rows if r['run'] == n)}
                for n, (a, b) in enumerate(runs, 1)]
    if len(runs) > 1:
        notes.append('couchd ran %d times (%s); gaps between runs are not blindness'
                     % (len(runs), ', '.join('%s..%s' % (fmt_t(a), fmt_t(b))
                                             for a, b in runs)))
    # The direction table, clipped to whatever stretch is under review, so it
    # cannot describe an evening the verdict does not cover.
    lo, hi = (window if window else (runs[0][0], runs[-1][1]))
    own_rows = [{'from': max(a, lo), 'to': min(b, hi), 'owned': sorted(o),
                 'label': ('couchd acting / legacy shadowing for %s (legacy '
                           'still acting on everything else)' % ', '.join(sorted(o))
                           if o else
                           'legacy acting / couchd shadowing (couchd owns nothing)')}
                for a, b, o in windows if b >= lo and a <= hi]
    owned_here = sorted({n for w in own_rows for n in w['owned']})
    if owned_here:
        notes.append('DIRECTION REVERSED for %s inside this window: couchd\'s '
                     'acted intents are the acting stream and the legacy '
                     'scripts\' yielded would-dos are the shadow (rows in '
                     'ACTED-ONLY / SHADOW-ONLY, read that way round)'
                     % ', '.join(owned_here))
    acting = acting_health(crecs, current)
    health = observer_health(obs, blinds, snaps, current, notes)
    disagreements = [dict(r, label=agreement_label(r)[0], why=agreement_label(r)[1])
                     for r in agree if disagrees(r)
                     and in_runs(float(r.get('t', 0)), current, RUN_EDGE_SLACK_S)]
    reasons = list(health['reasons'])
    if not l_ok:
        reasons.append('legacy intent stream missing or empty - nothing to compare')
    if not c_ok:
        reasons.append('couchd shadow stream missing or empty - nothing to compare')
    # A violation carried by an intent that is only a fan-out repeat of a decision we
    # already judged is reported, not double-counted.
    on_rows = {round(r['t'], 6) for r in rows if 'ORDER' in r['flags']}
    absorbed = len([a for a in viol.values()
                    if round(a['intent']['t'], 6) not in on_rows])
    hard = [r for r in rows if ('SET-MISMATCH' in r['flags'] or 'ORDER' in r['flags'])
            and not r['stale']]
    gating = [r for r in hard if r['label'] != 'T5']   # pre-declared = not gating
    # What the verdict is a verdict OVER. A gate computed across zero
    # comparable decisions is not a pass, and must never be able to read like
    # one (the 5 Aug replay found Evening 1's own "0 gating divergences"
    # came out of a 4-minute idle window with 0 intents in it).
    evaluated = [r for r in rows if not r['stale']]
    matched_here = [p for p in pairs
                    if in_runs(p['couchd']['t'], current, RUN_EDGE_SLACK_S)]
    scope = {'from': (window[0] if window else (runs[0][0] if runs else span[0])),
             'to': (window[1] if window else (runs[-1][1] if runs else span[1])),
             'source': '--window' if window else ('--since' if since else 'data'),
             'runs_clipped': clipped,
             'model': model_key, 'model_rule': model_rule,
             'rows_evaluated': len(evaluated),
             'rows_stale': len(rows) - len(evaluated),
             'matched_evaluated': len(matched_here),
             'decisions': len(matched_here) + len(evaluated)}
    if not scope['decisions']:
        reasons.append('nothing to judge: 0 comparable decisions inside the '
                       'window under review (%s..%s) - a gate computed over an '
                       'empty stretch is not a pass'
                       % (fmt_t(scope['from']), fmt_t(scope['to'])))
    return {'inputs': {'legacy': legacy_path, 'couchd': shadow_path,
                       'snapshots': snapshots_path if snaps else None},
            'notes': notes, 'rows': rows, 'cooldown_associated': cooled,
            'launch_sequence': launch_rows, 'runs': run_rows, 'model_t': model_t,
            'absorbed_violations': absorbed,
            'matched_total': len(pairs),
            'matched_clean': len(pairs) - len([p for p in pairs if p['flags']]),
            'counts': counts, 'offsets': offsets, 'context_records': len(ctx),
            'yield_markers': len(yields),
            'ownership': {'windows': own_rows, 'owned': owned_here,
                          'reversed': bool(owned_here)},
            'acting_health': acting,
            'acting_declined': [{'t': it['t'], 'verb': it['verb'],
                                 'subject': it['subject'],
                                 'outcome': acting_outcome(it['raw'])[0],
                                 'detail': acting_outcome(it['raw'])[1]}
                                for it in sorted(declined, key=lambda i: i['t'])],
            'scope': scope,
            'edge_latency': edge_latency(crecs, runs),
            'assertions': [{k: v for k, v in a.items() if k != 'intent'}
                           for a in asserts],
            'agreement': {'total': len(agree), 'disagreements': disagreements},
            'observer_health': health,
            'gating_count': len(gating) + len([d for d in disagreements
                                               if d['label'] != 'T5']),
            'whitelisted_hard': len(hard) - len(gating),
            'validity': {'verdict': 'INVALID' if reasons else 'VALID',
                         'reasons': reasons}}


def render(rep):
    out = ['couchd shadow-diff  legacy=%s' % rep['inputs']['legacy'],
           '                    couchd=%s' % rep['inputs']['couchd']]
    h = rep['observer_health']
    if h['span_s']:
        out.append('                    window=%s..%s (%.0f min)' %
                   (fmt_t(h['window'][0]), fmt_t(h['window'][1]), h['span_s'] / 60.0))
    out += ['  ! %s' % n for n in rep['notes']]
    own = rep['ownership']
    out += ['', '== OWNERSHIP == (which stack ACTED, from couchd\'s own daemon '
                'records; the other one is the shadow)']
    for w in own['windows']:
        out.append('  %s..%s  %s' % (fmt_t(w['from']), fmt_t(w['to']), w['label']))
    if not own['windows']:
        out.append('  (no daemon records: read as couchd owning nothing)')
    for sec in SECTIONS:
        rows = [r for r in rep['rows'] if r['section'] == sec]
        if not rows and sec in REVERSED_SECTION.values():
            continue        # pre-flip evenings never mention the reversed classes
        out += ['', '== %s ==%s (%d)' % (sec, SECTION_MEANING.get(sec, ''),
                                         len(rows))]
        if not rows:
            out.append('  (none)')
        for r in rows:
            off = ' off=%+.3fs' % r['offset'] if r['offset'] is not None else ''
            flg = ' [%s]' % ','.join(r['flags']) if r['flags'] else ''
            out.append('  %-3s %s  %s(%s)%s  %s%s%s%s' %
                       (r['label'] or '..', fmt_t(r['t']), r['verb'], r['subject'],
                        flg, r['args'], off,
                        '  <couchd acting>'
                        if r.get('direction') == ACTING
                        and r['section'] == 'BOTH-BUT-DIFFERENT' else '',
                        '  ~run%d stale-model' % r['run'] if r['stale'] else ''))
            out += ['        %s' % x for x in (r['note'], r['context']) if x]
    ag = rep['agreement']
    out += ['', '== AGREEMENT (freeze-set / channel cross-checks, gating per R4) == '
                '(%d of %d disagree)' % (len(ag['disagreements']), ag['total'])]
    out += ['  %-3s %s  %s\n        %s' %
            (r.get('label') or '..', fmt_t(float(r.get('t', 0))),
             r.get('metric') or 'freeze_set', r.get('why', ''))
            for r in ag['disagreements']] or ['  (none)']
    if rep['launch_sequence']:
        out += ['', '== LAUNCH-SEQUENCE == (%d unmatched rows inside %ds of a launch '
                    '- artifacts of the same finger, non-gating)'
                % (len(rep['launch_sequence']), LAUNCH_WINDOW_S)]
        for r in rep['launch_sequence'][:INFO_ROWS_SHOWN]:
            out.append('  ..  %s  %-6s %s(%s)  %s\n        %s' %
                       (fmt_t(r['t']), r['side'], r['verb'], r['subject'], r['args'],
                        r['note']))
        if len(rep['launch_sequence']) > INFO_ROWS_SHOWN:
            out.append('  ... %d more (--json for all)'
                       % (len(rep['launch_sequence']) - INFO_ROWS_SHOWN))
    if rep['cooldown_associated']:
        out += ['', '== COOLDOWN-ASSOCIATED == (%d repeats/fan-out of an already '
                    'matched decision - not divergences)'
                % len(rep['cooldown_associated'])]
        for r in rep['cooldown_associated'][:INFO_ROWS_SHOWN]:
            out.append('  ..  %s  %-6s %s(%s)  %s off=%+.3fs\n        %s' %
                       (fmt_t(r['t']), r['side'], r['verb'], r['subject'], r['args'],
                        r['offset'], r['note']))
        if len(rep['cooldown_associated']) > INFO_ROWS_SHOWN:
            out.append('  ... %d more (--json for all)'
                       % (len(rep['cooldown_associated']) - INFO_ROWS_SHOWN))
    if len(rep['runs']) > 1:
        out += ['', '== RUNS == (rows in stale-model runs are informational only)']
        for r in rep['runs']:
            out.append('  run%d  %s..%s (%3.0f min)  intents=%-3d rows=%-3d %s'
                       % (r['n'], fmt_t(r['start']), fmt_t(r['end']),
                          (r['end'] - r['start']) / 60.0, r['intents'], r['rows'],
                          'STALE-MODEL (pre %s)' % fmt_t(rep['model_t'])
                          if r['stale'] else 'current model'))
    out += ['', '== SUMMARY ==',
            '  matched %d (%d clean, %d differing); gating (SET-MISMATCH/ORDER/'
            'agreement, per R4/R5): %d, +%d pre-declared T5 not gating'
            % (rep['matched_total'], rep['matched_clean'],
               rep['matched_total'] - rep['matched_clean'], rep['gating_count'],
               rep['whitelisted_hard'])]
    # The reversed columns only appear on an evening that actually had a flip
    # in it, so a shadow evening's summary reads exactly as it always did.
    cols = [s for s in SECTIONS if s not in REVERSED_SECTION.values()
            or any(c[s] for c in rep['counts'].values())]
    out.append('  %-18s %s' % ('verb', ' '.join('%8s' % SECTION_SHORT[s]
                                                for s in cols)))
    for v, c in sorted(rep['counts'].items()):
        if any(c.values()):
            out.append('  %-18s %s' % (v, ' '.join('%8d' % c[s] for s in cols)))
    out.append('  matched-offset ms (min/p50/p95/max), bound %dms for %s:'
               % (PERCEPTUAL_BOUND_S * 1000, '/'.join(PERCEPTUAL_VERBS)))
    for v, o in sorted(rep['offsets'].items()):
        out.append('    %-16s n=%-3d %6.0f %6.0f %6.0f %6.0f' %
                   (v, o['n'], o['min'] * 1000, o['p50'] * 1000, o['p95'] * 1000,
                    o['max'] * 1000))
    ah = rep['acting_health']
    if ah['records'] or ah['effect_records']:
        t = ah['totals']
        out.append('  ACTING HEALTH (C17, couchd\'s own actions - health, not '
                   'divergence): acted %d, skipped %d, failed %d, refused %d, '
                   'model-only %d' % (t['acted'], t['skipped'], t['failed'],
                                      t['refused'], t['model-only']))
        out.append('    %-16s %7s %7s %7s %7s %7s   %s'
                   % ('verb', 'acted', 'skipped', 'failed', 'refused', 'mdl-only',
                      'effects (confirmed/missed/unverified)'))
        for v in sorted(set(ah['per_verb']) | set(ah['effects'])):
            row = ah['per_verb'].get(v, dict.fromkeys(ACTING_OUTCOMES, 0))
            e = ah['effects'].get(v)
            out.append('    %-16s %7d %7d %7d %7d %7d   %s'
                       % (v, row['acted'], row['skipped'], row['failed'],
                          row['refused'], row['model-only'],
                          '%d/%d/%d' % (e.get('confirmed', 0), e.get('missed', 0),
                                        e.get('unverified', 0)) if e else '-'))
        for x in ah['examples']:
            out.append('      %s %s %s(%s): %s' % (x['outcome'].upper(),
                                                   fmt_t(x['t']), x['verb'],
                                                   x['subject'], x['detail']))
    if rep['acting_declined']:
        out.append('    (%d unmatched intent(s) couchd decided and then DECLINED '
                   'are counted above, not as divergences - a skip changes '
                   'nothing for the shadow to disagree with)'
                   % len(rep['acting_declined']))
        for x in rep['acting_declined'][:INFO_ROWS_SHOWN]:
            out.append('      %s %s(%s) %s: %s' % (fmt_t(x['t']), x['verb'],
                                                   x['subject'], x['outcome'],
                                                   x['detail']))
    el = rep.get('edge_latency')
    if el:
        out.append('  couchd edge-to-decision ms (its own measure, not gating): '
                   'n=%d p50=%.0f p95=%.0f max=%.0f%s%s'
                   % (el['n'], el['p50'] * 1000, el['p95'] * 1000,
                      el['max'] * 1000,
                      '' if el['kernel_p95'] is None
                      else ' kernel-p95=%.0f' % (el['kernel_p95'] * 1000),
                      '' if el['within_bound']
                      else '  <-- ABOVE the %dms bound'
                           % (PERCEPTUAL_BOUND_S * 1000)))
        if el['coalesced']:
            out.append('    (%d neighbouring edge(s) coalesced into a decided '
                       'pass by the debounce)' % el['coalesced'])
    out.append('  happens-before assertions (R5, evaluated outside the windows):')
    by_name = {}
    for a in rep['assertions']:
        b = by_name.setdefault(a['name'], {'pass': 0, 'fail': 0, 'na': 0, 'ex': []})
        b['pass' if a['ok'] else ('fail' if a['ok'] is False else 'na')] += 1
        if a['ok'] is False and len(b['ex']) < 3:
            b['ex'].append(a['detail'])
    for name, b in sorted(by_name.items()) or [('(no assertable intents)', None)]:
        if b is None:
            out.append('    n/a  (no assertable intents)')
            continue
        out.append('    %s %s - %d pass, %d fail, %d unassociated'
                   % ('FAIL' if b['fail'] else 'PASS', name, b['pass'], b['fail'],
                      b['na']))
        out += ['           e.g. %s' % e for e in b['ex']]
    if rep['absorbed_violations']:
        out.append('    (%d failure(s) sit on fan-out repeats of a decision already '
                   'judged above - reported, not double-counted)'
                   % rep['absorbed_violations'])
    out.append('  observer health (obs are change-driven; heartbeat max gap %.0fs):'
               % h['heartbeat_gap'])
    for s in h['sources']:
        out.append('    %-9s %-9s %-8s n=%-4d last-gap %5.0fs' %
                   (s['source'], 'required' if s['required'] else 'optional',
                    'present' if s['present'] else 'SILENT', s['samples'],
                    s['last_gap']))
    # The verdict, and WHAT IT IS A VERDICT OVER. Never one without the other:
    # a gate computed over an idle stretch has to look like one on the page.
    s = rep['scope']
    out.append('  EVENING VALIDITY: %s' % rep['validity']['verdict'])
    out.append('    window %s..%s (%s), staleness by %s%s'
               % (fmt_t(s['from']), fmt_t(s['to']), s['source'], s['model_rule'],
                  ' %s' % s['model'] if s['model'] else ''))
    out.append('    direction: %s'
               % ('couchd ACTING on %s (legacy shadowing it); legacy acting on '
                  'the rest' % ', '.join(own['owned']) if own['reversed']
                  else 'legacy acting, couchd shadowing (couchd owns nothing '
                       'in this window)'))
    out.append('    judged %d decision(s): %d matched pair(s) + %d divergence '
               'row(s); %d row(s) skipped as stale-model%s'
               % (s['decisions'], s['matched_evaluated'], s['rows_evaluated'],
                  s['rows_stale'],
                  ', %d run(s) clipped away by --window' % s['runs_clipped']
                  if s['runs_clipped'] else ''))
    out.append('    gating divergences: %d%s'
               % (rep['gating_count'],
                  '' if s['decisions'] else '  <-- over NOTHING; not a pass'))
    out += ['    - %s' % r for r in rep['validity']['reasons']]
    return '\n'.join(out)


def parse_since(text, day, flag='--since'):
    """--since as HH:MM[:SS] against the report's date, or a raw epoch."""
    if not text:
        return None
    try:
        return float(text) if float(text) > 100000 else None
    except ValueError:
        pass
    for fmt in ('%Y%m%d %H:%M:%S', '%Y%m%d %H:%M'):
        try:
            return datetime.strptime('%s %s' % (day, text), fmt).timestamp()
        except ValueError:
            continue
    raise SystemExit('%s: expected HH:MM, HH:MM:SS or an epoch, got %r'
                     % (flag, text))


def parse_window(text, day):
    """--window A-B, either end optional: `00:38-03:15`, `-03:15`, `21:00-`.

    Pins the stretch of the evening under review, so a verdict cannot be
    computed over whatever the files happen to contain and then read as if it
    covered the evening.
    """
    if not text:
        return None
    lo, sep, hi = text.partition('-')
    if not sep:
        raise SystemExit('--window: expected START-END (either end may be '
                         'empty), got %r' % text)
    t0 = parse_since(lo.strip(), day, '--window') if lo.strip() else 0.0
    t1 = parse_since(hi.strip(), day, '--window') if hi.strip() else float('inf')
    if t0 is None or t1 is None or t1 <= t0:
        raise SystemExit('--window: END must be after START, got %r' % text)
    return (t0, t1)


def main(argv=None):
    ap = argparse.ArgumentParser(
        description=__doc__.split('\n')[0],
        epilog=__doc__[__doc__.index('Examples:'):],
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('legacy', nargs='?', help='legacy intent JSONL '
                    '(default /tmp/legacy-intents.jsonl, or a copy off /tmp)')
    ap.add_argument('--legacy', dest='legacy_opt', help='same, as an option')
    ap.add_argument('--shadow', help='couchd shadow JSONL (overrides --date)')
    ap.add_argument('--date', help='evening as YYYYMMDD (default today)')
    ap.add_argument('--shadow-dir', default=os.path.expanduser('~/couch/shadow'))
    ap.add_argument('--snapshots', help='world-snapshot JSONL for divergence context')
    ap.add_argument('--no-context', action='store_true')
    ap.add_argument('--since', help='ignore everything before HH:MM[:SS] (of --date) '
                    'or an epoch; runs before the newest daemon start are marked '
                    'stale automatically, so this is only for narrowing further')
    ap.add_argument('--window', help='pin the stretch under review: START-END '
                    'as HH:MM[:SS] (of --date) or epochs, either end optional. '
                    'The verdict line states the window it covered and how many '
                    'decisions were in it, so an idle stretch cannot pass as an '
                    'evening')
    ap.add_argument('--json', action='store_true', help='machine-readable report')
    a = ap.parse_args(argv)
    day = a.date or datetime.now().strftime('%Y%m%d')
    legacy = a.legacy_opt or a.legacy or '/tmp/legacy-intents.jsonl'
    shadow = a.shadow or os.path.join(a.shadow_dir, 'couchd-%s.jsonl' % day)
    snaps = a.snapshots or os.path.join(a.shadow_dir, 'snapshots-%s.jsonl' % day)
    rep = build(legacy, shadow, snaps, parse_since(a.since, day), not a.no_context,
                window=parse_window(a.window, day))
    print(json.dumps(rep, indent=1, default=str) if a.json else render(rep))
    return 0 if rep['validity']['verdict'] == 'VALID' and not rep['gating_count'] else 1


if __name__ == '__main__':
    sys.exit(main())
