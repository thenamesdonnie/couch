#!/usr/bin/env python3
"""shadow-diff - offline comparison of legacy console intents vs couchd's shadow stream.

Run by hand in the morning. Reads the two JSONL streams, greedily interval-joins
them on (verb, canonical subject) inside per-verb tolerance windows, and prints the
three divergence classes from R2 with an empty T-label column for hand triage.

It NEVER touches the TV, X, Kodi, Steam, the pad or any daemon. Files in, text out.

Examples:
  tools/shadow-diff                          # today's shadow log + /tmp/legacy-intents.jsonl
  tools/shadow-diff --date 20260804          # a specific evening
  tools/shadow-diff corpus/legacy-0804.jsonl # legacy stream copied off /tmp
  tools/shadow-diff --shadow ~/couch/shadow/couchd-20260804.jsonl --json > diff.json
  tools/shadow-diff --date 20260804 --no-context   # skip world-snapshot context lines

Triage labels (C10): T1 harness, T2 benign, T3 bug-in-old, T4 bug-in-couchd (the only
gating bucket), T5 pre-declared, T6 same decision wrong latency.
"""
import argparse
import json
import os
import sys
from datetime import datetime

# ---- tunables (edit here; every number is ours to recalibrate, per /build) ----
TOLERANCE = {                       # seconds, per verb, +/- around the legacy event
    'freeze': 5.0, 'thaw': 5.0, 'kill': 5.0,
    'route_pad': 2.0, 'show': 2.0, 'close_steam_menu': 2.0,
    'dismiss': 2.0, 'iconify': 2.0,
    'launch': 10.0, 'quit': 10.0, 'set_flag': 10.0, 'clear_flag': 10.0,
    'request_tv_wake': 10.0,
    # Both stacks gained the double-tap switcher in the same change, so there
    # is no T5 whitelist entry for it: show_switcher must appear in BOTH
    # streams or it is a real T4. The watcher fires the addon immediately
    # after its suspend, couchd emits the intent in the same pass.
    'show_switcher': 3.0,
    # The paused game's freeze-frame. Both stacks gained it in the same change,
    # so like show_switcher there is no T5 entry: it must appear in BOTH
    # streams. Wider than the flag verbs it follows because the watcher runs
    # pause-snap off its select loop (a blocked watcher is a pad that stops
    # responding), so the legacy line can trail its own freeze by a beat.
    'snapshot': 5.0,
    # Only reachable from a non-default key binding (Couch Switcher >
    # Configure). Both stacks decide it off the same gestureconf read, so it
    # is diffable like everything else; the window is wide because the effect
    # is a network dial to the TV that takes 6-8s from cold.
    'tv_toggle': 15.0,
}
DEFAULT_TOLERANCE = 5.0
# couchd emits ONE intent per (verb, subject, reason) per cooldown window, so legacy
# repeats inside that window associate to the same intent (many-to-one) instead of
# piling up as LEGACY-ONLY rows. Class is inferred from the intent's reason string.
COOLDOWN = {'gesture': 3.0, 'guard': 5.0, 'transition': 10.0, 'repair': 30.0}
REASON_CLASS = (('repair', 'repair'), ('reconcile', 'repair'), ('entropy', 'repair'),
                ('guard', 'guard'), ('enforce', 'guard'), ('gesture', 'gesture'),
                ('ps-', 'gesture'), ('hold', 'gesture'), ('tap', 'gesture'))
DEFAULT_COOLDOWN_CLASS = 'transition'
PID_SET_VERBS = {'freeze', 'thaw', 'quit', 'kill'}   # R4: pid sets are diffable args
# Trigger channels (R4): the user's finger, not a reconcile decision. couchd cannot
# predict a launch, so these are counted and shown as context, never diffed.
CONTEXT_VERBS = {'invoked', 'launch', 'request_tv_wake'}
# The routing/raising cluster game-launch fires while a launch is in flight. Unmatched
# inside LAUNCH_WINDOW_S of a launch it is a launch-sequence artifact, not a divergence.
LAUNCH_CLUSTER_VERBS = ('route_pad', 'show')
LAUNCH_WINDOW_S = 15.0
# legacy says show(game); couchd says show(<appid>). Same window, different vocabulary.
SUBJECT_ALIASES = {'show': ('game',)}
PERCEPTUAL_BOUND_S = 0.250           # C10/T6 routing+raise bound, p95 gated
PERCEPTUAL_VERBS = ('route_pad', 'show')
OBSERVER_BLIND_LIMIT_S = 300.0       # R5 observer-health gate: >5 min blind = INVALID
HEARTBEAT_LIMIT_S = 300.0            # max gap in world obs + snapshots (cadence ~30s)
GESTURE_ASSOC_S = 5.0                # route_pad <-> gesture release association window
FLAG_FREEZE_S = 10.0                 # freeze -> set_flag(suspended) pairing window
BP_HOLD_S = 20.0                     # R7(a) big-picture-hold context lookback
REAPER_SLACK = 2                     # R5 whitelist: transient reaper children tolerated
# obs sources are CHANGE-driven: silence is not staleness, so a silent source is a
# note, never a verdict. Blindness comes from the daemon's own observer_blind records,
# from heartbeat gaps, and from ACTIVITY_CHECKS (world said active, source said nothing).
REQUIRED_SOURCES = ('pad', 'flags', 'pids', 'kodi', 'x11', 'steam')
OPTIONAL_SOURCES = ('trigger', 'world')
ACTIVITY_CHECKS = {'pad': lambda w: bool((w.get('pad') or {}).get('present')),
                   'pids': lambda w: bool(w.get('pids'))}
GESTURE_IDLE_IGNORE = ('pad-quiet', 'init', 'startup')   # not real release edges
# R5's "route_pad after the release edge" assumes the release-driven path. A hold that
# TIMES OUT is decided with the button still down, on purpose, so the assertion does
# not apply - it is reported n/a, never as an ordering violation.
HB_RELEASE_EXEMPT = ('timeout',)
INFO_ROWS_SHOWN = 12                 # cap on the two non-gating info sections
# Comparison only means anything while couchd was actually running: daemon start/stop
# records carve the evening into runs. Legacy actions outside them are not divergences
# (R6: a stopped couchd is never an error), and health is judged inside runs only.
RUN_EDGE_SLACK_S = 10.0
IGNORE_ARG_KEYS = {'pids', 'pid_set', 'frozen_pids', 'pid', 'resolver', 'argv',
                   'snapshot', 't', 'mono', 'seq', 'ts', 'release_t'}
SECTIONS = ('COUCHD-ONLY', 'LEGACY-ONLY', 'BOTH-BUT-DIFFERENT')


# ---- loading -----------------------------------------------------------------
def load_jsonl(path, notes, label):
    """Return (records, ok). Missing/partial files degrade to a note, never a crash."""
    if not path or not os.path.exists(path):
        notes.append('%s stream MISSING: %s (diff below is not a real comparison)'
                     % (label, path))
        return [], False
    recs, bad = [], 0
    with open(path, 'r', errors='replace') as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                r = json.loads(line)
            except ValueError:
                bad += 1
                continue
            if isinstance(r, dict):
                recs.append(r)
    if bad:
        notes.append('%s stream: %d unparseable line(s) skipped (truncated tail?)'
                     % (label, bad))
    if not recs:
        notes.append('%s stream empty: %s' % (label, path))
    return recs, bool(recs)


def as_intent(rec, side):
    """Normalise an intent record into the comparable shape.

    couchd tags intents kind=="intent"; legacy lines carry no kind at all.
    """
    if rec.get('kind') not in (None, 'intent') or not rec.get('verb'):
        return None
    try:
        t = float(rec.get('t'))
    except (TypeError, ValueError):
        return None
    args = rec.get('args') if isinstance(rec.get('args'), dict) else {}
    return {'t': t, 'verb': str(rec['verb']), 'subject': rec.get('subject'),
            'args': args, 'side': side, 'reason': rec.get('reason'),
            'origin': rec.get('src') or rec.get('reason') or side,
            'seq': rec.get('seq'), 'raw': rec}


def canon(subject):
    """appids compare as strings; everything case- and whitespace-insensitive."""
    if subject is None:
        return ''
    if isinstance(subject, bool):
        return str(subject).lower()
    if isinstance(subject, (int, float)):
        return str(int(subject))
    return str(subject).strip().lower()


def subj_match(verb, a, b):
    """Subject equality, with the documented per-verb aliases."""
    ca, cb = canon(a), canon(b)
    if ca == cb:
        return True
    for alias in SUBJECT_ALIASES.get(verb, ()):
        if (ca == alias and cb.isdigit()) or (cb == alias and ca.isdigit()):
            return True
    return False


def pid_set(it):
    """frozenset of pid strings, or None when this intent carries no pid set."""
    a = it['args']
    for k in ('pids', 'pid_set', 'frozen_pids'):
        v = a.get(k)
        if isinstance(v, (list, dict)):     # list of pids, or {pid: state}
            return frozenset(str(p) for p in v)
    if a.get('pid') is not None:
        return frozenset([str(a['pid'])])
    return None


def arg_diff(a, b):
    """Keys both sides define with different values (volatile keys excluded)."""
    return ['%s=%s|%s' % (k, a['args'][k], b['args'][k])
            for k in sorted(set(a['args']) & set(b['args']) - IGNORE_ARG_KEYS)
            if canon(a['args'][k]) != canon(b['args'][k])]


# ---- matching (greedy interval join, R2 + cooldown many-to-one) ---------------
def match(legacy, couchd):
    """Time-sorted greedy nearest-match. Returns (pairs, legacy_only, couchd_only)."""
    legacy = sorted(legacy, key=lambda i: i['t'])
    couchd = sorted(couchd, key=lambda i: i['t'])
    taken, pairs, l_only = set(), [], []
    for li in legacy:
        tol = TOLERANCE.get(li['verb'], DEFAULT_TOLERANCE)
        best, best_dt = None, None
        for n, ci in enumerate(couchd):
            if n in taken or ci['verb'] != li['verb']:
                continue
            if not subj_match(li['verb'], ci['subject'], li['subject']):
                continue
            dt = ci['t'] - li['t']
            if abs(dt) <= tol and (best_dt is None or abs(dt) < abs(best_dt)):
                best, best_dt = n, dt
        if best is None:
            l_only.append(li)
        else:
            taken.add(best)
            pairs.append({'legacy': li, 'couchd': couchd[best], 'offset': best_dt,
                          'flags': [], 'notes': [], 'repeats': []})
    return pairs, l_only, [ci for n, ci in enumerate(couchd) if n not in taken]


def cooldown_s(reason):
    r = canon(reason)
    for needle, cls in REASON_CLASS:
        if needle in r:
            return COOLDOWN[cls]
    return COOLDOWN[DEFAULT_COOLDOWN_CLASS]


def associate_repeats(pairs, leftovers, side):
    """One decision, several records: attach repeats/fan-out to their matched pair.

    Two asymmetries make this necessary, and they run in OPPOSITE directions:
      legacy side  - the old scripts re-do an action every reconcile tick, while
                     couchd emits once per (verb, subject, reason) cooldown window;
      couchd side  - couchd splits one real decision across several reasons (a
                     hold-release route_pad AND a joystick-drift repair, 120ms apart),
                     while the old stack writes the pad once.
    A strict 1:1 join orphans the siblings and reports them as one-sided divergences.
    """
    still, assoc = [], []
    for it in leftovers:
        hit = None
        for p in pairs:
            other = p['legacy' if side == 'legacy' else 'couchd']
            if other['verb'] != it['verb'] or \
                    not subj_match(it['verb'], other['subject'], it['subject']):
                continue
            span = max(TOLERANCE.get(it['verb'], DEFAULT_TOLERANCE),
                       cooldown_s(it['reason'] if side == 'couchd'
                                  else p['couchd']['reason']))
            anchor = p['legacy']['t']       # both sides hang off the legacy action
            lo = anchor if side == 'legacy' else anchor - span   # repeats only follow
            if lo <= it['t'] <= anchor + span:
                hit = p
                break
        if hit is None:
            still.append(it)
        else:
            hit['repeats'].append(it)
            assoc.append((it, hit, side))
    return still, assoc


def launch_sequence_split(leftovers, launches, side):
    """A launch is the user's finger, not a decision either stack could predict.

    The route_pad/show cluster fired while a launch is in flight is a consequence of
    that finger, so an unmatched one inside the launch window is an artifact of the
    two stacks reacting at different points of the same sequence - reported, never
    gating. Anything outside the window stays a real divergence.
    """
    still, seq = [], []
    for it in leftovers:
        near = [l for l in launches if abs(l - it['t']) <= LAUNCH_WINDOW_S]
        if it['verb'] in LAUNCH_CLUSTER_VERBS and near:
            seq.append((it, min(near, key=lambda l: abs(l - it['t'])), side))
        else:
            still.append(it)
    return still, seq


def compare_pair(p):
    """Fill in SET-MISMATCH / ARGS-DIFF flags for a matched pair."""
    li, ci = p['legacy'], p['couchd']
    if li['verb'] in PID_SET_VERBS:
        lp, cp = pid_set(li), pid_set(ci)
        if lp is None or cp is None:
            p['notes'].append('pid set absent on %s side' %
                              ('legacy' if lp is None else 'couchd'))
        elif lp != cp:
            p['flags'].append('SET-MISMATCH')
            p['notes'].append('legacy-only pids=%s couchd-only pids=%s' %
                              (sorted(lp - cp) or '-', sorted(cp - lp) or '-'))
    d = arg_diff(li, ci)
    if d:
        p['flags'].append('ARGS-DIFF')
        p['notes'].append(' '.join(d))
    return p


# ---- happens-before assertions (R5, independent of the tolerance windows) -----
def release_edges(obs, transitions):
    """PS release edges, best channel first.

    The pad's BTN_MODE=0 carries a KERNEL timestamp: that is the release, full stop.
    Gesture->idle transitions are only a fallback for when the pad observer was blind,
    because they are written when the gesture machine *decides* (handoff-decided,
    double-tap-window-expired) - in the same pass as the intent they would be judging,
    which manufactures 0ms 'the intent preceded the release' failures.
    """
    kernel = sorted(float(r.get('kernel_t') or r['t']) for r in obs
                    if r.get('source') == 'pad' and r.get('event') == 'BTN_MODE'
                    and not r.get('value'))
    fallback = sorted(float(r.get('kernel_t') or r['t']) for r in transitions
                      if r.get('region') == 'gesture' and r.get('to') == 'idle'
                      and canon(r.get('reason')) not in GESTURE_IDLE_IGNORE)
    return {'kernel': kernel, 'fallback': fallback}


def assertions(couchd_i, legacy_i, edges, pairs):
    """Returns a list of {'name','ok','detail','intent'} rows."""
    rows = []
    for it in couchd_i:
        if it['verb'] != 'route_pad' or canon(it['subject']) != 'kodi':
            continue
        if any(x in canon(it['reason']) for x in HB_RELEASE_EXEMPT):
            rows.append({'name': 'route_pad(kodi) after gesture release', 'ok': None,
                         'detail': 'exempt: %s decides with the button still down'
                                   % it['reason'], 'intent': None})
            continue
        r = it['args'].get('release_t', it['args'].get('gesture_release_t'))
        near, src = ([float(r)], 'args') if r is not None else ([], '')
        for chan in ('kernel', 'fallback'):     # kernel edge wins whenever one exists
            if near:
                break
            near, src = [x for x in edges.get(chan, ())
                         if abs(x - it['t']) <= GESTURE_ASSOC_S], chan
        if not near:
            rows.append({'name': 'route_pad(kodi) after gesture release', 'ok': None,
                         'detail': 'no release edge within %.0fs - unassociated'
                                   % GESTURE_ASSOC_S, 'intent': it})
            continue
        edge = min(near, key=lambda x: abs(x - it['t']))
        ok = it['t'] >= edge
        rows.append({'name': 'route_pad(kodi) after gesture release', 'ok': ok,
                     'src': src,
                     'detail': 'route_pad %+.3fs relative to release edge (%s)'
                               % (it['t'] - edge, src), 'intent': None if ok else it})
    for it in legacy_i + couchd_i:
        if it['verb'] != 'set_flag':
            continue
        if 'suspend' not in canon(it['subject'] or it['args'].get('flag')):
            continue
        near = [f for f in legacy_i + couchd_i
                if f['verb'] == 'freeze' and abs(f['t'] - it['t']) <= FLAG_FREEZE_S]
        if not near:
            rows.append({'name': 'freeze before set_flag(suspended)', 'ok': None,
                         'detail': 'no freeze within %.0fs of the flag (R7(a) shape?)'
                                   % FLAG_FREEZE_S, 'intent': it})
            continue
        first = min(near, key=lambda f: f['t'])
        ok = first['t'] <= it['t']
        rows.append({'name': 'freeze before set_flag(suspended)', 'ok': ok,
                     'detail': 'freeze %+.3fs relative to the flag write'
                               % (first['t'] - it['t']), 'intent': None if ok else it})
    for verb in PERCEPTUAL_VERBS:
        offs = [abs(p['offset']) for p in pairs if p['legacy']['verb'] == verb]
        if offs:
            rows.append({'name': '%s matched-offset p95 <= %dms'
                                 % (verb, PERCEPTUAL_BOUND_S * 1000),
                         'ok': pct(offs, 95) <= PERCEPTUAL_BOUND_S,
                         'detail': 'p95=%.0fms over %d matches'
                                   % (pct(offs, 95) * 1000, len(offs)), 'intent': None})
    return rows


def edge_latency(crecs, runs):
    """couchd's OWN edge-to-decision latency, as it recorded it (R5).

    The matched-offset table below measures couchd against the legacy stack,
    which only works while there IS a legacy stack to measure against and only
    for decisions both of them take. This is the same quantity measured from
    the inside - kernel BTN_MODE event to decision - so a regression after the
    flip is still attributable, and so the 5 Aug "p95 1.4s vs a 250ms bound"
    number has a direct successor. Reported, never gating: it is couchd's
    account of itself.
    """
    vals, kern, coalesced = [], [], 0
    for r in crecs:
        if r.get('kind') != 'latency' or r.get('event') != 'gesture-edge':
            continue
        if not in_runs(float(r.get('t') or 0), runs, RUN_EDGE_SLACK_S):
            continue
        if not r.get('intents'):
            continue            # an edge that decided nothing has no latency
        if isinstance(r.get('decide_latency_s'), (int, float)):
            vals.append(float(r['decide_latency_s']))
        if isinstance(r.get('kernel_latency_s'), (int, float)):
            kern.append(float(r['kernel_latency_s']))
        coalesced += int(r.get('coalesced') or 0)
    if not vals:
        return None
    return {'n': len(vals), 'p50': pct(vals, 50), 'p95': pct(vals, 95),
            'max': max(vals), 'coalesced': coalesced,
            'kernel_p95': pct(kern, 95) if kern else None,
            'within_bound': pct(vals, 95) <= PERCEPTUAL_BOUND_S}


def pct(vals, p):
    vals = sorted(vals)
    if not vals:
        return 0.0
    k = (len(vals) - 1) * p / 100.0
    lo, hi = int(k), min(int(k) + 1, len(vals) - 1)
    return vals[lo] + (vals[hi] - vals[lo]) * (k - lo)


def disagrees(rec):
    """True when an agreement record (R4 freeze-set / channel metric) really diverges."""
    if rec.get('agree') is False:
        return True
    if rec.get('agree') is True:
        return False
    return any(isinstance(v, (list, tuple)) and v and
               any(w in k for w in ('only', 'diff', 'missing', 'extra'))
               for k, v in rec.items())


def agreement_label(rec):
    """(label, why) for a disagreeing freeze-set record.

    R5's whitelist pre-declares gameprocess-ledger vs game-pids on transient reaper
    children. So: couchd's would-freeze set agreeing with the process tree, with the
    difference confined to Steam's ledger, is the pre-declared case. couchd's own set
    drifting from the tree is not - that is the T4 the metric exists to catch.
    """
    tree_vs_couchd = rec.get('tree_minus_couchd') or rec.get('couchd_minus_tree')
    ledger = (rec.get('ledger_minus_tree') or []) + (rec.get('tree_minus_ledger') or [])
    if not tree_vs_couchd and ledger:
        return 'T5', ('R5 whitelist: Steam ledger vs process tree (%d pid(s)); couchd '
                      'agrees with the tree' % len(ledger))
    return '', 'couchd\'s would-freeze set differs from the process tree'


# ---- pre-declared whitelist (R5 + R7) ---------------------------------------
def bp_hold_context(t, couchd_i, legacy_i):
    """True when a big-picture hold with no game pids sits just before t (R7(a))."""
    for it in couchd_i + legacy_i:
        if not (t - BP_HOLD_S <= it['t'] <= t):
            continue
        a = it['args']
        bp = canon(it['subject']) == 'bigpicture' or \
            canon(a.get('foreground')) == 'bigpicture' or \
            canon(a.get('mode')) == 'bigpicture'
        if bp and it['verb'] in ('freeze', 'hold', 'set_flag', 'show', 'invoked') \
                and not (pid_set(it) or ()):
            return True
    return False


def triage(section, li, ci, flags, couchd_i, legacy_i):
    """Pre-fill the T column where a divergence matches the written-first whitelist.

    T5 note, written 5 Aug 2026 BEFORE the first flip (pre-declared per C10, so
    it cannot be mistaken for a T4 later):

      * TOGGLE CADENCE. couchd's toggle verbs (close_steam_menu, tv_toggle,
        show steam-menu) now carry cooldowns that outlast their own C17
        deadlines - 8s, 20s and 6s - because the underlying mechanism is a
        switch: a second guide press inside the first one's window REOPENS the
        menu it closed (the 02:53:48.9 + 02:53:53.2 dance commit f2ac188's
        latch exists to stop). The legacy guard re-checks once a second and can
        therefore emit two close_steam_menu lines where couchd emits one.
        A legacy-only REPEAT of a toggle inside couchd's cooldown is T5 (same
        decision, deliberately emitted once), NOT a missed decision. The first
        of the pair must still match, or it is a real T4.
      * MODEL CATCH-UP LANDED, 5 Aug 2026 (overnight). Every entry below that
        ends "couchd model catch-up pending" now HAS its model: couchd emits
        the iconify and its deiconify, the supersede-before-freeze kill, the
        refreeze repair, the desktop-overlay close, and (as decisions it
        records but never performs - game-launch does not yield either step)
        the Big-Picture pre-step and the appid adoption. The rules stay: they
        are pre-declared, and a whitelist that disappears the day the model
        catches up cannot tell you the model REGRESSED. Read them the other
        way round from tonight - a LEGACY-ONLY row still landing on one of
        them means couchd's version did not fire, which is worth the look it
        used to be exempt from.
      * YIELDED LEGACY LINES. Post-flip, the legacy scripts write their
        would-do with "yielded": true in args (shadow reversal), and the
        watcher emits a `yield` verb for gestures it no longer performs. This
        differ does not yet read either field - teaching it to is the first
        job of flip day, before the first flipped evening is triaged.
    """
    # R7(g) FIRST, ahead of R7(b): these rows have subject "bigpicture" too, but
    # they are a deliberate pre-step, not the appid-literal bug R7(b) describes.
    # Legacy puts Steam into Big Picture before every game so the pad talks to a
    # UI the guard can repair (desktop mode's overlay is invisible to it).
    if section == 'LEGACY-ONLY' and li['verb'] == 'launch' and \
            canon(li['args'].get('reason')) in ('ensure-bp-before-game',
                                                'ensure-bp-timeout'):
        return 'T5', 'R7(g) pre-declared: legacy switches Steam to Big Picture ' \
                     'before a game launch (uimode 7 -> 4); couchd model ' \
                     'catch-up pending'
    for it in [x for x in (li, ci) if x]:
        if canon(it['subject']) == 'bigpicture' or \
                canon(it['args'].get('appid')) == 'bigpicture':
            return 'T5', 'R7(b) pre-declared: legacy records appid literal ' \
                         '"bigpicture" (retriage as T3 - real legacy bug)'
    # R7(f): Steam in DESKTOP ui mode swallows the guide press a tap-resume
    # sends and opens its overlay over the game. Legacy's guard learned to
    # detect that from the routing log and close it; couchd models neither the
    # detection nor the close.
    if section == 'LEGACY-ONLY' and li['verb'] == 'close_steam_menu' and \
            canon(li['args'].get('reason')) == 'desktop-overlay-after-tap':
        return 'T5', 'R7(f) pre-declared: legacy closes Steam\'s desktop-mode ' \
                     'overlay after a tap-resume; couchd model catch-up pending'
    # R7(e): a game started from inside Big Picture has no appid in our own
    # state, so legacy re-reads it from Steam's gameprocess ledger and rewrites
    # the session line mid-flight. couchd derives regions from the same ledger
    # but does not yet model the rewrite.
    if section == 'LEGACY-ONLY' and li['verb'] == 'set_flag' and \
            canon(li['args'].get('reason')) == 'bigpicture-appid-adoption':
        return 'T5', 'R7(e) pre-declared: legacy adopts the real appid for a ' \
                     'game launched inside Big Picture; couchd model ' \
                     'catch-up pending'
    if section == 'LEGACY-ONLY' and li['verb'] in ('set_flag', 'clear_flag'):
        return 'T5', 'R5 whitelist: flag verbs are absent from couchd\'s stream'
    # R5 whitelist, written before evening one: "single arbiter replaces guard
    # supersede". The guard's window bookkeeping and its kill-the-previous-guard
    # handshake are a protocol between two competing enforcers; couchd IS the
    # arbiter, so it models the same thing as its enforcement region, not intents.
    if section == 'LEGACY-ONLY' and canon(li['origin']) == 'guard' and \
            li['verb'] in ('kill', 'window_open', 'window_close'):
        return 'T5', 'R5 whitelist: single arbiter replaces the guard supersede ' \
                     'protocol (couchd models this as its enforcement region)'
    if section == 'BOTH-BUT-DIFFERENT' and 'SET-MISMATCH' in flags:
        lp, cp = pid_set(li), pid_set(ci)
        if lp is not None and cp is not None and (lp <= cp or cp <= lp) and \
                len(lp ^ cp) <= REAPER_SLACK:
            return 'T5', 'R5 whitelist: gameprocess ledger vs game-pids, transient ' \
                         'reaper children'
    # R7(c): the frozen game's window is iconified at suspend and mapped back
    # at resume, because a SIGSTOPped client keeps whatever pointer grab it
    # froze holding (cursor over Kodi, XTEST clicks eaten) and X only drops a
    # grab when the grab window stops being viewable. Legacy-only tonight:
    # couchd model catch-up pending.
    if section == 'LEGACY-ONLY' and li['verb'] == 'iconify' and \
            canon(li['args'].get('via')) == 'wm-change-state':
        return 'T5', 'R7(c) pre-declared: legacy iconifies the frozen game at ' \
                     'suspend to release its stuck pointer grab; couchd model ' \
                     'catch-up pending'
    if section == 'LEGACY-ONLY' and li['verb'] == 'show' and \
            canon(li['args'].get('via')) == 'activate':
        return 'T5', 'R7(c) pre-declared: legacy maps the frozen game back ' \
                     '(_NET_ACTIVE_WINDOW) on resume and after a repair thaw, ' \
                     'before any normal raise; couchd model catch-up pending'
    # R7(d): the 4 Aug 2026 guard-vs-freeze race. Legacy grew a repair for the
    # state it left behind (flag set, game running) and a pre-emptive close of
    # any open guard window; couchd's model has neither yet.
    if section == 'LEGACY-ONLY' and li['verb'] == 'freeze' and \
            canon(li['args'].get('reason')) == 'reconcile:refreeze-lost-suspend':
        return 'T5', 'R7(d) pre-declared: legacy re-freezes a game whose ' \
                     'suspend was undone by a stale guard window; couchd ' \
                     'model catch-up pending'
    if section == 'LEGACY-ONLY' and li['verb'] == 'kill' and \
            canon(li['subject']) == 'steam-input-guard' and \
            canon(li['args'].get('reason')) == 'superseded-by-freeze':
        return 'T5', 'R7(d) pre-declared: legacy closes an open guard window ' \
                     'before freezing, so its thaw-repair cannot undo the ' \
                     'freeze; couchd model catch-up pending'
    if section == 'LEGACY-ONLY' and li['verb'] == 'window_close' and \
            canon(li['args'].get('reason')) == 'suspended-mid-window':
        return 'T5', 'R7(d) pre-declared: legacy\'s game-mode guard ends its ' \
                     'window when a suspend lands inside it; couchd model ' \
                     'catch-up pending'
    if section == 'LEGACY-ONLY' and li['verb'] == 'route_pad' and \
            canon(li['subject']) != 'kodi' and bp_hold_context(li['t'], couchd_i,
                                                               legacy_i):
        return 'T5', 'R7(a) pre-declared: legacy misses /tmp/game-suspended on a pure ' \
                     'Big Picture hold, reconcile then moves the pad ' \
                     '(retriage as T3 - real legacy bug)'
    return '', ''


# ---- observer health (R5, independent of diffing) ----------------------------
def world_series(obs, snaps):
    """(t, world-dict) samples from world obs + snapshots - the heartbeat channel."""
    out = [(float(r['t']), r) for r in obs if r.get('source') == 'world' and 't' in r]
    for s in snaps:
        w = dict(s)
        w.update(s.get('flags') or {})
        out.append((float(s['t']), w))
    return sorted(out, key=lambda x: x[0])


def daemon_runs(crecs, fallback):
    """[(start, end)] windows in which couchd was actually observing.

    With no daemon records at all we cannot know, so the whole data span is one run.
    When they exist, a run whose start record is missing (the log rotated at midnight
    mid-run) is anchored to couchd's own first record - NOT to the legacy stream,
    which is cumulative across days and once stretched run 1 back three hours.
    """
    marks = sorted((float(r['t']), r.get('event')) for r in crecs
                   if r.get('kind') == 'daemon' and isinstance(r.get('t'), (int, float)))
    if not marks:
        return [tuple(fallback)]
    cts = [float(r['t']) for r in crecs if isinstance(r.get('t'), (int, float))]
    first, last = (min(cts), max(cts)) if cts else fallback
    runs, start = [], None
    for t, ev in marks:
        if ev == 'start':
            start = t if start is None else start
        elif ev == 'stop':
            runs.append((start if start is not None else first, t))
            start = None
    if start is not None:
        runs.append((start, last))
    return runs or [tuple(fallback)]


def in_runs(t, runs, slack=0.0):
    return any(a - slack <= t <= b + slack for a, b in runs)


def observer_health(obs, blinds, snaps, runs, notes):
    """Heartbeat gaps, daemon-declared blindness, activity cross-checks, verdict."""
    t0, t1 = runs[0][0], runs[-1][1]
    span = sum(max(0.0, b - a) for a, b in runs)
    per = {}
    for r in obs:
        if isinstance(r.get('t'), (int, float)):
            per.setdefault(str(r.get('source') or 'unknown'), []).append(float(r['t']))
    health, reasons = [], []
    for src in sorted(set(REQUIRED_SOURCES) | set(OPTIONAL_SOURCES) | set(per)):
        ts = sorted(per.get(src, []))
        health.append({'source': src, 'present': bool(ts), 'samples': len(ts),
                       'required': src in REQUIRED_SOURCES,
                       'last_gap': (t1 - ts[-1]) if ts else span})
        if not ts and src in REQUIRED_SOURCES:
            notes.append('no %s observations all evening (obs are change-driven, so '
                         'quiet is not stale - but check the source was wired)' % src)

    series = world_series(obs, snaps)
    hb = 0.0
    for a, b in runs:                       # heartbeat judged INSIDE each daemon run
        beats = [t for t, _ in series if a <= t <= b]
        gaps = [beats[0] - a] + [y - x for x, y in zip(beats, beats[1:])] + \
               [b - beats[-1]] if beats else [b - a]
        hb = max([hb] + gaps)
        if max(gaps) > HEARTBEAT_LIMIT_S:
            reasons.append('world/snapshot heartbeat gap of %.0fs inside the run '
                           '%s..%s (limit %.0fs)' % (max(gaps), fmt_t(a), fmt_t(b),
                                                     HEARTBEAT_LIMIT_S))

    for b in blinds:
        age = float(b.get('age_s') or b.get('duration') or 0.0)
        txt = 'observer_blind on %s: %s %s (age %.0fs)' % (
            b.get('source'), b.get('why', ''), b.get('detail', ''), age)
        (reasons if age > OBSERVER_BLIND_LIMIT_S else notes).append(txt)

    for src, pred in ACTIVITY_CHECKS.items():       # world said active, source silent
        for a, b in runs:
            start, last = None, None
            for t, w in [x for x in series if a <= x[0] <= b] + [(b + 1.0, {})]:
                if pred(w):
                    start, last = (t if start is None else start), t
                    continue
                if start is not None:
                    if last - start > OBSERVER_BLIND_LIMIT_S and \
                            not [x for x in per.get(src, []) if start <= x <= last]:
                        reasons.append('%s observer silent for %.0fs while the world '
                                       'said it was active' % (src, last - start))
                    start = None
    return {'window': [t0, t1], 'span_s': span, 'sources': health, 'heartbeat_gap': hb,
            'runs': runs, 'blind': blinds, 'valid': not reasons, 'reasons': reasons}


# ---- report ------------------------------------------------------------------
def fmt_t(t):
    try:
        return datetime.fromtimestamp(t).strftime('%H:%M:%S.%f')[:-3]
    except (ValueError, OSError, OverflowError):
        return str(t)


def arg_str(it):
    a, bits = it['args'], []
    ps = pid_set(it)
    if ps is not None:
        bits.append('pids=%d[%s]' % (len(ps), ','.join(sorted(ps)[:4])))
    for k in ('resolver', 'mode', 'flag', 'appid', 'window', 'scope', 'app'):
        if k in a:
            bits.append('%s=%s' % (k, a[k]))
    if it.get('reason'):
        bits.append('why=%s' % it['reason'])
    return ' '.join(bits)[:64]


def snapshot_near(snaps, t):
    """The world couchd saw at or before a divergence (real snapshot schema)."""
    prev = [s for s in snaps if float(s.get('t', 0)) <= t]
    if not prev:
        return ''
    s = max(prev, key=lambda x: float(x.get('t', 0)))
    f, reg = s.get('flags') or {}, s.get('regions') or {}
    bits = ['session=%s' % f.get('session'), 'suspended=%s' % f.get('suspended'),
            'focused=%s' % s.get('focused'), 'joystick=%s' % s.get('joystick'),
            'ui_mode=%s' % s.get('ui_mode'), 'pids=%d' % len(s.get('pids') or {}),
            '/'.join('%s:%s' % (k, v) for k, v in sorted(reg.items()))]
    return 'world @%s (%s): %s' % (fmt_t(float(s.get('t', t))), s.get('why', '?'),
                                   ' '.join(bits))


def mkrow(section, li, ci, offset, flags, notes, couchd_i, legacy_i):
    """One report row, with the T column pre-filled from the whitelist if it hits."""
    lab, note = triage(section, li, ci, flags, couchd_i, legacy_i)
    ref = li or ci
    return {'section': section, 'label': lab, 't': ref['t'], 'verb': ref['verb'],
            'subject': ref['subject'], 'flags': sorted(set(flags)), 'offset': offset,
            'args': ' || '.join(arg_str(x) for x in (li, ci) if x),
            'note': '; '.join([n for n in notes if n] + ([note] if note else [])),
            'origin': ref['origin']}


def build(legacy_path, shadow_path, snapshots_path=None, since=None, context=True):
    """Everything the report needs, as plain data (also the --json payload)."""
    notes = []
    if since:
        notes.append('--since %s: everything before it ignored' % fmt_t(since))
    lrecs, l_ok = load_jsonl(legacy_path, notes, 'legacy')
    crecs, c_ok = load_jsonl(shadow_path, notes, 'couchd')
    snaps = [r for r in crecs if r.get('kind') == 'snapshot' and 't' in r]
    if snapshots_path and os.path.exists(snapshots_path):
        snaps += [r for r in load_jsonl(snapshots_path, [], 'snapshots')[0]
                  if r.get('kind') in (None, 'snapshot') and 't' in r]

    legacy_all = [i for i in (as_intent(r, 'legacy') for r in lrecs) if i]
    couchd_all = [i for i in (as_intent(r, 'couchd') for r in crecs) if i]
    obs = [r for r in crecs if r.get('kind') == 'obs']
    trans = [r for r in crecs if r.get('kind') == 'transition']
    blinds = [r for r in crecs if r.get('kind') == 'observer_blind']
    agree = [r for r in crecs if r.get('kind') == 'agreement']
    bad_inv = [r for r in crecs if r.get('kind') == 'invariant' and not r.get('ok')]
    # The run windows come from couchd's OWN records only. Including the legacy
    # stream here once stretched run 1 back three hours, because /tmp/legacy-
    # intents.jsonl is cumulative across days while the shadow log rotates nightly.
    ats = [float(r['t']) for r in lrecs + crecs + snaps
           if isinstance(r.get('t'), (int, float))]
    span = (min(ats), max(ats)) if ats else (0.0, 0.0)
    runs = daemon_runs(crecs, span)
    starts = [float(r['t']) for r in crecs if r.get('kind') == 'daemon'
              and r.get('event') == 'start' and isinstance(r.get('t'), (int, float))]
    if since:
        runs = [(max(a, since), b) for a, b in runs if b > since] or [(since, span[1])]
    model_t = max(starts) if starts else runs[0][0]     # newest model = newest start
    current = [r for r in runs if r[0] >= model_t - 0.001]   # started with this model
    ctx = [i for i in legacy_all + couchd_all if i['verb'] in CONTEXT_VERBS]
    legacy_i = [i for i in legacy_all if i['verb'] not in CONTEXT_VERBS]
    couchd_i = [i for i in couchd_all if i['verb'] not in CONTEXT_VERBS
                and in_runs(i['t'], runs, RUN_EDGE_SLACK_S)]
    outside = [i for i in legacy_i if not in_runs(i['t'], runs, RUN_EDGE_SLACK_S)]
    if outside:
        legacy_i = [i for i in legacy_i if i not in outside]
        notes.append('%d legacy intent(s) outside couchd\'s run windows excluded '
                     '(couchd was not running; %s)' % (len(outside), ', '.join(
                         sorted({'%s(%s)' % (i['verb'], i['subject'])
                                 for i in outside}))[:120]))
    if ctx:
        notes.append('%d trigger-channel record(s) (%s) held as context, not diffed'
                     % (len(ctx), ','.join(sorted(CONTEXT_VERBS))))
    if bad_inv:
        notes.append('%d failing invariant record(s): %s' % (len(bad_inv), '; '.join(
            sorted({'%s %s' % (r.get('name'), r.get('leaks') or '')
                    for r in bad_inv}))[:200]))
    for r in crecs:
        if r.get('kind') == 'daemon' and r.get('event') == 'stop':
            notes.append('daemon stop @%s: %s passes, %s intents'
                         % (fmt_t(float(r.get('t', 0))), r.get('passes'),
                            r.get('intents')))

    pairs, l_only, c_only = match(legacy_i, couchd_i)
    l_only, assoc = associate_repeats(pairs, l_only, 'legacy')
    c_only, c_assoc = associate_repeats(pairs, c_only, 'couchd')
    assoc += c_assoc
    launches = sorted(i['t'] for i in ctx if i['verb'] in ('launch', 'invoked'))
    l_only, l_seq = launch_sequence_split(l_only, launches, 'legacy')
    c_only, c_seq = launch_sequence_split(c_only, launches, 'couchd')
    for p in pairs:
        compare_pair(p)
    asserts = assertions(couchd_i, legacy_i, release_edges(obs, trans), pairs)
    for a in asserts:                       # an ordering violation gates even in-window
        if a['ok'] is False and a['intent'] is not None:
            for p in pairs:
                if p['couchd'] is a['intent'] or p['legacy'] is a['intent']:
                    p['flags'].append('ORDER')
                    p['notes'].append('%s: %s' % (a['name'], a['detail']))

    # An ordering violation gates wherever it lands, matched or not (R5).
    viol = {id(a['intent']): a for a in asserts if a['ok'] is False and a['intent']}
    rows = [mkrow('COUCHD-ONLY', None, it, None,
                  ['ORDER'] if id(it) in viol else [],
                  ['%s: %s' % (viol[id(it)]['name'], viol[id(it)]['detail'])]
                  if id(it) in viol else [], couchd_i, legacy_i)
            for it in c_only]
    rows += [mkrow('LEGACY-ONLY', it, None, None, [], [], couchd_i, legacy_i)
             for it in l_only]
    rows += [mkrow('BOTH-BUT-DIFFERENT', p['legacy'], p['couchd'], p['offset'],
                   p['flags'], p['notes'], couchd_i, legacy_i)
             for p in pairs if p['flags']]
    rows.sort(key=lambda r: (SECTIONS.index(r['section']), r['t']))
    lverbs = {i['verb'] for i in legacy_i}
    cverbs = {i['verb'] for i in couchd_i}
    for r in rows:
        r['context'] = snapshot_near(snaps, r['t']) if (snaps and context) else ''
        r['run'] = next((n for n, (a, b) in enumerate(runs, 1)
                         if a - RUN_EDGE_SLACK_S <= r['t'] <= b + RUN_EDGE_SLACK_S), 0)
        r['stale'] = not in_runs(r['t'], current, RUN_EDGE_SLACK_S)
        absent = (r['section'] == 'LEGACY-ONLY' and r['verb'] not in cverbs) or \
                 (r['section'] == 'COUCHD-ONLY' and r['verb'] not in lverbs)
        if absent:                      # vocabulary gap, not a decision divergence
            r['note'] = '; '.join(x for x in (r['note'], 'verb never appears in the '
                                  'other stream at all (structural)') if x)
    cooled = [{'t': it['t'], 'verb': it['verb'], 'subject': it['subject'], 'side': side,
               'args': arg_str(it), 'offset': it['t'] - p['legacy']['t'],
               'note': '%s repeat of the pair at %s (%s), window %.0fs' %
                       ('legacy' if side == 'legacy' else 'couchd fan-out',
                        fmt_t(p['legacy']['t']),
                        it['reason'] if side == 'couchd' else p['couchd']['reason'],
                        cooldown_s(p['couchd']['reason']))}
              for it, p, side in assoc]
    launch_rows = [{'t': it['t'], 'verb': it['verb'], 'subject': it['subject'],
                    'side': side, 'args': arg_str(it), 'offset': it['t'] - lt,
                    'note': 'launch-sequence artifact: %+.1fs from the launch at %s '
                            '(non-gating)' % (it['t'] - lt, fmt_t(lt))}
                   for it, lt, side in sorted(l_seq + c_seq, key=lambda x: x[0]['t'])]

    verbs = sorted({i['verb'] for i in legacy_i + couchd_i})
    counts = {v: {s: sum(1 for r in rows if r['section'] == s and r['verb'] == v)
                  for s in SECTIONS} for v in verbs}
    offsets = {}
    for v in verbs:
        o = [abs(p['offset']) for p in pairs if p['legacy']['verb'] == v]
        if o:
            offsets[v] = {'n': len(o), 'min': min(o), 'p50': pct(o, 50),
                          'p95': pct(o, 95), 'max': max(o)}
    run_rows = [{'n': n, 'start': a, 'end': b, 'stale': (a, b) not in current,
                 'intents': sum(1 for i in couchd_i if a <= i['t'] <= b),
                 'rows': sum(1 for r in rows if r['run'] == n)}
                for n, (a, b) in enumerate(runs, 1)]
    if len(runs) > 1:
        notes.append('couchd ran %d times (%s); gaps between runs are not blindness, '
                     'and runs before the newest daemon start (%s) carry an older '
                     'model - marked stale, excluded from gating'
                     % (len(runs), ', '.join('%s..%s' % (fmt_t(a), fmt_t(b))
                                             for a, b in runs), fmt_t(model_t)))
    health = observer_health(obs, blinds, snaps, current, notes)
    disagreements = [dict(r, label=agreement_label(r)[0], why=agreement_label(r)[1])
                     for r in agree if disagrees(r)
                     and in_runs(float(r.get('t', 0)), current, RUN_EDGE_SLACK_S)]
    reasons = list(health['reasons'])
    if not l_ok:
        reasons.append('legacy intent stream missing or empty - nothing to compare')
    if not c_ok:
        reasons.append('couchd shadow stream missing or empty - nothing to compare')
    # A violation carried by an intent that is only a fan-out repeat of a decision we
    # already judged is reported, not double-counted.
    on_rows = {round(r['t'], 6) for r in rows if 'ORDER' in r['flags']}
    absorbed = len([a for a in viol.values()
                    if round(a['intent']['t'], 6) not in on_rows])
    hard = [r for r in rows if ('SET-MISMATCH' in r['flags'] or 'ORDER' in r['flags'])
            and not r['stale']]
    gating = [r for r in hard if r['label'] != 'T5']   # pre-declared = not gating
    return {'inputs': {'legacy': legacy_path, 'couchd': shadow_path,
                       'snapshots': snapshots_path if snaps else None},
            'notes': notes, 'rows': rows, 'cooldown_associated': cooled,
            'launch_sequence': launch_rows, 'runs': run_rows, 'model_t': model_t,
            'absorbed_violations': absorbed,
            'matched_total': len(pairs),
            'matched_clean': len(pairs) - len([p for p in pairs if p['flags']]),
            'counts': counts, 'offsets': offsets, 'context_records': len(ctx),
            'edge_latency': edge_latency(crecs, runs),
            'assertions': [{k: v for k, v in a.items() if k != 'intent'}
                           for a in asserts],
            'agreement': {'total': len(agree), 'disagreements': disagreements},
            'observer_health': health,
            'gating_count': len(gating) + len([d for d in disagreements
                                               if d['label'] != 'T5']),
            'whitelisted_hard': len(hard) - len(gating),
            'validity': {'verdict': 'INVALID' if reasons else 'VALID',
                         'reasons': reasons}}


def render(rep):
    out = ['couchd shadow-diff  legacy=%s' % rep['inputs']['legacy'],
           '                    couchd=%s' % rep['inputs']['couchd']]
    h = rep['observer_health']
    if h['span_s']:
        out.append('                    window=%s..%s (%.0f min)' %
                   (fmt_t(h['window'][0]), fmt_t(h['window'][1]), h['span_s'] / 60.0))
    out += ['  ! %s' % n for n in rep['notes']]
    for sec in SECTIONS:
        rows = [r for r in rep['rows'] if r['section'] == sec]
        out += ['', '== %s == (%d)' % (sec, len(rows))]
        if not rows:
            out.append('  (none)')
        for r in rows:
            off = ' off=%+.3fs' % r['offset'] if r['offset'] is not None else ''
            flg = ' [%s]' % ','.join(r['flags']) if r['flags'] else ''
            out.append('  %-3s %s  %s(%s)%s  %s%s%s' %
                       (r['label'] or '..', fmt_t(r['t']), r['verb'], r['subject'],
                        flg, r['args'], off,
                        '  ~run%d stale-model' % r['run'] if r['stale'] else ''))
            out += ['        %s' % x for x in (r['note'], r['context']) if x]
    ag = rep['agreement']
    out += ['', '== AGREEMENT (freeze-set / channel cross-checks, gating per R4) == '
                '(%d of %d disagree)' % (len(ag['disagreements']), ag['total'])]
    out += ['  %-3s %s  %s\n        %s' %
            (r.get('label') or '..', fmt_t(float(r.get('t', 0))),
             r.get('metric') or 'freeze_set', r.get('why', ''))
            for r in ag['disagreements']] or ['  (none)']
    if rep['launch_sequence']:
        out += ['', '== LAUNCH-SEQUENCE == (%d unmatched rows inside %ds of a launch '
                    '- artifacts of the same finger, non-gating)'
                % (len(rep['launch_sequence']), LAUNCH_WINDOW_S)]
        for r in rep['launch_sequence'][:INFO_ROWS_SHOWN]:
            out.append('  ..  %s  %-6s %s(%s)  %s\n        %s' %
                       (fmt_t(r['t']), r['side'], r['verb'], r['subject'], r['args'],
                        r['note']))
        if len(rep['launch_sequence']) > INFO_ROWS_SHOWN:
            out.append('  ... %d more (--json for all)'
                       % (len(rep['launch_sequence']) - INFO_ROWS_SHOWN))
    if rep['cooldown_associated']:
        out += ['', '== COOLDOWN-ASSOCIATED == (%d repeats/fan-out of an already '
                    'matched decision - not divergences)'
                % len(rep['cooldown_associated'])]
        for r in rep['cooldown_associated'][:INFO_ROWS_SHOWN]:
            out.append('  ..  %s  %-6s %s(%s)  %s off=%+.3fs\n        %s' %
                       (fmt_t(r['t']), r['side'], r['verb'], r['subject'], r['args'],
                        r['offset'], r['note']))
        if len(rep['cooldown_associated']) > INFO_ROWS_SHOWN:
            out.append('  ... %d more (--json for all)'
                       % (len(rep['cooldown_associated']) - INFO_ROWS_SHOWN))
    if len(rep['runs']) > 1:
        out += ['', '== RUNS == (rows in stale-model runs are informational only)']
        for r in rep['runs']:
            out.append('  run%d  %s..%s (%3.0f min)  intents=%-3d rows=%-3d %s'
                       % (r['n'], fmt_t(r['start']), fmt_t(r['end']),
                          (r['end'] - r['start']) / 60.0, r['intents'], r['rows'],
                          'STALE-MODEL (pre %s)' % fmt_t(rep['model_t'])
                          if r['stale'] else 'current model'))
    out += ['', '== SUMMARY ==',
            '  matched %d (%d clean, %d differing); gating (SET-MISMATCH/ORDER/'
            'agreement, per R4/R5): %d, +%d pre-declared T5 not gating'
            % (rep['matched_total'], rep['matched_clean'],
               rep['matched_total'] - rep['matched_clean'], rep['gating_count'],
               rep['whitelisted_hard']),
            '  %-18s %8s %8s %8s' % ('verb', 'COUCHD-O', 'LEGACY-O', 'BOTH-DIF')]
    for v, c in sorted(rep['counts'].items()):
        if any(c.values()):
            out.append('  %-18s %8d %8d %8d' % (v, c['COUCHD-ONLY'], c['LEGACY-ONLY'],
                                                c['BOTH-BUT-DIFFERENT']))
    out.append('  matched-offset ms (min/p50/p95/max), bound %dms for %s:'
               % (PERCEPTUAL_BOUND_S * 1000, '/'.join(PERCEPTUAL_VERBS)))
    for v, o in sorted(rep['offsets'].items()):
        out.append('    %-16s n=%-3d %6.0f %6.0f %6.0f %6.0f' %
                   (v, o['n'], o['min'] * 1000, o['p50'] * 1000, o['p95'] * 1000,
                    o['max'] * 1000))
    el = rep.get('edge_latency')
    if el:
        out.append('  couchd edge-to-decision ms (its own measure, not gating): '
                   'n=%d p50=%.0f p95=%.0f max=%.0f%s%s'
                   % (el['n'], el['p50'] * 1000, el['p95'] * 1000,
                      el['max'] * 1000,
                      '' if el['kernel_p95'] is None
                      else ' kernel-p95=%.0f' % (el['kernel_p95'] * 1000),
                      '' if el['within_bound']
                      else '  <-- ABOVE the %dms bound'
                           % (PERCEPTUAL_BOUND_S * 1000)))
        if el['coalesced']:
            out.append('    (%d neighbouring edge(s) coalesced into a decided '
                       'pass by the debounce)' % el['coalesced'])
    out.append('  happens-before assertions (R5, evaluated outside the windows):')
    by_name = {}
    for a in rep['assertions']:
        b = by_name.setdefault(a['name'], {'pass': 0, 'fail': 0, 'na': 0, 'ex': []})
        b['pass' if a['ok'] else ('fail' if a['ok'] is False else 'na')] += 1
        if a['ok'] is False and len(b['ex']) < 3:
            b['ex'].append(a['detail'])
    for name, b in sorted(by_name.items()) or [('(no assertable intents)', None)]:
        if b is None:
            out.append('    n/a  (no assertable intents)')
            continue
        out.append('    %s %s - %d pass, %d fail, %d unassociated'
                   % ('FAIL' if b['fail'] else 'PASS', name, b['pass'], b['fail'],
                      b['na']))
        out += ['           e.g. %s' % e for e in b['ex']]
    if rep['absorbed_violations']:
        out.append('    (%d failure(s) sit on fan-out repeats of a decision already '
                   'judged above - reported, not double-counted)'
                   % rep['absorbed_violations'])
    out.append('  observer health (obs are change-driven; heartbeat max gap %.0fs):'
               % h['heartbeat_gap'])
    for s in h['sources']:
        out.append('    %-9s %-9s %-8s n=%-4d last-gap %5.0fs' %
                   (s['source'], 'required' if s['required'] else 'optional',
                    'present' if s['present'] else 'SILENT', s['samples'],
                    s['last_gap']))
    out.append('  EVENING VALIDITY: %s' % rep['validity']['verdict'])
    out += ['    - %s' % r for r in rep['validity']['reasons']]
    return '\n'.join(out)


def parse_since(text, day):
    """--since as HH:MM[:SS] against the report's date, or a raw epoch."""
    if not text:
        return None
    try:
        return float(text) if float(text) > 100000 else None
    except ValueError:
        pass
    for fmt in ('%Y%m%d %H:%M:%S', '%Y%m%d %H:%M'):
        try:
            return datetime.strptime('%s %s' % (day, text), fmt).timestamp()
        except ValueError:
            continue
    raise SystemExit('--since: expected HH:MM, HH:MM:SS or an epoch, got %r' % text)


def main(argv=None):
    ap = argparse.ArgumentParser(
        description=__doc__.split('\n')[0],
        epilog=__doc__[__doc__.index('Examples:'):],
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('legacy', nargs='?', help='legacy intent JSONL '
                    '(default /tmp/legacy-intents.jsonl, or a copy off /tmp)')
    ap.add_argument('--legacy', dest='legacy_opt', help='same, as an option')
    ap.add_argument('--shadow', help='couchd shadow JSONL (overrides --date)')
    ap.add_argument('--date', help='evening as YYYYMMDD (default today)')
    ap.add_argument('--shadow-dir', default=os.path.expanduser('~/couch/shadow'))
    ap.add_argument('--snapshots', help='world-snapshot JSONL for divergence context')
    ap.add_argument('--no-context', action='store_true')
    ap.add_argument('--since', help='ignore everything before HH:MM[:SS] (of --date) '
                    'or an epoch; runs before the newest daemon start are marked '
                    'stale automatically, so this is only for narrowing further')
    ap.add_argument('--json', action='store_true', help='machine-readable report')
    a = ap.parse_args(argv)
    day = a.date or datetime.now().strftime('%Y%m%d')
    legacy = a.legacy_opt or a.legacy or '/tmp/legacy-intents.jsonl'
    shadow = a.shadow or os.path.join(a.shadow_dir, 'couchd-%s.jsonl' % day)
    snaps = a.snapshots or os.path.join(a.shadow_dir, 'snapshots-%s.jsonl' % day)
    rep = build(legacy, shadow, snaps, parse_since(a.since, day), not a.no_context)
    print(json.dumps(rep, indent=1, default=str) if a.json else render(rep))
    return 0 if rep['validity']['verdict'] == 'VALID' and not rep['gating_count'] else 1


if __name__ == '__main__':
    sys.exit(main())
