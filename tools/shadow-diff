def bp_hold_context(t, couchd_i, legacy_i):
    """True when a big-picture hold with no game pids sits just before t (R7(a))."""
    for it in couchd_i + legacy_i:
        if not (t - BP_HOLD_S <= it['t'] <= t):
            continue
        a = it['args']
        bp = canon(it['subject']) == 'bigpicture' or \
            canon(a.get('foreground')) == 'bigpicture' or \
            canon(a.get('mode')) == 'bigpicture'
        if bp and it['verb'] in ('freeze', 'hold', 'set_flag', 'show', 'invoked') \
                and not (pid_set(it) or ()):
            return True
    return False


def triage(section, li, ci, flags, couchd_i, legacy_i):
