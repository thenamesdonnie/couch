#!/usr/bin/env bash
# The console's session manager. Launches games over Kodi and manages the
# handover: Kodi's joystick input goes off so the pad speaks only to the game,
# and when the game ends the pad comes back to Kodi and Kodi takes the screen.
#
# Games can also be SUSPENDED: pad-home-watcher freezes the processes
# (SIGSTOP) when the PS button is held, and this script thaws them when the
# same tile is picked again. A suspended game costs nothing to keep around.
#
# Usage: game-launch steam <appid>   launch, or resume if that game is paused
#        game-launch bigpicture      Steam's couch UI (refocuses if already up)
#        game-launch resume          thaw whatever is paused
#        game-launch quit            politely close any game and Big Picture,
#                                    forcing only if ignored (the power menu
#                                    uses this as its save-and-quit)
#
# Called detached from the Kodi helper plugin, so it owns the whole session:
# nothing here may assume a terminal, and a launch must always restore Kodi's
# input on the way out, whatever happened in the middle.
set -u

# Callers vary: the Kodi plugin has the session's display, an SSH shell or the
# power menu's detached Popen may not. All the window work needs X, so fill in
# the TV's display when nobody else did.
export DISPLAY="${DISPLAY:-:0}"
export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"

MODE="${1:-}"
APPID="${2:-}"
JSON=http://localhost:8090/jsonrpc
AUTH=kodi:$KODI_PASSWORD
# Test seams, tools/curtain's pattern: unset in normal operation, the tests
# point them under tmp_path (live /tmp is off limits to tests, hard rule).
LOG="${GAME_LAUNCH_LOG:-/tmp/game-launch.log}"
SESSION="${GAME_SESSION_FILE:-/tmp/game-session}"     # "<launcher pid> <mode> <appid>" while a session runs
SUSPENDED="${GAME_SUSPENDED_FILE:-/tmp/game-suspended}" # "<appid>" or "bigpicture" while a game is frozen

say() { echo "$(date +%H:%M:%S.%3N) $*" >> "$LOG"; }

# One JSON line per decision beside the human one, so the couchd shadow-diff
# reads our intent instead of guessing it back from effects. Args are
# key=value pairs; "key:=..." passes an already-formed JSON value (arrays,
# numbers). Purely additive: logging here can never fail a caller.
INTENTS="${LEGACY_INTENTS_FILE:-/tmp/legacy-intents.jsonl}"  # same seam name the focus python honours
_jstr() {
  local s=${1-}
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/ }; s=${s//$'\t'/ }
  printf '"%s"' "$s"
}
_jnums() {  # whitespace-separated pids -> JSON array of numbers
  local p out=''
  for p in ${1-}; do
    case "$p" in *[!0-9]*) continue ;; esac
    out="$out${out:+,}$p"
  done
  printf '[%s]' "$out"
}
_jargv() {
  local a out=''
  for a in "$@"; do out="$out${out:+,}$(_jstr "$a")"; done
  printf '[%s]' "$out"
}
intent() {
  local verb=${1-} subject=${2-} kv k args='' subj=null
  if [ $# -gt 2 ]; then shift 2; else shift $#; fi
  for kv in "$@"; do
    k=${kv%%=*}
    if [ "${k%:}" != "$k" ]; then
      args="$args${args:+,}$(_jstr "${k%:}"):${kv#*=}"
    else
      args="$args${args:+,}$(_jstr "$k"):$(_jstr "${kv#*=}")"
    fi
  done
  [ -n "$subject" ] && subj=$(_jstr "$subject")
  printf '{"t": %s, "src": "game-launch", "verb": %s, "subject": %s, "args": {%s}}\n' \
    "$(date +%s.%3N)" "$(_jstr "$verb")" "$subj" "$args" >> "$INTENTS" 2>/dev/null || true
}

# ONE AT A TIME. suspend, resume and quit are multi-step sequences over the same
# state (the game's own processes, both flags, the pad, the screen), and they
# now have two callers each: the phone's screen switcher and couchd's gestures.
# Interleaved, a suspend's SIGSTOP can land after a resume's SIGCONT and leave
# the console frozen with the pad pointed at Kodi. Those three verbs take this
# lock for the whole of their body; the lock lives on fd 9 and is dropped when
# the shell exits, which for all three is immediately after.
#
# It is NEVER taken by the launch verbs: a launcher lives as long as its game,
# and a lock held that long would block every suspend of the session.
#
# On timeout we say so LOUDLY and go ahead anyway: whatever went wrong, leaving
# a game frozen with the pad in the wrong place is worse than a race.
LOCK=/tmp/game-launch.lock
LOCK_WAIT=10
session_lock() {
  command -v flock >/dev/null 2>&1 || return 0
  # Probed with a plain redirect first: `exec` with a FAILING redirect kills a
  # non-interactive shell outright, and that must never happen mid-verb.
  : >>"$LOCK" 2>/dev/null || { say "lock: cannot open $LOCK, proceeding unlocked"; return 0; }
  exec 9>>"$LOCK"
  flock -w "$LOCK_WAIT" 9 && return 0
  say "!!! LOCK TIMEOUT: $LOCK held by another game-launch for ${LOCK_WAIT}s; proceeding anyway"
  intent lock_timeout "$MODE" "file=$LOCK" "waited=$LOCK_WAIT" "mode=$MODE"
  return 0
}

# WHO OWNS WHAT, right now. ~/couch/couchd/owns.conf is the ONE file both
# stacks read - couchd every tick, this script at every decision - and while it
# is empty (the state it ships in) nothing below changes: this script does
# everything it has always done.
#
# The grammar is deliberately tiny so this parser and couchd's owns.py cannot
# drift: the LAST `COUCHD_OWNS=` line wins; the value is cut at '#', stripped of
# CR, trimmed, unwrapped of ONE surrounding quote pair, trimmed again, then
# split on commas or whitespace. A missing or unreadable file answers "owns
# nothing", which leaves this script acting. owns.py's unquote() is these same
# five steps, and a parity test runs both over a corpus of hostile files.
OWNS_CONF="${COUCHD_OWNS_FILE:-/home/ds2000/couch/couchd/owns.conf}"
COUCHD_STATUS="${COUCHD_STATUS_FILE:-/home/ds2000/couch/shadow/status.json}"
COUCHD_HEARTBEAT_MAX_AGE=30     # seconds; couchd rewrites status.json every ~3s

# Ownership is a LEASE, not a note. `systemctl --user stop couchd` is the
# charter's one-command rollback and nobody reaching for it at 11pm is going to
# edit a config file first, so a stale or absent heartbeat means this script
# acts whatever the file says. owns.py's couchd_alive() is the same rule.
couchd_heartbeat_ok() {
  local m now
  m="$(stat -c %Y "$COUCHD_STATUS" 2>/dev/null)" || return 1
  [ -n "$m" ] || return 1
  now="$(date +%s)"
  [ "$((now - m))" -lt "$COUCHD_HEARTBEAT_MAX_AGE" ]
}

couchd_owns() {
  local want="$1" raw r
  raw="$(sed -n 's/^[[:space:]]*COUCHD_OWNS[[:space:]]*=[[:space:]]*//p' \
        "$OWNS_CONF" 2>/dev/null | tail -n1)"
  raw="${raw%%#*}"                    # 1. trailing comment
  raw="${raw//$'\r'/}"                # 2. a CRLF file must not own differently
  read -r raw <<< "$raw" || true      # 3. trim (read eats leading/trailing IFS)
  # 4. exactly ONE surrounding quote pair - never every quote in the string, or
  #    COUCHD_OWNS="gestures" "transitions" would own two things here and none
  #    in owns.py, which is a responsibility with no owner after a flip.
  case "$raw" in
    '"'*'"') raw="${raw#\"}"; raw="${raw%\"}" ;;
    "'"*"'") raw="${raw#\'}"; raw="${raw%\'}" ;;
  esac
  read -r raw <<< "$raw" || true      # 5. trim again
  raw="${raw//,/ }"
  for r in $raw; do [ "$r" = "$want" ] && return 0; done
  return 1
}

# The yield itself, in one place: record the would-do (legacy becomes the
# SHADOW for a responsibility couchd has taken, which is what the morning
# differ compares against) and tell the caller not to act.
#   yield_to_couchd <responsibility> <verb> <subject> [k=v ...] || <do it>
yield_to_couchd() {
  local resp="$1" verb="$2" subj="$3"
  shift 3
  couchd_owns "$resp" || return 1
  couchd_heartbeat_ok || {
    say "$verb $subj: couchd owns $resp but its heartbeat is stale - acting anyway"
    return 1
  }
  intent "$verb" "$subj" "$@" yielded=true owner=couchd
  say "$verb $subj: yielded to couchd ($resp)"
  return 0
}

# Big Picture is the console's UI mode for GAMING, and only for gaming.
#
# Steam is started -silent by ~/.config/autostart/steam.desktop, which lands it
# in DESKTOP mode (uimode 7). That autostart is deliberately left alone: Kodi
# owns the screen at boot and that rule outranks this one. The cost of desktop
# mode only appears once a game is running - Steam's controller routing follows
# its UI mode, and in desktop mode a guide TAP is swallowed into the desktop
# keyboard/mouse overlay, a window steam-input-guard's invariant 1 was written
# against ClientUI and cannot recognise. In Big Picture (uimode 4) the routing
# is ClientUI/769, which the guard already closes properly.
#
# So the mode is switched at LAUNCH time, per game, never at boot. Detection
# first: if Steam is already in Big Picture this does nothing at all, which is
# what stops it flapping the UI on every tile press.
#
# It is also NEVER put back on quit. Whatever mode Steam ends up in is left
# alone: Kodi is raised over it regardless, nothing on the console reads the
# mode except this function, and a forced switch during teardown is one more
# thing to race with a game that is still saving.
STEAM_UIMODE=/home/ds2000/.local/bin/steam-uimode
UIMODE_BIG_PICTURE=4          # Steam's own numbering; see steam-uimode.MODES
BP_CONFIRM_S=6
ensure_big_picture() {
  [ -x "$STEAM_UIMODE" ] || return 0
  local now t=0
  now="$(timeout 3 "$STEAM_UIMODE" 2>/dev/null)"
  if [ "$now" = "$UIMODE_BIG_PICTURE" ]; then
    say "steam already in big picture (uimode $now)"
    return 0
  fi
  say "steam in uimode ${now:-unknown}; opening big picture before the game"
  intent launch bigpicture reason=ensure-bp-before-game \
    via=steam-open-bigpicture "was=${now:-unknown}" "mode=$MODE" "appid=$APPID"
  steam "steam://open/bigpicture" >/dev/null 2>&1 &
  # 0.25s confirm grain (steam-uimode costs ~22ms a probe), same 6s total:
  # the 1s cadence charged every desktop-mode launch ~0.4s of pure
  # discretization (measured "confirmed after 1s" was the poll, not Steam).
  while [ $t -lt $((BP_CONFIRM_S * 4)) ]; do
    sleep 0.25; t=$((t+1))
    now="$(timeout 3 "$STEAM_UIMODE" 2>/dev/null)"
    if [ "$now" = "$UIMODE_BIG_PICTURE" ]; then
      say "big picture confirmed after $((t * 250))ms"
      return 0
    fi
  done
  # A launch is NEVER blocked on this. Worst case is exactly today's behaviour,
  # with FIX 7's desktop-overlay arm still there as the safety net.
  say "big picture never confirmed (${BP_CONFIRM_S}s, uimode ${now:-unknown}); launching anyway"
  intent launch bigpicture reason=ensure-bp-timeout "waited=$BP_CONFIRM_S" \
    "got=${now:-unknown}" "mode=$MODE"
  return 0
}

# A game started from INSIDE Big Picture is invisible to our own state: this
# script was invoked as `game-launch bigpicture`, so the session line it wrote
# has an EMPTY appid field, and every consumer that keys off that field then
# works on the string "bigpicture" instead of a number. Live, 5 Aug 2026:
#
#   02:28:57  === launch bigpicture       session "<pid> bigpicture "
#   02:30:34  === launch steam 367520     the game's own Kodi tile CLOSED and
#                                         RELAUNCHED it - "bigpicture" is not
#                                         "367520", so the tile read a running
#                                         game as "a different game was picked"
#
# The operator lost his progress to that. The same empty field is what lets
# /tmp/game-suspended hold the literal "bigpicture", which then keys pause-snap
# and the tile art to a name no library entry has: one missing appid, two faces.
#
# So the moment a game appears under a Big Picture session, ask Steam what it
# actually is (game-appid: its gameprocess ledger, falling back to the reaper's
# AppId= argv) and rewrite the session line in place. Failure changes nothing.
GAME_APPID=/home/ds2000/.local/bin/game-appid
ADOPTED=0
adopt_appid() {
  [ "$ADOPTED" = 1 ] && return 0
  [ -x "$GAME_APPID" ] || return 0
  game_running || return 0
  local real
  real="$(timeout 5 "$GAME_APPID" 2>/dev/null)" || return 0
  case "$real" in ''|*[!0-9]*) return 0 ;; esac
  # The launcher pid FIELD is kept, and must be: the EXIT trap only clears the
  # session flag while `cut -d" " -f1` still equals this shell's $$, so a line
  # rewritten without it would orphan the flag for the rest of the session.
  echo "$$ steam $real" > "$SESSION"
  APPID="$real"
  ADOPTED=1
  say "adopted appid $real from big picture"
  intent set_flag session "value=$$ steam $real" "launcher=$$" \
    reason=bigpicture-appid-adoption "was=$MODE"
}

# The appid (or mode) of the session currently on file, for intent subjects.
session_appid() {
  local a
  a="$(cut -d' ' -f3 "$SESSION" 2>/dev/null)"
  [ -n "$a" ] || a="$(cut -d' ' -f2 "$SESSION" 2>/dev/null)"
  printf '%s' "$a"
}

jrpc() {
  curl -s -m 5 -u "$AUTH" -H 'content-type: application/json' -d "$1" "$JSON" >/dev/null 2>&1
}

pad_to_game() {
  jrpc '{"jsonrpc":"2.0","id":1,"method":"Settings.SetSettingValue","params":{"setting":"input.enablejoystick","value":false}}'
  say "pad -> game"
  intent route_pad game via=kodi-jsonrpc "mode=$MODE"
}

pad_to_kodi() {
  jrpc '{"jsonrpc":"2.0","id":1,"method":"Settings.SetSettingValue","params":{"setting":"input.enablejoystick","value":true}}'
  say "pad -> kodi"
  intent route_pad kodi via=kodi-jsonrpc "mode=$MODE"
}

# Put Kodi back on the screen. Raising the window and giving it input focus is
# enough on this XFCE session; Kodi is fullscreen so it covers whatever Steam
# left behind.
focus_kodi() {
  intent show kodi via=xlib-restack "mode=$MODE"
  python3 - <<'EOF' >>/tmp/game-launch.log 2>&1
from Xlib import display, X
d = display.Display()
root = d.screen().root
def find(w):
    try:
        for c in w.query_tree().children:
            if (c.get_wm_name() or '') == 'Kodi':
                return c
            r = find(c)
            if r: return r
    except Exception:
        pass
    return None
w = find(root)
if w:
    w.configure(stack_mode=X.Above)
    try:
        d.set_input_focus(w, X.RevertToParent, X.CurrentTime)
    except Exception:
        pass
    d.sync()
    print("kodi focused")
else:
    print("kodi window not found")
EOF
}

# The game's own processes run out of steamapps/common, which is what makes
# "is a game running" answerable at all — Steam itself never exits.
game_pids() { /home/ds2000/.local/bin/game-pids; }
game_running() { game_pids >/dev/null; }
cont_all() {
  local p pids
  pids="$(game_pids)"
  for p in $pids; do kill -CONT "$p" 2>/dev/null; done
  if [ -n "$pids" ]; then
    intent thaw "$(session_appid)" "pids:=$(_jnums "$pids")" \
      resolver=game-pids signal=SIGCONT "mode=$MODE"
  fi
}

# The paused game's last rendered frame, kept as its artwork while it is
# frozen (the phone's switcher row, the Kodi home row tile). Purely cosmetic:
# time-boxed, and a failure is a log line and nothing else - a suspend must
# never wait on, or be broken by, a screenshot. Safe to call after the STOP:
# xfwm4 compositing keeps the window's pixmap, so a covered, frozen window
# still captures its real last frame (see pause-snap).
PAUSE_SNAP=/home/ds2000/.local/bin/pause-snap
snap_paused() {
  [ -x "$PAUSE_SNAP" ] || return 0
  intent snapshot "$1" via=pause-snap "reason=${2:-suspend}" "mode=$MODE"
  PAUSE_SNAP_SRC=game-launch timeout 2 "$PAUSE_SNAP" "$1" "${2:-suspend}" \
    >/dev/null 2>&1 || say "pause-snap: no frame for $1 (harmless)"
}
# A freeze-frame outlives its pause by nothing. No argument clears the lot,
# which is what a quit (or a game swapped out from under a stale flag) wants.
clear_snaps() {
  [ -x "$PAUSE_SNAP" ] || return 0
  timeout 2 "$PAUSE_SNAP" --clear ${1:+"$1"} >/dev/null 2>&1 || true
}

# The transition CURTAIN (tools/curtain): the game's own freeze-frame held
# fullscreen over the suspend/resume window shuffle, faded once the right
# thing has the screen. Wired 6 Aug 2026, after the standalone test passed and
# both stacks + the guard learned to treat WM_CLASS couch-curtain as
# transparent (tools/curtain's header makes that whitelist a hard
# precondition). Same cosmetic contract as pause-snap: time-boxed, any failure
# is a log line and the shuffle simply runs bare, exactly as it did before
# today. Never for bigpicture (nothing worth hiding behind its own frame),
# never without the binary. The tool's double watchdog means a stuck curtain
# is impossible; the clears on the error paths below are belt and braces so
# nothing ever sits over a state this script knows is broken.
CURTAIN="${CURTAIN_BIN:-/home/ds2000/couch/tools/curtain}"
SNAP_DIR="${PAUSE_SNAP_DIR:-$HOME/couch/data/paused}"   # where pause-snap keeps frames
CURTAIN_UP=0             # WE raised one this run; error paths must drop it
CURTAIN_FRESH_SLACK=30   # resume: frame may predate the pause flag by this much

curtain_usable() {  # <subject> - is a curtain even on the table here?
  [ -x "$CURTAIN" ] || return 1
  case "${1:-}" in bigpicture) return 1 ;; esac
  [ "$(cut -d' ' -f2 "$SESSION" 2>/dev/null)" = "bigpicture" ] && return 1
  return 0
}

# The wide freeze-frame pause-snap keeps for an appid: <safe>__<stamp>.jpg
# (never the .tile crop). safe() mirrored from pause-snap: non [A-Za-z0-9._-]
# becomes _, truncated to 100.
_snap_frame() {
  local name f best=
  name="$(printf '%s' "${1:-game}" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-100)"
  [ -n "$name" ] || name=game
  for f in "$SNAP_DIR/${name}__"*.jpg; do
    case "$f" in *.tile.jpg) continue ;; esac
    [ -f "$f" ] || continue
    if [ -z "$best" ] || [ "$f" -nt "$best" ]; then best="$f"; fi
  done
  [ -n "$best" ] && printf '%s' "$best"
}

# A frozen game's frame cannot rot on its own (the processes are SIGSTOPped),
# so "fresh" means "belongs to THIS pause": no older than the suspended flag,
# give or take the snap landing just beside the flag write. A leftover from
# some earlier pause is a lie, and an honest quick shuffle beats a wrong
# frozen frame - the caller skips the curtain entirely when this says no.
frame_is_this_pause() {
  local fm sm
  fm="$(stat -c %Y "$1" 2>/dev/null)" || return 1
  sm="$(stat -c %Y "$SUSPENDED" 2>/dev/null)" || return 1
  [ -n "$fm" ] && [ -n "$sm" ] || return 1
  [ "$((fm + CURTAIN_FRESH_SLACK))" -ge "$sm" ]
}

curtain_show() {  # <subject> <frame> <reason> - synchronous (~0.25s when it works)
  local subject="${1:-game}" frame="$2" reason="${3:-transition}"
  # No status pre-probe: cmd_show (tools/curtain) already handles a live
  # daemon itself - it atomically swaps the running curtain onto the new
  # image (bounded 2s confirm), replaces a wedged one, and clears a stale
  # pid/fifo before spawning fresh. Probing first cost ~45ms on every
  # curtained transition and ~300ms (clear + respawn) in the stale case,
  # for identical outcomes.
  if timeout 3 "$CURTAIN" show "$frame" >/dev/null 2>&1; then
    CURTAIN_UP=1
    say "curtain up ($frame)"
    # Written AFTER the exit 0, not before - focus_game's lesson (6 Aug): an
    # intent for a show that never happened hides the failure from the differ.
    intent curtain_show "$subject" wm_class=couch-curtain via=tools-curtain \
      "image=$frame" "reason=$reason" "mode=$MODE"
    return 0
  fi
  say "curtain show failed (harmless); the shuffle runs bare"
  return 1
}

curtain_fade() {  # <subject> - dissolve to reveal whatever the shuffle put up
  [ "$CURTAIN_UP" = 1 ] || return 0
  CURTAIN_UP=0
  intent curtain_fade "${1:-transition}" wm_class=couch-curtain \
    via=tools-curtain "mode=$MODE"
  timeout 5 "$CURTAIN" fade >/dev/null 2>&1 || true
  say "curtain faded"
  return 0
}

curtain_clear() {  # <reason> - error paths: nothing may sit over a broken state
  [ -x "$CURTAIN" ] || return 0
  if [ "$CURTAIN_UP" != 1 ]; then
    timeout 3 "$CURTAIN" status >/dev/null 2>&1 || return 0
  fi
  CURTAIN_UP=0
  intent curtain_clear "${1:-error}" wm_class=couch-curtain via=tools-curtain \
    "reason=${1:-error}" "mode=$MODE"
  timeout 3 "$CURTAIN" clear >/dev/null 2>&1 || true
  say "curtain cleared (${1:-error})"
  return 0
}

# A SIGSTOPped game cannot answer the X server, so any pointer grab it held at
# the instant it froze stays held: its cursor sprite sits on top of Kodi and
# the phone's XTEST clicks are swallowed by the frozen client. X drops a grab
# when the grab window stops being viewable, so the suspend UNMAPS the game's
# window and the resume maps it back (_NET_ACTIVE_WINDOW, which xfwm4
# deiconifies on). Cosmetic in both directions: a failure is a log line, never
# a failed suspend or a refused resume.
XINPUT=/home/ds2000/couch/server/xinput.py
_game_window() {  # [--any-state] -> hex window id, or nothing
  local pids
  pids="$(game_pids | tr '\n' ' ')"
  [ -n "$pids" ] || return 1
  # shellcheck disable=SC2086  # pids are a deliberate word-split list
  timeout 5 python3 "$XINPUT" gamewin ${1:+"$1"} $pids 2>/dev/null
}
hide_frozen_game() {
  local wid
  wid="$(_game_window)" || return 0
  case "$wid" in 0x*) ;; *) say "iconify: no window for ${1:-game} (harmless)"; return 0 ;; esac
  timeout 5 python3 "$XINPUT" iconify "$wid" >>"$LOG" 2>&1 \
    || { say "iconify failed (harmless); pointer grab may persist"; return 0; }
  say "iconified frozen ${1:-game} ($wid)"
  intent iconify "${1:-game}" via=wm-change-state reason=release-pointer-grab \
    "window=$wid" "mode=$MODE"
}
show_frozen_game() {
  local wid
  wid="$(_game_window --any-state)" || return 0
  case "$wid" in 0x*) ;; *) return 0 ;; esac
  timeout 5 python3 "$XINPUT" activate "$wid" >>"$LOG" 2>&1 \
    || { say "activate failed (harmless), focus_game still to come"; return 0; }
  say "mapped frozen ${1:-game} back ($wid)"
  intent show "${1:-game}" via=activate reason=deiconify "window=$wid" "mode=$MODE"
}

# shadPS4 runs from an AppImage: the runtime process keeps the .AppImage name in
# its argv, and the real emulator binary runs out of the /tmp/.mount_Shadps* the
# AppImage mounts. Either match means the emulator is up.
emu_running() { pgrep -f 'Shadps4-sdl|mount_Shadps' >/dev/null; }

# Big Picture titles its window only in _NET_WM_NAME (the UTF-8 one); the
# legacy WM_NAME is empty, so this must read the modern property.
bp_running() {
  python3 - <<'EOF'
import sys
from Xlib import display
d = display.Display()
NET = d.intern_atom('_NET_WM_NAME')
def walk(w):
    try:
        for c in w.query_tree().children:
            try:
                p = c.get_full_property(NET, 0)
                nm = p.value.decode() if p else ''
            except Exception:
                nm = ''
            if 'Big Picture' in nm:
                return True
            if walk(c): return True
    except Exception:
        pass
    return False
sys.exit(0 if walk(d.screen().root) else 1)
EOF
}

# Put the game's own window on top. Steam's desktop window tends to raise
# itself during a launch and sit over the game; the game's window is found by
# its process id (_NET_WM_PID), which no amount of retitling can confuse.
# When asked for 'bp' it raises Big Picture instead.
focus_game() {
  local what="${1:-game}"
  game_pids | tr '\n' ' ' > /tmp/game-pids
  # Big Picture's window left MAPPED fullscreen behind the game is the
  # "Steam says 60fps, feels 20" root cause (6 Aug 2026): the compositor
  # juggles two stacked live fullscreen surfaces and frame pacing dies.
  # ensure_big_picture raises BP before every launch and never hides it, and
  # a steam-routed resume re-surfaces it, so once the game's own window is
  # the one being shown, BP goes to the taskbar with the same wm-change-state
  # message the steam-desktop squatter already gets. Never when Big Picture
  # IS the session (want=bp, mode/session bigpicture - it is the thing being
  # shown), and never while the game is suspended (nothing is being shown
  # over BP then, and BP may be all the room has).
  local hide_bp=0
  if [ "$what" = "game" ] && [ ! -f "$SUSPENDED" ] \
      && [ "$MODE" != "bigpicture" ] \
      && [ "$(cut -d' ' -f2 "$SESSION" 2>/dev/null)" != "bigpicture" ]; then
    hide_bp=1
  fi
