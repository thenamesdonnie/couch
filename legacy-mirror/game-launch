walk(root)
if target is None:
    target = fallback
for w in steam_desktop:
    ev = protocol.event.ClientMessage(window=w, client_type=CHANGE_STATE, data=(32, [3, 0, 0, 0, 0]))
    root.send_event(ev, event_mask=X.SubstructureRedirectMask | X.SubstructureNotifyMask)
