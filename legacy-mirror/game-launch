# The LAUNCH path's converging focus. A game's window can lag its processes
# by a lot - Hollow Knight maps ~20-25s after launch, and the single
# focus_game the launch flow used to fire at ~+14s found nothing (first live
# run after deploy, 6 Aug 2026): the restack silently failed, Big Picture
# stayed mapped fullscreen behind the game, and the frame-pacing lag came
# back. So the launch path retries until focus_game's python actually found
# and showed the window (its exit status says which - and the BP-hide rides
# the same successful attempt), bounded so a game whose window never maps
# cannot hold the launcher here forever, and stopping early if the game dies.
# ONLY the launch path: the resume path converges on its own finer grain
# (resume_focus_converge - the window there already exists), and the guard's
# `game-launch focus` repair already re-fires once a second on its own.
#
# Adaptive cadence: until that focus lands, Big Picture sits mapped
# fullscreen behind (or over) the game - the worst visual state the console
# has - so the first stretch retries at 0.5s (a retry costs ~100ms of helper
# spawns, affordable) to land the focus+BP-hide the beat the window maps.
# Past 10s the wait is a long Proton load and the cadence backs off to 2s;
# the 40s cap and the honest focus_timeout intent are unchanged.
# Bookkeeping is in DECISECONDS (integer shell arithmetic; 400 = 40s).
FOCUS_RETRY_EARLY_S=0.5
FOCUS_RETRY_EARLY_FOR_DS=100   # first 10s at the fine cadence
FOCUS_RETRY_LATE_S=2
FOCUS_WAIT_MAX_S=40
focus_game_when_mapped() {
  local waited_ds=0
  while :; do
    if focus_game; then
      [ "$waited_ds" -gt 0 ] && say "game window found after $((waited_ds / 10)).$((waited_ds % 10))s"
      return 0
    fi
    game_running || { say "focus retries stopped: game gone after $((waited_ds / 10))s"; return 1; }
    [ "$waited_ds" -ge $((FOCUS_WAIT_MAX_S * 10)) ] && break
    if [ "$waited_ds" -lt "$FOCUS_RETRY_EARLY_FOR_DS" ]; then
      sleep "$FOCUS_RETRY_EARLY_S"
      waited_ds=$((waited_ds + 5))
    else
      sleep "$FOCUS_RETRY_LATE_S"
      waited_ds=$((waited_ds + 20))
    fi
  done
  say "game window never mapped ($((waited_ds / 10))s); leaving the stack alone"
  intent focus_timeout "${APPID:-game}" "waited=$((waited_ds / 10))" "mode=$MODE" \
    reason=game-window-never-mapped
  # No launch path shows a curtain today, but one left up by an interrupted
  # flow must not sit over a window that never came: belt and braces.
  curtain_clear focus-timeout
  return 1
}

# Politely close any game and Big Picture, thawing frozen ones first so they
# can actually see the request (a stopped process can't save). Games that save
# on quit get their chance; only a game that ignores the ask gets killed.
close_games() {
  local why="${1:-quit}"
  # Flag first here too (resume_game explains the rule). This close thaws the
  # game and then gives it up to ~17 seconds to save, and the WHOLE of that
  # used to run with the suspended flag still set - the widest
  # refreeze-lost-suspend window on the console, and a repairer that fired
  # inside it would have SIGSTOPped a game mid-save. With the flag gone
  # first, the closing game reads as a normal running session, which no
  # repair touches.
  rm -f "$SUSPENDED"
  clear_snaps
  intent clear_flag suspended reason=games-closed "why=$why"
  cont_all
  sleep 1
  game_pids | tr '\n' ' ' > /tmp/game-pids
  intent quit all "pids:=$(_jnums "$(cat /tmp/game-pids 2>/dev/null)")" \
    resolver=game-pids scope=games+bigpicture+shadps4 via=WM_DELETE_WINDOW \
    "reason=$why"
  python3 - <<'EOF' >>/tmp/game-launch.log 2>&1
