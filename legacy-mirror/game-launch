# Resuming feels sluggish (~2s) and nobody has measured WHERE that goes: the
# thaw, the window map, the power-menu curl, the fixed sleep, or focus_game's
# retries. Pure instrumentation, one log line per phase at ms resolution, no
# behaviour change and no decision reads it. Delete once the answer is known.
RESUME_T0=0
RESUME_LAST=0
_ms() { date +%s%3N; }
phase() {
  local now; now=$(_ms)
  say "resume phase: $1 +$((now - RESUME_T0))ms (+$((now - RESUME_LAST))ms)"
  RESUME_LAST=$now
}

# The RESUME path's focus converge, replacing the flat `sleep 1` that was
# ~77% of a measured resume (docs/transition-latency-budget.md §2: the game's
# frame is back on screen at ~+0.5s; only the focus assert rode the sleep).
# Fine grain because the window is already MAPPED-or-mapping here
# (show_frozen_game just activated it) - this is not the launch path's
# tens-of-seconds Proton wait, so 100ms beats and a short cap: 15 tries
# x 0.1s + ~0.1s of helper spawns per try keeps the old guarantee (the one
# blind attempt at +1.0s) with margin, then the caller's bp/kodi fallbacks
# take over exactly as before.
RESUME_FOCUS_GRAIN_S=0.1
RESUME_FOCUS_TRIES=15
resume_focus_converge() {  # <want: game|emu>
  local want="${1:-game}" try=0
  while ! focus_game "$want"; do
    try=$((try + 1))
    [ "$try" -ge "$RESUME_FOCUS_TRIES" ] && {
      say "resume focus: no $want window after $try tries (~$((try * 200))ms)"
      return 1
    }
    sleep "$RESUME_FOCUS_GRAIN_S"
  done
  [ "$try" -gt 0 ] && say "resume focus converged after $try retries"
  return 0
}

resume_game() {
  RESUME_T0=$(_ms); RESUME_LAST=$RESUME_T0
  local was; was="$(cat "$SUSPENDED" 2>/dev/null)"
  # Curtain BEFORE the thaw and the window work, on this pause's OWN frame
  # only (frame_is_this_pause; a mismatch means skip the curtain entirely).
  # Must run before the rm/clear_snaps below: the freshness check reads the
  # flag's mtime, and the show is synchronous, so by the time clear_snaps
  # deletes the jpg the daemon has already read it into its pixmap.
  local frame=
  if curtain_usable "${was:-game}"; then
    if frame="$(_snap_frame "${was:-game}")" && frame_is_this_pause "$frame"; then
      curtain_show "${was:-game}" "$frame" resume
    else
      say "curtain: no fresh freeze-frame for ${was:-game}; honest shuffle instead"
    fi
  fi
  # FLAG FIRST, THAW SECOND (the reconcile-flip hard gate, 6 Aug 2026).
  # Every repairer on this console - the watcher's reconcile, the guard's
  # invariants, couchd's model - reads the pair (suspended flag, pid states)
  # and converges the world toward what the FLAG says. The old order here
  # (SIGCONT, then rm) showed them all a sub-second world of "flag set, pids
  # running", whose one repair is to RE-FREEZE the game: couchd's shadow
  # decided exactly that three times on the acceptance night (03:18, 03:33,
  # 03:42), and once couchd owns `reconcile` that would have been a SIGSTOP
  # mid-resume, every resume. Clearing the flag before the SIGCONTs swaps
  # that transient for "flag gone, pids still frozen", whose repair (a thaw)
  # CONVERGES with this resume instead of undoing it - and every repairer now
  # waits out sub-second disagreements anyway (watcher THAW_RECHECK_S, guard
  # THAW_CONFIRM_S, couchd FLAG_DRIFT_PERSIST_S). If this shell dies between
  # the rm and the SIGCONTs, the lost-thaw repair finishes the resume, which
  # is the direction the player asked to go; the old order's crash left a
  # running game whose flag said to freeze it again.
  rm -f "$SUSPENDED"
  intent clear_flag suspended reason=resume "was=$was"
  phase flag-cleared
  cont_all
  phase thawed
  clear_snaps "$was"
  # Map the game's window back before anything tries to raise it: the suspend
  # iconified it to drop its stuck pointer grab, and focus_game only ever looks
  # at MAPPED windows - it would miss an iconified game and fall through to Big
  # Picture, or to handing the pad back to Kodi. Done first so xfwm4 has the
  # whole of the power-menu check and the sleep below to finish the map.
  show_frozen_game "${was:-game}"
  phase window-mapped
  # If the resume tap came from inside the power menu (hold opens it, tap
  # resumes), dismiss it so it isn't sitting there stale on the next return.
  if curl -s -m 3 -u "$AUTH" -H 'content-type: application/json' \
      -d '{"jsonrpc":"2.0","id":1,"method":"GUI.GetProperties","params":{"properties":["currentwindow"]}}' \
      "$JSON" 2>/dev/null | grep -q '"id":10106'; then
    jrpc '{"jsonrpc":"2.0","id":1,"method":"Input.Back"}'
    say "dismissed stale power menu"
    intent dismiss power-menu via=kodi-input-back window=10106 reason=resume-tap
  fi
  phase menu-checked
  pad_to_game
  phase pad-routed
  # Focus the right window: the emulator by its class, a Steam game by pid.
  # If Steam's Big Picture menu has swallowed the game window (a PS tap
  # in-game opens it), fall back to focusing Big Picture itself; and if
  # nothing at all is focusable, the pad must go back to Kodi rather than
  # being left pointed at an invisible window.
  #
  # No fixed sleep here any more. A flat `sleep 1` used to sit above this so
  # xfwm4 could finish the deiconify (focus_game only sees MAPPED windows) -
  # measured at ~77% of the whole resume (budget doc: focus-asserted +1.79s
  # of which +1.0s was the sleep; the map itself lands in ~50-500ms). The
  # converge below keeps the sleep's guarantee - it keeps trying past the
  # point the old single blind attempt at +1.0s gave up - while landing on
  # the first attempt that finds the window, typically immediately.
  # The curtain (if one is up) drops only on a CONFIRMED focus - fade reveals
  # the thing the pad now speaks to. The one path where nothing is focusable
  # gets a clear, not a fade: nothing may sit over a state we know is broken.
  if [ "$(cut -d' ' -f2 "$SESSION" 2>/dev/null)" = "shadps4" ]; then
    if resume_focus_converge emu; then curtain_fade shadps4; else curtain_clear resume-emu-not-focused; fi
  elif resume_focus_converge game; then
    curtain_fade "${was:-game}"
  elif focus_game bp; then
    curtain_fade bigpicture
  else
    say "nothing to focus, pad stays with kodi"
    curtain_clear resume-nothing-to-focus
    pad_to_kodi
    focus_kodi
  fi
  # The resume tap also toggled Steam's Big Picture menu; if it's now open
  # invisibly it will eat the pad instead of the game. Guard closes it.
  phase focus-asserted
  setsid /home/ds2000/.local/bin/steam-input-guard game >/dev/null 2>&1 9>&- &
  say "resumed"
}

# The trigger channel: one line per invocation, whoever called us - a Kodi
# tile, the phone's screen switcher, the power menu, or an ssh shell.
intent invoked "$MODE" "argv:=$(_jargv "$@")" "appid=$APPID"

case "$MODE" in
  quit)
    say "=== quit (save and close)"
    session_lock
    # A curtain still up here is an interrupted transition's, and this quit is
    # about to change what is true underneath it: drop it before the teardown
    # (belt and braces - its own watchdog would take it inside seconds anyway).
    curtain_clear quit
    if game_running || bp_running || emu_running; then close_games power-menu-quit; else say "nothing to quit"; fi
    exit 0
    ;;
  resume)
    say "=== resume"
    session_lock
    touch /tmp/tv-wake-request
    intent request_tv_wake tv via=tv-wake-request-flag reason=resume
    resume_game
    exit 0
    ;;
  focus)
    # Re-assert the right window on top (used by steam-input-guard); touches
    # no session state.
    if game_running; then focus_game; else focus_game bp; fi
    exit 0
    ;;
  suspend)
    # The couch app's screen switcher picked Kodi mid-game: same deal as a
    # PS-button hold. Freeze the game, hand the pad to Kodi, guard the drift.
    say "=== suspend (screen switcher)"
    session_lock
    frozen=0
    stoplist="$(game_pids)"
    for p in $stoplist; do kill -STOP "$p" 2>/dev/null && frozen=1; done
    if [ "$frozen" = 1 ]; then
      appid="$(cut -d' ' -f3 "$SESSION" 2>/dev/null)"
      [ -n "$appid" ] || appid="$(cut -d' ' -f2 "$SESSION" 2>/dev/null)"
      echo "${appid:-game}" > "$SUSPENDED"
      say "froze game ($(cat "$SUSPENDED"))"
      intent freeze "${appid:-game}" "pids:=$(_jnums "$stoplist")" \
        resolver=game-pids signal=SIGSTOP reason=screen-switcher
      intent set_flag suspended "value=${appid:-game}" reason=screen-switcher
      # Before Kodi is raised over it. Not because it has to be - a covered
      # window still captures - but because the game is the only thing this
      # branch is sure about at this point.
      snap_paused "${appid:-game}" screen-switcher
      # Curtain up on that just-captured frame BEFORE the shuffle below (the
      # Kodi raise, the game iconify): the room keeps seeing the game, the
      # shuffle happens underneath, and the fade after it reveals Kodi.
      if curtain_usable "${appid:-game}"; then
        if frame="$(_snap_frame "${appid:-game}")"; then
          curtain_show "${appid:-game}" "$frame" suspend
        else
          say "curtain: no freeze-frame for ${appid:-game}; shuffle runs bare"
        fi
      fi
    fi
    pad_to_kodi
    focus_kodi
    # Kodi has the screen now, so the frozen window can go. After snap_paused
    # above, which reads the compositing pixmap that iconifying frees.
    [ "$frozen" = 1 ] && hide_frozen_game "${appid:-game}"
    # Kodi is focused and the frozen window is gone: dissolve to reveal it.
    curtain_fade kodi
    # 9>&- : the guard outlives us by seconds, and an inherited lock fd would
    # keep the session lock held for all of them. (Closing an unopened fd is a
    # no-op, so this is safe whether or not the lock was taken.)
    setsid /home/ds2000/.local/bin/steam-input-guard kodi >/dev/null 2>&1 9>&- &
    exit 0
    ;;
  steam)
    if [ -f "$SUSPENDED" ]; then
      if [ "$(cat "$SUSPENDED")" = "$APPID" ]; then
        # The tile-resume is a resume in all but name, and it exits right
        # after: same lock the `resume` verb takes, same reason.
        say "=== resume $APPID from its tile"
        session_lock
        intent launch "$APPID" mode=resume source=kodi-tile app=steam
        resume_game
        exit 0
      fi
      # A different game was picked: the paused one gets a proper goodbye
      # first, and its launcher a moment to notice and bow out.
      say "closing paused game before launching $APPID"
      close_games "different-game-picked:$APPID"
      # Same 10s deadline for the old launcher to bow out, 0.25s grain.
      for _ in $(seq 40); do [ -f "$SESSION" ] || break; sleep 0.25; done
    fi
    ;;
  bigpicture)
    if bp_running; then
      # Already open behind Kodi: thaw anything paused and go back to it.
      # A resume in all but name, so it takes the session lock like one - a
      # suspend interleaving this thaw is exactly the frozen-with-the-pad-
      # on-Kodi race the lock exists for. This branch exits right after, so
      # the lock is never held for a launch's lifetime.
      say "=== back to big picture"
      session_lock
      intent launch bigpicture mode=refocus source=kodi-tile
      # Flag first, thaw second - resume_game explains the rule.
      rm -f "$SUSPENDED"
      intent clear_flag suspended reason=back-to-big-picture
      cont_all
      clear_snaps
      pad_to_game
      focus_game bp
      exit 0
    fi
    ;;
  shadps4)
    # If this game is paused, its tile resumes it instead of booting fresh.
    if [ -f "$SUSPENDED" ]; then
      if [ "$(cat "$SUSPENDED")" = "$APPID" ]; then
        say "=== resume $APPID (shadps4) from its tile"
        session_lock   # a resume in all but name; exits right after
        intent launch "$APPID" mode=resume source=kodi-tile app=shadps4
        resume_game
        exit 0
      fi
      say "closing paused game before launching $APPID"
      close_games "different-game-picked:$APPID"
      # Same 10s deadline for the old launcher to bow out, 0.25s grain.
      for _ in $(seq 40); do [ -f "$SESSION" ] || break; sleep 0.25; done
    fi
    ;;
  *)
    say "unknown mode: $MODE"
    exit 1
    ;;
esac

say "=== launch $MODE $APPID"
intent launch "${APPID:-$MODE}" "mode=$MODE" "app=$MODE" source=fresh-launch
# Launching from the phone with the TV off should light the set up: tv-waker
# consumes this flag within half a second and wakes only if it's in standby.
# The flag write is the session-start handover's, so couchd writes it (byte for
# byte, same path) once it owns transitions.
yield_to_couchd transitions request_tv_wake tv via=tv-wake-request-flag \
  "reason=launch $MODE" || {
  touch /tmp/tv-wake-request
  intent request_tv_wake tv via=tv-wake-request-flag "reason=launch $MODE"
}
# The session flag is how the PS-button watcher knows the pad belongs to a
# game. Ownership is recorded so an old launcher bowing out can't take a new
# launcher's flag with it.
echo "$$ $MODE $APPID" > "$SESSION"
intent set_flag session "value=$$ $MODE $APPID" "launcher=$$" reason=launch
# The session flag is OURS either way - this shell's lifetime IS the session,
# and a launcher that stopped clearing its own flag would orphan every session
# it ran. Only the pad-and-screen handover is the `transitions` responsibility.
restore_on_exit() {
  yield_to_couchd transitions route_pad kodi via=kodi-jsonrpc "mode=$MODE" && {
    intent show kodi via=xlib-restack "mode=$MODE" yielded=true owner=couchd
    say "restored (trap): yielded to couchd (transitions)"
    return 0
  }
  pad_to_kodi
  focus_kodi
  say "restored (trap)"
}
trap '[ "$(cut -d" " -f1 "$SESSION" 2>/dev/null)" = "$$" ] && { rm -f "$SESSION"; intent clear_flag session reason=launcher-exit "launcher=$$"; }; restore_on_exit' EXIT

yield_to_couchd transitions route_pad game via=kodi-jsonrpc "mode=$MODE" \
  || pad_to_game

case "$MODE" in
  steam)
    # Into Big Picture first, so the pad talks to a UI the guard can repair.
    # Only this arm calls it: `bigpicture` mode below is already opening BP by
    # definition, and calling it there would open it twice.
    ensure_big_picture
    steam "steam://rungameid/$APPID" >/dev/null 2>&1 &
    # First run of a Proton game builds its prefix and compiles shaders, so
    # give it a long leash before deciding it never started. Once it shows,
    # make sure its window is the one on top, then wait it out. A suspended
    # game still counts as running here, which is the point: the launcher
    # stays alive holding the session until the game truly ends.
    # 0.5s probe (game-pids costs ~39ms, ~8% duty), same 180s leash: the 2s
    # cadence detected the processes up to 2s after they appeared. Counted in
    # half-seconds (integer arithmetic): 360 x 0.5s = 180s.
    t=0
    while ! game_running; do
      sleep 0.5; t=$((t+1))
      [ $t -ge 360 ] && { say "never appeared (180s)"; break; }
    done
    if game_running; then
      say "running"
      # Straight into the converge - no fixed sleep 4. That pause predates
      # focus_game_when_mapped (6 Aug), which already handles a window that
      # is not there yet; for a fast-mapping game the 4s was pure padding
      # spent in the BP-behind-game worst state.
      yield_to_couchd transitions show "${APPID:-game}" via=xlib-restack \
        "mode=$MODE" resolver=game-pids || focus_game_when_mapped
      while game_running; do sleep 3; done
      say "ended"
    fi
    ;;
  bigpicture)
    steam "steam://open/bigpicture" >/dev/null 2>&1 &
    t=0
    while ! bp_running; do
      sleep 2; t=$((t+2))
      [ $t -ge 60 ] && { say "never appeared (60s)"; break; }
    done
    if bp_running; then
      say "running"
      # Big Picture is where games get STARTED, so this poll is also where a
      # nameless session learns its own name (see adopt_appid). Cheap: it stops
      # trying the moment it succeeds, and does nothing at all until a game is
      # actually up.
      while bp_running; do adopt_appid; sleep 3; done
      say "ended"
    fi
    # Leaving Big Picture often means "into a game": if one is up, keep the
    # pad with it until it ends too. Adopt here as well - a game launched in
    # the last seconds of Big Picture's life can outlive it before the poll
    # above ever came round.
    if game_running; then
      adopt_appid
      say "game outlived big picture (appid ${APPID:-unknown})"
      while game_running; do adopt_appid; sleep 3; done
      say "game ended"
    fi
    ;;
  shadps4)
    # APPID carries the eboot.bin path of a dumped game, or is empty to open
    # the emulator's own controller-driven library (Big Picture).
    if [ -n "$APPID" ]; then
      shadps4 "$APPID" >/dev/null 2>&1 &
    else
      shadps4 >/dev/null 2>&1 &
    fi
    t=0
    while ! emu_running; do
      sleep 1; t=$((t+1))
      [ $t -ge 60 ] && { say "shadps4 never appeared (60s)"; break; }
    done
    if emu_running; then
      say "shadps4 running"
      sleep 3
      yield_to_couchd transitions show "${APPID:-shadps4}" via=xlib-restack \
        "mode=$MODE" || focus_game emu
      while emu_running; do sleep 3; done
      say "shadps4 ended"
    fi
    ;;
esac
# trap restores pad + focus
