def yield_gesture(gname, reason, action):
    """The would-do line for a gesture couchd now owns.

    A suspend is worth spelling out - the pid set is the diffable part, and
    reading it is free (game-pids + /proc, no side effects) - so the differ can
    still check couchd froze what this script would have frozen. Everything
    else is named by its action; recomputing each bound action's full effect
    list without running it would be reimplementing couchd in this file, which
    is the thing the cutover exists to stop doing."""
    args = {'gesture': gname, 'action': action, 'reason': reason,
            'yielded': True, 'owner': 'couchd'}
    if action == 'suspend_to_kodi' and os.path.exists(SESSION):
        parts = _session_parts()
        # The WHOLE game-pids set, not running_pids(): couchd decides on
        # kernel timestamps in-process, so by the time this shadow line is
        # written its SIGSTOPs have usually already landed, and a filter that
        # drops 'T' states subtracts the owner's own action from our
        # counterfactual. That is how every yielded would-freeze on the
        # acceptance night (6 Aug 2026) recorded pids=[] against couchd's 18
        # - 10 gating SET-MISMATCH rows. At the press these pids WERE
        # running; the set game-pids names is the set the acting path would
        # have frozen. (The acting path keeps its filter: it reads BEFORE it
        # stops anything, where 'T' really does mean already-frozen.)
        intent('freeze', _session_appid(parts),
               pids=sorted(game_pids()), resolver='game-pids',
               **args)
    else:
        intent('yield', gname, **args)
    say(f'{LABELS.get(gname, gname)}: {action} -> couchd owns gestures')


def act(gesture, c, defer_handoff=False):
    """Run whatever `gesture` is bound to. The whole dispatch is here, and
    couchd's action_intents() mirrors it verb for verb off the same config -
    so the shadow diff still compares like with like after a rebind.

    Returns True only for the hold's deferred suspend (see act_suspend)."""
    action = c.action_for(gesture)
    if action == 'none':
        return False
    _, gname, reason = GESTURE_META.get(
        gesture, (gesture, gesture, f'ps-{gesture}'))
    if yielded('gestures'):
        # couchd runs the gesture vocabulary now. Nothing here fires, and no
        # deferred handoff is armed either: returning False keeps the release
        # path from calling handoff_to_kodi, so this script performs no part
        # of a gesture it does not own.
        yield_gesture(gname, reason, action)
        return False
    try:
        if action == 'suspend_to_kodi':
            return act_suspend(gname, reason, defer_handoff)
        fn = ACTIONS.get(action)
        if fn is None:
            say(f'{gname}: unknown action {action!r}, ignoring')
            return False
        fn(gname, reason)
    except Exception as e:
        # A bound action that throws must never take the watcher down with it:
        # the PS button is the room's only way out of a game.
        say(f'{gname}: action {action} failed: {e}')
    return False


def hold_ready(action):
    """Whether the hold threshold fires at all.

    `suspend_to_kodi` keeps the console's original gate: no /tmp/game-session
    means the threshold is NOT spent, so a session appearing mid-press still
    suspends. `none` never fires, which is precisely what leaves the press
    available to the long-hold tier (gestureconf only allows a long hold with
    the hold unbound)."""
    if action == 'none':
        return False
    if action == 'suspend_to_kodi':
        return os.path.exists(SESSION)
    return True


CURTAIN_CLASS = 'couch-curtain'   # tools/curtain's freeze-frame overlay


def _foreground_class(cl):
    """May `cl` be reported as the foreground window's class?

    The couch-curtain overlay (tools/curtain) is TRANSPARENT to
    classification: a cosmetic freeze-frame stretched over a suspend/resume
    handover, deliberately on top of everything, and reading it as "the
    foreground window" would turn every repair that looks at the screen into
    a fight with a window that re-raises itself. Skipped entirely, as if not
    mapped - the contract at the top of tools/curtain."""
    return bool(cl) and cl != CURTAIN_CLASS


def curtain_visible():
    """Is the couch-curtain overlay actually up right now?

    _foreground_class keeps the curtain out of the classifications; this
    answers the other half of the whitelist: while the curtain is up the room
    is looking at IT, so the frozen-game-visible repair has nothing visible
    to repair and must not restack Kodi against an overlay that is covering
    the handover on purpose (and holds itself on top until it fades or its
    watchdog kills it). The curtain is override-redirect, so it sits as a
    direct child of root and one shallow pass finds it."""
    try:
        from Xlib import display
        d = display.Display()
        root = d.screen().root
        up = False
        for c in root.query_tree().children:
            try:
                if c.get_attributes().map_state != 2:
                    continue
                if (c.get_wm_class() or ('', ''))[0] == CURTAIN_CLASS:
                    up = True
                    break
            except Exception:
                continue
        d.close()
        return up
    except Exception:
        return False


def screen_classes():
    """(topmost window class, focused window class), in one X round trip.

    Topmost is the guard's rule (steam-input-guard.top_window): mapped, not
    InputOnly, at least 600x400, last in the bottom-to-top child order. Focus is
    read the guard's way too, walking up from the focus window until something
    owns a class. Together they answer the question a repair actually needs:
    is the room looking at the game, or at something else? The couch-curtain
    overlay is never the answer (see _foreground_class)."""
    try:
        from Xlib import display
        d = display.Display()
        root = d.screen().root

        def cls_of(w, depth=0):
            try:
                cl = (w.get_wm_class() or ('', ''))[0]
                if cl or depth >= 3:
                    return cl
                for ch in w.query_tree().children:
                    r = cls_of(ch, depth + 1)
                    if r:
                        return r
            except Exception:
                pass
            return ''

        topcls = ''
        for c in root.query_tree().children:  # bottom -> top
            try:
                a = c.get_attributes()
                if a.map_state != 2 or a.win_class == 2:
                    continue
                g = c.get_geometry()
                if g.width < 600 or g.height < 400:
                    continue
                cl = cls_of(c)
                if _foreground_class(cl):
                    topcls = cl
            except Exception:
                continue
        focuscls = ''
        try:
            f = d.get_input_focus().focus
            for _ in range(5):
                if not hasattr(f, 'get_wm_class'):
                    break
                try:
                    cl = (f.get_wm_class() or ('', ''))[0]
                except Exception:
                    cl = ''
                if _foreground_class(cl):
                    focuscls = cl
                    break
                f = f.query_tree().parent
        except Exception:
            pass
        d.close()
        return topcls, focuscls
    except Exception:
        return '', ''


def top_is_frozen_game():
    """Is the visible window a steam_app while the game is suspended?

    Never while the couch-curtain is up: the room sees the curtain, not the
    frozen game (whose window may still sit mapped beneath it mid-handover),
    so there is nothing visible to repair - and raising Kodi would stack it
    against an overlay that re-raises itself (see curtain_visible)."""
    if curtain_visible():
        return False
    return screen_classes()[0].startswith('steam_app')


_last_reconcile = [0.0]


def reconcile():
    """The standing safety net: every ~10s, repair drift that arises OUTSIDE
    the transition guards - Kodi crash-restarts reloading a stale joystick
    setting, a dead launcher orphaning the session, a lost thaw, a stale
    paused flag, a frozen game left visible. Everything here is idempotent
    and converges toward the state the flags describe."""
    now = time.monotonic()
    if now - _last_reconcile[0] < 10:
        return
    _last_reconcile[0] = now
    try:
        # Yielding reverses the roles for this responsibility: the repairs are
        # still COMPUTED and written to the intent stream (that stream is the
        # shadow the differ needs once couchd is the one repairing), but every
        # effect below is skipped. Read fresh on every pass, so a rollback to
        # an empty owns.conf has this script repairing again within 10s.
        _reconcile(dry=yielded('reconcile'))
    except Exception as e:
        say(f'reconcile error: {e}')


def _reconcile(dry=False):
    # `dry` = couchd owns the reconcile responsibility. Two helpers keep the
    # yield honest and reviewable: EVERY side effect below goes through do(),
    # and EVERY intent line carries Y so the differ can tell a would-do from a
    # did. The repair logic itself, including the local bookkeeping that
    # follows each repair, is untouched - a shadow that skipped its own state
    # updates would report a different second repair than the real thing did.
    def do(fn, *a, **kw):
        return None if dry else fn(*a, **kw)

    Y = {'yielded': True, 'owner': 'couchd'} if dry else {}
    session = None
    try:
        session = open(SESSION).read().split()
    except OSError:
        pass
    suspended = os.path.exists(SUSPENDED)
    states = _pid_states()

    # A session whose launcher died with no game left is an orphan: nothing
    # will ever return the pad to Kodi, so reclaim it here.
    if session:
        try:
            launcher_alive = os.path.exists(f'/proc/{int(session[0])}')
        except (ValueError, IndexError):
            launcher_alive = False
        if not launcher_alive and not states:
            say('reconcile: orphaned session (launcher gone, no game) - reclaiming')
            for p in (SESSION, SUSPENDED):
                try:
                    if dry:
                        if not os.path.exists(p):
                            continue   # nothing to record removing
                    else:
                        os.remove(p)
                    intent('clear_flag',
                           'suspended' if p == SUSPENDED else 'session',
                           reason='orphaned-session', repair='reconcile',
                           launcher_alive=False, pids=[], **Y)
                except OSError:
                    pass
            do(clear_snapshots)
            session, suspended = None, False
            pad_to_kodi('reconcile:orphaned-session', dry=dry)
            focus_kodi('reconcile:orphaned-session', dry=dry)

    # A paused flag with nothing actually frozen is stale (game was killed
    # externally); it would make the next PS tap misfire.
    #
    # EXCEPT 'bigpicture': a Big Picture suspend has no pids to freeze BY
    # DESIGN (there is no reaper tree, only Steam's own UI), so "flag with
    # nothing frozen" is its normal resting state, not staleness. couchd's
    # model has carried this exemption since R7(a); without it here the two
    # stacks fight every ~10s while gestures are flipped: couchd's hold
    # writes the flag and routes the pad to Kodi, this repair deletes it,
    # and the joystick repair below then routes the pad back to an
    # invisible Big Picture (found by adversarial review, 5 Aug 2026).
    if suspended and not states and _suspended_appid() != 'bigpicture':
        say('reconcile: stale suspended flag, removing')
        try:
            if not dry:
                os.remove(SUSPENDED)
            intent('clear_flag', 'suspended', reason='stale-suspended-flag',
                   repair='reconcile', pids=[], resolver='game-pids', **Y)
        except OSError:
            pass
        do(clear_snapshots)
        suspended = False

    # A paused flag with the game still RUNNING had no repair at all until
    # tonight, which is why the 4 Aug 2026 race stuck: a resume's guard window
    # was still open when a PS hold froze the game, and the guard's stale-read
    # thaw-repair SIGCONTed the fresh freeze a second later - Kodi on screen,
    # game audible behind it, flag set, nothing converging. Both sides of that
    # race are fixed now (the guard re-reads the flag and closes on a suspend;
    # freeze_game supersedes any open guard first), but the STATE deserves a
    # repair regardless of how it was reached. What is on screen says which way
    # to converge: the flag is only wrong if the player can actually see and
    # drive the game.
    if suspended and states and any(s != 'T' for s in states.values()):
        # Re-read the flag AT THE DECISION, the guard's suspended_now() lesson
        # in the other direction: this pass's `suspended` was read tens of
        # milliseconds ago, and a resume that started since has already
        # cleared the flag (game-launch clears it BEFORE its SIGCONTs,
        # 6 Aug 2026), so the running pids ARE the resume, not drift.
        # Repairing on the stale pair is the refreeze-lost-suspend hazard the
        # reconcile flip is gated on - a SIGSTOP mid-resume, every resume.
        # With flag-first ordering this re-read is decisive: pids seen running
        # means the SIGCONTs landed, which means the rm landed before them,
        # so a flag that is truly mid-resume can never still be on disk here.
        if not os.path.exists(SUSPENDED):
            say('reconcile: suspended flag cleared mid-pass (a resume is in '
                'flight) - not drift, leaving it be')
            suspended = False
        else:
            topcls, focuscls = screen_classes()
            if topcls.startswith('steam_app') and focuscls.startswith('steam_app'):
                say('reconcile: suspended flag but the game is on screen and '
                    'focused - clearing the flag')
                try:
                    if not dry:
                        os.remove(SUSPENDED)
                    intent('clear_flag', 'suspended', repair='reconcile',
                           reason='reconcile:stale-suspended-while-playing',
                           pids=sorted(states), resolver='game-pids',
                           topcls=topcls, focuscls=focuscls, **Y)
                except OSError:
                    pass
                do(clear_snapshots)
                suspended = False
            else:
                say(f'reconcile: suspended flag but {len(states)} process(es) '
                    f'running behind {topcls or "?"} - re-freezing')
                appid = _suspended_appid() or _session_appid(session)
                intent('freeze', appid, pids=sorted(states),
                       resolver='game-pids', signal='SIGSTOP',
                       repair='reconcile',
                       reason='reconcile:refreeze-lost-suspend',
                       topcls=topcls or '?', **Y)
                for pid in states:
                    try:
                        do(os.kill, int(pid), signal.SIGSTOP)
                    except OSError:
                        pass
                # A game that ran on behind Kodi has a live pointer grab again.
                do(iconify_frozen_game, appid,
                   'reconcile:refreeze-lost-suspend')
                states = {p: 'T' for p in states}

    # A game that should be running but is entirely frozen lost its thaw -
    # UNLESS the frozen-without-flag world is a resume's own critical section
    # (flag cleared, SIGCONTs milliseconds away). Confirm the drift OUTLIVES
    # that window before believing it: re-sample after THAW_RECHECK_S, and
    # back off if the pids came back on their own OR the flag reappeared (a
    # suspend landing mid-pass - the 4 Aug guard race, checked here for the
    # same reason). A real lost thaw sails through 0.6s later, well inside
    # this net's 10s cadence. The confirm runs in dry mode too: a shadow that
    # skipped it would report a repair the acting path never fires.
    if not suspended and states and all(s == 'T' for s in states.values()):
        time.sleep(THAW_RECHECK_S)
        states = _pid_states()
        if (os.path.exists(SUSPENDED) or not states
                or any(s != 'T' for s in states.values())):
            say(f'reconcile: frozen-without-flag did not persist '
                f'{THAW_RECHECK_S}s - a transition is in flight, not drift')
        else:
            say('reconcile: game frozen with no suspended flag - thawing')
            appid = _session_appid(session)
            intent('thaw', appid, pids=sorted(states),
                   resolver='game-pids', reason='frozen-without-suspended-flag',
                   repair='reconcile', **Y)
            for pid in states:
                try:
                    do(os.kill, int(pid), signal.SIGCONT)
                except OSError:
                    pass
            # ...and it may have been iconified by the suspend that lost its
            # flag, so map it back: a thawed game left invisible is audible,
            # holds the pad, and shows the room nothing that explains either.
            do(map_game_window, appid, 'reconcile:thawed-without-flag')

    # Kodi's joystick setting must match who owns the pad. Kodi crash-restarts
    # reload whatever guisettings last saved, which can be the wrong side.
    want = not (session and not suspended)
    got = get_joystick()
    if got is not None and got is not want:
        say(f'reconcile: joystick {got} but should be {want} - fixing')
        intent('route_pad', 'kodi' if want else 'game',
               reason='joystick-setting-drift', repair='reconcile',
               was=got, via='kodi-jsonrpc', **Y)
        try:
            do(set_joystick, want)
        except OSError:
            pass

    # A frozen game must never be what the room is looking at.
    if suspended and top_is_frozen_game():
        say('reconcile: frozen game visible - raising kodi')
        focus_kodi('reconcile:frozen-game-visible', dry=dry)


def watch(paths):
    fds = {}
    for p in paths:
        fds[os.open(p, os.O_RDONLY | os.O_NONBLOCK)] = p
    say(f'watching {", ".join(paths)}')
    pressed_at = None
    fired = False           # the hold threshold has been spent this press
    long_fired = False      # ...and the long-hold one
    pending_handoff = None  # set when frozen mid-hold, done on release
    last_tap_at = None      # monotonic release of a tap that did nothing on
    #                         its own: the only kind that can pair into a
    #                         double-tap (see gesture.py)
    pending_resume = None   # monotonic deadline for a deferred tap-resume: set
    #                         only while a game is paused AND the double-tap is
    #                         bound, so a double-tap there opens the switcher
    swallowed = False       # this press landed inside a settle window and is
    #                         spent: it must fire nothing on release either
    settling_said = False   # the settling log line is once per burst, not per
    #                         press - a spam burst is loud enough already
    c = conf()              # the bindings in force; never changed mid-press
    try:
        while True:
            if pressed_at is None and not pending_handoff:
                # Re-read on change only (a stat unless Kodi rewrote the
                # file), and never while a gesture is in flight: swapping the
                # rules under a press that has already half-happened is how a
                # hold ends up handing the pad nowhere.
                c = conf()
            hold_s = c.hold_seconds
            r, _, _ = select.select(list(fds), [], [], 0.2)
            for fd in r:
                try:
                    data = os.read(fd, EVENT_SIZE * 64)
                except OSError:
                    if pending_handoff:
                        handoff_to_kodi('pad-gone-mid-hold')
                    return  # pad went away; rescan
                for off in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
                    _, _, etype, code, value = struct.unpack_from(EVENT_FORMAT, data, off)
                    if etype == EV_KEY and code == BTN_MODE:
                        if value == 1:
                            if settle_swallows(time.monotonic(),
                                               _settle_until[0]):
                                # The tail of a burst that already got what it
                                # asked for. Swallowed WHOLE: it fires nothing
                                # now, nothing on release (pressed_at stays
                                # None, so no hold threshold can be reached
                                # either), and it seeds no tap sequence - or
                                # the last two presses of a burst would compose
                                # a fresh double-tap exactly as the window
                                # expired, which is the bug arriving late.
                                if not settling_said:
                                    say('gesture ignored (settling)')
                                    settling_said = True
                                swallowed = True
                                pressed_at = None
                                last_tap_at = None
                                pending_resume = None
                                fired = False
                                long_fired = False
                                continue
                            settling_said = False
                            swallowed = False
                            pressed_at = time.monotonic()
                            fired = False
                            long_fired = False
                        elif value == 0:
                            if swallowed:
                                swallowed = False
                                continue
                            # A short tap while a game is paused jumps back into
                            # it (PS4-style home <-> game toggle), whatever the
                            # tap is bound to - see resume_game. Hold still
                            # suspends (freeze fires mid-hold below; Kodi only
                            # gets the pad here, on release, so it never sees
                            # any part of the held button).
                            released_at = time.monotonic()
                            was_tap = (not fired and not long_fired
                                       and pressed_at is not None
                                       and released_at - pressed_at < hold_s)
                            if pending_handoff:
                                handoff_to_kodi('hold-release')
                                pending_handoff = None
                                last_tap_at = None
                                pending_resume = None
                                act('hold_release', c)
                            elif fired or long_fired:
                                # A bound hold (or long hold) already ran and
                                # had no deferred half; its release is still
                                # its own gesture. 'none' by default, so this
                                # is the old do-nothing branch until bound.
                                last_tap_at = None
                                pending_resume = None
                                act('hold_release', c)
                            elif was_tap and os.path.exists(SUSPENDED):
                                # A tap on a paused game resumes it - unless
                                # the double-tap is bound, in which case this
                                # tap cannot yet know it is the whole gesture:
                                # a double-tap on a paused game opens the
                                # switcher (see resume_game). So it waits out
                                # the double-tap window, and ONLY here.
                                what = paused_tap_decision(
                                    pending_resume is not None,
                                    None if last_tap_at is None
                                    else pressed_at - last_tap_at,
                                    released_at - pressed_at,
                                    c.action_for('double_tap') != 'none',
                                    c.double_tap_seconds, hold_s)
                                if what == 'double_tap':
                                    pending_resume = None   # the switcher wins
                                    last_tap_at = None
                                    act('double_tap', c)
                                elif what == 'defer':
                                    pending_resume = (released_at
                                                      + c.double_tap_seconds)
                                    last_tap_at = released_at
                                else:
                                    resume_game()
                                    last_tap_at = None
                            elif was_tap:
                                # A tap that did nothing: either the opening
                                # half of a double-tap, or the closing one.
                                # The gap is measured release -> next press.
                                if (c.action_for('double_tap') != 'none'
                                        and is_double_tap(
                                            None if last_tap_at is None
                                            else pressed_at - last_tap_at,
                                            released_at - pressed_at,
                                            c.double_tap_seconds, hold_s)):
                                    last_tap_at = None  # the window is spent
                                    act('double_tap', c)
                                else:
                                    last_tap_at = released_at
                                    # ...and whatever a plain tap is bound to.
                                    # gestureconf only allows this with the
                                    # double-tap unbound, so a real double can
                                    # never fire it on its way through.
                                    act('tap', c)
                            else:
                                last_tap_at = None  # a hold is never half a double
                            pressed_at = None
            if (pressed_at is not None and not fired
                    and time.monotonic() - pressed_at >= hold_s
                    and hold_ready(c.action_for('hold'))):
                fired = True
                last_tap_at = None  # a hold cancels any half-formed double
                pending_resume = None   # ...and any deferred resume with it
                if act('hold', c, defer_handoff=True):
                    pending_handoff = time.monotonic()
            # The third tier, reachable only with `hold` bound to nothing
            # (gestureconf.suppress): otherwise the hold above fired first and
            # the press is spent. 'none' by default, so this never runs today.
            if (pressed_at is not None and not long_fired
                    and c.action_for('long_hold') != 'none'
                    and time.monotonic() - pressed_at >= c.long_hold_seconds):
                long_fired = True
                last_tap_at = None
                pending_resume = None
                act('long_hold', c)
            # No second tap came inside the double-tap window, so the first one
            # meant what a tap on a paused game has always meant. The flag is
            # re-read: a reconcile (or the phone) may have resumed in between.
            if (pending_resume is not None
                    and time.monotonic() >= pending_resume):
                pending_resume = None
                last_tap_at = None
                if os.path.exists(SUSPENDED):
                    resume_game()
            # Safety: if the release never arrives (pad died mid-hold), hand
            # over anyway after a few seconds rather than stranding the pad.
            if pending_handoff and time.monotonic() - pending_handoff > 4:
                handoff_to_kodi('hold-release-timeout')
                pending_handoff = None
            # Standing drift repair, but never mid-press: reconciling while
            # the button is down could hand Kodi a phantom held button.
            if pressed_at is None and not pending_handoff:
                reconcile()
    finally:
        for fd in fds:
            try:
                os.close(fd)
            except OSError:
                pass


def main():
    complained = False
    while True:
        pads = find_pads()
        if not pads:
            reconcile()  # drift repair runs with or without a pad connected
            time.sleep(5)
            continue
        try:
            watch(pads)  # returns when the pad disconnects
        except PermissionError:
            # Usually a race with udev applying the seat ACL to a fresh node;
            # retry quickly rather than leaving the PS button dead for long.
            if not complained:
                say('no permission on /dev/input - needs the dualsense udev rule')
                complained = True
            time.sleep(5)
        except Exception as e:
            say(f'watch error: {e}')
            time.sleep(5)


if __name__ == '__main__':
    main()
