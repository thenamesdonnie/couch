def background(fn, *args):
    """Anything that has to wait on Steam, the TV or the couch server runs off
    the select loop: a blocked watcher is a pad that stops responding, which
    is exactly what this whole script exists to prevent."""
    import threading
    threading.Thread(target=fn, args=args, daemon=True).start()


def act_suspend(gname, reason, defer_handoff):
    """`suspend_to_kodi` - freeze the game and land on Kodi. The console's
    original hold, unchanged.

    Returns True when the caller must arm the deferred handoff (the hold's
    contract: the pad may not move while the button is still down). Any other
    gesture bound to this hands off at once, exactly as the double-tap
    switcher already did.
    """
    if not os.path.exists(SESSION):
        return False
    if not freeze_game(gname, reason):
        return False
    arm_settle('suspend')
    if defer_handoff:
        return True
    handoff_to_kodi(gname)
    return False


def act_switcher(gname, reason):
    """The on-TV switcher: the Kodi dialog script.couch.switcher draws.

    Kodi owns the dialog, so it has to own the pad and the screen first —
    with a game actually running that is the whole hold suspend, in the same
    order a hold does it, and couchd's model emits the same sequence
    (gesture:ps-double-tap, then show_switcher)."""
    say(f'{LABELS.get(gname, gname)}: switcher')
    show_desktop_off()
    if os.path.exists(SESSION) and freeze_game(gname, reason):
        handoff_to_kodi(gname)
    else:
        focus_kodi(gname)
    intent('show_switcher', 'tv', gesture=gname, reason=reason,
           via='kodi-addon:script.couch.switcher')
    show_switcher()
    arm_settle('switcher')


def _steam_menu():
    """Steam's own menu, opened with the guide press steam-input-guard uses to
    CLOSE it - the button is a toggle, so it is the identical mechanism. The
    virtual pad is only started if there isn't one already, and is always
    handed back; a leaked vpad is a phantom player 2 forever (audit failure
    10)."""
    started = False
    try:
        if not os.path.exists('/tmp/vpad.fifo'):
            subprocess.run([VPAD, 'up'], check=False, capture_output=True)
            started = True
            time.sleep(1.5)     # Steam needs a beat to enumerate it
        subprocess.run([VPAD, 'press', 'guide'], check=False,
                       capture_output=True)
        time.sleep(1.0)         # ...and a beat to act on the press
    except OSError as e:
        say(f'steam menu failed: {e}')
    finally:
        if started:
            subprocess.run([VPAD, 'quit'], check=False, capture_output=True)


