#!/usr/bin/env python3
"""Hold the PS button in a game and land back on the Kodi home screen,
with the game left frozen in the background, ready to resume.

Kodi's own pad input is off while a game runs (game-launch turns it off), so
this reads the DualSense directly from its evdev node and watches one thing:
the PS button (BTN_MODE) held for about a second while a game session is
active AND its processes are actually running. On that hold it SIGSTOPs the
game (a frozen game costs nothing), hands the pad back to Kodi, and puts Kodi
on screen. The game's tile on the home row shows it paused; picking it again
resumes it (game-launch handles the thaw). Quitting for real is the power
menu's job, which calls game-launch quit.

A quick tap stays with Steam (the overlay). Outside a game session, or while
the game is already frozen, this does nothing at all, so Kodi's tap-for-home
and hold-for-power-menu keep working.

TWO quick taps open the on-TV switcher instead: the Kodi dialog that
script.couch.switcher draws, listing the running game, Kodi and the desktop,
navigable with the stick. Because that dialog is Kodi's, a double-tap with a
game actually running does the whole hold suspend first (freeze, pad to Kodi,
guard) and only then asks for the dialog. A tap that already did something on
its own - the resume of a paused game - is never half of a double: the game
has the pad back by then and a Kodi dialog over it would be dead.

Reading /dev/input needs the udev rule in
/etc/udev/rules.d/71-dualsense-uaccess.rules; until that exists this logs a
hint and waits rather than dying.
"""
import json
import os
import re
import select
import signal
import struct
import subprocess
import sys
import threading
import time
import urllib.request

EVENT_FORMAT = 'llHHi'  # struct input_event on x86_64
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)
EV_KEY = 0x01
BTN_MODE = 0x13c  # the PS button
HOLD_SECONDS = 0.9

# The tap / double-tap / hold arithmetic has ONE home: ~/couch/couchd/gesture.py,
# the module couchd's shadow model and the stage-2 input process both run, so
# all three stacks decide the same gesture from the same numbers. This script
# is a standalone file in ~/.local/bin, so the path has to be explicit -
# APPENDED, never prepended, so nothing in that directory can shadow a stdlib
# module here. The hold path deliberately keeps its own monotonic arithmetic
# untouched (couchd measures kernel timestamps; changing the timebase of a
# live gesture is not what this feature is for), and the fallback below keeps
# the console alive if ~/couch ever moves.
sys.path.append('/home/ds2000/couch/couchd')
try:
    from gesture import (DOUBLE_TAP_S, SETTLE_S, is_double_tap,
                         paused_tap_decision, settle_swallows)
except ImportError:  # pragma: no cover - the source of truth is gesture.py
    DOUBLE_TAP_S = 0.35
    SETTLE_S = 1.2

    def is_double_tap(gap, second_duration, window=DOUBLE_TAP_S,
                      hold=HOLD_SECONDS):
        return (gap is not None and gap < window
                and second_duration is not None and second_duration < hold)

    def settle_swallows(now, settle_until):
        return settle_until is not None and now < settle_until

    def paused_tap_decision(deferred, gap, second_duration, double_tap_bound,
                            window=DOUBLE_TAP_S, hold=HOLD_SECONDS):
        if deferred and is_double_tap(gap, second_duration, window, hold):
            return 'double_tap'
        return 'defer' if double_tap_bound else 'resume'

# The BINDINGS come from the same directory, and from the file Kodi's own
# settings page writes (Add-ons > Program add-ons > Couch Switcher >
# Configure). Same rule as gesture.py: one reader, two stacks, so couchd's
# would-do log still describes this script after a rebind. Same fallback rule
# too - if ~/couch ever moves, the console keeps the behaviour it shipped with
# rather than losing the PS button.
try:
    import gestureconf
except ImportError:  # pragma: no cover - the source of truth is gestureconf.py
    gestureconf = None

# WHO OWNS WHAT, right now. ~/couch/couchd/owns.conf is the one file both
# stacks read (couchd every tick, this script at every decision). While it is
# empty - the state it ships in - nothing below changes: this script does
# everything it has always done. Naming a responsibility there means couchd is
# doing it now, and our job flips to being the SHADOW for it: we still write
# the would-do line to /tmp/legacy-intents.jsonl (that is what the morning
# differ compares against couchd's stream after a flip) and perform no action.
#
# Every failure mode here answers "couchd owns nothing", which leaves this
# script acting - the console keeps working if ~/couch ever moves.
_owns_import_error = None
try:
    import owns as couchd_owns
except Exception as _e:  # pragma: no cover - the source of truth is owns.py
    # ANY failure, not just ImportError. A syntax error in owns.py must never
    # crash-loop this service (Restart=always) and take the PS button - the
    # room's only way out of a game - down with it. No module means no
    # yielding, which means this script keeps doing everything.
    couchd_owns = None
    _owns_import_error = _e

_owns_said = [None]
_heartbeat_said = [None]


def yielded(responsibility):
    """True when couchd owns `responsibility` AND is alive to act on it.

    Ownership is a LEASE (owns.py's couchd_alive): the file grants it, couchd's
    status.json heartbeat keeps it. `systemctl --user stop couchd` therefore
    hands everything back within 30s without anyone editing a config file in
    the dark, which is the charter's one-command rollback honoured literally."""
    if couchd_owns is None:
        if _owns_said[0] is None:
            _owns_said[0] = []
            say(f'owns.py unavailable ({_owns_import_error}); '
                f'acting on everything')
        return False
    try:
        cur = couchd_owns.load()
    except Exception as e:
        say(f'owns.conf unreadable ({e}); acting on everything')
        return False
    if cur.sorted != _owns_said[0]:
        _owns_said[0] = cur.sorted
        say(f'couchd {couchd_owns.describe(cur)}')
        for w in cur.warnings:
            say(f'owns.conf: {w}')
    if responsibility not in cur.names:
        return False
    alive = couchd_owns.couchd_alive()
    if alive != _heartbeat_said[0]:
        _heartbeat_said[0] = alive
        if alive:
            say('couchd heartbeat ok; yielding ' + ', '.join(cur.sorted))
        else:
            age = couchd_owns.heartbeat_age()
            say('couchd owns %s but its heartbeat is STALE (%s) - acting on '
                'everything again' % (', '.join(cur.sorted),
                                      'never' if age is None else f'{age:.0f}s'))
    return alive

DEFAULT_BINDINGS = {'tap': 'none', 'double_tap': 'switcher',
                    'hold': 'suspend_to_kodi', 'hold_release': 'none',
                    'long_hold': 'none'}


class _FallbackConf:
    """What gestureconf returns, minus the file, for the missing-module case."""
    bindings = DEFAULT_BINDINGS
    hold_seconds = HOLD_SECONDS
    double_tap_seconds = DOUBLE_TAP_S
    long_hold_seconds = 3.0
    warnings = ()

    def action_for(self, gesture):
        return self.bindings.get(gesture, 'none')


_FALLBACK = _FallbackConf()
_said_warnings = [None]


def conf():
    """The current bindings. Cheap enough for the select loop: gestureconf
    stats the settings file and re-parses only when it changed, so a rebind
    lands on the next iteration with no restart and no watcher of its own."""
    if gestureconf is None:
        return _FALLBACK
    try:
        c = gestureconf.load()
    except Exception as e:  # the module promises not to, but this is the
        say(f'bindings unreadable ({e}); using defaults')  # console's input
        return _FALLBACK
    if c.warnings and c.warnings != _said_warnings[0]:
        _said_warnings[0] = c.warnings
        for w in c.warnings:
            say(f'bindings: {w}')
    return c
SESSION = '/tmp/game-session'
SUSPENDED = '/tmp/game-suspended'
LOG = '/tmp/pad-home.log'
INTENTS = '/tmp/legacy-intents.jsonl'  # machine-readable decisions (couchd R3)

# Only the button device; the same pad also exposes motion sensors and a
# touchpad, which never carry BTN_MODE.
WANTED = 'DualSense Wireless Controller'
UNWANTED = re.compile(r'Motion|Touchpad', re.I)


def say(msg):
    now = time.time()
    with open(LOG, 'a') as f:
        f.write(f"{time.strftime('%H:%M:%S', time.localtime(now))}"
                f".{int(now % 1 * 1000):03d} {msg}\n")


def intent(verb, subject=None, **args):
    """One JSON line per decision, beside the human line: the couchd
    shadow-diff reads these instead of guessing intent from effects. Purely
    additive - a failure here must never reach the caller."""
    try:
        with open(INTENTS, 'a') as f:
            f.write(json.dumps({'t': time.time(), 'src': 'watcher',
                                'verb': verb, 'subject': subject,
                                'args': args}, default=str) + '\n')
    except OSError:
        pass


def _suspended_appid():
    """Whatever the paused-game flag names, as an intent subject."""
    try:
        return open(SUSPENDED).read().strip() or None
    except OSError:
        return None


def _session_parts():
    """/tmp/game-session split, or [] if there is no session."""
    try:
        return open(SESSION).read().split()
    except OSError:
        return []


def _session_appid(parts):
    """appid (or mode) out of an already-read /tmp/game-session split."""
    if parts and len(parts) > 2 and parts[2]:
        return parts[2]
    if parts and len(parts) > 1:
        return parts[1]
    return None


def find_pads():
    nodes = []
    try:
        blocks = open('/proc/bus/input/devices').read().split('\n\n')
    except OSError:
        return nodes
    for b in blocks:
        m = re.search(r'N: Name="([^"]*)"', b)
        if not m or WANTED not in m.group(1) or UNWANTED.search(m.group(1)):
            continue
        h = re.search(r'H: Handlers=.*?(event\d+)', b)
        if h:
            nodes.append('/dev/input/' + h.group(1))
    return nodes


def game_pids():
    # One source of truth: reaper's process tree + shadPS4 (see game-pids).
    try:
        return [int(p) for p in subprocess.run(
            ['/home/ds2000/.local/bin/game-pids'],
            capture_output=True, text=True).stdout.split()]
    except ValueError:
        return []


_settle_until = [None]   # monotonic deadline; see gesture.SETTLE_S


def arm_settle(what):
    """Open a settle window after a heavy transition.

    Everything that takes the screen and the pad arms one, so the burst of
    presses that produced it cannot immediately produce its opposite. Monotonic
    rather than kernel time on purpose: watch()'s own press arithmetic is
    monotonic (see the gesture.py import note), and a deadline in one timebase
    compared against presses in another is worse than either."""
    _settle_until[0] = time.monotonic() + SETTLE_S
    say(f'settling {SETTLE_S:.1f}s after {what}')


def resume_game():
    # PS4-style: a tap on the home screen jumps back into the paused game.
    #
    # NOT A BINDING, deliberately. This is the recovery path: the only way
    # back into a game this script suspended. A settings page that let it be
    # bound away would let someone strand a frozen game with no route back to
    # it from the couch - the same class of mistake the suspend_to_kodi safety
    # rail exists to prevent, in the opposite direction. So it stays state
    # logic, ABOVE the binding dispatch: a tap with /tmp/game-suspended
    # present resumes, and only a tap that finds nothing paused is handed to
    # whatever `tap` is bound to.
    #
    # ONE amendment (5 Aug 2026, Donnie's call, overriding the earlier ruling
    # that this always fires instantly): while a game is paused AND the
    # double-tap is bound, the tap that would resume waits out the double-tap
    # window first, because a double-tap on a paused game should open the
    # switcher - that is precisely when it is most useful, since you are
    # already sitting on Kodi wondering what else is running. The deferral
    # lives in watch(), is that narrow, and disappears the moment the
    # double-tap is unbound: everywhere else a tap is still instant.
    # The resume is state logic rather than a binding, but it is still part of
    # the gesture vocabulary: when couchd owns gestures it owns this too, and
    # this script only records what it would have done. The settle window is
    # still armed - yielding removes our EFFECTS, never our own arithmetic, so
    # the press stream this script sees stays exactly the one it saw before.
    if yielded('gestures'):
        say('PS tap: resume -> couchd owns gestures')
        intent('launch', _suspended_appid(), mode='resume', gesture='tap',
               via='game-launch resume', yielded=True, owner='couchd')
        arm_settle('resume')
        return
    say('PS tap: resume paused game')
    intent('launch', _suspended_appid(), mode='resume', gesture='tap',
           via='game-launch resume')
    subprocess.Popen(['/home/ds2000/.local/bin/game-launch', 'resume'],
                     start_new_session=True)
    arm_settle('resume')


PAUSE_SNAP = '/home/ds2000/.local/bin/pause-snap'
# Set when the freeze-frame is safely on disk. The iconify that follows a
# suspend frees the window's compositing pixmap, which is exactly what
# pause-snap reads, so the two must not race.
_SNAP_DONE = threading.Event()
SNAP_WAIT_S = 4.0


def snapshot(appid, gesture_name='hold', reason='ps-hold'):
    """Keep the game's last rendered frame as its artwork while it is paused,
    so the phone's switcher and the Kodi home row show where the player left
    off. Purely cosmetic, so it runs OFF the select loop: a blocked watcher is
    a pad that stops responding, and no screenshot is worth that.

    Safe to run after the SIGSTOP: xfwm4 compositing keeps every mapped
    window's pixmap, so a frozen window covered by Kodi still captures its
    real last frame (verified 4 Aug 2026; see pause-snap)."""
    intent('snapshot', appid, via='pause-snap', gesture=gesture_name,
           reason=reason)
    _SNAP_DONE.clear()
    background(_snapshot, appid, reason)


def _snapshot(appid, reason):
    try:
        env = dict(os.environ, PAUSE_SNAP_SRC='watcher')
        subprocess.run([PAUSE_SNAP, str(appid), reason], timeout=3,
                       capture_output=True, env=env)
    except (OSError, subprocess.SubprocessError) as e:
        say(f'pause-snap: no frame for {appid} ({e})')
    finally:
        _SNAP_DONE.set()


def clear_snapshots(appid=None):
    """A freeze-frame outlives its pause by nothing. No appid clears the lot,
    which is what the stale-flag and orphan repairs want."""
    try:
        subprocess.run([PAUSE_SNAP, '--clear'] + ([str(appid)] if appid else []),
                       timeout=3, capture_output=True)
    except (OSError, subprocess.SubprocessError):
        pass


def running_pids(pids):
    """Only processes that are actually executing; 'T' means already frozen."""
    out = []
    for pid in pids:
        try:
            stat = open(f'/proc/{pid}/stat').read()
            state = stat.rsplit(') ', 1)[1].split()[0]
        except (OSError, IndexError):
            continue
        if state != 'T':
            out.append(pid)
    return out


def _pid_states():
    """pid -> process state for the game's processes, read fresh from /proc.

    One reader for both the reconcile pass and its confirmation re-sample
    (see THAW_RECHECK_S), so the two compare like with like."""
    states = {}
    for pid in game_pids():
        try:
            stat = open(f'/proc/{pid}/stat').read()
            states[pid] = stat.rsplit(') ', 1)[1].split()[0]
        except (OSError, IndexError):
            pass
    return states


# How long a frozen-without-flag world must PERSIST before the lost-thaw
# repair believes it (the reconcile-flip hard gate, 6 Aug 2026). game-launch
# now clears /tmp/game-suspended BEFORE its SIGCONTs, so for the few hundred
# milliseconds of a resume's critical section the world reads exactly like a
# lost thaw. A real lost thaw is still there THAW_RECHECK_S later; the
# transient is not. The same re-sample also catches the opposite straddle - a
# suspend landing mid-pass shows up as the flag REAPPEARING, the 4 Aug guard
# lesson. The guard's THAW_CONFIRM_S and couchd's FLAG_DRIFT_PERSIST_S are
# this same contract on their own cadences.
THAW_RECHECK_S = 0.6


def jrpc(method, params):
    body = json.dumps({'jsonrpc': '2.0', 'id': 1, 'method': method,
                       'params': params}).encode()
    req = urllib.request.Request(
        'http://localhost:8090/jsonrpc', data=body,
        headers={'content-type': 'application/json'})
    import base64
    req.add_header('Authorization', 'Basic ' + base64.b64encode(b'kodi:$KODI_PASSWORD').decode())
    return json.loads(urllib.request.urlopen(req, timeout=5).read())


def set_joystick(value):
    jrpc('Settings.SetSettingValue',
         {'setting': 'input.enablejoystick', 'value': value})


def get_joystick():
    try:
        return jrpc('Settings.GetSettingValue',
                    {'setting': 'input.enablejoystick'})['result']['value']
    except (OSError, KeyError, ValueError):
        return None  # Kodi down or mid-restart


def pad_to_kodi(reason='handoff', dry=False):
    # `dry` is the yield: the caller's responsibility belongs to couchd, so the
    # decision is still recorded and the JSON-RPC call is not made.
    if dry:
        say(f'pad -> kodi (yielded: {reason})')
        intent('route_pad', 'kodi', reason=reason, via='kodi-jsonrpc',
               yielded=True, owner='couchd')
        return
    try:
        set_joystick(True)
        say('pad -> kodi')
        intent('route_pad', 'kodi', reason=reason, via='kodi-jsonrpc')
    except OSError as e:
        say(f'kodi rpc failed: {e}')
        intent('route_pad', 'kodi', reason=reason, via='kodi-jsonrpc',
               failed=str(e))


def focus_kodi(reason='handoff', dry=False):
    if dry:
        say(f'kodi focus (yielded: {reason})')
        intent('show', 'kodi', reason=reason, via='xlib-restack',
               yielded=True, owner='couchd')
        return
    try:
        from Xlib import display, X
        d = display.Display()
        root = d.screen().root

        def find(w):
            try:
                for c in w.query_tree().children:
                    if (c.get_wm_name() or '') == 'Kodi':
                        return c
                    r = find(c)
                    if r:
                        return r
            except Exception:
                pass
            return None
        w = find(root)
        if w:
            w.configure(stack_mode=X.Above)
            try:
                d.set_input_focus(w, X.RevertToParent, X.CurrentTime)
            except Exception:
                pass
            d.sync()
            say('kodi focused')
            intent('show', 'kodi', reason=reason, via='xlib-restack')
    except Exception as e:
        say(f'focus failed: {e}')


XINPUT = '/home/ds2000/couch/server/xinput.py'


def iconify_frozen_game(appid, reason='release-pointer-grab'):
    """Unmap the frozen game's window, once Kodi already has the screen.

    A SIGSTOPped game cannot answer the X server, so any pointer grab it held
    at the instant it froze stays held: its cursor sprite sits on top of Kodi
    and the phone's XTEST clicks are swallowed by the frozen client. X drops a
    grab when the grab window stops being viewable, so unmapping the window is
    what actually frees the pointer - raising Kodi over it does not. The resume
    maps it back (game-launch: _NET_ACTIVE_WINDOW, which xfwm4 deiconifies on).

    Runs OFF the select loop and waits for the freeze-frame first: pause-snap
    reads the window's compositing pixmap, which iconifying frees. Cosmetic
    either way - a stuck cursor is ugly, a suspend that failed is not
    acceptable, so nothing here may reach the caller."""
    background(_iconify_frozen_game, appid, reason)


def _iconify_frozen_game(appid, reason):
    _SNAP_DONE.wait(SNAP_WAIT_S)
    try:
        pids = [str(p) for p in game_pids()]
        if not pids:
            return
        wid = subprocess.run(['python3', XINPUT, 'gamewin'] + pids,
                             capture_output=True, text=True,
                             timeout=5).stdout.strip()
        if not wid.startswith('0x'):
            say(f'iconify: no window for {appid} (harmless)')
            return
        subprocess.run(['python3', XINPUT, 'iconify', wid], timeout=5,
                       capture_output=True)
        say(f'iconified frozen {appid} ({wid})')
        intent('iconify', appid, via='wm-change-state', reason=reason,
               window=wid)
    except (OSError, subprocess.SubprocessError) as e:
        say(f'iconify failed for {appid} ({e}); pointer grab may persist')


def map_game_window(appid, reason='restore-after-thaw'):
    """The exact undo of iconify_frozen_game (xfwm4 deiconifies on a pager
    _NET_ACTIVE_WINDOW), for the repairs that thaw a game themselves.

    Without it a repair-thawed game would be left running in the taskbar,
    invisible: audible, eating the pad, and with no window on screen to explain
    itself. On a window that was never iconified this is just a raise."""
    background(_map_game_window, appid, reason)


def _map_game_window(appid, reason):
    try:
        pids = [str(p) for p in game_pids()]
        if not pids:
            return
        wid = subprocess.run(['python3', XINPUT, 'gamewin', '--any-state'] + pids,
                             capture_output=True, text=True,
                             timeout=5).stdout.strip()
        if not wid.startswith('0x'):
            return
        subprocess.run(['python3', XINPUT, 'activate', wid], timeout=5,
                       capture_output=True)
        say(f'mapped {appid} back ({wid})')
        intent('show', appid, via='activate', reason=reason, window=wid)
    except (OSError, subprocess.SubprocessError) as e:
        say(f'map back failed for {appid} ({e})')


GAME_APPID = '/home/ds2000/.local/bin/game-appid'


def resolve_appid():
    """Ask Steam what the running game actually is, or None.

    Only ever called when our own session line cannot say (a game started from
    inside Big Picture), so the cost lands on that path alone."""
    try:
        r = subprocess.run([GAME_APPID], capture_output=True, text=True,
                           timeout=5)
        out = r.stdout.strip()
        return out if out.isdigit() else None
    except (OSError, subprocess.SubprocessError):
        return None


GUARD_PIDFILE = '/tmp/steam-input-guard.pid'


def supersede_guard(reason='superseded-by-freeze'):
    """Close any enforcement window still open, before we freeze anything.

    A guard opened by a resume spends its seconds asserting game-mode
    invariants, one of which is "a game that should be running must be thawed".
    A PS hold inside that window raced its own repair and lost: 18 processes
    frozen at 02:13:33 on 4 Aug 2026, SIGCONTed by the resume's guard at
    02:13:34.865, leaving Kodi on screen with the game playing behind it. The
    guard now re-reads the flag and closes on a suspend, which fixes it at the
    source; this closes the window from our side too, so neither stack has to
    win a race in order to be correct.

    Same mechanism as the guard's own supersede(): SIGTERM the pid on file and
    leave the pidfile alone - the dying guard's SIGTERM handler removes it, and
    only if it still owns it, which is what makes a double-fire harmless."""
    if yielded('guard'):
        # couchd runs the enforcement windows now, and the pid on file is
        # COUCHD'S (it write-throughs the same pidfile so this file keeps
        # meaning what it always meant). SIGTERMing it would kill the daemon
        # that is holding the console together - so this yields hard.
        try:
            old = int(open(GUARD_PIDFILE).read())
        except (OSError, ValueError):
            return
        intent('kill', 'steam-input-guard', pids=[old],
               resolver='guard-pidfile', signal='SIGTERM', reason=reason,
               yielded=True, owner='couchd')
        say(f'supersede guard {old} -> couchd owns guard')
        return
    try:
        old = int(open(GUARD_PIDFILE).read())
        os.kill(old, 0)                     # alive?
        os.kill(old, signal.SIGTERM)
    except (OSError, ValueError):
        return
    say(f'superseded steam-input-guard {old}')
    intent('kill', 'steam-input-guard', pids=[old], resolver='guard-pidfile',
           signal='SIGTERM', reason=reason)


def freeze_game(gesture_name='hold', reason='ps-hold'):
    """Fires at the hold threshold, while the button is still down: freeze
    the game right away for a responsive feel, but do NOT give Kodi the pad
    yet — if its joystick input comes back mid-press, Kodi sees a phantom
    held button (it can miss the release while re-opening the device) and
    fires its own PS-hold action, popping the power menu. Returns True if
    the handoff to Kodi should happen on release.

    The double-tap switcher borrows this whole path (the defaults are the
    hold's, so the hold's behaviour and its log lines are untouched); it just
    calls the handoff itself rather than waiting for a release."""
    label = LABELS.get(gesture_name, 'PS double-tap')
    parts = []
    try:
        parts = open(SESSION).read().split()
    except OSError:
        pass
    mode = parts[1] if len(parts) > 1 else '?'
    appid = parts[2] if len(parts) > 2 and parts[2] else mode

    pids = running_pids(game_pids())
    if pids and not str(appid).isdigit():
        # A game started from INSIDE Big Picture leaves the session's appid
        # field empty, so the line above falls back to the MODE and this freeze
        # would stamp /tmp/game-suspended with the literal "bigpicture". That
        # keys pause-snap's freeze-frames and the tile art to a name no library
        # entry has, and makes the game's own Kodi tile read as "a different
        # game was picked" - which on 5 Aug 2026 closed and relaunched it,
        # losing the operator's progress. game-launch adopts the real appid
        # while the session runs; this is the second net, for a hold that lands
        # before its poll came round. A failure leaves today's value untouched.
        real = resolve_appid()
        if real:
            say(f'resolved appid {real} for a nameless "{mode}" session')
            intent('set_flag', 'session', value=real, resolver='game-appid',
                   reason='bigpicture-appid-adoption', was=appid)
            appid = real
    if pids:
        # Before the STOPs, not after: a guard window left open by a recent
        # resume would otherwise SIGCONT this freeze a second later.
        supersede_guard()
        say(f'{label}, freezing {len(pids)} process(es) of {appid}')
        intent('freeze', appid, pids=sorted(pids), resolver='game-pids',
               gesture=gesture_name, reason=reason, mode=mode)
        for pid in pids:
            try:
                os.kill(pid, signal.SIGSTOP)
            except OSError:
                pass
        with open(SUSPENDED, 'w') as f:
            f.write(appid)
        intent('set_flag', 'suspended', value=appid, reason=reason)
        snapshot(appid, gesture_name, reason)
    elif mode == 'bigpicture':
        # Nothing to freeze: Big Picture itself just stays open behind Kodi.
        say(f'{label}, leaving big picture and back to kodi')
    else:
        return False  # no live game, not big picture: nothing meaningful
    return True


def handoff_to_kodi(reason='release'):
    """Runs on button release (or a safety timeout): only now does Kodi get
    the pad and the screen."""
    pad_to_kodi(reason)
    focus_kodi(reason)
    # Kodi is on screen now, so the frozen game's window can go: a suspended
    # game keeps whatever pointer grab it froze holding, which puts its cursor
    # over Kodi and eats the phone's clicks. Only when something is actually
    # paused, and only after the freeze-frame is captured (see
    # iconify_frozen_game).
    paused = _suspended_appid()
    if paused:
        iconify_frozen_game(paused)
    # Steam saw the same PS press we did and may have opened its Big Picture
    # menu, which silently keeps the controller routed to Steam's UI while
    # Kodi is on screen. The guard closes it and re-raises Kodi.
    subprocess.Popen(['/home/ds2000/.local/bin/steam-input-guard', 'kodi'],
                     start_new_session=True)


def show_desktop_off():
    """Undo xfwm4's show-desktop if it is on.

    The switcher dialog draws inside Kodi, so a Kodi hidden behind an empty
    desktop would leave the room looking at nothing while the stick moved an
    invisible list. Coming BACK from the desktop is half the point of the
    gesture. Reuses the couch server's X helper rather than keeping a second
    copy of the client-message plumbing here."""
    try:
