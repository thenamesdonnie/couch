# Secrets and machine-specific config. Real values live here, never in git.
.env
.env.*
!.env.example

# Superseded by .env; kept on the box only until the migration is confirmed.
data/secrets.json

# Dependencies
node_modules/

# Frontend build output. Regenerate with `npm run build` in web/ after a
# clone: the server serves web/dist from disk, so it must exist at runtime.
web/dist/

# Captured pad input streams: large, machine-specific, regenerated on demand.
recordings/

# Freeze-frames of paused games (pause-snap): transient screen content, written
# at suspend and deleted on resume. Never anything to commit.
data/paused/

# Test rig output
tools/psfuzz/

# Logs
*.log
logs/

# Python
__pycache__/
*.py[cod]

# Editor and OS cruft
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
couchd/.venv/
kodi-addons/**/__pycache__/
.serena/
shadow/.intents-archive-state.json

# Pre-baked game loading cards (tools/warm-loading-cards): derived art, several
# MB per game, regenerated from the heroes/logos on demand.
data/loading-cards/

# Which Kodi this particular box launches, and which one it last launched.
# Machine state, not a project decision: kodi-flavour-active is rewritten on
# every single launch, and a checkout on another box must not inherit either.
data/kodi-flavour
data/kodi-flavour-active
shadow/couchd.lock

# Local working notes and shadow-mode traces: useful on the box, noise in the repo.
todo.md
shadow/

# Vendored ReShade shader packs: upstream git repos, not ours to carry.
data/ds3-reshade/

# Your own service inventory; ships as services.example.json instead.
data/services.json

# Game files are not redistributable; see data/README.md
data/bb-eboot/cmdtable.json
data/bb-eboot/dbg_refs.json
data/bb-eboot/translations.json
data/bb-eboot/script_commands.md
data/bb-eboot/lockdash/cave.bin
data/bb-hks/*.hks
data/bb-reborne-lighting-twin/
data/shadps4-particles/staging/
